<Project>
  <!--
    Klyroo.UI.Maui is built apart from the Blazor libraries: this file stops MSBuild from importing the repository's own Directory.Build.props
    (central package versions, warnings as errors on every project), which a MAUI library should not inherit, like the samples. It is not part of Klyroo.UI.slnx.
    One version for every project of the repository: build/Version.props.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Version.props" />

  <PropertyGroup>
    <!-- The target framework version of the library: net10.0 (the LTS) by default. A machine whose MAUI workload is the .NET 11 one builds with -p:KlyrooMauiTfm=net11.0. -->
    <KlyrooMauiTfm Condition="'$(KlyrooMauiTfm)' == ''">net10.0</KlyrooMauiTfm>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Klyroo Contributors</Authors>
    <Copyright>Copyright (c) 2026 Klyroo Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/klyroo/klyroo-ui</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/klyroo/klyroo-ui</RepositoryUrl>
  </PropertyGroup>
</Project>
