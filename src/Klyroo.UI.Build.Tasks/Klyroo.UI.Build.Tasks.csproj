<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MSBuild task assembly of Klyroo.UI (self-hosted fonts). Shipped in the package under buildTransitive/tasks/, never referenced
    by an app. netstandard2.0 so the same dll loads in `dotnet build` (MSBuild on .NET) and in Visual Studio (MSBuild on
    .NET Framework). No runtime dependency beyond the MSBuild assemblies the host already provides.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Klyroo.UI.Build</RootNamespace>
    <AssemblyName>Klyroo.UI.Build.Tasks</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- IconNames.cs and SvgImport.cs are compiled by Klyroo.UI too; this switches their namespace. -->
    <DefineConstants>$(DefineConstants);KLYROO_TASKS</DefineConstants>
    <!-- Task assemblies are loaded from the package folder, next to nothing: keep the output to one dll. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Klyroo.UI.Tests" />
  </ItemGroup>

</Project>
