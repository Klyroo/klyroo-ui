<Project>
  <!--
    Mode with Tailwind compiled by the app: copies the Blux theme (tokens, dark variant, and the list of classes the
    components use) to a stable path, obj/blux/blux.theme.css, because the NuGet cache path changes with every version.
    The app's stylesheet imports it after Tailwind:  @import "tailwindcss";  @import "../obj/blux/blux.theme.css";
  -->
  <Target Name="BluxCopyTailwindTheme" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../staticwebassets/blux.theme.css"
          DestinationFolder="$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), blux))"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Build-time features (fonts, icons): the shared task assembly, then one targets file per feature. -->
  <Import Project="$(MSBuildThisFileDirectory)Blux.UI.Tasks.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Blux.UI.Fonts.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Blux.UI.Icons.targets" />
</Project>
