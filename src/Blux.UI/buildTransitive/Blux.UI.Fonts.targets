<Project>
  <!--
    Self-hosted fonts. The app declares fonts as items:

      <BluxFont Include="Public Sans" Role="sans" Provider="google" Weights="400;700" Styles="normal;italic" Subsets="latin;latin-ext" />

    At build time the BluxResolveFonts task asks the providers, downloads only the requested files (cached), and generates
    blux.fonts.css (@font-face, a fallback face per family, the blux-font-sans and blux-font-mono variables) and the font files into
    obj/<config>/<tfm>/blux/fonts/. They are added to the static web assets at _blux/fonts/, so MapStaticAssets serves them from
    the app's own origin. BxFonts links the stylesheet and preloads the main face from a manifest generated into the assembly
    (obj/<config>/<tfm>/blux/BluxFontsManifest.g.cs, next to the fonts folder and not in it: everything in the folder is served).
    Nothing is requested from a third party when the page runs. BluxFonts=false turns the feature off.

    Declare the items in the project that hosts the app (the server project of a Server or Auto app): BxFonts reads the manifest
    of the entry assembly. Declaring them in a Blazor WebAssembly project is a build error (BLUXFONT010).
  -->
  <PropertyGroup>
    <BluxFonts Condition="'$(BluxFonts)' == ''">true</BluxFonts>
    <BluxFontsProviderPriority Condition="'$(BluxFontsProviderPriority)' == ''">google;bunny;fontsource</BluxFontsProviderPriority>
    <BluxFontsCacheDir Condition="'$(BluxFontsCacheDir)' == ''">$([MSBuild]::NormalizeDirectory($(BluxCacheDir), fonts-cache))</BluxFontsCacheDir>
    <BluxFontsCacheDays Condition="'$(BluxFontsCacheDays)' == ''">7</BluxFontsCacheDays>
    <BluxFontsFailOnError Condition="'$(BluxFontsFailOnError)' == ''">$([System.String]::Equals('$(Configuration)', 'Release'))</BluxFontsFailOnError>
    <!-- The generated names carry a hash of the content, so a font never changes at its URL. -->
    <BluxFontsCacheControl Condition="'$(BluxFontsCacheControl)' == ''">max-age=31536000, immutable</BluxFontsCacheControl>
  </PropertyGroup>

  <!--
    A Blazor WebAssembly project (a standalone app or the client project of an Auto app) is not the host of the page: the server
    renders the head, and BxFonts reads the manifest of the entry assembly, which on the server is the server project. Fonts
    declared in the client would render nothing there, and both projects would publish the same _blux/fonts/blux.fonts.css.
  -->
  <Target Name="BluxFontsCheckProject"
          BeforeTargets="BluxResolveFonts;BluxFontsDesignTime;ResolveProjectStaticWebAssets;CoreCompile"
          Condition="'$(BluxFonts)' != 'false' And '@(BluxFont)' != '' And '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
    <Error Code="BLUXFONT010"
           Text="BluxFont items are declared in '$(MSBuildProjectName)', a Blazor WebAssembly project. The server renders the page head, so fonts are self-hosted by the server project: declare the BluxFont items in the server project (the one that has the App component with BxFonts), and remove them here. Set BluxFonts=false in this project to silence this error." />
  </Target>

  <!--
    Design-time builds (IntelliSense, the IDE's evaluation) never touch the network and generate nothing: they only expose what
    an earlier real build left, so the manifest source and the static web assets are the same as at the last build.
  -->
  <Target Name="BluxFontsDesignTime"
          BeforeTargets="ResolveProjectStaticWebAssets;CoreCompile"
          Condition="'$(BluxFonts)' != 'false' And '@(BluxFont)' != '' And '$(DesignTimeBuild)' == 'true'">
    <PropertyGroup>
      <BluxFontsOutputDir Condition="'$(BluxFontsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux, fonts))</BluxFontsOutputDir>
      <BluxFontsManifestFile Condition="'$(BluxFontsManifestFile)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux))BluxFontsManifest.g.cs</BluxFontsManifestFile>
    </PropertyGroup>
    <ItemGroup>
      <_BluxFontExisting Include="$(BluxFontsOutputDir)*.woff2;$(BluxFontsOutputDir)*.woff;$(BluxFontsOutputDir)*.ttf;$(BluxFontsOutputDir)*.otf;$(BluxFontsOutputDir)blux.fonts.css" Condition="Exists('$(BluxFontsOutputDir)blux.fonts.css')" />
      <_BluxFontFile Include="@(_BluxFontExisting)" BluxFile="%(Filename)%(Extension)" />
      <Compile Include="$(BluxFontsManifestFile)" Condition="Exists('$(BluxFontsManifestFile)')" />
    </ItemGroup>
  </Target>

  <Target Name="BluxResolveFonts"
          BeforeTargets="ResolveProjectStaticWebAssets;CoreCompile"
          Condition="'$(BluxFonts)' != 'false' And '@(BluxFont)' != '' And '$(DesignTimeBuild)' != 'true'">
    <!-- IntermediateOutputPath is only known once the SDK targets are evaluated, so the defaults are computed here. -->
    <PropertyGroup>
      <BluxFontsOutputDir Condition="'$(BluxFontsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux, fonts))</BluxFontsOutputDir>
      <!-- Outside the fonts folder: every file of that folder that the task lists becomes a static web asset. -->
      <BluxFontsManifestFile Condition="'$(BluxFontsManifestFile)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux))BluxFontsManifest.g.cs</BluxFontsManifestFile>
    </PropertyGroup>

    <BluxResolveFonts Fonts="@(BluxFont)"
                      OutputDir="$(BluxFontsOutputDir)"
                      CacheDir="$(BluxFontsCacheDir)"
                      ProjectDirectory="$(MSBuildProjectDirectory)"
                      ProviderPriority="$(BluxFontsProviderPriority)"
                      FailOnError="$(BluxFontsFailOnError)"
                      Offline="$(BluxOffline)"
                      CacheDays="$(BluxFontsCacheDays)"
                      ManifestSourceFile="$(BluxFontsManifestFile)">
      <Output TaskParameter="GeneratedFiles" ItemName="_BluxFontFile" />
    </BluxResolveFonts>

    <ItemGroup>
      <Compile Include="$(BluxFontsManifestFile)" />
      <FileWrites Include="@(_BluxFontFile)" />
      <FileWrites Include="$(BluxFontsManifestFile)" />
    </ItemGroup>
  </Target>

  <!--
    Adds the generated files to the static web assets, served at /_blux/fonts/. They live in obj, not in wwwroot, so they are
    defined here with their own content root (what the development server reads them from) instead of being discovered.
    The generated file names carry a hash of their content, so a font is immutable at its URL: every route of a font file gets
    $(BluxFontsCacheControl) through a content type mapping of its own for each font extension (woff2, woff, ttf, otf), whatever
    the SDK's defaults or the app's StaticWebAssetEndpointDefaultMediaCacheControlHeader say. The stylesheet keeps the SDK's rules.
  -->
  <Target Name="BluxFontsDefineAssets" AfterTargets="ResolveProjectStaticWebAssets" Condition="'@(_BluxFontFile)' != ''">
    <ItemGroup>
      <_BluxFontCandidate Include="@(_BluxFontFile)" RelativePath="_blux/fonts/%(_BluxFontFile.BluxFile)" />
      <_BluxFontMapping Include="font/woff2" Pattern="*.woff2" Cache="$(BluxFontsCacheControl)" Priority="1" />
      <_BluxFontMapping Include="font/woff" Pattern="*.woff" Cache="$(BluxFontsCacheControl)" Priority="1" />
      <_BluxFontMapping Include="font/ttf" Pattern="*.ttf" Cache="$(BluxFontsCacheControl)" Priority="1" />
      <_BluxFontMapping Include="font/otf" Pattern="*.otf" Cache="$(BluxFontsCacheControl)" Priority="1" />
    </ItemGroup>

    <DefineStaticWebAssets CandidateAssets="@(_BluxFontCandidate)"
                           SourceType="Computed"
                           SourceId="$(PackageId)"
                           ContentRoot="$(BluxFontsOutputDir)"
                           BasePath="$(StaticWebAssetBasePath)"
                           AssetKind="All"
                           AssetMode="All"
                           AssetRole="Primary"
                           AssetMergeSource="$(StaticWebAssetMergeTarget)"
                           FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
                           FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
                           CopyToOutputDirectory="Never"
                           CopyToPublishDirectory="PreserveNewest">
      <Output TaskParameter="Assets" ItemName="_BluxFontAsset" />
    </DefineStaticWebAssets>

    <ItemGroup>
      <_BluxFontFileAsset Include="@(_BluxFontAsset)" Condition="'%(Extension)' != '.css'" />
      <_BluxFontCssAsset Include="@(_BluxFontAsset)" Condition="'%(Extension)' == '.css'" />
    </ItemGroup>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_BluxFontFileAsset)"
                                   ContentTypeMappings="@(_BluxFontMapping)">
      <Output TaskParameter="Endpoints" ItemName="_BluxFontEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_BluxFontCssAsset)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)"
                                   Condition="'@(_BluxFontCssAsset)' != ''">
      <Output TaskParameter="Endpoints" ItemName="_BluxFontEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_BluxFontAsset)" />
      <StaticWebAssetEndpoint Include="@(_BluxFontEndpoint)" />
    </ItemGroup>
  </Target>
</Project>
