<Project>
  <!--
    Self-hosted fonts. The app declares fonts as items:

      <BluxFont Include="Public Sans" Role="sans" Provider="google" Weights="400;700" Styles="normal;italic" Subsets="latin;latin-ext" />

    At build time the BluxResolveFonts task asks the providers, downloads only the requested files (cached), and generates
    blux.fonts.css (@font-face, a fallback face per family, --blux-font-sans / --blux-font-mono) and the font files into
    obj/<config>/<tfm>/blux/fonts/. They are added to the static web assets at _blux/fonts/, so MapStaticAssets serves them from
    the app's own origin. BxFonts links the stylesheet and preloads the main face from a manifest generated into the assembly.
    Nothing is requested from a third party when the page runs. BluxFonts=false turns the feature off.
  -->
  <PropertyGroup>
    <BluxFonts Condition="'$(BluxFonts)' == ''">true</BluxFonts>
    <BluxFontsProviderPriority Condition="'$(BluxFontsProviderPriority)' == ''">google;bunny;fontsource</BluxFontsProviderPriority>
    <BluxFontsCacheDir Condition="'$(BluxFontsCacheDir)' == ''">$([MSBuild]::NormalizeDirectory($(BluxCacheDir), fonts-cache))</BluxFontsCacheDir>
    <BluxFontsCacheDays Condition="'$(BluxFontsCacheDays)' == ''">7</BluxFontsCacheDays>
    <BluxFontsOutputDir Condition="'$(BluxFontsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux, fonts))</BluxFontsOutputDir>
    <BluxFontsFailOnError Condition="'$(BluxFontsFailOnError)' == ''">$([System.String]::Equals('$(Configuration)', 'Release'))</BluxFontsFailOnError>
  </PropertyGroup>

  <Target Name="BluxResolveFonts"
          BeforeTargets="ResolveProjectStaticWebAssets;CoreCompile"
          Condition="'$(BluxFonts)' != 'false' And '@(BluxFont)' != ''">
    <BluxResolveFonts Fonts="@(BluxFont)"
                      OutputDir="$(BluxFontsOutputDir)"
                      CacheDir="$(BluxFontsCacheDir)"
                      ProjectDirectory="$(MSBuildProjectDirectory)"
                      ProviderPriority="$(BluxFontsProviderPriority)"
                      FailOnError="$(BluxFontsFailOnError)"
                      Offline="$(BluxOffline)"
                      CacheDays="$(BluxFontsCacheDays)"
                      ManifestSourceFile="$(BluxFontsOutputDir)BluxFontsManifest.g.cs">
      <Output TaskParameter="GeneratedFiles" ItemName="_BluxFontFile" />
    </BluxResolveFonts>

    <ItemGroup>
      <!-- Link places them in wwwroot/_blux/fonts, which the static web assets discovery turns into assets served at /_blux/fonts/. -->
      <Content Include="@(_BluxFontFile)" Link="wwwroot\_blux\fonts\%(RelativePath)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
      <Compile Include="$(BluxFontsOutputDir)BluxFontsManifest.g.cs" />
      <FileWrites Include="@(_BluxFontFile)" />
      <FileWrites Include="$(BluxFontsOutputDir)BluxFontsManifest.g.cs" />
    </ItemGroup>
  </Target>

  <!--
    The generated file names carry a hash of their content, so a font is immutable at its URL: serve it with a year of cache
    even through the route without the SDK's own fingerprint (the one the generated CSS refers to).
  -->
  <Target Name="BluxFontsLongCache" AfterTargets="ResolveProjectStaticWebAssets" Condition="'@(_BluxFontFile)' != ''">
    <ItemGroup>
      <_BluxFontEndpoint Include="@(StaticWebAssetEndpoint)" Condition="$([System.String]::new('%(Route)').StartsWith('_blux/fonts/')) And !$([System.String]::new('%(Route)').EndsWith('.css'))" />
      <StaticWebAssetEndpoint Update="@(_BluxFontEndpoint)" ResponseHeaders="$([System.String]::new('%(ResponseHeaders)').Replace('max-age=3600, must-revalidate', 'max-age=31536000, immutable'))" />
    </ItemGroup>
  </Target>
</Project>
