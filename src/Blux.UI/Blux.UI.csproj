<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI</RootNamespace>
    <PackageId>Blux.UI</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Accessible, themable Blazor components styled with Tailwind CSS v4.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;components;ui;tailwind</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="TailwindMerge.NET" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blux.UI.Tests" />
    <InternalsVisibleTo Include="Blux.UI.ClassExtractor" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Blux.UI.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <!-- Sources of the generated assets: not shipped as content. -->
  <ItemGroup>
    <Content Remove="js/**;styles/**" />
    <None Include="js/**;styles/**" Pack="false" />
  </ItemGroup>

</Project>
