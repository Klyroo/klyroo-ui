<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI</RootNamespace>
    <PackageId>Blux.UI</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Accessible, themable Blazor components styled with Tailwind CSS v4.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;components;ui;tailwind</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- Package metadata. -->
  <PropertyGroup>
    <Authors>blux-ui contributors</Authors>
    <Copyright>Copyright (c) 2026 blux-ui contributors</Copyright>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md, included in this package.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <!-- TODO(release): set both once the hosting account is decided (for example https://github.com/OWNER/blux-ui).
         Left empty on purpose: the pack neither warns nor fails without them, but no repository link appears on nuget.org. -->
    <RepositoryUrl></RepositoryUrl>
    <PackageProjectUrl></PackageProjectUrl>
  </PropertyGroup>

  <!-- Reproducible build and debugging experience. SourceLink for GitHub is built into the .NET SDK (8+): no package reference. -->
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="TailwindMerge.NET" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blux.UI.Tests" />
    <InternalsVisibleTo Include="Blux.UI.ClassExtractor" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Blux.UI.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <!-- Sources of the generated assets: not shipped as content. -->
  <ItemGroup>
    <Content Remove="js/**;styles/**" />
    <None Include="js/**;styles/**" Pack="false" />
  </ItemGroup>

</Project>
