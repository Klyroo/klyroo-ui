@namespace Blux.UI
@inherits BxComponentBase

@*
    The <bx-popover> custom element owns the browser side: it shows the native [popover] when "open" is set,
    positions it, moves focus, and reports every open/close (including Escape and light dismiss) through "bx-toggle".
    Blazor never renders the open state of the native element itself, so the two never fight over it.
*@
@* data-bx-seq must come before open: Blazor applies attributes in order and the element reads it when open changes. *@
<bx-popover data-bx-seq="@(OpenChanged.HasDelegate ? _sequence : null)"
            open="@Open"
            placement="@Placement"
            offset="@Offset"
            @onbxtoggle="ToggleHandler"
            @onbxtoggle:stopPropagation="true"
            @attributes="AdditionalAttributes">
    <span data-slot="trigger">@ChildContent</span>
    <div id="@_id" popover="auto" role="@Role" tabindex="-1" aria-label="@(Role is null ? null : AriaLabel)" class="@_slots["content"]" data-slot="content">
        @Content
    </div>
</bx-popover>
