@namespace Blux.UI
@inherits BxComponentBase

@*
    A select of locales, built on BxSelect. Choosing one writes the ASP.NET Core culture cookie in the browser and
    reloads the page, so it works in static rendering and without a .NET runtime in the page. The server must run
    UseRequestLocalization with the same cultures: the cookie is only read there. Nothing is posted by the select itself.
    In a Blazor Hybrid web view there is no server: the choice goes to the IBxCultureStore (localStorage by default) and
    BxApp applies it at the next start. No cookie is written and the page is not reloaded, unless Reload is set to true.
*@
<div class="@_slots["root"]"
     data-bx-locale-select
     data-bx-cookie="@CookieName"
     data-bx-cookie-path="@CookiePath"
     data-bx-reload="@(!IsHybrid && Reload != false ? "" : null)"
     @attributes="AdditionalAttributes">
    <BxSelect Items="_items" Value="@_value" ValueChanged="SelectHandler" Size="Size" Variant="Variant" Color="Color"
              aria-label="@(AriaLabel ?? Messages.LocaleSelectLabel)" />
</div>

@code {
    private SlotSet _slots = default!;
    private IReadOnlyList<BxSelectItem> _items = [];
    private string? _value;
    private string? _chosen;
    private string? _lastValue;
    private bool _valueSeen;

    [Inject] private IServiceProvider Services { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // Unbound in a browser: nothing travels to .NET, the browser writes the cookie itself.
    private EventCallback<string?> SelectHandler =>
        IsHybrid ? EventCallback.Factory.Create<string?>(this, SelectedAsync) : default;

    /// <summary>The locales to offer, shown by <see cref="BxLocale.Name"/> (with <see cref="BxLocale.Flag"/> when set). Defaults to <see cref="BluxOptions.Locales"/>. Each code must be a culture the server supports.</summary>
    [Parameter] public IReadOnlyList<BxLocale>? Locales { get; set; }

    /// <summary>
    /// The selected locale code. Defaults to the code of the locale in effect (the enclosing <see cref="BxApp"/>, or the one
    /// matching the current UI culture). In WebAssembly the client has its own culture: pass the value when it can differ from the server's.
    /// </summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>The cookie to write. The default is the one the ASP.NET Core request localization middleware reads.</summary>
    [Parameter] public string CookieName { get; set; } = ".AspNetCore.Culture";

    /// <summary>The path of the cookie. It must cover every page that is localized.</summary>
    [Parameter] public string CookiePath { get; set; } = "/";

    /// <summary>
    /// Reloads the page after the choice is saved. In a browser it is on by default (the server renders the page in the new culture).
    /// In a Blazor Hybrid web view it is off by default: the culture of a .NET process is read at start, so set it to true to apply the
    /// choice right away (the culture of the process is changed and the web view reloads, losing the state of the page), or leave
    /// it off and let the choice apply at the next start.
    /// </summary>
    [Parameter] public bool? Reload { get; set; }

    /// <summary>Raised with the code of the chosen locale in a Blazor Hybrid web view, after it was saved. A browser has no use for it: the page reloads.</summary>
    [Parameter] public EventCallback<string> OnLocaleChange { get; set; }

    /// <summary>Accessible name of the select. Defaults to the built-in text.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public BxSize Size { get => _sizeParameter ?? DefaultSize(BxSize.Md); set => _sizeParameter = value; }
    private BxSize? _sizeParameter;
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Outline;
    [Parameter] public BxColor Color { get => _colorParameter ?? DefaultColor(BxColor.Primary); set => _colorParameter = value; }
    private BxColor? _colorParameter;
    [Parameter] public LocaleSelectUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(Options.LocaleSelect, new Dictionary<string, string?>(), Ui, "root");
        var locales = Locales ?? Options.Locales;
        _items = locales.Select(l => new BxSelectItem(l.Code, l.Flag is null ? l.Name : l.Flag + " " + l.Name)).ToList();
        // A choice made here stays shown across renders of the parent (in a web view it applies at the next start, so the
        // locale in effect still says the old one) until the app passes a different Value.
        if (_valueSeen && Value != _lastValue) _chosen = null;
        _valueSeen = true;
        _lastValue = Value;
        _value = (_chosen is null ? null : Resolve(locales, _chosen)) ?? Resolve(locales, Value ?? CurrentLocale.Code);
    }

    private async Task SelectedAsync(string? code)
    {
        if (string.IsNullOrEmpty(code)) return;
        _value = _chosen = code;
        if (Services.GetService(typeof(IBxCultureStore)) is IBxCultureStore store) await store.SetAsync(code);
        await OnLocaleChange.InvokeAsync(code);
        if (Reload == true)
        {
            var culture = BxCultureStoreMatch.Match(code, null);
            if (culture is not null) BxCultureStoreMatch.Apply(culture);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }

    private static string? Resolve(IReadOnlyList<BxLocale> locales, string code)
    {
        var exact = locales.FirstOrDefault(l => string.Equals(l.Code, code, StringComparison.OrdinalIgnoreCase));
        if (exact is not null) return exact.Code;
        var language = code.Split('-')[0];
        return locales.FirstOrDefault(l => string.Equals(l.Code.Split('-')[0], language, StringComparison.OrdinalIgnoreCase))?.Code;
    }
}
