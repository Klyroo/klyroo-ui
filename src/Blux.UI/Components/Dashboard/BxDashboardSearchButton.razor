@namespace Blux.UI
@inherits BxComponentBase

@*
    The button that opens the BxDashboardSearch of its dashboard, showing the shortcut with BxKbd. A click is handled in
    the browser (js/dashboard.js). In a collapsed sidebar only the icon is left; the label stays for screen readers.
*@
<button type="button" class="@_slots["root"]" aria-haspopup="dialog" aria-keyshortcuts="@(Keys is null ? "Control+K Meta+K" : null)" data-bx-search-open @attributes="AdditionalAttributes">
    @BxIcons.Named("search", _slots["icon"])
    <span class="@_slots["label"]">@(Label ?? Options.Strings.DashboardSearchButton)</span>
    @if (Keys is null || Keys.Count > 0)
    {
        <bx-mod-keys class="@_slots["kbds"]" aria-hidden="true">
            @if (Keys is null)
            {
                @* The modifier follows the platform: the browser sets the label (<bx-mod-keys>, js/platform-keys.js), "Ctrl" until then. *@
                <BxKbd Size="BxSize.Sm" data-bx-mod="" data-label="Ctrl" />
                <BxKbd Value="K" Size="BxSize.Sm" />
            }
            else
            {
                @foreach (var key in Keys)
                {
                    <BxKbd Value="@key" Size="BxSize.Sm" />
                }
            }
        </bx-mod-keys>
    }
</button>

@code {
    private SlotSet _slots = default!;

    /// <summary>The text of the button. Defaults to the built-in text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// The keys of the shortcut to show, one <see cref="BxKbd"/> each. Match the <c>Shortcut</c> of the search. Left out, the
    /// hint follows the platform in the browser (the command key and K on Apple devices, Ctrl and K elsewhere), matching the
    /// default <c>mod+k</c> shortcut, and the button announces <c>aria-keyshortcuts</c>. Keys you give are shown as given.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? Keys { get; set; }
    [Parameter] public DashboardSearchButtonUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.DashboardSearchButton, new Dictionary<string, string?>(), Ui, "root");
}
