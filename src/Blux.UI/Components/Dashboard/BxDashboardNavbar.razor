@namespace Blux.UI
@using Blux.UI.Internal
@inherits BxComponentBase

@*
    The top bar of a panel: the sidebar toggle (below the lg breakpoint), a title, and left, center and right areas.
*@
@if (_tag == "header")
{
    <header class="@_slots["root"]" @attributes="AdditionalAttributes">@Inner</header>
}
else
{
    <div class="@_slots["root"]" @attributes="AdditionalAttributes">@Inner</div>
}

@code {
    private SlotSet _slots = default!;
    private string _tag = "header";

    private RenderFragment Inner => @<text>
    <div class="@_slots["left"]" data-slot="left">
        @if (Toggle)
        {
            <BxDashboardSidebarToggle />
        }
        @Leading
        @if (Title is not null)
        {
            <Heading Level="HeadingLevel" Class="@_slots["title"]">@Title</Heading>
        }
        @Trailing
        @Left
    </div>
    @if (ChildContent is not null)
    {
        <div class="@_slots["center"]" data-slot="center">@ChildContent</div>
    }
    @if (Right is not null)
    {
        <div class="@_slots["right"]" data-slot="right">@Right</div>
    }
    </text>;

    /// <summary>The title, a heading of <see cref="HeadingLevel"/> (1 by default).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Level of the title heading, 1 to 6. A page has one h1: give the navbars after the first one a lower level, or no <see cref="Title"/>.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 1;

    /// <summary>
    /// The element to render: "header" (default) or "div", in any case; anything else throws an <see cref="ArgumentException"/>. A header outside a sectioning element is the banner landmark and
    /// a page has one: use "div" for the second navbar of a page, such as the one of a detail panel next to a list.
    /// </summary>
    [Parameter] public string As { get; set; } = "header";

    /// <summary>Shows the <see cref="BxDashboardSidebarToggle"/> at the start, below the lg breakpoint.</summary>
    [Parameter] public bool Toggle { get; set; } = true;

    /// <summary>Before the title.</summary>
    [Parameter] public RenderFragment? Leading { get; set; }

    /// <summary>After the title.</summary>
    [Parameter] public RenderFragment? Trailing { get; set; }

    /// <summary>Left area, after the title.</summary>
    [Parameter] public RenderFragment? Left { get; set; }

    /// <summary>The center area, between the left and the right ones.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Right area: actions, the user menu.</summary>
    [Parameter] public RenderFragment? Right { get; set; }
    [Parameter] public DashboardNavbarUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _tag = string.IsNullOrWhiteSpace(As) ? "header" : As.Trim().ToLowerInvariant();
        if (_tag is not ("header" or "div"))
        {
            throw new ArgumentException($"BxDashboardNavbar: As must be \"header\" or \"div\" (any case), not \"{As}\".", nameof(As));
        }
        _slots = ResolveSlots(Options.DashboardNavbar, new Dictionary<string, string?>(), Ui, "root");
    }
}
