@namespace Blux.UI
@using Blux.UI.Internal
@inherits BxFieldBase<string>

<div class="@_slots["root"]" data-color="@Color.Value">
    @if (LeadingIcon is not null)
    {
        <span class="@_slots["leading"]"><span class="@_slots["leadingIcon"]" aria-hidden="true">@LeadingIcon</span></span>
    }
    @if (BrowserCommit)
    {
        @if (UseEditContext)
        {
            <ValueBridge TValue="string" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Context="binding">@Markup(binding)</ValueBridge>
        }
        else
        {
            @Markup(new EditBinding(Name, Field?.Invalid == true))
        }
    }
    else if (UseEditContext)
    {
        <InputText Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" @attributes="Attributes()" />
    }
    else if (!ValueChanged.HasDelegate)
    {
        <input name="@Name" value="@Value" @attributes="Attributes()" />
    }
    else if (Immediate)
    {
        <input name="@Name" @bind:get="Value" @bind:set="SetValue" @bind:event="oninput" @attributes="Attributes()" />
    }
    else
    {
        <input name="@Name" @bind:get="Value" @bind:set="SetValue" @attributes="Attributes()" />
    }
    @if (TrailingIcon is not null)
    {
        <span class="@_slots["trailing"]"><span class="@_slots["trailingIcon"]" aria-hidden="true">@TrailingIcon</span></span>
    }
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The <c>type</c> attribute: text, email, password, search, tel, url, number…</summary>
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Update the bound value on every keystroke instead of on change. Costs a round trip per key in Server mode.</summary>
    [Parameter] public bool Immediate { get; set; }

    /// <summary>
    /// Milliseconds of quiet after the last keystroke before the value is reported, in the browser: typing a word raises one
    /// <c>ValueChanged</c> per pause instead of one per key (a round trip each in Server mode). Enter and leaving the field
    /// report at once, and nothing is reported in the middle of an IME composition. A render that arrives with an older
    /// value does not overwrite what was typed after it. <c>null</c> (the default) keeps the plain behavior; it replaces
    /// <see cref="Immediate"/> when both are set. Static rendering has no .NET to report to, so there it only holds the attribute.
    /// </summary>
    [Parameter] public int? Debounce { get; set; }

    /// <summary>
    /// Escape empties the field and reports the empty value (immediately, whatever <see cref="Debounce"/> says). On an already
    /// empty field Escape is left alone, so it still closes a modal around the field. The browser does the work, in every render mode.
    /// </summary>
    [Parameter] public bool ClearOnEscape { get; set; }
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Outline;
    [Parameter] public RenderFragment? LeadingIcon { get; set; }
    [Parameter] public RenderFragment? TrailingIcon { get; set; }
    [Parameter] public InputUi? Ui { get; set; }

    private int _sequence;

    // Debounce and ClearOnEscape are done by a script of Blux on the native input, which reports through bx-change.
    private bool BrowserCommit => Debounce is not null || ClearOnEscape;

    // Immediate without Debounce is a delay of 0: report on every input.
    private int? DelayAttribute => Debounce is { } ms ? Math.Max(ms, 0) : Immediate ? 0 : null;

    private EventCallback<BxChangeEventArgs> ChangeHandler =>
        ValueChanged.HasDelegate ? EventCallback.Factory.Create<BxChangeEventArgs>(this, OnChange) : default;

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Input, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(EffectiveSize),
            ["leading"] = VariantValue.Of(LeadingIcon is not null),
            ["trailing"] = VariantValue.Of(TrailingIcon is not null),
        }, Ui, "root");

    private Dictionary<string, object> Attributes()
    {
        var attributes = ControlAttributes(_slots["base"]);
        attributes["type"] = Type;
        if (Placeholder is not null) attributes["placeholder"] = Placeholder;
        return attributes;
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private async Task OnChange(BxChangeEventArgs e)
    {
        _sequence = e.Sequence;
        var value = e.Value ?? "";
        if (value == (Value ?? ""))
        {
            return;
        }
        Value = value;
        await ValueChanged.InvokeAsync(value);
        NotifyFieldChanged();
    }

    // data-bx-seq comes before value: Blazor applies attributes in order, and the script ignores a write of value that a
    // render older than its last report made, which it can only tell once it has seen the sequence of that render.
    private RenderFragment Markup(EditBinding binding) =>
        @<input data-bx-seq="@(ValueChanged.HasDelegate ? _sequence : null)"
                data-bx-debounce="@DelayAttribute"
                data-bx-clear-on-escape="@(ClearOnEscape ? "" : null)"
                name="@binding.Name"
                value="@Value"
                aria-invalid="@(binding.Invalid ? "true" : null)"
                @onbxchange="ChangeHandler"
                @onbxchange:stopPropagation="true"
                @attributes="Attributes()" />;
}
