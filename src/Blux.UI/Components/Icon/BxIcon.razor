@namespace Blux.UI
@inherits BxComponentBase

<svg viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     role="@(Label is null ? null : "img")"
     aria-label="@Label"
     aria-hidden="@(Label is null ? "true" : null)"
     data-icon="@Name"
     class="@_slots["base"]"
     @attributes="AdditionalAttributes">
    @if (_path is not null)
    {
        <path d="@_path" />
    }
</svg>

@code {
    private SlotSet _slots = default!;
    private string? _path;

    /// <summary>
    /// Lucide icon name ("search", "chevron-down"…), from the built-in set or from <see cref="BluxOptions.Icons"/>.
    /// An unknown name renders an empty icon.
    /// </summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Accessible name. Without it the icon is decorative and hidden from assistive technology.</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public BxSize Size { get; set; } = BxSize.Md;
    [Parameter] public IconUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _path = Options.Icons.TryGetValue(Name, out var custom) ? custom
            : IconRegistry.Builtin.TryGetValue(Name, out var builtin) ? builtin
            : null;
        _slots = ResolveSlots(Options.Icon, new Dictionary<string, string?> { ["size"] = VariantValue.Of(Size) }, Ui, "base");
    }
}
