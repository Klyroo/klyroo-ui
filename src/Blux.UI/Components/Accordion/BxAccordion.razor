@namespace Blux.UI
@using Blux.UI.Internal
@inherits BxComponentBase

@*
    WAI-ARIA accordion, toggled in the browser. Closed panels use hidden="until-found", so find-in-page still finds
    their text and opens them (where supported).
*@
<bx-accordion type="@(Multiple ? "multiple" : "single")"
              collapsible="@Collapsible"
              data-bx-seq="@(ValueChanged.HasDelegate ? _sequence : null)"
              value="@string.Join(',', _open)"
              class="@_slots["root"]"
              @onbxchange="ChangeHandler"
              @onbxchange:stopPropagation="true"
              @attributes="AdditionalAttributes">
    @for (var i = 0; i < Items.Count; i++)
    {
        // Copied: the Heading content below is a lambda evaluated after the loop has moved on.
        var index = i;
        var item = Items[index];
        var value = ValueOf(item, index);
        var open = _open.Contains(value);
        <div data-slot="item" data-value="@value" data-state="@(open ? "open" : "closed")" class="@_slots["item"]">
            <Heading Level="HeadingLevel" Class="@_slots["header"]">
                <button type="button" data-slot="trigger" data-bx-accordion-trigger id="@($"{_id}-trigger-{index}")" aria-controls="@($"{_id}-content-{index}")"
                        aria-expanded="@(open ? "true" : "false")" disabled="@item.Disabled" class="@_slots["trigger"]">
                    @if (item.Icon is not null)
                    {
                        <span class="@_slots["leadingIcon"]" aria-hidden="true">@item.Icon</span>
                    }
                    <span class="@_slots["label"]">@item.Label</span>
                    @RenderIcon(Options.Icons.ChevronDown, _slots["trailingIcon"])
                </button>
            </Heading>
            <div role="region" data-slot="content" data-bx-accordion-content id="@($"{_id}-content-{index}")" aria-labelledby="@($"{_id}-trigger-{index}")"
                 hidden="@(open ? null : "until-found")" class="@_slots["content"]">
                <div class="@_slots["body"]">@item.Content</div>
            </div>
        </div>
    }
</bx-accordion>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;
    private int _sequence;
    private IReadOnlyList<string> _open = [];

    [Parameter, EditorRequired] public IReadOnlyList<BxAccordionItem> Items { get; set; } = [];

    /// <summary>Values of the open items.</summary>
    [Parameter] public IReadOnlyList<string>? Value { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<string>> ValueChanged { get; set; }

    /// <summary>Several items can be open at once.</summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>With a single open item, it can be closed too.</summary>
    [Parameter] public bool Collapsible { get; set; } = true;

    /// <summary>Heading level of the item headers, to fit the page outline.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;
    [Parameter] public AccordionUi? Ui { get; set; }

    private EventCallback<BxChangeEventArgs> ChangeHandler =>
        ValueChanged.HasDelegate ? EventCallback.Factory.Create<BxChangeEventArgs>(this, OnChange) : default;

    private static string ValueOf(BxAccordionItem item, int index) => item.Value ?? index.ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnParametersSet()
    {
        _id ??= NewId("accordion");
        _open = Value ?? [];
        _slots = ResolveSlots(Options.Accordion, new Dictionary<string, string?>(), Ui, "root");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private async Task OnChange(BxChangeEventArgs e)
    {
        _sequence = e.Sequence;
        _open = (e.Value ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
        Value = _open;
        await ValueChanged.InvokeAsync(_open);
    }
}
