@namespace Blux.UI
@inherits BxComponentBase

<kbd data-color="@Color.Value" class="@_slots["base"]" @attributes="AdditionalAttributes">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Value)))</kbd>

@code {
    private SlotSet _slots = default!;

    /// <summary>The key to show, "Ctrl" or "K" for example. <see cref="ChildContent"/> wins when both are set.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public BxColor Color { get; set; } = BxColor.Neutral;
    [Parameter] public BxVariant Variant { get; set; } = BxVariant.Outline;
    [Parameter] public BxSize Size { get; set; } = BxSize.Md;
    [Parameter] public KbdUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Kbd, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(Size),
        }, Ui, "base");
}
