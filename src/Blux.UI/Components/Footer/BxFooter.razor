@namespace Blux.UI
@inherits BxComponentBase

@* A site footer with optional top and bottom areas, and left, center and right slots that line up from the lg breakpoint up. *@
<footer class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Top is not null)
    {
        <div class="@_slots["top"]">@Top</div>
    }
    @if (Left is not null || ChildContent is not null || Right is not null)
    {
        <div class="@_slots["container"]">
            @if (Left is not null)
            {
                <div class="@_slots["left"]">@Left</div>
            }
            @if (ChildContent is not null)
            {
                <div class="@_slots["center"]">@ChildContent</div>
            }
            @if (Right is not null)
            {
                <div class="@_slots["right"]">@Right</div>
            }
        </div>
    }
    @if (Bottom is not null)
    {
        <div class="@_slots["bottom"]">@Bottom</div>
    }
</footer>

@code {
    private SlotSet _slots = default!;

    /// <summary>The middle of the footer: links, a newsletter form.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Start side: a copyright line, a logo.</summary>
    [Parameter] public RenderFragment? Left { get; set; }

    /// <summary>End side: social links, a language select.</summary>
    [Parameter] public RenderFragment? Right { get; set; }

    /// <summary>A full-width area above, typically a <see cref="BxFooterColumns"/>.</summary>
    [Parameter] public RenderFragment? Top { get; set; }

    /// <summary>A full-width area below.</summary>
    [Parameter] public RenderFragment? Bottom { get; set; }
    [Parameter] public FooterUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Footer, new Dictionary<string, string?>(), Ui, "root");
}
