@namespace Blux.UI
@using System.Globalization
@using Blux.UI.Internal
@inherits BxFieldBase<decimal?>

@if (UseEditContext)
{
    <ValueBridge TValue="decimal?" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Context="binding">@Markup(binding)</ValueBridge>
}
else
{
    @Markup(new EditBinding(Name, Field?.Invalid == true))
}

@code {
    private SlotSet _slots = default!;
    private int _sequence;

    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }

    /// <summary>Amount added or removed by the buttons and the arrow keys; Page Up and Page Down use ten steps.</summary>
    [Parameter] public decimal Step { get; set; } = 1;
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Culture used to show and read the number, such as <c>fr-FR</c>. Defaults to the current culture. The posted value is always invariant.</summary>
    [Parameter] public string? Locale { get; set; }

    /// <summary>Horizontal puts the buttons on both sides of the field, vertical stacks them at its end.</summary>
    [Parameter] public BxOrientation Orientation { get; set; } = BxOrientation.Horizontal;
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Outline;
    [Parameter] public InputNumberUi? Ui { get; set; }

    private static string? Invariant(decimal? value) => value?.ToString(CultureInfo.InvariantCulture);

    private EventCallback<BxChangeEventArgs> ChangeHandler =>
        ValueChanged.HasDelegate ? EventCallback.Factory.Create<BxChangeEventArgs>(this, OnChange) : default;

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.InputNumber, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(EffectiveSize),
            ["orientation"] = Orientation == BxOrientation.Vertical ? "vertical" : "horizontal",
        }, Ui, "root");

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private async Task OnChange(BxChangeEventArgs e)
    {
        _sequence = e.Sequence;
        decimal? value = decimal.TryParse(e.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed) ? parsed : null;
        if (value == Value)
        {
            return;
        }
        Value = value;
        await ValueChanged.InvokeAsync(value);
        NotifyFieldChanged();
    }

    private Dictionary<string, object> InputAttributes(EditBinding binding)
    {
        var attributes = ControlAttributes(_slots["base"]);
        attributes.Remove("required");
        if (Required || Field?.Required == true) attributes["aria-required"] = "true";
        if (binding.Invalid) attributes["aria-invalid"] = "true";
        attributes["data-slot"] = "input";
        attributes["type"] = "text";
        attributes["role"] = "spinbutton";
        attributes["inputmode"] = "decimal";
        attributes["autocomplete"] = "off";
        if (Placeholder is not null) attributes["placeholder"] = Placeholder;
        return attributes;
    }

    private RenderFragment Markup(EditBinding binding) =>
        @<bx-input-number data-bx-seq="@(ValueChanged.HasDelegate ? _sequence : null)"
                          value="@Invariant(Value)"
                          min="@Invariant(Min)"
                          max="@Invariant(Max)"
                          step="@Invariant(Step)"
                          locale="@(Locale ?? CultureInfo.CurrentCulture.Name)"
                          disabled="@Disabled"
                          class="@_slots["root"]"
                          data-color="@Color.Value"
                          @onbxchange="ChangeHandler"
                          @onbxchange:stopPropagation="true">
            <input type="hidden" data-slot="value" name="@binding.Name" value="@Invariant(Value)" disabled="@Disabled" />
            <input @attributes="InputAttributes(binding)" />
            <button type="button" tabindex="-1" class="@_slots["decrement"]" data-slot="decrement" aria-label="@Options.Strings.InputNumberDecrement" disabled="@Disabled">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="@_slots["icon"]"><path d="M5 12h14" /></svg>
            </button>
            <button type="button" tabindex="-1" class="@_slots["increment"]" data-slot="increment" aria-label="@Options.Strings.InputNumberIncrement" disabled="@Disabled">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="@_slots["icon"]"><path d="M5 12h14M12 5v14" /></svg>
            </button>
        </bx-input-number>;
}
