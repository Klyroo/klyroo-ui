@namespace Blux.UI
@inherits BxComponentBase
@using Blux.UI.Internal

@* A section named by its title, with an optional list of features and a media slot. *@
<section aria-labelledby="@(Title is null ? null : _titleId)" class="@_slots["root"]" @attributes="AdditionalAttributes">
    <div class="@_slots["container"]">
        <div class="@_slots["wrapper"]">
            @if (Icon is not null)
            {
                <span class="@_slots["leading"]" aria-hidden="true" data-slot="leading">
                    <BxIcon Name="@Icon" Class="@_slots["leadingIcon"]" />
                </span>
            }
            @if (Headline is not null)
            {
                <p class="@_slots["headline"]" data-slot="headline">@Headline</p>
            }
            @if (Title is not null)
            {
                <SectionHeading Level="HeadingLevel" Id="@_titleId" Class="@_slots["title"]">@Title</SectionHeading>
            }
            @if (Description is not null)
            {
                <p class="@_slots["description"]" data-slot="description">@Description</p>
            }
            @PageRender.Buttons(Links, _slots["links"], BxSize.Lg)
            @if (Features is { Count: > 0 })
            {
                <ul class="@_slots["features"]" data-slot="features">
                    @foreach (var feature in Features)
                    {
                        <li class="@_slots["feature"]">
                            <BxPageFeature Icon="@feature.Icon" Title="@feature.Title" Description="@feature.Description"
                                           Href="@feature.Href" Target="@feature.Target" HeadingLevel="@FeatureHeadingLevel" />
                        </li>
                    }
                </ul>
            }
            @ChildContent
        </div>
        @if (Media is not null)
        {
            <div class="@_slots["media"]" data-slot="media">@Media</div>
        }
    </div>
</section>

@code {
    private SlotSet _slots = default!;
    private readonly string _titleId = NewId("pagesection");

    /// <summary>Name of a built-in icon shown above the headline.</summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Headline { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }

    /// <summary>Links rendered as buttons under the description.</summary>
    [Parameter] public IReadOnlyList<PageLinkItem>? Links { get; set; }

    /// <summary>Features listed under the links, each with an icon, a title and a description.</summary>
    [Parameter] public IReadOnlyList<PageFeatureItem>? Features { get; set; }

    /// <summary>Extra content after the features.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>An illustration or a screenshot shown beside (horizontal) or under (vertical) the text.</summary>
    [Parameter] public RenderFragment? Media { get; set; }

    /// <summary>Horizontal puts the text and the media side by side; vertical stacks them and spreads the features on three columns.</summary>
    [Parameter] public BxOrientation Orientation { get; set; } = BxOrientation.Horizontal;

    /// <summary>Shows the media before the text in a horizontal section.</summary>
    [Parameter] public bool Reverse { get; set; }

    /// <summary>Level of the title heading, 1 to 6.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 2;

    /// <summary>Renders the feature titles as headings of this level; they are plain text by default.</summary>
    [Parameter] public int? FeatureHeadingLevel { get; set; }
    [Parameter] public PageSectionUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PageSection, new Dictionary<string, string?>
        {
            ["orientation"] = Orientation == BxOrientation.Vertical ? "vertical" : "horizontal",
            ["reverse"] = VariantValue.Of(Reverse),
        }, Ui, "root");
}
