@namespace Blux.UI
@inherits BxComponentBase
@using Blux.UI.Internal

@*
    Logos as a wrapped, centered list, or as a BxMarquee strip (CSS only, no script, stopped under prefers-reduced-motion).
    A logo is named by its Alt: an icon gets role="img" and a label, an image gets its alt text.
*@
<div class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Title is not null)
    {
        @if (HeadingLevel is { } level)
        {
            <SectionHeading Level="level" Class="@_slots["title"]">@Title</SectionHeading>
        }
        else
        {
            <p class="@_slots["title"]" data-slot="title">@Title</p>
        }
    }
    @if (Marquee)
    {
        <BxMarquee Duration="Duration" Class="@_slots["marquee"]">
            @if (Items is not null)
            {
                @foreach (var logo in Items)
                {
                    <span class="@_slots["item"]">@Logo(logo)</span>
                }
            }
            @ChildContent
        </BxMarquee>
    }
    else if (Items is { Count: > 0 })
    {
        <ul class="@_slots["items"]" data-slot="items">
            @foreach (var logo in Items)
            {
                <li class="@_slots["item"]">@Logo(logo)</li>
            }
        </ul>
        @if (ChildContent is not null)
        {
            <div class="@_slots["items"]">@ChildContent</div>
        }
    }
    else if (ChildContent is not null)
    {
        <div class="@_slots["items"]" data-slot="items">@ChildContent</div>
    }
</div>

@code {
    private SlotSet _slots = default!;

    private RenderFragment Logo(PageLogoItem logo) => @<text>
        @if (logo.Icon is not null)
        {
            <BxIcon Name="@logo.Icon" Label="@logo.Alt" Class="@_slots["icon"]" />
        }
        else if (logo.Src is not null)
        {
            <img src="@logo.Src" alt="@logo.Alt" loading="lazy" class="@_slots["image"]" />
        }
    </text>;

    /// <summary>Heading above the logos.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The logos, each an icon or an image with an accessible name.</summary>
    [Parameter] public IReadOnlyList<PageLogoItem>? Items { get; set; }

    /// <summary>Custom logos, shown after <see cref="Items"/>. Give each one an accessible name.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Scrolls the logos in a loop, see <see cref="BxMarquee"/>. The scrolling copies are hidden from assistive technology.</summary>
    [Parameter] public bool Marquee { get; set; }

    /// <summary>Seconds for one loop of the marquee.</summary>
    [Parameter] public double Duration { get; set; } = 30;

    /// <summary>Level of the title heading, 1 to 6; null renders a paragraph.</summary>
    [Parameter] public int? HeadingLevel { get; set; } = 2;
    [Parameter] public PageLogosUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PageLogos, new Dictionary<string, string?>(), Ui, "root");
}
