@namespace Blux.UI
@inherits BxComponentBase

@*
    A site header: a title or logo on the left, links in the middle, actions on the right. Below the lg breakpoint the
    middle links give way to a menu button that opens a BxSlideover, a native modal dialog handled in the browser, so the
    menu works in static rendering too. Following a link in the panel closes it.
*@
<header class="@_slots["root"]" @attributes="AdditionalAttributes">
    <div class="@_slots["container"]">
        <div class="@_slots["left"]">
            @if (Left is not null)
            {
                @Left
            }
            else if (Title is not null)
            {
                <a href="@Href" class="@_slots["title"]">@Title</a>
            }
        </div>
        <div class="@_slots["center"]">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else if (Items.Count > 0)
            {
                <BxNavigationMenu Items="Items" AriaLabel="@(AriaLabel ?? Messages.HeaderNavigation)" />
            }
        </div>
        <div class="@_slots["right"]">@Right</div>
        @if (Menu && (Body is not null || Items.Count > 0))
        {
            <div class="@_slots["menu"]">
                <BxSlideover Title="@(MenuTitle ?? Messages.HeaderMenu)" Side="MenuSide" data-bx-layout-menu>
                    <ChildContent>
                        <BxButton Square Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" LeadingIcon="@(BxIcons.Named("menu", "size-5"))"
                                  aria-label="@Messages.OpenHeaderMenu" />
                    </ChildContent>
                    <Body>
                        @if (Body is not null)
                        {
                            @Body
                        }
                        else
                        {
                            <BxNavigationMenu Items="Items" Orientation="BxOrientation.Vertical" AriaLabel="@Messages.HeaderMenu" />
                        }
                    </Body>
                </BxSlideover>
            </div>
        }
    </div>
</header>

@code {
    private SlotSet _slots = default!;

    /// <summary>The title link on the left, used when <see cref="Left"/> is not set.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Where the title link goes.</summary>
    [Parameter] public string Href { get; set; } = "/";

    /// <summary>Replaces the title link: a logo, or a logo with the title.</summary>
    [Parameter] public RenderFragment? Left { get; set; }

    /// <summary>The middle of the header, shown from the lg breakpoint up. Replaces the <see cref="Items"/> navigation.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The right side: actions, color mode button, language select. Always visible.</summary>
    [Parameter] public RenderFragment? Right { get; set; }

    /// <summary>
    /// Site links: a horizontal navigation in the middle, and a vertical one in the mobile menu. Set
    /// <see cref="ChildContent"/> or <see cref="Body"/> to replace either.
    /// </summary>
    [Parameter] public IReadOnlyList<BxNavigationItem> Items { get; set; } = [];

    /// <summary>Content of the mobile menu. Replaces the vertical <see cref="Items"/> navigation.</summary>
    [Parameter] public RenderFragment? Body { get; set; }

    /// <summary>Shows the mobile menu button below the lg breakpoint, when there is something to put in the menu.</summary>
    [Parameter] public bool Menu { get; set; } = true;

    /// <summary>Title of the mobile menu panel. Defaults to the built-in text.</summary>
    [Parameter] public string? MenuTitle { get; set; }

    /// <summary>The edge the mobile menu slides in from.</summary>
    [Parameter] public SlideoverSide MenuSide { get; set; } = SlideoverSide.Right;

    /// <summary>Accessible name of the <see cref="Items"/> navigation. Needed when the page has several.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Keeps the header at the top of the screen while the page scrolls.</summary>
    [Parameter] public bool Sticky { get; set; } = true;
    [Parameter] public HeaderUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Header, new Dictionary<string, string?>
        {
            ["sticky"] = VariantValue.Of(Sticky),
        }, Ui, "root");
}
