@namespace Blux.UI
@inherits BxComponentBase

@*
    <bx-chat-messages> owns the scrolling and the announcements, in the browser:
    - it keeps the latest message in view while the user is at the bottom, and stops following as soon as they scroll up
      (a "jump to latest" button then appears);
    - the log itself is aria-live="off", so a streamed answer is not read token by token. When an assistant message is
      complete (it is not marked streaming any more) its text goes to the polite status region once.
    Nothing here needs .NET to be interactive, apart from the messages that you update.
*@
<bx-chat-messages data-status="@_status"
                  data-auto-scroll="@(AutoScroll ? "true" : "false")"
                  class="@_slots["root"]"
                  @attributes="AdditionalAttributes">
    <div role="log" aria-live="off" aria-relevant="additions" tabindex="0" data-bx-chat-viewport
         aria-label="@(Label ?? Messages.ChatConversation)" aria-busy="@(Busy ? "true" : null)"
         class="@_slots["viewport"]">
        <div class="@_slots["content"]" data-bx-chat-content-list>
            @ChildContent
            @if (Busy)
            {
                <div class="@_slots["indicator"]" data-slot="indicator">
                    @if (Indicator is not null)
                    {
                        @Indicator
                    }
                    else
                    {
                        <span class="@_slots["dot"]" aria-hidden="true"></span>
                        <span class="@_slots["dot"]" aria-hidden="true"></span>
                        <span class="@_slots["dot"]" aria-hidden="true"></span>
                    }
                </div>
            }
            @* Always rendered, so the text arrives in a live region that already exists and is announced. *@
            <div role="status" class="@_slots["srOnly"]" data-slot="typing-status">@(Busy ? Messages.ChatResponding : null)</div>
            @if (Status == ChatStatus.Error)
            {
                <div role="alert" class="@_slots["error"]" data-slot="error">
                    @if (Error is not null)
                    {
                        @Error
                    }
                    else
                    {
                        @Messages.ChatError
                    }
                </div>
            }
        </div>
    </div>
    @if (AutoScroll)
    {
        <button type="button" hidden data-bx-chat-jump class="@_slots["jump"]">
            @RenderIcon(Options.Icons.ArrowDown, _slots["jumpIcon"])
            @Messages.ChatJumpToLatest
        </button>
    }
    <div role="status" aria-live="polite" aria-atomic="true" data-bx-chat-announce class="@_slots["status"]"></div>
</bx-chat-messages>

@code {
    private SlotSet _slots = default!;
    private string _status = "idle";

    /// <summary>The messages: <see cref="BxChatMessage"/> items, in order.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Where the conversation is. Submitted and Streaming show the typing indicator, Error shows <see cref="Error"/>.
    /// Update it from .NET as the request progresses.
    /// </summary>
    [Parameter] public ChatStatus Status { get; set; }

    /// <summary>Accessible name of the log. Defaults to the built-in text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Follows the latest message while the user is at the bottom, and shows the "jump to latest" button once they scroll up.
    /// Without it the list never scrolls by itself.
    /// </summary>
    [Parameter] public bool AutoScroll { get; set; } = true;

    /// <summary>Replaces the typing dots.</summary>
    [Parameter] public RenderFragment? Indicator { get; set; }

    /// <summary>Replaces the message shown when <see cref="Status"/> is Error.</summary>
    [Parameter] public RenderFragment? Error { get; set; }
    [Parameter] public ChatMessagesUi? Ui { get; set; }

    private bool Busy => Status is ChatStatus.Submitted or ChatStatus.Streaming;

    protected override void OnParametersSet()
    {
        _status = ChatValue.Of(Status);
        _slots = ResolveSlots(Options.ChatMessages, new Dictionary<string, string?>(), Ui, "root");
    }
}
