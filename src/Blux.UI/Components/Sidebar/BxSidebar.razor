@namespace Blux.UI
@inherits BxComponentBase

@*
    An app sidebar. From the lg breakpoint up it is a column that can collapse to icons and, if asked, be resized; the
    browser owns both states (the <bx-sidebar> element in js/layout.js), keeps them in cookies named after Id, and tells
    .NET about the collapsed state only when CollapsedChanged is bound. Below lg the column is replaced by a button that
    opens the same content in a BxSlideover, so it works in static rendering too.
    The aside carries data-state="expanded|collapsed" and is a Tailwind group named "sidebar".
    Header, ChildContent and Footer are rendered twice: in the column and in the mobile panel. Only one is on screen
    (the other is display:none or a closed dialog, so assistive technology does not see it twice), but both exist in the
    DOM and in the component tree, so an id, a form field or a stateful component inside them is duplicated. Prefer
    classes to ids there, and keep state outside. The copy cannot be rendered on demand: the panel opens in the browser,
    and a copy that appears after a round trip to .NET would open empty (Server) or not at all (static rendering).
*@
<bx-sidebar data-bx-seq="@(CollapsedChanged.HasDelegate ? _sequence : null)"
            class="@_slots["host"]"
            style="--bx-sidebar-width:@(Width)px"
            collapsed="@Collapsed"
            resizable="@Resizable"
            data-bx-sidebar-id="@Id"
            data-bx-min-width="@MinWidth"
            data-bx-max-width="@MaxWidth"
            data-bx-width="@Width"
            @onbxtoggle="ToggleHandler"
            @onbxtoggle:stopPropagation="true">
    @Root
    <div class="@_slots["mobile"]">
        <BxSlideover Side="SlideoverSide.Left" Title="@(MobileTitle ?? Options.Strings.SidebarLabel)" Ui="_slideoverUi" data-bx-layout-menu>
            <ChildContent>
                <BxButton Square Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" LeadingIcon="@(BxIcons.Named("menu", "size-5"))"
                          aria-label="@Options.Strings.OpenSidebar" hidden="@(!MobileTrigger)" />
            </ChildContent>
            <Body>
                <div class="@_slots["mobileBody"]">
                    @if (Header is not null)
                    {
                        <div class="@_slots["header"]"><div class="@_slots["headerContent"]">@Header</div></div>
                    }
                    <div class="@_slots["content"]">@ChildContent</div>
                    @if (Footer is not null)
                    {
                        <div class="@_slots["footer"]">@Footer</div>
                    }
                </div>
            </Body>
        </BxSlideover>
    </div>
</bx-sidebar>
@if (Id is not null && !CollapsedChanged.HasDelegate)
{
    @* Runs while the page is parsed, before the first paint: applies the remembered state so a reload does not shift.
       The element does the same later (and alone in interactive renders, where inserted scripts never run). *@
    @((MarkupString)$"<script{NonceAttribute}>{FirstPaintScript}</script>")
}

@code {
    private SlotSet _slots = default!;
    private SlideoverUi _slideoverUi = new() { Body = "p-0 sm:p-0" };
    private int _sequence;

    /// <summary>The scrollable middle: navigation, search. Rendered twice (column and mobile panel): avoid ids and local state in it.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Top of the sidebar: a logo and a title. Hidden while the sidebar is collapsed, next to the collapse button.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Bottom of the sidebar: the signed-in user, settings.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Name under which the collapsed state and the width are remembered, in the cookies <c>blux-sidebar-{id}</c>
    /// ("1" when collapsed) and <c>blux-sidebar-{id}-width</c>, written by the browser. Without an id nothing is
    /// remembered. With a bound <see cref="Collapsed"/> the collapsed state is not restored: your state wins.
    /// A small inline script placed right after the sidebar applies the remembered state while the page is parsed,
    /// before the first paint, so a reload neither shifts nor animates (give it <see cref="ScriptNonce"/> under a strict
    /// Content-Security-Policy). Reading the cookies on the server and passing <see cref="Collapsed"/> also works.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Nonce for the small inline script that applies the remembered state before the first paint, when a
    /// Content-Security-Policy forbids inline scripts without one.</summary>
    [Parameter] public string? ScriptNonce { get; set; }

    private string NonceAttribute => ScriptNonce is null ? "" : $" nonce=\"{System.Net.WebUtility.HtmlEncode(ScriptNonce)}\"";

    // Same cookie format as js/layout.js: blux-sidebar-{encoded id} = "1" when collapsed, and {name}-width in pixels.
    private const string FirstPaintScript =
        "(function(){try{var h=document.currentScript.previousElementSibling;if(!h||h.localName!=='bx-sidebar')return;" +
        "var k='blux-sidebar-'+encodeURIComponent(h.getAttribute('data-bx-sidebar-id'));" +
        "var g=function(n){var p=document.cookie.split('; ');for(var i=0;i<p.length;i++){var j=p[i].indexOf('=');" +
        "if(j>0&&p[i].slice(0,j)===n)return decodeURIComponent(p[i].slice(j+1));}return null;};" +
        "var c=g(k),a=h.querySelector(':scope>[data-slot=root]');" +
        "if(c!==null&&a){a.setAttribute('data-state',c==='1'?'collapsed':'expanded');" +
        "a.querySelectorAll('[data-bx-sidebar-toggle]').forEach(function(b){b.setAttribute('aria-pressed',c==='1'?'true':'false');});}" +
        "if(h.hasAttribute('resizable')){var w=Number(g(k+'-width'));if(w>0)h.style.setProperty('--bx-sidebar-width',w+'px');}" +
        "}catch(e){}})();";

    /// <summary>Shows the button that collapses the sidebar to icons.</summary>
    [Parameter] public bool Collapsible { get; set; } = true;

    /// <summary>
    /// The collapsed state when nothing is remembered. Use <c>@bind-Collapsed</c> to follow and set it from .NET;
    /// the browser still toggles it without a round trip, and in static rendering a bound state is not reported.
    /// </summary>
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>Adds a handle on the edge to resize the sidebar with the mouse or the arrow keys, Home and End.</summary>
    [Parameter] public bool Resizable { get; set; }

    /// <summary>Width in pixels when expanded and not resized yet.</summary>
    [Parameter] public int Width { get; set; } = 256;
    [Parameter] public int MinWidth { get; set; } = 192;
    [Parameter] public int MaxWidth { get; set; } = 448;

    /// <summary>
    /// The element to render, "aside" by default. A complementary landmark must not sit inside another landmark:
    /// use "div" when the sidebar is placed inside a main element.
    /// </summary>
    [Parameter] public string As { get; set; } = "aside";

    /// <summary>Accessible name of the sidebar landmark. Defaults to the built-in text.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Shows the button that opens the mobile panel. Turn it off when another button opens the panel instead, such as
    /// <see cref="BxDashboardSidebarToggle"/>: the button stays in the page, hidden, so the panel keeps its trigger.
    /// </summary>
    [Parameter] public bool MobileTrigger { get; set; } = true;

    /// <summary>Title of the mobile panel. Defaults to the built-in text.</summary>
    [Parameter] public string? MobileTitle { get; set; }
    [Parameter] public SidebarUi? Ui { get; set; }

    private EventCallback<BxToggleEventArgs> ToggleHandler =>
        CollapsedChanged.HasDelegate ? EventCallback.Factory.Create<BxToggleEventArgs>(this, OnToggle) : default;

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Sidebar, new Dictionary<string, string?>(), Ui, "root");

    // The event reports whether the sidebar is expanded ("open"), like every other toggle.
    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxToggleEventArgs))]
    private async Task OnToggle(BxToggleEventArgs e)
    {
        _sequence = e.Sequence;
        var collapsed = !e.Open;
        if (collapsed == Collapsed) return;
        Collapsed = collapsed;
        await CollapsedChanged.InvokeAsync(collapsed);
    }

    private RenderFragment Root => builder =>
    {
        builder.OpenElement(0, As);
        builder.AddAttribute(1, "class", _slots["root"]);
        builder.AddAttribute(2, "data-slot", "root");
        builder.AddAttribute(3, "data-state", Collapsed ? "collapsed" : "expanded");
        if (As is "aside" or "nav")
        {
            builder.AddAttribute(4, "aria-label", AriaLabel ?? Options.Strings.SidebarLabel);
        }
        builder.AddMultipleAttributes(5, AdditionalAttributes);
        builder.AddContent(6, Panel);
        builder.CloseElement();
    };

    private RenderFragment Panel =>
        @<text>
            @if (Header is not null || Collapsible)
            {
                <div class="@_slots["header"]" data-slot="header">
                    @if (Header is not null)
                    {
                        <div class="@_slots["headerContent"]">@Header</div>
                    }
                    @if (Collapsible)
                    {
                        <button type="button" class="@_slots["toggle"]" aria-label="@Options.Strings.CollapseSidebar"
                                aria-pressed="@(Collapsed ? "true" : "false")" data-bx-sidebar-toggle>
                            @BxIcons.Named("chevron-left", _slots["toggleIcon"])
                        </button>
                    }
                </div>
            }
            <div class="@_slots["content"]" data-slot="content">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="@_slots["footer"]" data-slot="footer">@Footer</div>
            }
            @if (Resizable)
            {
                <div role="separator" tabindex="0" aria-orientation="vertical" aria-label="@Options.Strings.ResizeSidebar"
                     aria-valuemin="@MinWidth" aria-valuemax="@MaxWidth" aria-valuenow="@Width"
                     class="@_slots["handle"]" data-slot="handle"></div>
            }
        </text>;
}
