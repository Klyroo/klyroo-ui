@namespace Blux.UI
@inherits BxComponentBase

<div class="@_slots["root"]" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    private SlotSet _slots = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Horizontal places the posts next to each other in a responsive grid, vertical stacks them in one column.</summary>
    [Parameter] public BxOrientation Orientation { get; set; } = BxOrientation.Horizontal;
    [Parameter] public BlogPostsUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.BlogPosts, new Dictionary<string, string?>
        {
            ["orientation"] = Orientation == BxOrientation.Vertical ? "vertical" : "horizontal",
        }, Ui, "root");
}
