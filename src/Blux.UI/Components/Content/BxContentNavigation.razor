@namespace Blux.UI
@implements IDisposable
@inherits BxComponentBase

@*
    The navigation of a documentation site: a tree of pages with collapsible groups. Site navigation as a disclosure,
    not role="menu": links in lists, groups behind buttons with aria-expanded (<bx-collapsible>, so opening works
    without a round trip and in static rendering). The current page carries aria-current="page", computed from the
    address with the matcher the other navigation components share, so it is right on a statically rendered page too.
*@
<nav aria-label="@(AriaLabel ?? Options.Strings.ContentNavigation)" data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    <ul class="@_slots["list"]">
        @foreach (var item in Items)
        {
            <li class="@_slots["item"]">@Entry(item, 0)</li>
        }
    </ul>
</nav>

@code {
    private SlotSet _slots = default!;
    private bool _subscribed;
    private CollapsibleUi _sectionUi = new();
    private CollapsibleUi _groupUi = new();

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    /// <summary>The entries. A top-level entry with children is a section heading with its pages below it.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<BxContentNavigationItem> Items { get; set; } = [];

    /// <summary>The color of the mark on the current page.</summary>
    [Parameter] public BxColor Color { get => _colorParameter ?? DefaultColor(BxColor.Primary); set => _colorParameter = value; }
    private BxColor? _colorParameter;

    /// <summary>Accessible name of the navigation landmark. Needed when the page has several.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public ContentNavigationUi? Ui { get; set; }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _subscribed = true;
    }

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(Options.ContentNavigation, new Dictionary<string, string?>(), Ui, "root");
        _sectionUi = new CollapsibleUi { Root = _slots["group"], Trigger = _slots["section"] };
        _groupUi = new CollapsibleUi { Root = _slots["group"], Trigger = _slots["trigger"] };
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed) Navigation.LocationChanged -= OnLocationChanged;
    }

    private bool IsActive(BxContentNavigationItem item)
    {
        if (item.Active is { } forced) return forced;
        if (item.Children is { Count: > 0 }) return item.Children.Any(IsActive);
        return !string.IsNullOrEmpty(item.Href) && LinkMatcher.Matches(Navigation, item.Href, item.Exact);
    }

    private RenderFragment Entry(BxContentNavigationItem item, int depth) =>
        @<text>
            @if (item.Children is { Count: > 0 })
            {
                <BxCollapsible Open="@(item.Open ?? IsActive(item))" Disabled="@item.Disabled" ShowIcon="false" Ui="@(depth == 0 ? _sectionUi : _groupUi)">
                    <Trigger>
                        @Inner(item)
                        @BxIcons.ChevronDown(_slots["chevron"])
                    </Trigger>
                    <ChildContent>
                        <ul class="@(depth == 0 ? _slots["sectionList"] : _slots["groupList"])">
                            @foreach (var child in item.Children)
                            {
                                <li>@Entry(child, depth + 1)</li>
                            }
                        </ul>
                    </ChildContent>
                </BxCollapsible>
            }
            else if (item.Href is not null && !item.Disabled)
            {
                <a href="@item.Href" target="@item.Target" rel="@(item.Target == "_blank" ? "noopener noreferrer" : null)"
                   aria-current="@(IsActive(item) ? "page" : null)" class="@_slots["link"]">@Inner(item)</a>
            }
            else
            {
                <span aria-disabled="@(item.Disabled ? "true" : null)" class="@Resolver.Merge(_slots["link"], item.Disabled ? _slots["disabled"] : null)">@Inner(item)</span>
            }
        </text>;

    private RenderFragment Inner(BxContentNavigationItem item) =>
        @<text>
            @if (item.Icon is not null)
            {
                <BxIcon Name="@item.Icon" Class="@_slots["icon"]" />
            }
            <span class="@_slots["label"]">@item.Title</span>
            @if (item.Badge is not null)
            {
                <span class="@_slots["badge"]"><BxBadge Label="@item.Badge" Color="@(item.BadgeColor ?? BxColor.Neutral)" Variant="BxVariant.Subtle" Size="BxSize.Xs" /></span>
            }
        </text>;
}
