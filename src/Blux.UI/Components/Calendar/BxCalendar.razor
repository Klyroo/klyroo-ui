@namespace Blux.UI
@using System.Globalization
@using System.Linq.Expressions
@using Blux.UI.Internal
@using Microsoft.AspNetCore.Components.Forms
@inherits BxFieldBase<DateOnly?>

@if (UseEditContext && Mode == BxCalendarMode.Single)
{
    <FieldBridge TValue="DateOnly?" Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Context="binding">@Markup(binding)</FieldBridge>
}
else if (EditContext is not null && Mode == BxCalendarMode.Multiple && ValuesExpression is not null)
{
    <FieldBridge TValue="IReadOnlyList<DateOnly>" Value="Values" ValueChanged="ValuesChanged" ValueExpression="ValuesExpression" Context="binding">@Markup(binding)</FieldBridge>
}
else if (EditContext is not null && Mode == BxCalendarMode.Range && RangeExpression is not null)
{
    <FieldBridge TValue="BxDateRange" Value="Range" ValueChanged="RangeChanged" ValueExpression="RangeExpression" Context="binding">@Markup(binding)</FieldBridge>
}
else
{
    @Markup(new EditBinding(Name, Field?.Invalid == true))
}

@code {
    private SlotSet _slots = default!;
    private CultureInfo _culture = CultureInfo.CurrentCulture;
    private int _sequence;

    /// <summary>What the calendar selects. <c>Single</c> binds <c>Value</c>, <c>Multiple</c> binds <see cref="Values"/>, <c>Range</c> binds <see cref="Range"/>.</summary>
    [Parameter] public BxCalendarMode Mode { get; set; } = BxCalendarMode.Single;

    /// <summary>The selected dates in <c>Multiple</c> mode.</summary>
    [Parameter] public IReadOnlyList<DateOnly>? Values { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<DateOnly>> ValuesChanged { get; set; }

    /// <summary>Lets an <c>EditForm</c> name the posted entries and validate <see cref="Values"/>. Set by <c>@bind-Values</c>. Each date posts as its own entry.</summary>
    [Parameter] public Expression<Func<IReadOnlyList<DateOnly>>>? ValuesExpression { get; set; }

    /// <summary>The selected range in <c>Range</c> mode.</summary>
    [Parameter] public BxDateRange? Range { get; set; }
    [Parameter] public EventCallback<BxDateRange> RangeChanged { get; set; }

    /// <summary>Lets an <c>EditForm</c> name the posted entries and validate <see cref="Range"/>. Set by <c>@bind-Range</c>. The range posts as <c>name.Start</c> and <c>name.End</c>.</summary>
    [Parameter] public Expression<Func<BxDateRange>>? RangeExpression { get; set; }

    /// <summary>Earliest selectable date.</summary>
    [Parameter] public DateOnly? Min { get; set; }

    /// <summary>Latest selectable date.</summary>
    [Parameter] public DateOnly? Max { get; set; }

    /// <summary>Dates that cannot be selected, besides those outside <see cref="Min"/> and <see cref="Max"/>.</summary>
    [Parameter] public IEnumerable<DateOnly>? DisabledDates { get; set; }

    /// <summary>First column of the grid. Defaults to the culture's first day of the week.</summary>
    [Parameter] public DayOfWeek? WeekStart { get; set; }

    /// <summary>Source of month and day names and of the first day of the week. Defaults to the current culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>Accessible name of the calendar.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public CalendarUi? Ui { get; set; }

    private bool Bound => Mode switch
    {
        BxCalendarMode.Multiple => ValuesChanged.HasDelegate,
        BxCalendarMode.Range => RangeChanged.HasDelegate,
        _ => ValueChanged.HasDelegate,
    };

    private EventCallback<BxChangeEventArgs> ChangeHandler =>
        Bound ? EventCallback.Factory.Create<BxChangeEventArgs>(this, OnChange) : default;

    private string Serialized => Mode switch
    {
        BxCalendarMode.Multiple => string.Join(',', (Values ?? []).Select(d => Iso.Date(d))),
        BxCalendarMode.Range => Range?.Start is null ? "" : $"{Iso.Date(Range.Start)}/{Iso.Date(Range.End)}",
        _ => Iso.Date(Value) ?? "",
    };

    protected override void OnParametersSet()
    {
        _culture = Culture ?? CultureInfo.CurrentCulture;
        _slots = ResolveSlots(Options.Calendar, new Dictionary<string, string?> { ["size"] = VariantValue.Of(EffectiveSize) }, Ui, "root");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private async Task OnChange(BxChangeEventArgs e)
    {
        _sequence = e.Sequence;
        var text = e.Value ?? "";
        switch (Mode)
        {
            case BxCalendarMode.Multiple:
                var dates = text.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(Iso.ParseDate).OfType<DateOnly>().ToList();
                Values = dates;
                await ValuesChanged.InvokeAsync(dates);
                if (EditContext is not null && ValuesExpression is not null) EditContext.NotifyFieldChanged(FieldIdentifier.Create(ValuesExpression));
                break;
            case BxCalendarMode.Range:
                var parts = text.Split('/');
                var range = new BxDateRange(Iso.ParseDate(parts[0]), parts.Length > 1 ? Iso.ParseDate(parts[1]) : null);
                Range = range;
                await RangeChanged.InvokeAsync(range);
                if (EditContext is not null && RangeExpression is not null) EditContext.NotifyFieldChanged(FieldIdentifier.Create(RangeExpression));
                break;
            default:
                var date = Iso.ParseDate(text);
                if (date == Value)
                {
                    return;
                }
                Value = date;
                await ValueChanged.InvokeAsync(date);
                NotifyFieldChanged();
                break;
        }
    }

    private string WeekStartValue => ((int)(WeekStart ?? _culture.DateTimeFormat.FirstDayOfWeek)).ToString(CultureInfo.InvariantCulture);

    private RenderFragment Markup(EditBinding binding) =>
        @<bx-calendar data-bx-seq="@(Bound ? _sequence : null)"
                      mode="@Mode.ToString().ToLowerInvariant()"
                      name="@(Mode == BxCalendarMode.Single ? null : binding.Name)"
                      value="@Serialized"
                      min="@Iso.Date(Min)"
                      max="@Iso.Date(Max)"
                      disabled-dates="@(DisabledDates is null ? null : string.Join(',', DisabledDates.Select(d => Iso.Date(d))))"
                      week-start="@WeekStartValue"
                      data-locale="@(_culture.Name)"
                      months="@string.Join('|', _culture.DateTimeFormat.MonthNames.Take(12))"
                      weekdays="@string.Join('|', _culture.DateTimeFormat.ShortestDayNames)"
                      weekdays-long="@string.Join('|', _culture.DateTimeFormat.DayNames)"
                      label-prev="@Options.Strings.PreviousMonth"
                      label-next="@Options.Strings.NextMonth"
                      disabled="@(Disabled ? "" : null)"
                      class="@_slots["root"]"
                      data-color="@Color.Value"
                      data-cls-header="@_slots["header"]"
                      data-cls-heading="@_slots["heading"]"
                      data-cls-nav="@_slots["nav"]"
                      data-cls-grid="@_slots["grid"]"
                      data-cls-weekday="@_slots["weekday"]"
                      data-cls-cell="@_slots["cell"]"
                      data-cls-day="@_slots["day"]"
                      role="group"
                      aria-label="@AriaLabel"
                      @onbxchange="ChangeHandler"
                      @onbxchange:stopPropagation="true"
                      @attributes="AdditionalAttributes">
            @if (Mode == BxCalendarMode.Single)
            {
                <input type="hidden" data-slot="value" name="@binding.Name" value="@Serialized" disabled="@Disabled" />
            }
            else
            {
                @* One hidden input per posted date, written by the element into this empty span. *@
                <span data-slot="values" hidden></span>
            }
            <div data-slot="body"></div>
        </bx-calendar>;
}
