@namespace Blux.UI
@using Blux.UI.Internal
@inherits BxComponentBase

@*
    With HrefTemplate every page is a link, so it works in static server rendering and the page lives in the URL.
    Without it the pages are buttons that report through PageChanged and stay disabled until the page is interactive.
*@
<nav aria-label="@(AriaLabel ?? Options.Strings.Pagination)" data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    <ul class="@_slots["list"]">
        @if (ShowFirstLast)
        {
            <li class="@_slots["item"]">@Control(1, Options.Strings.FirstPage, NavIcons.ChevronsLeft, _page <= 1)</li>
        }
        @if (ShowControls)
        {
            <li class="@_slots["item"]">@Control(_page - 1, Options.Strings.PreviousPage, NavIcons.ChevronLeft, _page <= 1)</li>
        }
        @foreach (var entry in _entries)
        {
            <li class="@_slots["item"]">
                @if (entry == 0)
                {
                    <span aria-hidden="true" class="@_slots["ellipsis"]">&hellip;</span>
                }
                else
                {
                    @PageItem(entry)
                }
            </li>
        }
        @if (ShowControls)
        {
            <li class="@_slots["item"]">@Control(_page + 1, Options.Strings.NextPage, NavIcons.ChevronRight, _page >= _pageCount)</li>
        }
        @if (ShowFirstLast)
        {
            <li class="@_slots["item"]">@Control(_pageCount, Options.Strings.LastPage, NavIcons.ChevronsRight, _page >= _pageCount)</li>
        }
    </ul>
</nav>

@code {
    private SlotSet _slots = default!;
    private int _page = 1;
    private int _pageCount = 1;
    private List<int> _entries = [];

    /// <summary>Total number of items. The page count is <c>ceil(Total / PageSize)</c>, at least 1.</summary>
    [Parameter] public int Total { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;

    /// <summary>Current page, starting at 1.</summary>
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    /// <summary>Pages shown on each side of the current one.</summary>
    [Parameter] public int SiblingCount { get; set; } = 1;

    /// <summary>Previous and next buttons.</summary>
    [Parameter] public bool ShowControls { get; set; } = true;

    /// <summary>Buttons jumping to the first and the last page.</summary>
    [Parameter] public bool ShowFirstLast { get; set; }

    /// <summary>
    /// Turns pages into links. <c>{page}</c> is replaced by the page number, for example <c>/items?page={page}</c>.
    /// The owner of the page reads the number from the URL and passes it as <see cref="Page"/>.
    /// </summary>
    [Parameter] public string? HrefTemplate { get; set; }
    [Parameter] public BxColor Color { get => _colorParameter ?? DefaultColor(BxColor.Primary); set => _colorParameter = value; }
    private BxColor? _colorParameter;
    [Parameter] public BxSize Size { get => _sizeParameter ?? DefaultSize(BxSize.Md); set => _sizeParameter = value; }
    private BxSize? _sizeParameter;

    /// <summary>Accessible name of the landmark. Defaults to <see cref="BluxStrings.Pagination"/>.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public PaginationUi? Ui { get; set; }

    private bool HasHref => !string.IsNullOrEmpty(HrefTemplate);

    // Buttons need an interactive renderer: until then they would look usable and do nothing.
    private bool Inert => !HasHref && !RendererInfo.IsInteractive;

    protected override void OnParametersSet()
    {
        _pageCount = Math.Max(1, (int)Math.Ceiling(Total / (double)Math.Max(1, PageSize)));
        _page = Math.Clamp(Page, 1, _pageCount);
        _entries = Entries(_page, _pageCount, Math.Max(0, SiblingCount));
        _slots = ResolveSlots(Options.Pagination, new Dictionary<string, string?> { ["size"] = VariantValue.Of(Size) }, Ui, "root");
    }

    /// <summary>Page numbers to show, 0 standing for an ellipsis. The width stays constant while paging.</summary>
    internal static List<int> Entries(int page, int count, int sibling)
    {
        var slots = 2 * sibling + 5;
        var result = new List<int>();
        if (count <= slots)
        {
            for (var p = 1; p <= count; p++) result.Add(p);
            return result;
        }
        var left = Math.Max(page - sibling, 1);
        var right = Math.Min(page + sibling, count);
        var showLeft = left > 3;
        var showRight = right < count - 2;
        if (!showLeft && showRight)
        {
            for (var p = 1; p <= 3 + 2 * sibling; p++) result.Add(p);
            result.Add(0);
            result.Add(count);
        }
        else if (showLeft && !showRight)
        {
            result.Add(1);
            result.Add(0);
            for (var p = count - (2 + 2 * sibling); p <= count; p++) result.Add(p);
        }
        else
        {
            result.Add(1);
            result.Add(0);
            for (var p = left; p <= right; p++) result.Add(p);
            result.Add(0);
            result.Add(count);
        }
        return result;
    }

    private string HrefFor(int page) => HrefTemplate!.Replace("{page}", page.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal);

    private EventCallback Click(int page) =>
        Inert ? default : EventCallback.Factory.Create(this, (Func<Task>)(() => Select(page)));

    private async Task Select(int page)
    {
        page = Math.Clamp(page, 1, _pageCount);
        if (page == _page) return;
        Page = page;
        _page = page;
        _entries = Entries(_page, _pageCount, Math.Max(0, SiblingCount));
        await PageChanged.InvokeAsync(page);
    }

    private RenderFragment PageItem(int page) =>
        @<text>
            @if (HasHref)
            {
                <a href="@HrefFor(page)" aria-current="@(page == _page ? "page" : null)" aria-label="@($"{Options.Strings.Page} {page}")" class="@_slots["page"]">@(page)</a>
            }
            else
            {
                <button type="button" disabled="@Inert" aria-current="@(page == _page ? "page" : null)" aria-label="@($"{Options.Strings.Page} {page}")"
                        class="@_slots["page"]" @onclick="Click(page)">@(page)</button>
            }
        </text>;

    private RenderFragment Control(int target, string label, Func<string?, RenderFragment> icon, bool disabled) =>
        @<text>
            @if (HasHref)
            {
                @* A disabled link has no href, so it cannot be followed or focused. *@
                <a href="@(disabled ? null : HrefFor(target))" role="@(disabled ? "link" : null)" aria-disabled="@(disabled ? "true" : null)"
                   aria-label="@label" class="@_slots["control"]">@icon(_slots["icon"])</a>
            }
            else
            {
                <button type="button" disabled="@(disabled || Inert)" aria-label="@label" class="@_slots["control"]"
                        @onclick="Click(target)">@icon(_slots["icon"])</button>
            }
        </text>;
}
