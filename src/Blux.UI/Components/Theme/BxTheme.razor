@namespace Blux.UI
@using Blux.UI.Theming

@*
    Cascades class overrides to every component of a given type below it, like Nuxt UI's UTheme. The classes are
    merged after the theme and AddBluxUi, and before the component's own Ui and Class, so an instance still wins.
    Without overrides it adds nothing and passes the enclosing scope through.
*@
<CascadingValue Value="_scope">@ChildContent</CascadingValue>

@code {
    private BxThemeScope? _scope;
    private BxThemeScope? _usedParent;
    private ISlotOverrides? _usedUi;
    private Type? _usedFor;
    private IReadOnlyDictionary<Type, ISlotOverrides>? _usedOverrides;
    private bool _built;

    [CascadingParameter] private BxThemeScope? Parent { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The component type the <see cref="Ui"/> applies to: <c>typeof(BxButton)</c>, or <c>typeof(BxTable&lt;&gt;)</c> for a generic one.</summary>
    [Parameter] public Type? For { get; set; }

    /// <summary>
    /// The overrides for <see cref="For"/>: any <c>*Ui</c> record, such as <c>new ButtonUi { Base = "font-bold" }</c>.
    /// Slots the component does not have are ignored.
    /// </summary>
    [Parameter] public ISlotOverrides? Ui { get; set; }

    /// <summary>Overrides for several component types at once. They win over <see cref="For"/> and <see cref="Ui"/> on a clash.</summary>
    [Parameter] public IReadOnlyDictionary<Type, ISlotOverrides>? Overrides { get; set; }

    protected override void OnParametersSet()
    {
        // A fresh scope makes every component below render again: only build one when an input changed.
        if (_built && ReferenceEquals(_usedParent, Parent) && ReferenceEquals(_usedUi, Ui) && _usedFor == For && ReferenceEquals(_usedOverrides, Overrides))
        {
            return;
        }
        (_built, _usedParent, _usedUi, _usedFor, _usedOverrides) = (true, Parent, Ui, For, Overrides);

        var map = new Dictionary<Type, ISlotOverrides>();
        if (For is not null && Ui is not null) map[For] = Ui;
        if (Overrides is not null)
        {
            foreach (var (type, ui) in Overrides) map[type] = ui;
        }
        _scope = map.Count == 0 ? Parent : new BxThemeScope(Parent, map);
    }
}
