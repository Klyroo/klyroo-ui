<Project>
  <!--
    Bundled icons. Any Iconify icon works by name (<BxIcon Name="ph:house" />, "i-mdi-home", "simple-icons:github"): at build time the
    LuxResolveIcons task scans the project's .razor, .cshtml and .cs files for literal icon names, adds what the project lists

      <LuxIcon Include="ph:house;mdi:home" />                                  names the scan cannot see (built at runtime)
      <LuxIconCollection Include="Assets/icons" Prefix="custom" />             a folder of .svg files, used as custom:file-name
      <LuxIconScanDirectory Include="../Shared" />                             a folder outside the project whose sources are scanned too

    downloads what its cache lacks from the Iconify API, and generates a C# file, added to the compilation, whose module initializer
    registers the icons with Lux.UI. Nothing is requested when the app runs, and a build without network works from the cache.
    The scan reads "i-prefix-name" strings anywhere and "prefix:name" only in icon places (Icon="...", Name= on BxIcon, BxIcons.Named, o.Icons.X =); it skips
    dot folders, links and files over 1 MiB, and does nothing when no source, item, option or icon file changed. Every icon body is sanitized (see the Icons guide).
    When no icon is bundled the generated file is removed and not compiled.

      LuxIcons=false         turns the whole feature off (no scan, no download, no generated file).
      LuxIconsScan=false     keeps the LuxIcon and LuxIconCollection items but does not scan the sources.
      LuxIconsApi            base address of the Iconify API (default https://api.iconify.design), for a self-hosted one.
      LuxIconsCacheDir       the cache (default $(LuxCacheDir)icons-cache), LuxIconsCacheDays how long it is trusted (default 30).
      LuxIconsFailOnError    an icon that cannot be found is an error (default in Release) or a warning (default in Debug).
  -->
  <PropertyGroup>
    <LuxIcons Condition="'$(LuxIcons)' == ''">true</LuxIcons>
    <LuxIconsScan Condition="'$(LuxIconsScan)' == ''">true</LuxIconsScan>
    <LuxIconsApi Condition="'$(LuxIconsApi)' == ''">https://api.iconify.design</LuxIconsApi>
    <LuxIconsCacheDir Condition="'$(LuxIconsCacheDir)' == ''">$([MSBuild]::NormalizeDirectory($(LuxCacheDir), icons-cache))</LuxIconsCacheDir>
    <LuxIconsCacheDays Condition="'$(LuxIconsCacheDays)' == ''">30</LuxIconsCacheDays>
    <LuxIconsFailOnError Condition="'$(LuxIconsFailOnError)' == ''">$([System.String]::Equals('$(Configuration)', 'Release'))</LuxIconsFailOnError>
  </PropertyGroup>

  <!--
    The generated file must be in @(Compile) before _GenerateCompileDependencyCache hashes the compile inputs (CompileDependsOn runs it just before
    CoreCompile): a file added after that is not in CoreCompileInputs.cache, so removing it later (LuxIcons=false, no icon left) would not make
    CoreCompile run again and the old initializer would stay in the assembly.
  -->
  <Target Name="LuxResolveIcons"
          BeforeTargets="_GenerateCompileDependencyCache;CoreCompile"
          Condition="'$(LuxIcons)' != 'false' And '$(DesignTimeBuild)' != 'true'">
    <!-- IntermediateOutputPath is only known once the SDK targets are evaluated, so the default is computed here. -->
    <PropertyGroup>
      <LuxIconsOutputDir Condition="'$(LuxIconsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux, icons))</LuxIconsOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_LuxIconExclude Include="$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath)))" />
      <_LuxIconExclude Include="$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseOutputPath)))" />
    </ItemGroup>

    <LuxResolveIcons Icons="@(LuxIcon)"
                      Collections="@(LuxIconCollection)"
                      Scan="$(LuxIconsScan)"
                      ProjectDirectory="$(MSBuildProjectDirectory)"
                      ScanDirectories="@(LuxIconScanDirectory)"
                      ExcludeDirectories="@(_LuxIconExclude)"
                      CacheDir="$(LuxIconsCacheDir)"
                      OutputFile="$(LuxIconsOutputDir)LuxIcons.g.cs"
                      Api="$(LuxIconsApi)"
                      FailOnError="$(LuxIconsFailOnError)"
                      Offline="$(LuxOffline)"
                      CacheDays="$(LuxIconsCacheDays)">
      <Output TaskParameter="HasIcons" PropertyName="_LuxIconsHasIcons" />
    </LuxResolveIcons>

    <!-- No icon bundled: the task has removed the file, and it stays out of the compilation. -->
    <ItemGroup Condition="'$(_LuxIconsHasIcons)' == 'true'">
      <Compile Include="$(LuxIconsOutputDir)LuxIcons.g.cs" />
      <FileWrites Include="$(LuxIconsOutputDir)LuxIcons.g.cs" />
    </ItemGroup>
    <ItemGroup>
      <FileWrites Include="$(LuxIconsOutputDir)LuxIcons.g.cs.inputs" Condition="Exists('$(LuxIconsOutputDir)LuxIcons.g.cs.inputs')" />
    </ItemGroup>
  </Target>

  <!-- LuxIcons=false: a file left by an earlier build with icons is deleted and kept out of the compilation, so the next compile does not register icons that are switched off. -->
  <Target Name="LuxIconsOff"
          BeforeTargets="_GenerateCompileDependencyCache;CoreCompile"
          Condition="'$(LuxIcons)' == 'false' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_LuxIconsOffDir Condition="'$(LuxIconsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux, icons))</_LuxIconsOffDir>
      <_LuxIconsOffDir Condition="'$(_LuxIconsOffDir)' == ''">$(LuxIconsOutputDir)</_LuxIconsOffDir>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="$(_LuxIconsOffDir)LuxIcons.g.cs" />
    </ItemGroup>
    <Delete Files="$(_LuxIconsOffDir)LuxIcons.g.cs;$(_LuxIconsOffDir)LuxIcons.g.cs.inputs" ContinueOnError="true" />
  </Target>

  <!-- Design-time builds (an IDE refreshing IntelliSense) never scan or download: they only keep the file of the last real build in the compilation. -->
  <Target Name="LuxIconsDesignTime"
          BeforeTargets="CoreCompile"
          Condition="'$(LuxIcons)' != 'false' And '$(DesignTimeBuild)' == 'true'">
    <PropertyGroup>
      <LuxIconsOutputDir Condition="'$(LuxIconsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), blux, icons))</LuxIconsOutputDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(LuxIconsOutputDir)LuxIcons.g.cs')">
      <Compile Include="$(LuxIconsOutputDir)LuxIcons.g.cs" />
    </ItemGroup>
  </Target>
</Project>
