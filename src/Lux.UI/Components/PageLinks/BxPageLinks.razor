@namespace Lux.UI
@inherits BxComponentBase
@using Lux.UI.Internal

@* A navigation landmark named by its title, or by the built-in "Links" text. The current page is marked with aria-current. *@
<nav aria-labelledby="@(Title is null ? null : _titleId)"
     aria-label="@(Title is null ? Messages.PageLinks : null)"
     class="@_slots["root"]"
     @attributes="AdditionalAttributes">
    @if (Title is not null)
    {
        @if (HeadingLevel is { } level)
        {
            <SectionHeading Level="level" Id="@_titleId" Class="@_slots["title"]">@Title</SectionHeading>
        }
        else
        {
            <p id="@_titleId" class="@_slots["title"]" data-slot="title">@Title</p>
        }
    }
    @if (Links is { Count: > 0 })
    {
        <ul class="@_slots["list"]" data-slot="list">
            @foreach (var link in Links)
            {
                <li class="@_slots["item"]">
                    <BxLink Raw Href="@link.Href" Target="@link.Target" Disabled="@link.Disabled" Active="@link.Active" Exact="@link.Exact" Class="@_slots["link"]">
                        @if (link.Icon is not null)
                        {
                            <BxIcon Name="@link.Icon" Class="@_slots["icon"]" />
                        }
                        <span class="@_slots["label"]">@link.Label</span>
                        @if (link.Target == "_blank")
                        {
                            <BxIcon Name="arrow-up-right" Class="@_slots["externalIcon"]" />
                            <span class="sr-only"> @Messages.OpensInNewTab</span>
                        }
                    </BxLink>
                </li>
            }
        </ul>
    }
</nav>

@code {
    private SlotSet _slots = default!;
    private readonly string _titleId = NewId("pagelinks");

    /// <summary>Heading above the list; it also names the navigation.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The links. A link to the current page (or to a page above it, unless <see cref="PageLinkItem.Exact"/>) is marked active.</summary>
    [Parameter] public IReadOnlyList<PageLinkItem>? Links { get; set; }

    /// <summary>Renders the title as a heading of this level (1 to 6) instead of a paragraph.</summary>
    [Parameter] public int? HeadingLevel { get; set; }
    [Parameter] public PageLinksUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PageLinks, new Dictionary<string, string?>(), Ui, "root");
}
