@namespace Lux.UI
@inherits LxFieldBase<string>

@if (UseEditContext)
{
    <InputTextArea Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" @attributes="Attributes()" />
}
else if (!ValueChanged.HasDelegate)
{
    <textarea name="@Name" value="@Value" @attributes="Attributes()"></textarea>
}
else if (Immediate)
{
    <textarea name="@Name" @bind:get="Value" @bind:set="SetValue" @bind:event="oninput" @attributes="Attributes()"></textarea>
}
else
{
    <textarea name="@Name" @bind:get="Value" @bind:set="SetValue" @attributes="Attributes()"></textarea>
}

@code {
    private SlotSet _slots = default!;

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>Grow with the content (CSS field-sizing, where the browser supports it).</summary>
    [Parameter] public bool AutoResize { get; set; }
    [Parameter] public bool Immediate { get; set; }
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Outline;
    [Parameter] public TextareaUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Textarea, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(EffectiveSize),
            ["autoresize"] = VariantValue.Of(AutoResize),
        }, Ui, "base");

    private Dictionary<string, object> Attributes()
    {
        var attributes = ControlAttributes(_slots["base"]);
        attributes["rows"] = Rows;
        attributes["data-color"] = Color.Value;
        if (Placeholder is not null) attributes["placeholder"] = Placeholder;
        return attributes;
    }
}
