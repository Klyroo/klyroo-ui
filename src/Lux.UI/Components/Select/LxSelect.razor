@namespace Lux.UI
@using Lux.UI.Internal
@inherits LxFieldBase<string>

@if (UseEditContext)
{
    <EditBridge Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Context="binding">@Markup(binding)</EditBridge>
}
else
{
    @Markup(new EditBinding(Name, Field?.Invalid == true))
}

@code {
    private SlotSet _slots = default!;
    private int _sequence;
    private string _id = default!;
    private IReadOnlyList<SelectSection> _sections = [];
    private bool _hasIcons;

    [Parameter, EditorRequired] public IReadOnlyList<LxSelectItem> Items { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Outline;
    [Parameter] public SelectUi? Ui { get; set; }

    private LxSelectItem? Selected => Items.FirstOrDefault(i => i.Value == Value);

    private EventCallback<LxChangeEventArgs> ChangeHandler =>
        ValueChanged.HasDelegate ? EventCallback.Factory.Create<LxChangeEventArgs>(this, OnChange) : default;

    protected override void OnParametersSet()
    {
        _id ??= NewId("select");
        _sections = SelectSections.Of(Items);
        _hasIcons = Items.Any(i => i.Icon is not null);
        _slots = ResolveSlots(Options.Select, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(EffectiveSize),
        }, Ui, "root");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(LxChangeEventArgs))]
    private async Task OnChange(LxChangeEventArgs e)
    {
        _sequence = e.Sequence;
        var value = string.IsNullOrEmpty(e.Value) ? null : e.Value;
        if (value == Value)
        {
            return;
        }
        Value = value;
        await ValueChanged.InvokeAsync(value);
        NotifyFieldChanged();
    }

    private Dictionary<string, object> TriggerAttributes(EditBinding binding)
    {
        var attributes = ControlAttributes(_slots["base"]);
        attributes.Remove("required");
        if (Required) attributes["aria-required"] = "true";
        if (binding.Invalid) attributes["aria-invalid"] = "true";
        attributes.AddFieldClass(binding);
        attributes["data-slot"] = "trigger";
        return attributes;
    }

    private RenderFragment Option(LxSelectItem item) =>
        @<div role="option" class="@_slots["item"]" data-value="@item.Value" data-label="@item.Label"
              aria-selected="@(item.Value == Value ? "true" : "false")" aria-disabled="@(item.Disabled ? "true" : null)"
              data-has-count="@(item.Count is null ? null : "")" data-has-icon="@(item.Icon is null ? null : "")">@ItemContent(item)</div>;

    private RenderFragment ItemContent(LxSelectItem item) =>
        @<text>
            @if (item.Icon is not null)
            {
                @RenderIcon(item.Icon, _slots["itemLeadingIcon"])
            }
            <span class="@_slots["itemLabel"]">@item.Label</span>
            @if (item.Count is { } count)
            {
                <span class="sr-only" data-slot="count-separator">, </span>
                <span class="@_slots["itemCount"]" data-slot="count">@count.ToString("N0", FormatCulture)</span>
            }
            @RenderIcon(Options.Icons.Check, _slots["itemIcon"])
        </text>;

    private RenderFragment Markup(EditBinding binding) =>
        @<lx-select data-lx-seq="@(ValueChanged.HasDelegate ? _sequence : null)"
                    value="@(Value ?? "")"
                    class="@_slots["root"]"
                    data-color="@Color.Value"
                    @onlxchange="ChangeHandler"
                    @onlxchange:stopPropagation="true">
            <input type="hidden" data-slot="value" name="@binding.Name" value="@(Value ?? "")" disabled="@Disabled" />
            <button type="button" role="combobox" aria-haspopup="listbox" aria-expanded="false" @attributes="TriggerAttributes(binding)">
                @if (_hasIcons)
                {
                    @* Filled by the browser with the icon of the selected item: no Blazor children, so nothing to diff. *@
                    <span class="@_slots["leadingIcon"]" data-slot="selectedIcon" aria-hidden="true"></span>
                }
                <span class="@_slots["label"]" data-slot="label"
                      data-label="@(Selected?.Label ?? Placeholder ?? "")"
                      data-placeholder="@(Selected is null ? "" : null)"
                      data-placeholder-text="@(Placeholder ?? "")"></span>
                @RenderIcon(Options.Icons.ChevronUpDown, _slots["trailingIcon"])
            </button>
            <div popover="auto" class="@_slots["content"]" data-slot="content">
                <div role="listbox" class="@_slots["listbox"]" tabindex="-1" aria-labelledby="@(Field?.LabelId ?? ControlId)">
                    @for (var s = 0; s < _sections.Count; s++)
                    {
                        var section = _sections[s];
                        if (section.Label is null)
                        {
                            foreach (var item in section.Items)
                            {
                                @Option(item)
                            }
                        }
                        else
                        {
                            var groupId = _id + "-group-" + s;
                            <div role="group" aria-labelledby="@groupId" class="@_slots["group"]" data-slot="group">
                                <div id="@groupId" role="presentation" class="@_slots["groupLabel"]" data-slot="group-label">@section.Label</div>
                                @foreach (var item in section.Items)
                                {
                                    @Option(item)
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </lx-select>;
}
