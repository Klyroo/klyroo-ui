@namespace Lux.UI
@using Lux.UI.Internal
@inherits LxListFieldBase

@if (UseEditContext)
{
    <ValueBridge TValue="IReadOnlyList<string>" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Context="binding">@Markup(binding)</ValueBridge>
}
else
{
    @Markup(new EditBinding(Name, Field?.Invalid == true))
}

@code {
    private SlotSet _slots = default!;

    [Parameter, EditorRequired] public IReadOnlyList<LxToggleItem> Items { get; set; } = [];

    /// <summary>Several items can be pressed at once; otherwise pressing an item releases the others.</summary>
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public LxOrientation Orientation { get; set; } = LxOrientation.Horizontal;
    [Parameter] public ToggleVariant Variant { get; set; } = ToggleVariant.Outline;

    /// <summary>Accessible name of the group when no <see cref="LxFormField"/> label is around.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public ToggleGroupUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.ToggleGroup, new Dictionary<string, string?>
        {
            ["variant"] = Variant.ToString().ToLowerInvariant(),
            ["size"] = VariantValue.Of(EffectiveSize),
            ["orientation"] = Orientation == LxOrientation.Vertical ? "vertical" : "horizontal",
        }, Ui, "root");

    private RenderFragment Markup(EditBinding binding) =>
        @<lx-toggle-group data-lx-seq="@SequenceAttribute"
                          id="@ControlId"
                          role="group"
                          name="@binding.Name"
                          data-values="@DataValues"
                          data-multiple="@(Multiple ? "" : null)"
                          data-orientation="@(Orientation == LxOrientation.Vertical ? "vertical" : "horizontal")"
                          aria-label="@AriaLabel"
                          aria-labelledby="@(AriaLabel is null ? Field?.LabelId : null)"
                          aria-describedby="@Field?.DescribedBy"
                          disabled="@Disabled"
                          class="@binding.WithFieldClass(_slots["root"])"
                          data-color="@Color.Value"
                          @onlxchange="ChangeHandler"
                          @onlxchange:stopPropagation="true"
                          @attributes="AdditionalAttributes">
            <span data-slot="values" hidden></span>
            @foreach (var item in Items)
            {
                <button type="button" class="@_slots["item"]" data-slot="item" data-value="@item.Value" disabled="@(item.Disabled || Disabled)"
                        aria-pressed="@(IsSelected(item.Value) ? "true" : "false")" data-state="@(IsSelected(item.Value) ? "on" : "off")"
                        tabindex="@(IsRoving(item) ? 0 : -1)">
                    @if (item.Icon is not null)
                    {
                        <span class="@_slots["icon"]" aria-hidden="true">@item.Icon</span>
                    }
                    @item.Label
                </button>
            }
        </lx-toggle-group>;

    // The element keeps the roving tabindex after the first render; this only gives static output one tab stop.
    private bool IsRoving(LxToggleItem item)
    {
        var pressed = Items.FirstOrDefault(i => !i.Disabled && IsSelected(i.Value));
        return ReferenceEquals(item, pressed ?? Items.FirstOrDefault(i => !i.Disabled));
    }
}
