@namespace Lux.UI
@inherits LxComponentBase

@* Pure CSS: the theme removes the inner radii of the children, so buttons, inputs and selects keep their own API. *@
<div role="group" aria-label="@AriaLabel" class="@_slots["base"]" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The controls to attach to each other: <c>LxButton</c>, <c>LxInput</c>, <c>LxSelect</c>…</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public LxOrientation Orientation { get; set; } = LxOrientation.Horizontal;

    /// <summary>Accessible name of the group, when it needs one.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public FieldGroupUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.FieldGroup, new Dictionary<string, string?>
        {
            ["orientation"] = Orientation == LxOrientation.Vertical ? "vertical" : "horizontal",
        }, Ui, "base");
}
