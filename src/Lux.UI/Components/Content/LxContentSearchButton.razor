@namespace Lux.UI
@inherits LxComponentBase

@*
    The button that opens a LxContentSearch, showing its shortcut with LxKbd. It is a LxButton, so it takes its color,
    variant and size. A click is handled in the browser (js/content.js), which opens the search by clicking the hidden
    trigger of its modal, so it works in static rendering and focus returns to the button when the search closes.
*@
<LxButton Color="Color" Variant="Variant" Size="Size" Square="Collapsed" Class="@_slots["root"]" Ui="_buttonUi"
          aria-haspopup="dialog" aria-keyshortcuts="@(Keys is null ? "Control+K Meta+K" : null)" aria-label="@(Collapsed ? ButtonLabel : null)" data-lx-content-search-open="@For"
          @attributes="AdditionalAttributes">
    <LeadingIcon>@RenderIcon(Options.Icons.Search, "size-5")</LeadingIcon>
    <ChildContent>
        @if (!Collapsed)
        {
            <span class="@_slots["label"]">@ButtonLabel</span>
            @if (Keys is null || Keys.Count > 0)
            {
                <lx-mod-keys class="@_slots["kbds"]" aria-hidden="true">
                    @if (Keys is null)
                    {
                        @* The modifier follows the platform: the browser sets the label (<lx-mod-keys>, js/platform-keys.js), the localized modifier name until then. *@
                        <LxKbd Size="LxSize.Sm" data-lx-mod="" data-label="@Messages.ModifierKey" />
                        <LxKbd Value="K" Size="LxSize.Sm" />
                    }
                    else
                    {
                        @foreach (var key in Keys)
                        {
                            <LxKbd Value="@key" Size="LxSize.Sm" />
                        }
                    }
                </lx-mod-keys>
            }
        }
    </ChildContent>
</LxButton>

@code {
    private SlotSet _slots = default!;

    private ButtonUi _buttonUi = new();

    private string ButtonLabel => Label ?? Messages.ContentSearchButton;

    /// <summary>The text of the button. Defaults to the built-in text; with <see cref="Collapsed"/> it is the accessible name.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Shows only the icon, as a square button. Without it the button shows its label and its shortcut.</summary>
    [Parameter] public bool Collapsed { get; set; } = true;

    /// <summary>
    /// The keys of the shortcut to show, one <see cref="LxKbd"/> each. Match the <c>Shortcut</c> of the search. Left out, the
    /// hint follows the platform in the browser (the command key and K on Apple devices, Ctrl and K elsewhere), matching the
    /// default <c>mod+k</c> shortcut, and the button announces <c>aria-keyshortcuts</c>. Keys you give are shown as given.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? Keys { get; set; }

    /// <summary>The <c>Name</c> of the search to open. Without it the button opens the unnamed one.</summary>
    [Parameter] public string For { get; set; } = "";
    [Parameter] public LxColor Color { get; set; } = LxColor.Neutral;
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;
    [Parameter] public LxSize Size { get => _sizeParameter ?? DefaultSize(LxSize.Md); set => _sizeParameter = value; }
    private LxSize? _sizeParameter;
    [Parameter] public ContentSearchButtonUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(Options.ContentSearchButton, new Dictionary<string, string?>
        {
            ["collapsed"] = VariantValue.Of(Collapsed),
        }, Ui, "root");
        // The label of the button holds the text and the keys side by side.
        _buttonUi = new ButtonUi { Label = _slots["buttonLabel"] };
    }
}
