@namespace Lux.UI
@inherits LxComponentBase

@*
    The previous and the next page. Plain links, so they work in every render mode; rel="prev" and rel="next" tell
    crawlers and browsers which is which. Renders nothing when there is neither.
*@
@if (Previous is not null || Next is not null)
{
    <nav aria-label="@(AriaLabel ?? Messages.ContentSurround)" class="@_previous["root"]" @attributes="AdditionalAttributes">
        @if (Previous is not null)
        {
            <a href="@Previous.Href" rel="prev" class="@_previous["link"]">
                <span class="@_previous["caption"]">
                    @RenderIcon(Options.Icons.ArrowLeft, _previous["icon"])
                    @Messages.ContentPrevious
                </span>
                <span class="@_previous["title"]">@Previous.Title</span>
                @if (Previous.Description is not null)
                {
                    <span class="@_previous["description"]">@Previous.Description</span>
                }
            </a>
        }
        @if (Next is not null)
        {
            <a href="@Next.Href" rel="next" class="@_next["link"]">
                <span class="@_next["caption"]">
                    @RenderIcon(Options.Icons.ArrowRight, _next["icon"])
                    @Messages.ContentNext
                </span>
                <span class="@_next["title"]">@Next.Title</span>
                @if (Next.Description is not null)
                {
                    <span class="@_next["description"]">@Next.Description</span>
                }
            </a>
        }
    </nav>
}

@code {
    private SlotSet _previous = default!;
    private SlotSet _next = default!;

    /// <summary>The page before this one. Without it the next page stays in the second column.</summary>
    [Parameter] public LxContentSurroundLink? Previous { get; set; }

    /// <summary>The page after this one.</summary>
    [Parameter] public LxContentSurroundLink? Next { get; set; }

    /// <summary>Accessible name of the navigation landmark. Defaults to the built-in text.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public ContentSurroundUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _previous = ResolveSlots(Options.ContentSurround, new Dictionary<string, string?> { ["direction"] = "previous" }, Ui, "root");
        _next = ResolveSlots(Options.ContentSurround, new Dictionary<string, string?> { ["direction"] = "next" }, Ui, "root");
    }
}
