@namespace Lux.UI
@inherits BxComponentBase

@*
    A "load more" point for a list that grows. Place it after the last item (or before the first, for a history that loads upward).
    <bx-infinite-scroll> watches a 1px sentinel with an IntersectionObserver and reports once each time it comes into view
    (see js/infinite-scroll.js); the button below it is the same action by hand, for keyboards, screen readers and browsers
    without IntersectionObserver. Without a .NET listener (a static page, or before the page is interactive) the button is a
    link to Href, so the next page works without scripts or a runtime.
*@
<bx-infinite-scroll class="@_slots["root"]"
                    data-bx-seq="@(Bound ? "0" : null)"
                    data-has-more="@(HasMore ? "" : null)"
                    data-loading="@(Busy ? "" : null)"
                    data-loads="@(Bound ? _loads.ToString() : null)"
                    data-root="@Root"
                    data-root-margin="@RootMargin"
                    @onbxchange="ChangeHandler"
                    @onbxchange:stopPropagation="true"
                    @attributes="AdditionalAttributes">
    @if (HasMore)
    {
        <div class="@_slots["sentinel"]" data-slot="sentinel" aria-hidden="true"></div>
        <BxButton Variant="ButtonVariant.Outline"
                  Label="@(Label ?? Messages.LoadMore)"
                  Href="@(Bound ? null : Href)"
                  Disabled="@Inert"
                  LeadingIcon="@(Busy ? Spinner : null)"
                  Class="@_slots["trigger"]"
                  @attributes="TriggerAttributes" />
    }
    else if (ShowEnd)
    {
        @* The status below announces it: this copy is for the eyes only. *@
        <p class="@_slots["end"]" data-slot="end" aria-hidden="true">@Messages.NoMoreItems</p>
    }
    @if (!HasMore)
    {
        @* Where the focus goes when the last button disappears while it has it. Not the live region: that one announces by itself. *@
        <span class="@_slots["marker"]" data-slot="marker" tabindex="-1"></span>
    }
    <div role="status" aria-live="polite" aria-atomic="true" tabindex="-1" class="@_slots["status"]" data-slot="status">@Announcement</div>
</bx-infinite-scroll>

@code {
    private SlotSet _slots = default!;
    private bool _busy;
    private int _loads;

    /// <summary>Whether there is anything left to load. When false the sentinel and the button are removed and the end is announced.</summary>
    [Parameter] public bool HasMore { get; set; } = true;

    /// <summary>
    /// A load is running. While it is true nothing is requested again; when it turns false the sentinel is checked again,
    /// so a sentinel still in view asks for the next items. A load started through <see cref="OnLoadMore"/> counts as running
    /// until the callback returns, so an async handler does not have to set this. The component does not set <c>aria-busy</c>
    /// (it would hide its own announcement): put <c>aria-busy</c> on your list while it loads.
    /// </summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Asked for the next items: each time the sentinel comes into view and when the button is used, never twice for one
    /// visibility until the load is over. Only runs when the page is interactive. After a load that added nothing (or threw),
    /// nothing is asked again until the sentinel has left the view and come back, or the button is used: a handler that has nothing
    /// more to give, or failed, should set <see cref="HasMore"/> to false, or show a retry.
    /// </summary>
    [Parameter] public EventCallback OnLoadMore { get; set; }

    /// <summary>
    /// How far before the sentinel is really in view the load starts, as the margin of an <c>IntersectionObserver</c>
    /// (pixels or percent, CSS order top right bottom left). The default loads 200px ahead of the end of a list; for a list
    /// that loads upward put the component first and use <c>"200px 0px 0px 0px"</c>.
    /// </summary>
    [Parameter] public string RootMargin { get; set; } = "0px 0px 200px 0px";

    /// <summary>
    /// A CSS selector of the element that scrolls (<c>"#feed"</c>). By default the closest scrollable ancestor is used
    /// (<c>overflow-y</c> auto or scroll), or the viewport when there is none.
    /// </summary>
    [Parameter] public string? Root { get; set; }

    /// <summary>
    /// Where the next items are, for a page without .NET (static rendering, or before the page is interactive): the button
    /// becomes a link to it, like <c>?page=2</c> or the next cursor URL. Once the page is interactive the button loads in place instead.
    /// </summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Text of the button. Defaults to the translated "Load more".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Shows the translated "No more items" when <see cref="HasMore"/> is false. It is announced either way.</summary>
    [Parameter] public bool ShowEnd { get; set; }
    [Parameter] public InfiniteScrollUi? Ui { get; set; }

    // Only a component that listens and can hear the browser asks for anything: the element does nothing otherwise. With a
    // listener the control is a real button (Space works, and it does not pretend to go somewhere); the link is the fallback.
    private bool Bound => OnLoadMore.HasDelegate && RendererInfo.IsInteractive;

    private bool Busy => Loading || _busy;

    // A button with no link and nobody to call would look usable and do nothing.
    private bool Inert => Href is null && !Bound;

    private EventCallback<BxChangeEventArgs> ChangeHandler =>
        Bound ? EventCallback.Factory.Create<BxChangeEventArgs>(this, OnChange) : default;

    private string Announcement => Busy ? Messages.LoadingMore : HasMore ? "" : Messages.NoMoreItems;

    private RenderFragment Spinner => RenderIcon(Options.Icons.Loading, _slots["spinner"]);

    // Kept focusable (not disabled) while loading, so a keyboard user does not lose the place; the element ignores the clicks.
    private Dictionary<string, object> TriggerAttributes => Busy
        ? new() { ["data-slot"] = "trigger", ["aria-disabled"] = "true" }
        : new() { ["data-slot"] = "trigger" };

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.InfiniteScroll, new Dictionary<string, string?>(), Ui, "root");

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private async Task OnChange(BxChangeEventArgs e)
    {
        // The browser asks again when its view of the state is older than ours (a slow round trip): one load at a time.
        if (_busy || Loading || !HasMore) return;
        _busy = true;
        StateHasChanged();
        try
        {
            await OnLoadMore.InvokeAsync();
        }
        finally
        {
            _busy = false;
            // Rendered with the end of every callback: it is how the browser learns a load is over when Loading was never set.
            _loads++;
        }
    }
}
