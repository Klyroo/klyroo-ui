@namespace Lux.UI
@inherits LxComponentBase

@*
    <lx-modal> shows the native modal dialog: top layer, inert page, focus kept inside, Escape.
    Elements with data-lx-close (the close button, or any of yours) close it without a round trip.
*@
<lx-modal data-lx-seq="@(OpenChanged.HasDelegate ? _sequence : null)"
          open="@Open"
          dismissible="@Dismissible"
          @onbxtoggle="ToggleHandler"
          @onbxtoggle:stopPropagation="true">
    @if (ChildContent is not null)
    {
        <span data-slot="trigger">@ChildContent</span>
    }
    <dialog id="@_id" class="@_slots["content"]" data-slot="content"
            aria-labelledby="@(Title is null ? null : _id + "-title")"
            aria-describedby="@(Description is null ? null : _id + "-description")"
            aria-label="@(Title is null ? AriaLabel : null)"
            @attributes="AdditionalAttributes">
        @if (Title is not null || Description is not null || Close)
        {
            <div class="@_slots["header"]" data-slot="header">
                <div class="@_slots["wrapper"]">
                    @if (Title is not null)
                    {
                        <h2 id="@(_id + "-title")" class="@_slots["title"]">@Title</h2>
                    }
                    @if (Description is not null)
                    {
                        <p id="@(_id + "-description")" class="@_slots["description"]">@Description</p>
                    }
                </div>
                @if (Close)
                {
                    <button type="button" class="@_slots["close"]" aria-label="@Messages.Close" data-lx-close>@RenderIcon(Options.Icons.Close, "size-5")</button>
                }
            </div>
        }
        @if (Body is not null)
        {
            <div class="@_slots["body"]" data-slot="body">@Body</div>
        }
        @if (Footer is not null)
        {
            <div class="@_slots["footer"]" data-slot="footer">@Footer</div>
        }
    </dialog>
</lx-modal>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;
    private int _sequence;

    /// <summary>The trigger: its first button opens the modal.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }

    /// <summary>Accessible name when there is no <see cref="Title"/>.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }

    /// <summary>Footer actions. Add <c>data-lx-close</c> to a button to make it close the modal.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Open state. Use <c>@bind-Open</c>: the browser closes the modal on its own (Escape, close button).</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Escape and a click on the backdrop close the modal.</summary>
    [Parameter] public bool Dismissible { get; set; } = true;

    /// <summary>Shows the close button in the header.</summary>
    [Parameter] public bool Close { get; set; } = true;
    [Parameter] public LxSize Size { get; set; } = LxSize.Md;
    [Parameter] public ModalUi? Ui { get; set; }

    private EventCallback<LxToggleEventArgs> ToggleHandler =>
        OpenChanged.HasDelegate ? EventCallback.Factory.Create<LxToggleEventArgs>(this, OnToggle) : default;

    protected override void OnParametersSet()
    {
        _id ??= NewId("modal");
        _slots = ResolveSlots(Options.Modal, new Dictionary<string, string?> { ["size"] = VariantValue.Of(Size) }, Ui, "content");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(LxToggleEventArgs))]
    private async Task OnToggle(LxToggleEventArgs e)
    {
        _sequence = e.Sequence;
        if (e.Open == Open) return;
        Open = e.Open;
        await OpenChanged.InvokeAsync(e.Open);
    }
}
