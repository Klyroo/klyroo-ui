@namespace Lux.UI
@inherits BxComponentBase
@implements IDisposable

<div class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Label is not null || Hint is not null)
    {
        <div class="@_slots["labelWrapper"]">
            @if (Label is not null)
            {
                <label id="@LabelId" for="@InputId" class="@_slots["label"]">@Label</label>
            }
            @if (Hint is not null)
            {
                <span id="@HintId" class="@_slots["hint"]">@Hint</span>
            }
        </div>
    }
    @if (Description is not null)
    {
        <p id="@DescriptionId" class="@_slots["description"]">@Description</p>
    }
    <div class="@_slots["container"]">
        <CascadingValue Value="_context">@ChildContent</CascadingValue>
    </div>
    @if (ErrorText is not null)
    {
        <p id="@ErrorId" class="@_slots["error"]" data-slot="error">@ErrorText</p>
    }
    else if (Help is not null)
    {
        <p id="@HelpId" class="@_slots["help"]">@Help</p>
    }
</div>

@code {
    private SlotSet _slots = default!;
    private FormFieldContext _context = default!;
    private string? _generatedId;
    private EditContext? _subscribed;

    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public string? Label { get; set; }

    /// <summary>Short text next to the label, such as "Optional".</summary>
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Help { get; set; }

    /// <summary>Error text. Without it, the first validation message of <see cref="For"/> is shown.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>The bound field, for validation messages inside an <c>EditForm</c>.</summary>
    [Parameter] public System.Linq.Expressions.Expression<Func<object?>>? For { get; set; }
    [Parameter] public bool Required { get; set; }

    /// <summary>Id of the control inside. Defaults to a generated one.</summary>
    [Parameter] public string? Id { get; set; }
    [Parameter] public BxSize Size { get => _sizeParameter ?? DefaultSize(BxSize.Md); set => _sizeParameter = value; }
    private BxSize? _sizeParameter;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public FormFieldUi? Ui { get; set; }

    private string InputId => Id ?? (_generatedId ??= NewId("field"));
    private string LabelId => InputId + "-label";
    private string? HintId => Hint is null ? null : InputId + "-hint";
    private string? DescriptionId => Description is null ? null : InputId + "-description";
    private string ErrorId => InputId + "-error";
    private string? HelpId => Help is null ? null : InputId + "-help";

    private string? ErrorText => Error ?? (For is not null && EditContext is not null
        ? EditContext.GetValidationMessages(FieldIdentifier.Create(For)).FirstOrDefault()
        : null);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, EditContext))
        {
            if (_subscribed is not null) _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
            _subscribed = EditContext;
            if (_subscribed is not null) _subscribed.OnValidationStateChanged += OnValidationStateChanged;
        }

        _slots = ResolveSlots(Options.FormField, new Dictionary<string, string?>
        {
            ["size"] = VariantValue.Of(Size),
            ["required"] = VariantValue.Of(Required),
        }, Ui, "root");

        var error = ErrorText;
        _context = new FormFieldContext
        {
            InputId = InputId,
            LabelId = Label is null ? null : LabelId,
            DescribedBy = FormFieldContext.Join(DescriptionId, HintId, error is null ? HelpId : ErrorId),
            Invalid = error is not null,
            Required = Required,
            Size = Size,
        };
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        OnParametersSet();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
    }
}
