<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same version as the library: both import build/Version.props. -->
  <Import Project="..\..\build\Version.props" />

  <!-- The local MCP server of Blux UI, as a dotnet tool: dotnet tool install -g Blux.UI.Mcp, then blux-ui-mcp.
       It speaks MCP over stdio and carries the docs bundle of the Blux.UI version it was built with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.Mcp.Tool</RootNamespace>
    <AssemblyName>Blux.UI.Mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blux-ui-mcp</ToolCommandName>
    <PackageId>Blux.UI.Mcp</PackageId>
    <Description>MCP server for Blux UI: component search, API, examples and guides for AI coding agents, over stdio.</Description>
    <PackageTags>blazor;ui;mcp;model-context-protocol;ai;tailwind</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>blux-ui contributors</Authors>
    <Copyright>Copyright (c) 2026 blux-ui contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- A tool needs the runtime it was built for; a newer major one is fine. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blux.UI.Mcp.Core\Blux.UI.Mcp.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
