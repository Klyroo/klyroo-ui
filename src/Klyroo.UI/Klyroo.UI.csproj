<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- VersionPrefix and VersionSuffix live in build/Version.props, shared with the dotnet tool. -->
  <Import Project="..\..\build\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.UI</RootNamespace>
    <PackageId>Klyroo.UI</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Accessible, themable Blazor components styled with Tailwind CSS v4.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>klyroo;blazor;components;ui;tailwind;maui</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- BL0007: Color and Size have a getter that falls back to KlyrooOptions.Defaults, which an auto property cannot do. -->
    <NoWarn>$(NoWarn);BL0007</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- Package metadata. -->
  <PropertyGroup>
    <Authors>Klyroo Contributors</Authors>
    <Company>Klyroo</Company>
    <Copyright>Copyright (c) 2026 Klyroo Contributors</Copyright>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md, included in this package.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/klyroo/klyroo-ui</RepositoryUrl>
    <PackageProjectUrl>https://github.com/klyroo/klyroo-ui</PackageProjectUrl>
  </PropertyGroup>

  <!-- Reproducible build and debugging experience. SourceLink for GitHub is built into the .NET SDK (8+): no package reference. -->
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Only once RepositoryUrl is set: otherwise the pack would fill it from the git origin (in CI, the checkout's URL). -->
    <PublishRepositoryUrl Condition="'$(RepositoryUrl)' != ''">true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="TailwindMerge.NET" />
  </ItemGroup>

  <!-- The name parser and the SVG reader are shared with the build task, so the library and the task read an icon name the same way. -->
  <ItemGroup>
    <Compile Include="..\Klyroo.UI.Build.Tasks\Icons\IconNames.cs;..\Klyroo.UI.Build.Tasks\Icons\IconCollections.g.cs;..\Klyroo.UI.Build.Tasks\Icons\SvgImport.cs;..\Klyroo.UI.Build.Tasks\Icons\SvgSanitizer.cs" LinkBase="Internal\Icons" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Klyroo.UI.Tests" />
    <InternalsVisibleTo Include="Klyroo.UI.ClassExtractor" />
    <InternalsVisibleTo Include="Klyroo.UI.DocsBundle" />
    <InternalsVisibleTo Include="Klyroo.Stack.DocsBundle" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Klyroo.UI.targets;buildTransitive/Klyroo.UI.Tasks.targets;buildTransitive/Klyroo.UI.Fonts.targets;buildTransitive/Klyroo.UI.Icons.targets;buildTransitive/Klyroo.UI.Tailwind.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <!--
    The MSBuild task assembly (self-hosted fonts and the build features to come): built first, then shipped next to the targets
    that load it. It is never referenced by the app, so it adds no dependency.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Klyroo.UI.Build.Tasks\Klyroo.UI.Build.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Klyroo.UI.Build.Tasks\bin\$(Configuration)\netstandard2.0\Klyroo.UI.Build.Tasks.dll" Pack="true" PackagePath="build/tasks/;buildTransitive/tasks/" Visible="false" />
  </ItemGroup>

  <!-- Sources of the generated assets: not shipped as content. -->
  <ItemGroup>
    <Content Remove="js/**;styles/**" />
    <None Include="js/**;styles/**" Pack="false" />
  </ItemGroup>

</Project>
