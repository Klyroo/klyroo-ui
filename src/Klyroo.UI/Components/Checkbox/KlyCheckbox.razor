@namespace Klyroo.UI
@inherits KlyFieldBase<bool>

<div class="@_slots["root"]" data-color="@Color.Value" data-disabled="@(Disabled ? "" : null)">
    <div class="@_slots["container"]">
        @if (UseEditContext)
        {
            <InputCheckbox Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" @attributes="Attributes()" />
        }
        else if (ValueChanged.HasDelegate)
        {
            <input type="checkbox" name="@Name" value="true" @bind:get="Value" @bind:set="OnChange" @attributes="Attributes()" />
        }
        else
        {
            <input type="checkbox" name="@Name" value="true" checked="@Value" @attributes="Attributes()" />
        }
        @RenderIcon(Options.Icons.Check, _slots["icon"])
        @if (Indeterminate)
        {
            @RenderIcon(Options.Icons.Minus, _slots["indeterminateIcon"])
        }
    </div>
    @if (Label is not null || Description is not null)
    {
        <div class="@_slots["wrapper"]">
            @if (Label is not null)
            {
                <label for="@ControlId" class="@_slots["label"]">@Label</label>
            }
            @if (Description is not null)
            {
                <p id="@DescriptionId" class="@_slots["description"]">@Description</p>
            }
        </div>
    }
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>Text next to the checkbox. A <see cref="KlyFormField"/> label also names it.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Text under the label of the checkbox.</summary>
    [Parameter] public string? Description { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the checkbox, see <see cref="CheckboxUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public CheckboxUi? Ui { get; set; }

    /// <summary>
    /// Shows the mixed state (a minus), for a "select all" box when only some items are selected. <c>indeterminate</c> is a
    /// DOM property that HTML cannot render, so the component renders <c>data-indeterminate</c> and the browser script of
    /// Klyroo sets the property (also in static rendering, and again after an enhanced navigation). The user's click clears
    /// the mixed state and toggles the box, as in any browser. The parameter is controlled: the parent decides what the
    /// box shows next, normally by setting it to <c>false</c> in its <c>ValueChanged</c> handler. While it stays <c>true</c>,
    /// every render of the parent puts the mixed state back. Static rendering has no .NET to render again, so a click there
    /// clears it until the page is rendered by the server again.
    /// </summary>
    [Parameter] public bool Indeterminate { get; set; }

    // Changes on every render while Indeterminate is true: a render that leaves the attribute as it was would not touch
    // the DOM, and the property the click cleared would not come back.
    private int _indeterminateVersion;

    private string? DescriptionId => Description is null ? null : ControlId + "-description";

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Indeterminate) _indeterminateVersion++;
        _slots = ResolveSlots(Options.Checkbox, new Dictionary<string, string?> { ["size"] = VariantValue.Of(EffectiveSize) }, Ui, "root");
    }

    private Task OnChange(bool value)
    {
        if (Indeterminate) _indeterminateVersion++;
        return SetValue(value);
    }

    private Dictionary<string, object> Attributes()
    {
        var attributes = ControlAttributes(_slots["base"], DescriptionId);
        if (Indeterminate) attributes["data-indeterminate"] = _indeterminateVersion.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return attributes;
    }
}
