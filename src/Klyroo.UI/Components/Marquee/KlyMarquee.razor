@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    Pure CSS: works in every render mode and needs no script. The content is rendered once for readers and repeated
    for the loop; the copies are aria-hidden and inert. The animation pauses on hover and focus and stops entirely
    under prefers-reduced-motion (the copies are then hidden and the content scrolls by hand).
*@
<div data-kly-marquee
     data-orientation="@_orientation"
     data-reverse="@(Reverse ? "true" : null)"
     data-pause-on-hover="@(PauseOnHover ? "true" : null)"
     data-overlay="@(Overlay ? "true" : null)"
     style="@($"--kly-marquee-duration: {Duration.ToString(System.Globalization.CultureInfo.InvariantCulture)}s")"
     class="@_slots["root"]"
     @attributes="AdditionalAttributes">
    <div data-kly-marquee-group class="@_slots["group"]">@ChildContent</div>
    @for (var copy = 0; copy < Repeat; copy++)
    {
        <div data-kly-marquee-group aria-hidden="true" inert class="@_slots["group"]">@ChildContent</div>
    }
</div>

@code {
    private SlotSet _slots = default!;
    private string _orientation = "horizontal";

    /// <summary>The items to scroll. Avoid ids and focusable elements: the content is repeated.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public KlyOrientation Orientation { get; set; } = KlyOrientation.Horizontal;

    /// <summary>Scrolls the other way.</summary>
    [Parameter] public bool Reverse { get; set; }

    /// <summary>Pauses while hovered or while something inside has focus.</summary>
    [Parameter] public bool PauseOnHover { get; set; } = true;

    /// <summary>Fades the edges. Vertical marquees need a height from their parent.</summary>
    [Parameter] public bool Overlay { get; set; } = true;

    /// <summary>Seconds for one full loop.</summary>
    [Parameter] public double Duration { get; set; } = 30;

    /// <summary>Number of aria-hidden copies of the content. One is enough unless the content is narrower than the container.</summary>
    [Parameter] public int Repeat { get; set; } = 1;
    [Parameter] public MarqueeUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _orientation = Orientation == KlyOrientation.Vertical ? "vertical" : "horizontal";
        _slots = ResolveSlots(Options.Marquee, new Dictionary<string, string?> { ["orientation"] = _orientation }, Ui, "root");
    }
}
