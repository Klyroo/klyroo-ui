@namespace Klyroo.UI
@inherits KlyComponentBase

<kbd data-color="@Color.Value" class="@_slots["base"]" @attributes="AdditionalAttributes">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Value)))</kbd>

@code {
    private SlotSet _slots = default!;

    /// <summary>The key to show, "Ctrl" or "K" for example. <see cref="ChildContent"/> wins when both are set.</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>The key, when <c>Value</c> is not enough.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Semantic color of the kbd: a built-in <see cref="KlyColor"/> or the name of a color you defined.</summary>
    [Parameter] public KlyColor Color { get; set; } = KlyColor.Neutral;
    /// <summary>Look of the key cap: <c>Solid</c>, <c>Outline</c>, <c>Soft</c> or <c>Subtle</c>.</summary>
    [Parameter] public KlyVariant Variant { get; set; } = KlyVariant.Outline;
    /// <summary>Size of the kbd, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;
    /// <summary>
    /// Per-instance class overrides of the slots of the kbd, see <see cref="KbdUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public KbdUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Kbd, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(Size),
        }, Ui, "base");
}
