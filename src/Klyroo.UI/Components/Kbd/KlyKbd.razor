@namespace Klyroo.UI
@inherits KlyComponentBase

<kbd data-color="@Color.Value" class="@_slots["base"]" @attributes="AdditionalAttributes">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Value)))</kbd>

@code {
    private SlotSet _slots = default!;

    /// <summary>The key to show, "Ctrl" or "K" for example. <see cref="ChildContent"/> wins when both are set.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public KlyColor Color { get; set; } = KlyColor.Neutral;
    [Parameter] public KlyVariant Variant { get; set; } = KlyVariant.Outline;
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;
    [Parameter] public KbdUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Kbd, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(Size),
        }, Ui, "base");
}
