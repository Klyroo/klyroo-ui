@namespace Klyroo.UI
@inherits KlyComponentBase

<span data-color="@Color.Value" class="@_slots["base"]" @attributes="AdditionalAttributes">
    @if (LeadingIcon is not null)
    {
        <span class="@_slots["leadingIcon"]" aria-hidden="true">@LeadingIcon</span>
    }
    @if (ChildContent is not null || Label is not null)
    {
        <span class="@_slots["label"]">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Label)))</span>
    }
    @if (TrailingIcon is not null)
    {
        <span class="@_slots["trailingIcon"]" aria-hidden="true">@TrailingIcon</span>
    }
</span>

@code {
    private SlotSet _slots = default!;

    /// <summary>Text of the badge. Use <c>ChildContent</c> for markup.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Content of the badge.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>
    /// Semantic color of the badge: a built-in <see cref="KlyColor"/> or the name of a color you defined. When not set, <see cref="KlyDefaults.Color"/> applies, else the default of the component.
    /// </summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;
    /// <summary>Look of the badge: <c>Solid</c>, <c>Outline</c>, <c>Soft</c> or <c>Subtle</c>.</summary>
    [Parameter] public KlyVariant Variant { get; set; } = KlyVariant.Solid;
    /// <summary>Size of the badge, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;
    /// <summary>Icon shown before the label, as markup such as a <see cref="KlyIcon"/>.</summary>
    [Parameter] public RenderFragment? LeadingIcon { get; set; }
    /// <summary>Icon shown after the label, as markup such as a <see cref="KlyIcon"/>.</summary>
    [Parameter] public RenderFragment? TrailingIcon { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the badge, see <see cref="BadgeUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public BadgeUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Badge, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(Size),
        }, Ui, "base");
}
