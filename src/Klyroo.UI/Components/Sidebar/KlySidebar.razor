@namespace Klyroo.UI
@inherits KlyComponentBase
@inject NavigationManager Navigation

@*
    An app sidebar. From the lg breakpoint up it is a column that can collapse to icons and, if asked, be resized; the
    browser owns both states (the <kly-sidebar> element in js/layout.js), keeps them in cookies named after Id, and tells
    .NET about the collapsed state only when CollapsedChanged is bound.
    Below lg the same aside is the off-canvas panel: it is a popover (popover="auto"), so it is hidden until a button with
    popovertarget opens it (the one rendered here, or KlyDashboardSidebarToggle, which js/layout.js points at it). It slides in
    from the start edge over a backdrop and shows a title and a close button that exist only below lg. Opening needs no
    round trip, so it works in static rendering. The element makes the panel modal while it is open (the page behind is
    inert, Tab stays inside, Escape and a click on the backdrop close it, the focus goes back to the button) and closes it
    when the screen grows past lg. The content exists once: ids, form fields and stateful components are not duplicated.
*@
<kly-sidebar data-kly-seq="@(CollapsedChanged.HasDelegate ? _sequence : null)"
            class="@_slots["host"]"
            style="--kly-sidebar-width:@(Width)px"
            collapsed="@Collapsed"
            resizable="@Resizable"
            data-kly-sidebar-id="@Id"
            data-kly-min-width="@MinWidth"
            data-kly-max-width="@MaxWidth"
            data-kly-width="@Width"
            @onklytoggle="ToggleHandler"
            @onklytoggle:stopPropagation="true">
    @Root
    @if (MobileTrigger)
    {
        <div class="@_slots["mobile"]">
            <KlyButton Square Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" LeadingIcon="@(RenderIcon(Options.Icons.Menu, "size-5"))"
                      aria-label="@Messages.OpenSidebar" aria-haspopup="dialog" popovertarget="@_id" data-kly-sidebar-open="" />
        </div>
    }
</kly-sidebar>
@if (Id is not null && !CollapsedChanged.HasDelegate && !IsHybrid)
{
    @* Runs while the page is parsed, before the first paint: applies the remembered state so a reload does not shift.
       The element does the same later (and alone in interactive renders, where inserted scripts never run, and in a
       Blazor Hybrid web view, where the state lives in localStorage and there is no parsing to run ahead of). *@
    @((MarkupString)$"<script{NonceAttribute}>{FirstPaintScript(KlyPathScope.SidebarCookiePrefix(KlyPathScope.PathBaseOf(Navigation.BaseUri)))}</script>")
}

@code {
    private SlotSet _slots = default!;
    private string? _id;
    private string? _generatedId;
    private string _tag = "aside";
    private int _sequence;

    /// <summary>The scrollable middle: navigation, search. It is rendered once and serves both the column and the off-canvas panel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Top of the sidebar: a logo and a title. Hidden while the sidebar is collapsed, next to the collapse button.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Bottom of the sidebar: the signed-in user, settings.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Name under which the collapsed state and the width are remembered, in the cookies <c>klyroo-sidebar-{id}</c>
    /// ("1" when collapsed) and <c>klyroo-sidebar-{id}-width</c>, written by the browser. Without an id nothing is
    /// remembered. An app served below a path base (<c>UsePathBase("/x")</c>) shares its origin with other apps, so its cookies are
    /// scoped to the base path and named <c>klyroo-sidebar.{slug}~~{id}</c> (see <see cref="KlyPathScope.SidebarCookieName"/>): a server
    /// keeps the last of two cookies of the same name, and another app's would otherwise win. At the root nothing changes. With a bound <see cref="Collapsed"/> the collapsed state is not restored: your state wins.
    /// A small inline script placed right after the sidebar applies the remembered state while the page is parsed,
    /// before the first paint, so a reload neither shifts nor animates (give it <see cref="ScriptNonce"/> under a strict
    /// Content-Security-Policy). Reading the cookies on the server and passing <see cref="Collapsed"/> also works: get the cookie name from
    /// <see cref="KlyPathScope.SidebarCookieName"/> with <c>Request.PathBase</c>, so the same code is right at the root and below a path base.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Nonce for the small inline script that applies the remembered state before the first paint, when a
    /// Content-Security-Policy forbids inline scripts without one.</summary>
    [Parameter] public string? ScriptNonce { get; set; }

    private string NonceAttribute => ScriptNonce is null ? "" : $" nonce=\"{System.Net.WebUtility.HtmlEncode(ScriptNonce)}\"";

    // Same cookie format and names as js/layout.js: {prefix}{encoded id} = "1" when collapsed, and {name}-width in pixels. The prefix depends on the path base.
    private static string FirstPaintScript(string prefix) =>
        "(function(){try{var h=document.currentScript.previousElementSibling;if(!h||h.localName!=='kly-sidebar')return;" +
        "var k='" + prefix + "'+encodeURIComponent(h.getAttribute('data-kly-sidebar-id'));" +
        "var g=function(n){var p=document.cookie.split('; ');for(var i=0;i<p.length;i++){var j=p[i].indexOf('=');" +
        "if(j>0&&p[i].slice(0,j)===n)return decodeURIComponent(p[i].slice(j+1));}return null;};" +
        "var c=g(k),a=h.querySelector(':scope>[data-slot=root]');" +
        "if(c!==null&&a&&matchMedia('(min-width: 64rem)').matches){a.setAttribute('data-state',c==='1'?'collapsed':'expanded');" +
        "a.querySelectorAll('[data-kly-sidebar-toggle]').forEach(function(b){b.setAttribute('aria-pressed',c==='1'?'true':'false');});}" +
        "if(h.hasAttribute('resizable')){var w=Number(g(k+'-width'));if(w>0)h.style.setProperty('--kly-sidebar-width',w+'px');}" +
        "}catch(e){}})();";

    /// <summary>Shows the button that collapses the sidebar to icons.</summary>
    [Parameter] public bool Collapsible { get; set; } = true;

    /// <summary>
    /// The collapsed state when nothing is remembered. Use <c>@bind-Collapsed</c> to follow and set it from .NET;
    /// the browser still toggles it without a round trip, and in static rendering a bound state is not reported.
    /// </summary>
    [Parameter] public bool Collapsed { get; set; }
    /// <summary>Raised with the new state when the sidebar collapses to icons or expands.</summary>
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>Adds a handle on the edge to resize the sidebar with the mouse or the arrow keys, Home and End.</summary>
    [Parameter] public bool Resizable { get; set; }

    /// <summary>Width in pixels when expanded and not resized yet.</summary>
    [Parameter] public int Width { get; set; } = 256;
    /// <summary>Smallest width the user can resize the sidebar to, in pixels. Defaults to 192.</summary>
    [Parameter] public int MinWidth { get; set; } = 192;
    /// <summary>Largest width the user can resize the sidebar to, in pixels. Defaults to 448.</summary>
    [Parameter] public int MaxWidth { get; set; } = 448;

    /// <summary>
    /// The element to render, "aside" by default. A complementary landmark must not sit inside another landmark:
    /// use "div" when the sidebar is placed inside a main element.
    /// </summary>
    [Parameter] public string As { get; set; } = "aside";

    /// <summary>Accessible name of the sidebar landmark. Defaults to the built-in text.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Shows the button that opens the off-canvas panel. Turn it off when another button opens the panel instead, such as
    /// <see cref="KlyDashboardSidebarToggle"/>, which finds the sidebar by itself.
    /// </summary>
    [Parameter] public bool MobileTrigger { get; set; } = true;

    /// <summary>Title of the mobile panel. Defaults to the built-in text.</summary>
    [Parameter] public string? MobileTitle { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the sidebar, see <see cref="SidebarUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public SidebarUi? Ui { get; set; }

    private EventCallback<KlyToggleEventArgs> ToggleHandler =>
        CollapsedChanged.HasDelegate ? EventCallback.Factory.Create<KlyToggleEventArgs>(this, OnToggle) : default;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // The panel's id: the popover buttons name it, so it is rendered. It follows the storage Id when there is one, which lets KlyDashboardSidebarToggle
        // name the panel from the server too. (An "id" attribute is the storage Id of the sidebar, never the element's.)
        _id = Id is { Length: > 0 } ? PanelId(Id) : _generatedId ??= NewId("sidebar");
        _tag = string.IsNullOrWhiteSpace(As) ? "aside" : As.Trim().ToLowerInvariant();
        _slots = ResolveSlots(Options.Sidebar, new Dictionary<string, string?>(), Ui, "root");
    }

    // The event reports whether the sidebar is expanded ("open"), like every other toggle.
    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(KlyToggleEventArgs))]
    private async Task OnToggle(KlyToggleEventArgs e)
    {
        _sequence = e.Sequence;
        var collapsed = !e.Open;
        if (collapsed == Collapsed) return;
        Collapsed = collapsed;
        await CollapsedChanged.InvokeAsync(collapsed);
    }

    private RenderFragment Root => builder =>
    {
        builder.OpenElement(0, _tag);
        builder.AddAttribute(1, "class", _slots["root"]);
        builder.AddAttribute(2, "data-slot", "root");
        builder.AddAttribute(3, "data-state", Collapsed ? "collapsed" : "expanded");
        builder.AddAttribute(4, "id", _id);
        builder.AddAttribute(5, "popover", "auto");
        if (_tag is "aside" or "nav")
        {
            builder.AddAttribute(6, "aria-label", AriaLabel ?? Messages.SidebarLabel);
        }
        builder.AddMultipleAttributes(7, AdditionalAttributes);
        builder.AddContent(8, Panel);
        builder.CloseElement();
    };

    /// <summary>The id of the panel of the sidebar with this storage id: what <see cref="KlyDashboardSidebarToggle"/> points its <c>popovertarget</c> at.</summary>
    internal static string PanelId(string storageId) =>
        "kly-sidebar-" + System.Text.RegularExpressions.Regex.Replace(storageId.Trim(), "[^A-Za-z0-9_-]", "-");

    // The panel element carries the dialog semantics while the off-canvas panel is open (set by js/layout.js): an aside may not be a dialog, so it is not the aside.
    private RenderFragment Panel =>
        @<text>
          <div class="@_slots["panel"]" data-slot="panel">
            <div class="@_slots["mobileHeader"]" data-slot="mobile-header">
                <h2 id="@(_id + "-title")" class="@_slots["mobileTitle"]">@(MobileTitle ?? Messages.SidebarLabel)</h2>
                <button type="button" class="@_slots["mobileClose"]" aria-label="@Messages.Close" popovertarget="@_id" popovertargetaction="hide">
                    @RenderIcon(Options.Icons.Close, "size-5")
                </button>
            </div>
            @if (Header is not null || Collapsible)
            {
                <div class="@_slots["header"]" data-slot="header">
                    @if (Header is not null)
                    {
                        <div class="@_slots["headerContent"]">@Header</div>
                    }
                    @if (Collapsible)
                    {
                        <button type="button" class="@_slots["toggle"]" aria-label="@Messages.CollapseSidebar"
                                aria-pressed="@(Collapsed ? "true" : "false")" data-kly-sidebar-toggle>
                            @RenderIcon(Options.Icons.ChevronLeft, _slots["toggleIcon"])
                        </button>
                    }
                </div>
            }
            <div class="@_slots["content"]" data-slot="content">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="@_slots["footer"]" data-slot="footer">@Footer</div>
            }
          </div>
            @if (Resizable)
            {
                <div role="separator" tabindex="0" aria-orientation="vertical" aria-label="@Messages.ResizeSidebar"
                     aria-valuemin="@MinWidth" aria-valuemax="@MaxWidth" aria-valuenow="@Width"
                     class="@_slots["handle"]" data-slot="handle"></div>
            }
        </text>;
}
