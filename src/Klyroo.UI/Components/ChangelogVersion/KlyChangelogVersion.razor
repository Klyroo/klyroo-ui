@namespace Klyroo.UI
@using Klyroo.UI.Internal
@inherits KlyComponentBase

<article data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Indicator)
    {
        <span class="@_slots["indicator"]" data-slot="indicator" aria-hidden="true"></span>
    }
    <div class="@_slots["container"]" data-slot="container">
        <div class="@_slots["header"]" data-slot="header">
            @if (Date is not null || Badge is not null)
            {
                <div class="@_slots["meta"]">
                    @if (Date is { } date)
                    {
                        <time datetime="@KlyDates.Iso(date)" class="@_slots["date"]">@KlyDates.Format(date, DateFormat, Culture ?? FormatCulture)</time>
                    }
                    @if (Badge is not null)
                    {
                        <KlyBadge Label="@Badge" Color="@BadgeColor" Variant="KlyVariant.Subtle" Size="KlySize.Sm" Class="@_slots["badge"]" />
                    }
                </div>
            }
            @if (Title is not null)
            {
                <Heading Level="HeadingLevel" Class="@_slots["title"]">
                    @if (Href is not null)
                    {
                        <a href="@Href" target="@Target" rel="@(Target == "_blank" ? "noopener noreferrer" : null)" data-slot="link" class="@_slots["link"]">@Title@if (Target == "_blank") {<span class="sr-only"> @Messages.OpensInNewTab</span>}</a>
                    }
                    else
                    {
                        @Title
                    }
                </Heading>
            }
            @if (Description is not null)
            {
                <p class="@_slots["description"]" data-slot="description">@Description</p>
            }
        </div>
        @if (Image is not null)
        {
            <div class="@_slots["image"]" data-slot="image">
                <KlyImage Src="@Image" Alt="@(ImageAlt ?? "")" ImageOptions="ImageOptions" Class="@_slots["imageElement"]" />
            </div>
        }
        @if (ChildContent is not null)
        {
            <div class="@_slots["body"]" data-slot="body">@ChildContent</div>
        }
        @if (Authors.Count > 0)
        {
            <div class="@_slots["authors"]" data-slot="authors">
                @foreach (var author in Authors)
                {
                    <KlyUser Name="@author.Name" Description="@author.Description" AvatarSrc="@author.AvatarSrc" Href="@author.Href" Size="KlySize.Sm" />
                }
            </div>
        }
        @if (Actions is not null)
        {
            <div class="@_slots["actions"]" data-slot="actions">@Actions</div>
        }
        @if (Footer is not null)
        {
            <div class="@_slots["footer"]" data-slot="footer">@Footer</div>
        }
    </div>
</article>

@code {
    private SlotSet _slots = default!;

    /// <summary>Version number or release name.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Level of the title heading: 3 by default, for versions under a level 2 heading.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;
    /// <summary>Text of the version, shown under its title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Release date, shown in the format culture of the locale in effect (the regional current culture when it has the same language), or in <see cref="Culture"/> in a <c>time</c> element.</summary>
    [Parameter] public DateTimeOffset? Date { get; set; }

    /// <inheritdoc cref="KlyBlogPost.DateFormat"/>
    [Parameter] public string? DateFormat { get; set; }

    /// <summary>
    /// The culture of the date. By default the format culture of the locale in effect (the regional current culture when it has the same language), so the prerender and a
    /// WebAssembly render agree as long as they pick the same locale.
    /// </summary>
    [Parameter] public System.Globalization.CultureInfo? Culture { get; set; }
    /// <summary>Text of a badge next to the title, such as "Latest".</summary>
    [Parameter] public string? Badge { get; set; }
    /// <summary>Semantic color of the badge.</summary>
    [Parameter] public KlyColor BadgeColor { get => _badgeColor ?? DefaultColor(KlyColor.Primary); set => _badgeColor = value; }
    private KlyColor? _badgeColor;
    /// <summary>Address of an image shown under the description.</summary>
    [Parameter] public string? Image { get; set; }
    /// <summary>Alternative text of the image. Leave it empty when the image is decorative.</summary>
    [Parameter] public string? ImageAlt { get; set; }

    /// <inheritdoc cref="KlyBlogPost.ImageOptions"/>
    [Parameter] public KlyImageOptions? ImageOptions { get; set; }
    /// <summary>The people behind the version, as <see cref="KlyPostAuthor"/> items.</summary>
    [Parameter] public IReadOnlyList<KlyPostAuthor> Authors { get; set; } = [];

    /// <summary>Links the title. Unlike a blog post the card is not stretched, so the rich content keeps its own links.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>The <c>target</c> attribute of the link of the version, such as <c>_blank</c>. It applies when <c>Href</c> is set.</summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>Shows the dot and the line that join the versions of a <see cref="KlyChangelogVersions"/>.</summary>
    [Parameter] public bool Indicator { get; set; } = true;
    /// <summary>
    /// Semantic color of the changelog version: a built-in <see cref="KlyColor"/> or the name of a color you defined. When not set, <see cref="KlyDefaults.Color"/> applies, else the default of the component.
    /// </summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;

    /// <summary>Rich description: paragraphs, lists, links.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Buttons or links shown under the content of the version.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
    /// <summary>Content shown at the bottom of the version.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the changelog version, see <see cref="ChangelogVersionUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public ChangelogVersionUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.ChangelogVersion, new Dictionary<string, string?>
        {
            ["indicator"] = VariantValue.Of(Indicator),
        }, Ui, "root");
}
