@namespace Klyroo.UI
@using Klyroo.UI.Internal
@inherits KlyComponentBase

@* A menu button on <kly-popover>: arrow keys, Home, End and typeahead move between items; Escape and Tab close it.
   An item with Children opens a submenu: a sibling popover of the menu (not a child of its role="menu", which only owns items), opened by the item as its invoker. *@
<kly-popover data-kly-seq="@(OpenChanged.HasDelegate ? _sequence : null)"
            open="@Open"
            placement="@Wire.Of(Placement)"
            offset="4"
            @onklytoggle="ToggleHandler"
            @onklytoggle:stopPropagation="true">
    <span data-slot="trigger">@ChildContent</span>
    <div popover="auto" role="menu" class="@_slots["content"]" data-slot="content" @attributes="AdditionalAttributes">
        @Entries(Items, "")
    </div>
    @foreach (var (path, item) in Submenus(Items, ""))
    {
        <div popover="auto" role="menu" id="@SubmenuId(path)" aria-labelledby="@TriggerId(path)" class="@_slots["content"]" data-slot="submenu">
            @Entries(item.Children!, path)
        </div>
    }
</kly-popover>

@code {
    private SlotSet _slots = default!;
    private int _sequence;
    private readonly string _id = NewId("menu");

    /// <summary>The trigger; it must contain a button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The entries. An item with <see cref="KlyMenuItem.Children"/> opens a submenu; a heading followed by items and a separator makes a labelled group.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyMenuItem> Items { get; set; } = [];

    /// <summary>Called with the activated item. Link items navigate instead, and items with children open their submenu.</summary>
    [Parameter] public EventCallback<KlyMenuItem> OnSelect { get; set; }
    /// <summary>Whether the menu is open. Bind it with <c>@bind-Open</c> when .NET needs the state.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>Raised with the new state when the menu opens or closes.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    /// <summary>Where the menu sits against the trigger. Defaults to <see cref="KlyPlacement.BottomStart"/>.</summary>
    [Parameter] public KlyPlacement Placement { get; set; } = KlyPlacement.BottomStart;
    /// <summary>
    /// Per-instance class overrides of the slots of the dropdown menu, see <see cref="DropdownMenuUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public DropdownMenuUi? Ui { get; set; }

    private EventCallback<KlyToggleEventArgs> ToggleHandler =>
        OpenChanged.HasDelegate ? EventCallback.Factory.Create<KlyToggleEventArgs>(this, OnToggle) : default;

    /// <inheritdoc />
    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.DropdownMenu, new Dictionary<string, string?>(), Ui, "content");

    private string SubmenuId(string path) => $"{_id}-s{path}";
    private string TriggerId(string path) => $"{_id}-t{path}";

    private static bool HasChildren(KlyMenuItem item) => item.Kind == KlyMenuItemKind.Item && item.Children is { Count: > 0 };

    /// <summary>Every item with children, at any depth, with the path of its indexes ("2", "2-0"): each one owns a submenu element.</summary>
    private static IEnumerable<(string Path, KlyMenuItem Item)> Submenus(IReadOnlyList<KlyMenuItem> items, string parent)
    {
        for (var i = 0; i < items.Count; i++)
        {
            if (!HasChildren(items[i]) || items[i].Disabled) continue;
            var path = parent.Length == 0 ? i.ToString() : $"{parent}-{i}";
            yield return (path, items[i]);
            foreach (var nested in Submenus(items[i].Children!, path)) yield return nested;
        }
    }

    private RenderFragment Entries(IReadOnlyList<KlyMenuItem> items, string parent) =>
        @<text>
            @for (var index = 0; index < items.Count; index++)
            {
                var item = items[index];
                var path = parent.Length == 0 ? index.ToString() : $"{parent}-{index}";
                switch (item.Kind)
                {
                    case KlyMenuItemKind.Separator:
                        <div role="separator" class="@_slots["separator"]"></div>
                        break;
                    case KlyMenuItemKind.Heading:
                        <div role="presentation" class="@_slots["label"]">@item.Label</div>
                        break;
                    default:
                        var color = item.Color?.Value;
                        if (HasChildren(item))
                        {
                            <button type="button" role="menuitem" tabindex="-1" id="@TriggerId(path)" class="@_slots["item"]" data-color="@color"
                                    aria-haspopup="menu" title="@item.Description" aria-description="@item.Description"
                                    popovertarget="@(item.Disabled ? null : SubmenuId(path))" popovertargetaction="@(item.Disabled ? null : "show")"
                                    aria-disabled="@(item.Disabled ? "true" : null)">
                                @ItemContent(item)
                                <span class="@_slots["itemChevron"]" aria-hidden="true">@RenderIcon(Options.Icons.ChevronRight, "size-4")</span>
                            </button>
                        }
                        else if (item.Href is not null && !item.Disabled)
                        {
                            <a role="menuitem" tabindex="-1" href="@item.Href" class="@_slots["item"]" data-color="@color" title="@item.Description" aria-description="@item.Description">@ItemContent(item)</a>
                        }
                        else
                        {
                            <button type="button" role="menuitem" tabindex="-1" class="@_slots["item"]" data-color="@color" title="@item.Description" aria-description="@item.Description"
                                    aria-disabled="@(item.Disabled ? "true" : null)"
                                    @onclick="(item.Disabled || !OnSelect.HasDelegate ? default : EventCallback.Factory.Create(this, () => OnSelect.InvokeAsync(item)))">
                                @ItemContent(item)
                            </button>
                        }
                        break;
                }
            }
        </text>;

    private RenderFragment ItemContent(KlyMenuItem item) =>
        @<text>
            @if (item.Icon is not null)
            {
                <span class="@_slots["itemIcon"]" aria-hidden="true">@item.Icon</span>
            }
            <span class="@_slots["itemLabel"]">@item.Label</span>
            @if (item.Shortcut is not null)
            {
                <kbd class="@_slots["itemShortcut"]">@item.Shortcut</kbd>
            }
        </text>;

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(KlyToggleEventArgs))]
    private async Task OnToggle(KlyToggleEventArgs e)
    {
        _sequence = e.Sequence;
        if (e.Open == Open) return;
        Open = e.Open;
        await OpenChanged.InvokeAsync(e.Open);
    }
}
