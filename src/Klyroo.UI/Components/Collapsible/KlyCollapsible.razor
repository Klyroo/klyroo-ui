@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A disclosure: a button and the region it shows. Opening happens in the browser (<kly-collapsible>); a closed region
    uses hidden="until-found" so find-in-page still reaches its text and opens it.
*@
<kly-collapsible data-kly-seq="@(OpenChanged.HasDelegate ? _sequence : null)"
                open="@Open"
                data-state="@(Open ? "open" : "closed")"
                class="@_slots["root"]"
                @onklytoggle="ToggleHandler"
                @onklytoggle:stopPropagation="true"
                @attributes="AdditionalAttributes">
    <button type="button" data-kly-collapsible-trigger id="@($"{_id}-trigger")" aria-controls="@($"{_id}-content")"
            aria-expanded="@(Open ? "true" : "false")" disabled="@Disabled" class="@_slots["trigger"]">
        @if (Trigger is not null)
        {
            @Trigger
        }
        else
        {
            <span class="@_slots["label"]">@Label</span>
        }
        @if (ShowIcon)
        {
            @RenderIcon(Options.Icons.ChevronDown, _slots["icon"])
        }
    </button>
    <div id="@($"{_id}-content")" data-kly-collapsible-content hidden="@(Open ? null : "until-found")" class="@_slots["content"]">
        @ChildContent
    </div>
</kly-collapsible>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;
    private int _sequence;

    /// <summary>The revealed content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Text of the trigger button.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Custom content of the trigger button; replaces <see cref="Label"/>. It must not contain interactive elements.</summary>
    [Parameter] public RenderFragment? Trigger { get; set; }

    /// <summary>Open state. Bind it with <c>@bind-Open</c> to hear about changes; unbound, nothing leaves the browser.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>Raised with the new state when the region opens or closes.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    /// <summary>Prevents the user from opening or closing the region.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows the chevron that turns when the region opens.</summary>
    [Parameter] public bool ShowIcon { get; set; } = true;
    /// <summary>
    /// Per-instance class overrides of the slots of the collapsible, see <see cref="CollapsibleUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public CollapsibleUi? Ui { get; set; }

    private EventCallback<KlyToggleEventArgs> ToggleHandler =>
        OpenChanged.HasDelegate ? EventCallback.Factory.Create<KlyToggleEventArgs>(this, OnToggle) : default;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _id ??= NewId("collapsible");
        _slots = ResolveSlots(Options.Collapsible, new Dictionary<string, string?>(), Ui, "root");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(KlyToggleEventArgs))]
    private async Task OnToggle(KlyToggleEventArgs e)
    {
        _sequence = e.Sequence;
        if (e.Open == Open) return;
        Open = e.Open;
        await OpenChanged.InvokeAsync(e.Open);
    }
}
