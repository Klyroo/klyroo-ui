@namespace Klyroo.UI
@inherits KlyComponentBase

<kly-editor-drag-handle class="@_slots["root"]" data-color="@Color.Value" hidden @attributes="AdditionalAttributes">
    <button type="button" tabindex="-1" class="@_slots["handle"]" aria-label="@(Label ?? Messages.EditorDragHandle)" title="@(Label ?? Messages.EditorDragHandle)">
        @RenderIcon(Options.Icons.Drag, _slots["icon"])
    </button>
</kly-editor-drag-handle>

@code {
    private SlotSet _slots = default!;

    /// <summary>
    /// Accessible name of the handle. Defaults to <see cref="KlyMessages.EditorDragHandle"/>. The handle shows beside the block
    /// under the pointer or holding the cursor, and drags it. The keyboard alternative is Alt and the up or down arrow in the text
    /// (or the arrows on the focused handle), and the <see cref="EditorAction.MoveUp"/> and <see cref="EditorAction.MoveDown"/> toolbar buttons.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Semantic color of the handle: a built-in <see cref="KlyColor"/> or the name of a color you defined.</summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;
    /// <summary>
    /// Per-instance class overrides of the slots of the editor drag handle, see <see cref="EditorDragHandleUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public EditorDragHandleUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.EditorDragHandle, new Dictionary<string, string?>(), Ui, "root");
}
