@namespace Klyroo.UI
@inherits KlyComponentBase

@* Below the md breakpoint the table cells stack: each tier is a card, each feature lists its value per tier with the tier name
   as a CSS label. Explicit roles keep the table semantics that display:block would otherwise drop in some browsers. *@
<div data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    <table role="table" class="@_slots["table"]">
        @if (Caption is not null)
        {
            <caption class="@_slots["caption"]">@Caption</caption>
        }
        <thead role="rowgroup" class="@_slots["thead"]">
            <tr role="row" class="@_slots["headRow"]">
                <th role="columnheader" scope="col" class="@_slots["corner"]"><span class="@_slots["srOnly"]">@Messages.PricingFeatures</span></th>
                @foreach (var tier in Tiers)
                {
                    <th role="columnheader" scope="col" class="@_slots["tier"]" data-highlight="@(tier.Highlight ? "" : null)">
                        <span class="@_slots["tierTitle"]">@tier.Title</span>
                        @if (tier.Badge is not null)
                        {
                            <KlyBadge Label="@tier.Badge" Variant="KlyVariant.Subtle" Size="KlySize.Sm" Class="@_slots["tierBadge"]" />
                        }
                        @if (tier.Description is not null)
                        {
                            <span class="@_slots["tierDescription"]">@tier.Description</span>
                        }
                        @if (tier.Price is not null)
                        {
                            <span class="@_slots["tierPrice"]">
                                @if (tier.Discount is not null)
                                {
                                    <del class="@_slots["tierDiscount"]"><span class="@_slots["srOnly"]">@Messages.PricingOriginalPrice</span> @tier.Price</del>
                                    <span><span class="@_slots["srOnly"]">@Messages.PricingDiscountedPrice</span> @tier.Discount</span>
                                }
                                else
                                {
                                    <span>@tier.Price</span>
                                }
                                @if (tier.BillingCycle is not null)
                                {
                                    <span class="@_slots["tierCycle"]">@tier.BillingCycle</span>
                                }
                            </span>
                        }
                        @if (tier.ButtonLabel is not null)
                        {
                            <div class="@_slots["tierButton"]">
                                <KlyButton Label="@tier.ButtonLabel" Href="@tier.ButtonHref" Block
                                          Variant="@(tier.Highlight ? ButtonVariant.Solid : ButtonVariant.Outline)" />
                            </div>
                        }
                    </th>
                }
            </tr>
        </thead>
        @foreach (var section in Sections)
        {
            <tbody role="rowgroup" class="@_slots["tbody"]">
                <tr role="row" class="@_slots["sectionRow"]">
                    <th role="rowheader" scope="rowgroup" colspan="@(Tiers.Count + 1)" class="@_slots["section"]">@section.Title</th>
                </tr>
                @foreach (var feature in section.Features)
                {
                    <tr role="row" class="@_slots["row"]">
                        <th role="rowheader" scope="row" class="@_slots["feature"]">@feature.Title</th>
                        @for (var i = 0; i < Tiers.Count; i++)
                        {
                            var tier = Tiers[i];
                            var value = ValueOf(feature, tier, i);
                            <td role="cell" data-label="@tier.Title" class="@_slots["cell"]">
                                @if (value is true)
                                {
                                    @RenderIcon(Options.Icons.Check, $"{_slots["valueIcon"]} {_slots["included"]}")
                                    <span class="@_slots["srOnly"]">@Messages.PricingIncluded</span>
                                }
                                else if (value is false or null)
                                {
                                    @RenderIcon(Options.Icons.Minus, $"{_slots["valueIcon"]} {_slots["notIncluded"]}")
                                    <span class="@_slots["srOnly"]">@Messages.PricingNotIncluded</span>
                                }
                                else
                                {
                                    <span>@(value is IFormattable formattable ? formattable.ToString(null, FormatCulture) : value.ToString())</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        }
    </table>
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The columns.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyPricingTier> Tiers { get; set; } = [];

    /// <summary>The groups of rows.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyPricingSection> Sections { get; set; } = [];

    /// <summary>Name of the table for assistive technology. It is not shown.</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>
    /// Keeps the tier headers at the top of the viewport while the table scrolls, from the md breakpoint up. The distance from the
    /// top is the <c>--kly-sticky-offset</c> CSS variable (0 by default), for pages with a fixed header.
    /// </summary>
    [Parameter] public bool Sticky { get; set; } = true;
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;
    [Parameter] public PricingTableUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PricingTable, new Dictionary<string, string?>
        {
            ["sticky"] = VariantValue.Of(Sticky),
        }, Ui, "root");

    private static object? ValueOf(KlyPricingTableFeature feature, KlyPricingTier tier, int index) =>
        feature.ByTier is not null && feature.ByTier.TryGetValue(tier.Id, out var byId) ? byId
        : index < feature.Values.Length ? feature.Values[index]
        : null;
}
