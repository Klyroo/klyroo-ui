@namespace Klyroo.UI
@inherits KlyComponentBase
@using Klyroo.UI.Internal

@*
    With Href the title is the only link of the card and its box stretches over the whole card (after:absolute),
    so a click anywhere follows it, there is one focus stop and no interactive element is nested in another.
    The spotlight is CSS only: a glow that fades in on hover, off under prefers-reduced-motion.
*@
<div data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Variant == PageCardVariant.Spotlight)
    {
        <span class="@_slots["spotlight"]" aria-hidden="true" data-slot="spotlight"></span>
    }
    @if (Header is not null)
    {
        <div class="@_slots["header"]" data-slot="header">@Header</div>
    }
    <div class="@_slots["container"]">
        @if (Icon is not null || Title is not null || Description is not null)
        {
            <div class="@_slots["wrapper"]">
                @if (Icon is not null)
                {
                    <span class="@_slots["leading"]" aria-hidden="true" data-slot="leading">
                        <KlyIcon Name="@Icon" Class="@_slots["leadingIcon"]" />
                    </span>
                }
                @if (Title is not null)
                {
                    @if (HeadingLevel is { } level)
                    {
                        <SectionHeading Level="level" Class="@_slots["title"]">@TitleContent</SectionHeading>
                    }
                    else
                    {
                        <p class="@_slots["title"]" data-slot="title">@TitleContent</p>
                    }
                }
                @if (Description is not null)
                {
                    <p class="@_slots["description"]" data-slot="description">@Description</p>
                }
            </div>
        }
        @if (ChildContent is not null)
        {
            <div class="@_slots["body"]" data-slot="body">@ChildContent</div>
        }
    </div>
    @if (Footer is not null)
    {
        <div class="@_slots["footer"]" data-slot="footer">@Footer</div>
    }
</div>

@code {
    private SlotSet _slots = default!;

    private RenderFragment TitleContent => @<text>
        @if (Href is null)
        {
            @Title
        }
        else
        {
            <a href="@Href" target="@Target" rel="@(Target == "_blank" ? "noopener noreferrer" : null)" class="@_slots["link"]" data-slot="link">@Title@if (Target == "_blank") {<span class="sr-only"> @Messages.OpensInNewTab</span>}</a>
        }
    </text>;

    /// <summary>Name of a built-in icon (see <see cref="KlyIcon"/>).</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Title of the page card.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Secondary text of the page card, shown under or next to its title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Makes the whole card a link, carried by the title.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>The <c>target</c> attribute of the link of the card, such as <c>_blank</c>. It applies when <c>Href</c> is set.</summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>Content above the text, an image for example.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Content beside (horizontal) or under (vertical) the text. Interactive content would sit under the stretched link: give it <c>relative z-10</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Content at the bottom of the card.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>Look of the card: <c>Outline</c>, <c>Soft</c> or <c>Subtle</c>.</summary>
    [Parameter] public PageCardVariant Variant { get; set; } = PageCardVariant.Outline;

    /// <summary>Tints the icon, the spotlight and the hover ring.</summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;

    /// <summary>Horizontal puts the text and the content side by side from the lg breakpoint.</summary>
    [Parameter] public KlyOrientation Orientation { get; set; } = KlyOrientation.Vertical;

    /// <summary>Shows the content before the text in a horizontal card.</summary>
    [Parameter] public bool Reverse { get; set; }

    /// <summary>Level of the title heading, 1 to 6; null renders a paragraph.</summary>
    [Parameter] public int? HeadingLevel { get; set; } = 3;
    /// <summary>
    /// Per-instance class overrides of the slots of the page card, see <see cref="PageCardUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public PageCardUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PageCard, new Dictionary<string, string?>
        {
            ["variant"] = Variant.ToString().ToLowerInvariant(),
            ["orientation"] = Orientation == KlyOrientation.Vertical ? "vertical" : "horizontal",
            ["reverse"] = VariantValue.Of(Reverse),
            ["link"] = VariantValue.Of(Href is not null),
        }, Ui, "root");
}
