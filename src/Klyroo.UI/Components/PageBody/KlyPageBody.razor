@namespace Klyroo.UI
@inherits KlyComponentBase

@* Styles the plain HTML inside it (headings, paragraphs, lists, code, quotes, links): handy for rendered Markdown. *@
<div class="@_slots["root"]" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The HTML or Razor content to style, such as rendered Markdown.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the page body, see <see cref="PageBodyUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public PageBodyUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PageBody, new Dictionary<string, string?>(), Ui, "root");
}
