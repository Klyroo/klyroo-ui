@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    The <kly-banner> custom element owns dismissal: the close button hides it and remembers the Id in localStorage,
    so it works on static pages and stays hidden after a reload. It never reports to .NET and Blazor never renders
    the hidden state, so the two do not fight over it.
*@
<kly-banner data-kly-banner-id="@Id">
    <div data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
        <div class="@_slots["container"]">
            @if (Icon is not null)
            {
                <span class="@_slots["icon"]" aria-hidden="true">@Icon</span>
            }
            <div class="@_slots["content"]">
                @if (Title is not null)
                {
                    @if (Href is null)
                    {
                        <p class="@_slots["title"]" data-slot="title">@Title</p>
                    }
                    else
                    {
                        @* The link stretches over the whole banner; the actions and the close button stay above it. *@
                        <a href="@Href" target="@Target" class="@_slots["title"]" data-slot="title">@Title</a>
                    }
                }
                @if (Description is not null || ChildContent is not null)
                {
                    <div class="@_slots["description"]" data-slot="description">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Description)))</div>
                }
                @if (Actions is not null)
                {
                    <div class="@_slots["actions"]">@Actions</div>
                }
            </div>
            @if (Close)
            {
                <button type="button" data-slot="close" class="@_slots["close"]" aria-label="@Messages.Close">
                    @RenderIcon(Options.Icons.Close, "size-4")
                </button>
            }
        </div>
    </div>
</kly-banner>

@code {
    private SlotSet _slots = default!;

    /// <summary>
    /// Identifies the banner in the browser's localStorage: a dismissed banner stays hidden on later visits.
    /// Without an Id a dismissal only lasts until the page is reloaded.
    /// </summary>
    [Parameter] public string? Id { get; set; }
    /// <summary>Title of the banner.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Text of the banner.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Rich description, instead of <see cref="Description"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Icon of the banner, as markup such as a <see cref="KlyIcon"/>.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }
    /// <summary>Buttons or links shown at the end of the banner.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Turns the title into a link that covers the whole banner.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>The <c>target</c> attribute of the banner link, such as <c>_blank</c>. It applies when <c>Href</c> is set.</summary>
    [Parameter] public string? Target { get; set; }
    /// <summary>
    /// Semantic color of the banner: a built-in <see cref="KlyColor"/> or the name of a color you defined. When not set, <see cref="KlyDefaults.Color"/> applies, else the default of the component.
    /// </summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;

    /// <summary>Shows a close button. It needs the Klyroo browser module, which every render mode loads.</summary>
    [Parameter] public bool Close { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the banner, see <see cref="BannerUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public BannerUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Banner, new Dictionary<string, string?> { ["link"] = VariantValue.Of(Href is not null) }, Ui, "root");
}
