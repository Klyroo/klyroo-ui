@namespace Klyroo.UI
@using Klyroo.UI.Internal
@typeparam TValue
@inherits KlyFieldBase<IReadOnlyList<TValue>>

@if (UseEditContext)
{
    <ValueBridge TValue="IReadOnlyList<TValue>" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Context="binding">@Markup(binding)</ValueBridge>
}
else
{
    @Markup(new EditBinding(Name, Field?.Invalid == true))
}

@code {
    private SlotSet _slots = default!;

    /// <summary>The checkboxes of the group, as <see cref="KlyCheckboxItem{TValue}"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyCheckboxItem<TValue>> Items { get; set; } = [];
    /// <summary>Caption of the group, rendered as the legend of its fieldset.</summary>
    [Parameter] public string? Legend { get; set; }
    /// <summary>Whether the checkboxes are stacked (<c>Vertical</c>) or side by side (<c>Horizontal</c>).</summary>
    [Parameter] public KlyOrientation Orientation { get; set; } = KlyOrientation.Vertical;
    /// <summary>
    /// Per-instance class overrides of the slots of the checkbox group, see <see cref="CheckboxGroupUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public CheckboxGroupUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.CheckboxGroup, new Dictionary<string, string?>
        {
            ["size"] = VariantValue.Of(EffectiveSize),
            ["orientation"] = Orientation == KlyOrientation.Horizontal ? "horizontal" : "vertical",
        }, Ui, "root");

    private bool IsChecked(TValue value) => Value?.Contains(value, EqualityComparer<TValue>.Default) == true;

    private static string? Format(TValue value) => Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture);

    // Keeps the order of Items, whatever order the boxes were ticked in.
    private async Task Toggle(TValue value, bool isChecked)
    {
        var selected = Items.Where(i => EqualityComparer<TValue>.Default.Equals(i.Value, value) ? isChecked : IsChecked(i.Value)).Select(i => i.Value).ToList();
        Value = selected;
        await ValueChanged.InvokeAsync(selected);
        NotifyFieldChanged();
    }

    private RenderFragment Item(KlyCheckboxItem<TValue> item, int index, EditBinding binding)
    {
        var id = $"{ControlId}-{index}";
        var descriptionId = item.Description is null ? null : id + "-description";
        var value = item.Value;
        var onChange = ValueChanged.HasDelegate
            ? EventCallback.Factory.Create<ChangeEventArgs>(this, e => Toggle(value, e.Value is true))
            : default;
        return @<div class="@_slots["item"]" data-disabled="@(item.Disabled || Disabled ? "" : null)">
            <div class="@_slots["container"]">
                <input type="checkbox" id="@id" name="@binding.Name" value="@Format(item.Value)" checked="@IsChecked(item.Value)"
                       disabled="@(item.Disabled || Disabled)" aria-describedby="@FormFieldContext.Join(descriptionId)"
                       aria-invalid="@(binding.Invalid ? "true" : null)" class="@binding.WithFieldClass(_slots["base"])" @onchange="onChange" />
                @RenderIcon(Options.Icons.Check, _slots["icon"])
            </div>
            <div class="@_slots["wrapper"]">
                <label for="@id" class="@_slots["label"]">@item.Label</label>
                @if (item.Description is not null)
                {
                    <p id="@descriptionId" class="@_slots["description"]">@item.Description</p>
                }
            </div>
        </div>;
    }

    private RenderFragment Markup(EditBinding binding) =>
        @<fieldset id="@ControlId" class="@_slots["root"]" data-color="@Color.Value" disabled="@Disabled"
                   aria-labelledby="@(Legend is null ? Field?.LabelId : null)" aria-describedby="@Field?.DescribedBy"
                   @attributes="AdditionalAttributes">
            @if (Legend is not null)
            {
                <legend class="@_slots["legend"]">@Legend</legend>
            }
            <div class="@_slots["fieldset"]">
                @for (var i = 0; i < Items.Count; i++)
                {
                    var index = i;
                    @Item(Items[index], index, binding)
                }
            </div>
        </fieldset>;
}
