@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    <kly-command-palette> filters the options as you type, highlights with the arrow keys and activates with Enter,
    all in the browser: no round trip per keystroke. Focus stays in the input (aria-activedescendant).
    The browser hides what does not match with data-filtered and shows the empty state with data-empty on the element.
*@
<kly-command-palette class="@_slots["root"]"
                    data-results-text="@Messages.CommandResults"
                    @onklychange="ChangeHandler"
                    @onklychange:stopPropagation="true"
                    @attributes="AdditionalAttributes">
    <div class="@_slots["inputWrapper"]" data-slot="inputWrapper">
        @RenderIcon(Options.Icons.Search, _slots["inputIcon"])
        <input type="text" role="combobox" class="@_slots["input"]" data-slot="input"
               aria-expanded="true" aria-controls="@(_id + "-listbox")" aria-autocomplete="list"
               aria-label="@(Label ?? Messages.SearchCommands)"
               placeholder="@Placeholder" autocomplete="off" spellcheck="false" />
        @if (CloseOnSelect)
        {
            <button type="button" data-kly-close
                    class="inline-flex min-h-6 shrink-0 cursor-pointer items-center rounded-md border border-(--klyroo-border) bg-(--klyroo-bg-muted) px-1.5 py-0.5 font-mono text-[11px] text-(--klyroo-text-muted) transition-colors hover:border-(--klyroo-border-accented) hover:text-(--klyroo-text-highlighted)"
                    aria-label="@Messages.CommandPaletteClose">
                Esc
            </button>
        }
    </div>
    <div id="@(_id + "-listbox")" role="listbox" tabindex="-1" class="@_slots["listbox"]" data-slot="listbox"
         aria-label="@(Label ?? Messages.SearchCommands)">
        @for (var g = 0; g < Groups.Count; g++)
        {
            var group = Groups[g];
            var groupId = _id + "-group-" + g;
            if (group.Label is null)
            {
                foreach (var item in group.Items)
                {
                    @Option(group, item)
                }
            }
            else
            {
                <div role="group" aria-labelledby="@groupId" class="@_slots["group"]" data-slot="group">
                    <div id="@groupId" role="presentation" class="@_slots["groupLabel"]">@group.Label</div>
                    @foreach (var item in group.Items)
                    {
                        @Option(group, item)
                    }
                </div>
            }
        }
    </div>
    <div class="@_slots["empty"]" data-slot="empty">@Messages.NoCommandResults</div>
    <div role="status" class="@_slots["status"]" data-slot="status"></div>
</kly-command-palette>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;

    /// <summary>The commands, in groups. A group without a label has no heading.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyCommandGroup> Groups { get; set; } = [];

    /// <summary>Called with the activated command. Link commands navigate as well.</summary>
    [Parameter] public EventCallback<KlyCommandItem> OnSelect { get; set; }
    /// <summary>Hint of the search field. Defaults to the built-in text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Accessible name of the search field and the list. Defaults to the built-in text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Makes activating a command close the enclosing <see cref="KlyModal"/>, <see cref="KlyDrawer"/> or
    /// <see cref="KlySlideover"/> without a round trip.
    /// </summary>
    [Parameter] public bool CloseOnSelect { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the command palette, see <see cref="CommandPaletteUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public CommandPaletteUi? Ui { get; set; }

    private EventCallback<KlyChangeEventArgs> ChangeHandler =>
        OnSelect.HasDelegate ? EventCallback.Factory.Create<KlyChangeEventArgs>(this, OnChange) : default;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _id ??= NewId("command");
        _slots = ResolveSlots(Options.CommandPalette, new Dictionary<string, string?>(), Ui, "root");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(KlyChangeEventArgs))]
    private async Task OnChange(KlyChangeEventArgs e)
    {
        var item = Groups.SelectMany(g => g.Items).FirstOrDefault(i => i.Key == e.Value);
        if (item is not null) await OnSelect.InvokeAsync(item);
    }

    private RenderFragment Option(KlyCommandGroup group, KlyCommandItem item) =>
        @<text>
            @if (item.Href is not null && !item.Disabled)
            {
                <a role="option" href="@item.Href" tabindex="-1" class="@_slots["item"]" data-value="@item.Key" data-search="@Search(group, item)"
                   data-kly-close="@(CloseOnSelect ? "" : null)">@ItemContent(item)</a>
            }
            else
            {
                <div role="option" class="@_slots["item"]" data-value="@item.Key" data-search="@Search(group, item)"
                     aria-disabled="@(item.Disabled ? "true" : null)" data-kly-close="@(CloseOnSelect ? "" : null)">@ItemContent(item)</div>
            }
        </text>;

    private RenderFragment ItemContent(KlyCommandItem item) =>
        @<text>
            @if (item.Icon is not null)
            {
                <span class="@_slots["itemIcon"]" aria-hidden="true">@item.Icon</span>
            }
            <span class="@_slots["itemWrapper"]">
                <span class="@_slots["itemLabel"]">@item.Label</span>
                @if (item.Description is not null)
                {
                    <span class="@_slots["itemDescription"]">@item.Description</span>
                }
            </span>
            @if (item.Count is { } count)
            {
                <span class="sr-only" data-slot="count-separator">, </span>
                <span class="@_slots["itemCount"]" data-slot="count">@count.ToString("N0", FormatCulture)</span>
            }
            @if (item.Shortcut is not null)
            {
                <kbd class="@_slots["itemShortcut"]">@item.Shortcut</kbd>
            }
        </text>;

    private static string Search(KlyCommandGroup group, KlyCommandItem item) =>
        string.Join(' ', new[] { item.Label, item.Description, item.Keywords, group.Label }.Where(s => !string.IsNullOrEmpty(s)));
}
