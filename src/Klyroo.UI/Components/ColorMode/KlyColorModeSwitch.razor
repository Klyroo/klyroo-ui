@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A switch that is on in dark mode. Its look follows the "dark" class of the page through CSS; the browser script keeps
    the checkbox in sync and writes the choice. Nothing goes through .NET, so it works on static pages.
*@
<div class="@_slots["root"]" data-color="@Color.Value" @attributes="AdditionalAttributes">
    @* A label, like KlySwitch: on a touch screen its ::after is the 44px hit area, and a tap there toggles the input. *@
    <label class="@_slots["container"]">
        <input type="checkbox" role="switch" id="@_id" class="@_slots["input"]" data-kly-color-mode="switch"
               aria-label="@(Label is null ? (AriaLabel ?? Messages.ToggleColorMode) : null)" />
        <span class="@_slots["thumb"]" aria-hidden="true" data-slot="thumb">
            @RenderIcon(Options.Icons.Dark, _slots["moon"])
            @RenderIcon(Options.Icons.Light, _slots["sun"])
        </span>
    </label>
    @if (Label is not null)
    {
        <div class="@_slots["wrapper"]" data-slot="wrapper">
            <label for="@_id" class="@_slots["label"]" data-slot="label">@Label</label>
        </div>
    }
</div>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;

    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;

    /// <summary>Visible label. Without it the switch needs <see cref="AriaLabel"/>.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Accessible name when there is no visible label. Defaults to the built-in text.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public ColorModeSwitchUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _id ??= NewId("colormode");
        _slots = ResolveSlots(Options.ColorModeSwitch, new Dictionary<string, string?> { ["size"] = VariantValue.Of(Size) }, Ui, "root");
    }
}
