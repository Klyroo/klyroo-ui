@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A button that switches between light and dark. The icon follows the "dark" class of the page through CSS and the
    click is handled in the browser, so it works on static pages and stays in sync with every other color mode control.
*@
<KlyButton Color="Color" Variant="Variant" Size="Size" Square="@(Label is null)" Label="@Label" Class="@Class"
          @attributes="AdditionalAttributes"
          aria-label="@(Label is null ? (AriaLabel ?? Messages.ToggleColorMode) : null)"
          data-kly-color-mode="toggle">
    <LeadingIcon>
        @RenderIcon(Options.Icons.Dark, _slots["moon"])
        @RenderIcon(Options.Icons.Light, _slots["sun"])
    </LeadingIcon>
</KlyButton>

@code {
    private SlotSet _slots = default!;

    [Parameter] public KlyColor Color { get; set; } = KlyColor.Neutral;
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;

    /// <summary>Visible text next to the icon. Without it the button is icon-only and needs <see cref="AriaLabel"/>.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Accessible name of an icon-only button. Defaults to the built-in text.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.ColorModeButton, new Dictionary<string, string?>(), null, "");
}
