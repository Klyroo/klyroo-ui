@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    Both images are rendered and CSS shows the one matching the "dark" class of the page: no script, no flash,
    correct on static pages. The hidden one is display:none, so it is not in the accessibility tree and, being lazy,
    it is not downloaded until it is shown (do not preload both).
*@
@* Width and Height go to both images. *@
<KlyImage Src="@Light" Alt="@(Alt ?? "")" Width="Width" Height="Height" ImageOptions="ImageOptions" Class="@_light" @attributes="AdditionalAttributes" />
<KlyImage Src="@(Dark ?? Light)" Alt="@(Alt ?? "")" Width="Width" Height="Height" ImageOptions="ImageOptions" Class="@_dark" @attributes="AdditionalAttributes" />

@code {
    private string _light = "";
    private string _dark = "";

    /// <summary>Image in light mode.</summary>
    [Parameter, EditorRequired] public string? Light { get; set; }

    /// <summary>Image in dark mode. Defaults to <see cref="Light"/>.</summary>
    [Parameter] public string? Dark { get; set; }

    /// <summary>Text alternative. Leave empty for a decorative image.</summary>
    [Parameter] public string? Alt { get; set; }

    /// <summary>Width of both images in CSS pixels, see <see cref="KlyImage.Width"/>.</summary>
    [Parameter] public int? Width { get; set; }

    /// <summary>Height of both images in CSS pixels, see <see cref="KlyImage.Height"/>.</summary>
    [Parameter] public int? Height { get; set; }

    /// <summary>Image settings forwarded to both light and dark images.</summary>
    [Parameter] public KlyImageOptions? ImageOptions { get; set; }

    protected override void OnParametersSet()
    {
        var slots = ResolveSlots(Options.ColorModeImage, new Dictionary<string, string?>(), null, "light");
        _light = slots["light"];
        _dark = Resolver.Merge(slots["dark"], Class);
    }
}
