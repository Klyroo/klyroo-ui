@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A native select of System, Light and Dark. The browser script sets its value from the stored mode and writes the
    choice, so it works on static pages and stays in sync with every other color mode control.
*@
<div class="@_slots["root"]" data-color="@Color.Value" @attributes="AdditionalAttributes">
    <select class="@_slots["base"]" aria-label="@(AriaLabel ?? Messages.ColorMode)" data-kly-color-mode="select">
        <option value="system">@Messages.ColorModeSystem</option>
        <option value="light">@Messages.ColorModeLight</option>
        <option value="dark">@Messages.ColorModeDark</option>
    </select>
    @RenderIcon(Options.Icons.ChevronUpDown, _slots["trailingIcon"])
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>
    /// Semantic color of the color mode select: a built-in <see cref="KlyColor"/> or the name of a color you defined. When not set, <see cref="KlyDefaults.Color"/> applies, else the default of the component.
    /// </summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;
    /// <summary>Look of the field: <c>Outline</c>, <c>Soft</c>, <c>Subtle</c>, <c>Ghost</c> or <c>None</c>.</summary>
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Outline;
    /// <summary>Size of the color mode select, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;

    /// <summary>Accessible name of the select. Defaults to the built-in text.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the color mode select, see <see cref="ColorModeSelectUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public ColorModeSelectUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.ColorModeSelect, new Dictionary<string, string?>
        {
            ["variant"] = Variant.ToString().ToLowerInvariant(),
            ["size"] = VariantValue.Of(Size),
        }, Ui, "root");
}
