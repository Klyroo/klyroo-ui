@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    Both avatars are rendered and CSS shows the one matching the "dark" class of the page: no script, no flash,
    correct on static pages. The hidden one is display:none, so it is not in the accessibility tree.
*@
<KlyAvatar Src="@Light" Alt="@Alt" Text="@Text" Icon="Icon" Size="Size" Ui="Ui" ImageOptions="ImageOptions" Class="@_light" @attributes="AdditionalAttributes" />
<KlyAvatar Src="@(Dark ?? Light)" Alt="@Alt" Text="@Text" Icon="Icon" Size="Size" Ui="Ui" ImageOptions="ImageOptions" Class="@_dark" @attributes="AdditionalAttributes" />

@code {
    private string _light = "";
    private string _dark = "";

    /// <summary>Image in light mode.</summary>
    [Parameter] public string? Light { get; set; }

    /// <summary>Image in dark mode. Defaults to <see cref="Light"/>.</summary>
    [Parameter] public string? Dark { get; set; }
    /// <summary>Alternative text of the picture. Both pictures carry it.</summary>
    [Parameter] public string? Alt { get; set; }
    /// <summary>Initials shown when there is no picture.</summary>
    [Parameter] public string? Text { get; set; }
    /// <summary>Icon shown when there is no picture and no text, as markup such as a <see cref="KlyIcon"/>.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }
    /// <summary>Size of the color mode avatar, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;
    /// <summary>
    /// Per-instance class overrides of the slots of the color mode avatar, see <see cref="AvatarUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public AvatarUi? Ui { get; set; }

    /// <summary>Image settings forwarded to both avatars, see <see cref="KlyAvatar.ImageOptions"/>.</summary>
    [Parameter] public KlyImageOptions? ImageOptions { get; set; }

    protected override void OnParametersSet()
    {
        var slots = ResolveSlots(Options.ColorModeAvatar, new Dictionary<string, string?>(), null, "light");
        _light = slots["light"];
        _dark = Resolver.Merge(slots["dark"], Class);
    }
}
