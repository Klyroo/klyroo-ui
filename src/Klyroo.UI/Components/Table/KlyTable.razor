@namespace Klyroo.UI
@using Klyroo.UI.Internal
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits KlyComponentBase

<CascadingValue TValue="KlyTable<TItem>" Value="this" IsFixed="true">
    @{ BeginCollectingColumns(); }
    @ChildContent
    @* Rendered after the columns above have registered. *@
    <Defer>
        <div class="@_slots["root"]" @attributes="AdditionalAttributes">
            <table class="@_slots["base"]">
                @if (Caption is not null)
                {
                    <caption class="@_slots["caption"]">@Caption</caption>
                }
                <thead class="@_slots["thead"]">
                    <tr class="@_slots["tr"]">
                        @foreach (var column in _columns)
                        {
                            <th scope="col" class="@CellClass(_slots["th"], column, false)" aria-sort="@AriaSort(column)">
                                @if (column.CanSort)
                                {
                                    <button type="button" class="@_slots["sortButton"]" disabled="@(!RendererInfo.IsInteractive)" title="@SortTitle(column)" @onclick="() => Sort(column)">
                                        @column.Title
                                        @if (column == _sortColumn)
                                        {
                                            @(_ascending ? RenderIcon(Options.Icons.ArrowUp, _slots["sortIcon"]) : RenderIcon(Options.Icons.ArrowDown, _slots["sortIcon"]))
                                        }
                                        else
                                        {
                                            @RenderIcon(Options.Icons.ChevronUpDown, _slots["sortIcon"])
                                        }
                                    </button>
                                }
                                else
                                {
                                    @column.Title
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="@_slots["tbody"]">
                    @{ var all = SortedItems.ToList(); var (rows, remaining) = _reveal.Apply(all, Max, Step); }
                    @if (rows.Count == 0)
                    {
                        <tr class="@_slots["tr"]">
                            <td colspan="@_columns.Count" class="@_slots["empty"]">@(Empty ?? (RenderFragment)(b => b.AddContent(0, Messages.NoData)))</td>
                        </tr>
                    }
                    @foreach (var item in rows)
                    {
                        <tr class="@_slots["tr"]">
                            @foreach (var column in _columns)
                            {
                                <td class="@CellClass(_slots["td"], column, true)">
                                    @column.Cell(item)
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                @if (_columns.Any(c => c.HasFooter))
                {
                    <tfoot class="@_slots["tfoot"]">
                        <tr class="@_slots["tr"]">
                            @foreach (var column in _columns)
                            {
                                <td class="@CellClass(_slots["tf"], column, false)" data-slot="tf">
                                    @if (column.FooterTemplate is not null)
                                    {
                                        @column.FooterTemplate
                                    }
                                    else
                                    {
                                        @column.Footer
                                    }
                                </td>
                            }
                        </tr>
                    </tfoot>
                }
            </table>
            @if (remaining > 0)
            {
                <button type="button" class="@_slots["more"]" data-slot="more" disabled="@(!RendererInfo.IsInteractive)"
                        @onclick="@(() => _reveal.More(all.Count, Max, Step))">
                    <span>@Messages.ShowMore(remaining)</span>
                    @RenderIcon(Options.Icons.ChevronDown, _slots["moreIcon"])
                </button>
            }
        </div>
    </Defer>
</CascadingValue>

@code {
    private readonly List<KlyColumnBase<TItem>> _columns = [];
    private readonly Reveal _reveal = new();
    private SlotSet _slots = default!;
    private KlyColumnBase<TItem>? _sortColumn;
    private bool _ascending = true;

    /// <summary>The rows to show. The columns come from the <see cref="KlyColumn{TItem, TValue}"/> and <see cref="KlyTemplateColumn{TItem}"/> children.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>The columns: <c>KlyColumn</c> and <c>KlyTemplateColumn</c> components.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Describes the table for assistive technologies (visually hidden).</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>Shown when there are no items.</summary>
    [Parameter] public RenderFragment? Empty { get; set; }

    /// <summary>The number of rows shown before a Show more button (all rows when <see langword="null"/>). The rows are cut after sorting.</summary>
    [Parameter] public int? Max { get; set; }

    /// <summary>The number of rows each click on Show more reveals (all the remaining ones when <see langword="null"/>).</summary>
    [Parameter] public int? Step { get; set; }

    /// <summary>Keeps the header visible while the table scrolls (give the table a max height through Class).</summary>
    [Parameter] public bool Sticky { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the table, see <see cref="TableUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public TableUi? Ui { get; set; }

    // Columns register each time the table renders, in markup order, so one inserted later by an @if takes its
    // place in the markup instead of going last. Every column has a Field or Template delegate, which Blazor always
    // treats as changed, so every column re-registers on each render.
    private void BeginCollectingColumns() => _columns.Clear();

    internal void AddColumn(KlyColumnBase<TItem> column)
    {
        if (!_columns.Contains(column)) _columns.Add(column);
    }

    internal void RemoveColumn(KlyColumnBase<TItem> column) => _columns.Remove(column);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _reveal.Sync(Max);
        _slots = ResolveSlots(Options.Table, new Dictionary<string, string?> { ["sticky"] = VariantValue.Of(Sticky) }, Ui, "root");
    }

    // The alignment, the tabular figures and the font of a column, then its own classes.
    private string CellClass(string slot, KlyColumnBase<TItem> column, bool withColumnClass) => Resolver.Merge(
        slot,
        column.Numeric ? _slots["cellNumeric"] : column.Align == KlyColumnAlign.End ? _slots["cellEnd"] : null,
        column.Mono ? _slots["cellMono"] : null,
        withColumnClass ? column.Class : null);

    private IEnumerable<TItem> SortedItems
    {
        get
        {
            var items = Items ?? [];
            return _sortColumn is { CanSort: true } column ? column.OrderItems(items, _ascending) : items;
        }
    }

    private string SortTitle(KlyColumnBase<TItem> column) =>
        column == _sortColumn && _ascending ? Messages.SortDescending : Messages.SortAscending;

    private string? AriaSort(KlyColumnBase<TItem> column) =>
        column != _sortColumn ? (column.CanSort ? "none" : null) : _ascending ? "ascending" : "descending";

    private void Sort(KlyColumnBase<TItem> column)
    {
        _ascending = column != _sortColumn || !_ascending;
        _sortColumn = column;
    }
}
