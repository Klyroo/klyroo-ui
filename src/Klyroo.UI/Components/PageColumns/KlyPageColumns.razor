@namespace Klyroo.UI
@inherits KlyComponentBase

@* CSS columns: items of different heights pack without gaps, in reading order down each column. *@
<div class="@_slots["root"]" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The items. Each direct child is kept whole: it is never split across two columns.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Number of columns from the lg breakpoint, 2 to 4: one column on phones, two from sm.</summary>
    [Parameter] public int Columns { get; set; } = 3;
    /// <summary>
    /// Per-instance class overrides of the slots of the page columns, see <see cref="PageColumnsUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public PageColumnsUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PageColumns, new Dictionary<string, string?>
        {
            ["columns"] = Math.Clamp(Columns, 2, 4).ToString(System.Globalization.CultureInfo.InvariantCulture),
        }, Ui, "root");
}
