@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    Sticky below the header (--klyroo-header-height) and shown from the lg breakpoint only. An aside is a complementary
    landmark: name it with aria-label when the page has more than one. Inside another landmark, render it with As="div".
*@
@if (_tag == "aside")
{
    <aside class="@_slots["root"]" @attributes="AdditionalAttributes">@Inner</aside>
}
else
{
    <div class="@_slots["root"]" @attributes="AdditionalAttributes">@Inner</div>
}

@code {
    private SlotSet _slots = default!;
    private string _tag = "aside";

    private RenderFragment Inner => @<text>
        @if (Top is not null)
        {
            <div class="@_slots["top"]" data-slot="top">@Top</div>
        }
        <div class="@_slots["body"]" data-slot="body">@ChildContent</div>
        @if (Bottom is not null)
        {
            <div class="@_slots["bottom"]" data-slot="bottom">@Bottom</div>
        }
    </text>;

    [Parameter] public RenderFragment? Top { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Bottom { get; set; }

    /// <summary>The element to render: "aside" (default) or "div", in any case; anything else throws an <see cref="ArgumentException"/>.</summary>
    [Parameter] public string As { get; set; } = "aside";
    [Parameter] public PageAsideUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        _tag = string.IsNullOrWhiteSpace(As) ? "aside" : As.Trim().ToLowerInvariant();
        if (_tag is not ("aside" or "div"))
        {
            throw new ArgumentException($"KlyPageAside: As must be \"aside\" or \"div\" (any case), not \"{As}\".", nameof(As));
        }
        _slots = ResolveSlots(Options.PageAside, new Dictionary<string, string?>(), Ui, "root");
    }
}
