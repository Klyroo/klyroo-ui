@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    One <img>, with the width, height, srcset, sizes and loading an optimizing provider can fill in.
    With the default "none" provider nothing is resized: the image keeps its src and gets width, height and loading only.
*@
@if (_preload)
{
    <HeadContent>
        <link rel="preload" as="image" href="@_resolved.Src" imagesrcset="@_resolved.SrcSet" imagesizes="@_resolved.Sizes" fetchpriority="@_priorityText" />
    </HeadContent>
}
@if (string.IsNullOrEmpty(Caption))
{
    <img src="@_resolved.Src"
     alt="@Alt"
     width="@_width"
     height="@_height"
     srcset="@_resolved.SrcSet"
     sizes="@_resolved.Sizes"
     loading="@_loadingText"
     fetchpriority="@_priorityText"
     class="@Class"
     style="@_style"
     @attributes="_attributes" />
}
else
{
    <figure class="@_figureSlots["figure"]" data-slot="image-figure">
        <img src="@_resolved.Src"
     alt="@Alt"
     width="@_width"
     height="@_height"
     srcset="@_resolved.SrcSet"
     sizes="@_resolved.Sizes"
     loading="@_loadingText"
     fetchpriority="@_priorityText"
     class="@Class"
     style="@_style"
     @attributes="_attributes" />
        <figcaption class="@_figureSlots["caption"]" data-slot="image-caption">@Caption</figcaption>
    </figure>
}

@code {
    private KlyResolvedImage _resolved = new("", null, null);
    private bool _preload;
    private string _loadingText = "lazy";
    private string? _priorityText;
    private string? _style;
    private string? _width;
    private string? _height;
    private IReadOnlyDictionary<string, object>? _attributes;
    private SlotSet _figureSlots = default!;

    /// <summary>Address of the image: a root-relative path ("/img/team.jpg") or an absolute URL.</summary>
    [Parameter, EditorRequired] public string? Src { get; set; }

    /// <summary>Text alternative. Required: pass an empty string for a decorative image.</summary>
    [Parameter, EditorRequired] public string? Alt { get; set; }

    /// <summary>
    /// Width of the image in CSS pixels. It is also the base of the 1x, 2x… candidates, and it reserves the space before the image loads.
    /// A value that is not positive is written as given and takes no part in the resolution.
    /// </summary>
    [Parameter] public int? Width { get; set; }

    /// <summary>Height of the image in CSS pixels, with the same rules as <see cref="Width"/>.</summary>
    [Parameter] public int? Height { get; set; }

    /// <summary>
    /// A caption under the image. When set, the image is wrapped in a <c>figure</c> with a <c>figcaption</c>; <c>Class</c> and the other attributes stay on the <c>img</c>.
    /// Nothing is wrapped when it is not set.
    /// </summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>Per-instance class overrides of the <c>figure</c> and <c>caption</c> slots, see <see cref="ImageUi"/>. They apply only with a <see cref="Caption"/>.</summary>
    [Parameter] public ImageUi? Ui { get; set; }

    /// <summary>Settings shared with the other image parameters: the parameters below override the ones set here.</summary>
    [Parameter] public KlyImageOptions? ImageOptions { get; set; }

    /// <summary>
    /// Responsive sizes: <c>"100vw sm:50vw md:400px"</c> (an unprefixed entry is the default; each breakpoint applies
    /// from its width upward). Breakpoints come from <see cref="KlyImageSettings.Screens"/>. It becomes the <c>sizes</c> attribute and decides the widths of the <c>srcset</c>.
    /// </summary>
    [Parameter] public string? Sizes { get; set; }

    /// <summary>Densities of the <c>srcset</c>, like <c>[1, 2]</c>. Defaults to <see cref="KlyImageSettings.Densities"/>.</summary>
    [Parameter] public IReadOnlyList<int>? Densities { get; set; }

    /// <summary>Output format. Only a provider that converts honors it.</summary>
    [Parameter] public KlyImageFormat? Format { get; set; }

    /// <summary>Quality from 1 to 100.</summary>
    [Parameter] public int? Quality { get; set; }

    /// <summary>How the image fills <see cref="Width"/> by <see cref="Height"/>. Cover when unset.</summary>
    [Parameter] public KlyImageFit? Fit { get; set; }

    /// <summary>Provider specific modifiers (for example <c>gravity</c>), merged over the preset's.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Modifiers { get; set; }

    /// <summary>Name of a registered provider; <see cref="KlyImageSettings.DefaultProvider"/> when unset.</summary>
    [Parameter] public string? Provider { get; set; }

    /// <summary>Name of an entry of <see cref="KlyImageSettings.Presets"/>.</summary>
    [Parameter] public string? Preset { get; set; }

    /// <summary>Lazy by default, eager when <see cref="Preload"/> is set. Use eager for the image visible at first paint.</summary>
    [Parameter] public KlyImageLoading? Loading { get; set; }

    /// <summary><c>high</c> speeds up the image that matters most (the hero); preloading sets it to high unless you choose.</summary>
    [Parameter] public KlyFetchPriority? FetchPriority { get; set; }

    /// <summary>
    /// Adds <c>&lt;link rel="preload" as="image" imagesrcset imagesizes&gt;</c> to the document head, and loads eagerly. It goes through
    /// <c>HeadContent</c>, so the app needs a <c>HeadOutlet</c> (the Blazor Web App template has one). In a Blazor Hybrid web view no link is
    /// added (the image only loads eagerly with a high priority).
    /// </summary>
    [Parameter] public bool? Preload { get; set; }

    /// <summary>
    /// A placeholder shown behind the image while it loads: <see cref="KlyImagePlaceholder.Url(string)"/> for a small image of yours, or
    /// <see cref="KlyImagePlaceholder.Auto"/> to ask the provider for a tiny (and, when it can blur, blurred) version of the image.
    /// It is painted as the background of the element.
    /// </summary>
    [Parameter] public KlyImagePlaceholder? Placeholder { get; set; }

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters) =>
        base.SetParametersAsync(Internal.PixelParameters.Coerce(parameters, "KlyImage", ["Width", "Height"], ApplyCascading));

    protected override void OnParametersSet()
    {
        if (Alt is null)
        {
            throw new InvalidOperationException("KlyImage needs Alt: describe the image, or pass an empty string when it is decorative.");
        }

        _figureSlots = ResolveSlots(Options.ImageFigure, new Dictionary<string, string?>(), Ui, "");

        var options = new KlyImageOptions
        {
            Format = Format,
            Quality = Quality,
            Provider = Provider,
            Preset = Preset,
            Sizes = Sizes,
            Densities = Densities,
            Fit = Fit,
            Modifiers = Modifiers,
            Loading = Loading,
            Preload = Preload,
        }.OverDefaultsOf(ImageOptions);

        _width = Attribute(Width);
        _height = Attribute(Height);
        var width = Pixels(Width);
        var height = Pixels(Height);
        _resolved = Options.Images.Resolve(Src, options, width, height);
        var preloadAsked = options.Preload == true && !string.IsNullOrEmpty(_resolved.Src);
        // A web view has no server rendered head, and the files come from the device: no preload link, but the image still loads eagerly.
        _preload = preloadAsked && !IsHybrid;
        _loadingText = (options.Loading ?? (preloadAsked ? KlyImageLoading.Eager : KlyImageLoading.Lazy)) == KlyImageLoading.Eager ? "eager" : "lazy";
        var priority = FetchPriority ?? (preloadAsked ? KlyFetchPriority.High : KlyFetchPriority.Auto);
        _priorityText = priority == KlyFetchPriority.Auto ? null : priority.ToString().ToLowerInvariant();

        var placeholder = PlaceholderUrl(options);
        _attributes = AdditionalAttributes;
        _style = null;
        if (placeholder is not null)
        {
            var style = $"background-image:url(\"{EscapeCssUrl(placeholder)}\");background-size:cover;background-repeat:no-repeat";
            if (AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("style", out var own) && own is string ownStyle)
            {
                style += ";" + ownStyle;
                _attributes = AdditionalAttributes.Where(a => a.Key != "style").ToDictionary(a => a.Key, a => a.Value);
            }
            _style = style;
        }
    }

    private string? PlaceholderUrl(KlyImageOptions options)
    {
        if (Placeholder is null) return null;
        if (Placeholder.Address is { } address) return address.Length > 0 ? address : null;

        // Auto: a tiny version from the provider, ten pixels wide placeholder, blurred when the provider supports it.
        var width = Pixels(Width);
        var height = Pixels(Height);
        var tinyHeight = width is > 0 && height is > 0 ? Math.Max(1, (int)Math.Round(10d * height.Value / width.Value)) : (int?)null;
        return Options.Images.ResolvePlaceholder(Src, options, 10, tinyHeight);
    }

    // The pixels that take part in the resolution: only a positive number does.
    private static int? Pixels(int? value) => value is > 0 ? value : null;

    // The width and height attributes: the number as given, so that the browser can reserve the space.
    private static string? Attribute(int? value) => value?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Percent-encodes what could end the url("...") or the style attribute early.
    private static string EscapeCssUrl(string url)
    {
        var builder = new System.Text.StringBuilder(url.Length);
        foreach (var c in url)
        {
            if (c is '"' or '\'' or '(' or ')' or '\\' or '<' or '>' or ' ' or '\n' or '\r' or '\t') builder.Append('%').Append(((int)c).ToString("X2"));
            else builder.Append(c);
        }
        return builder.ToString();
    }
}
