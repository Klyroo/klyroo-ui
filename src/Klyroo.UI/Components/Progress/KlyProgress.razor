@namespace Klyroo.UI
@inherits KlyComponentBase
@using System.Globalization

<div data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Status && !Indeterminate)
    {
        @* The value is already exposed by the progressbar: the visible copy is hidden to avoid reading it twice. *@
        <div class="@_slots["status"]" aria-hidden="true">@Percent%</div>
    }
    <div role="progressbar"
         aria-label="@(AriaLabel ?? Messages.Progress)"
         aria-valuemin="0"
         aria-valuemax="@Number(MaxValue)"
         aria-valuenow="@(Indeterminate ? null : Number(Current))"
         aria-valuetext="@ValueText"
         class="@_slots["base"]">
        <div class="@_slots["indicator"]" style="@(Indeterminate ? null : $"width: {Number(Percent)}%")"></div>
    </div>
    @if (Steps is { Count: > 0 })
    {
        <div class="@_slots["steps"]">
            @for (var i = 0; i < Steps.Count; i++)
            {
                var index = i;
                <span class="@_slots["step"]" data-state="@StepState(index)">@Steps[index]</span>
            }
        </div>
    }
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>
    /// Current value between 0 and the maximum. Null makes the bar indeterminate (no <c>aria-valuenow</c>), for work
    /// of unknown duration. With <see cref="Steps"/> it is the index of the current step.
    /// </summary>
    [Parameter] public double? Value { get; set; }

    /// <summary>Largest value. Ignored when <see cref="Steps"/> is set: the maximum is then the index of the last step.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>Labels of the steps shown under the progress bar. <see cref="Value"/> is the current step's index.</summary>
    [Parameter] public IReadOnlyList<string>? Steps { get; set; }

    /// <summary>Shows the percentage above the bar.</summary>
    [Parameter] public bool Status { get; set; }

    /// <summary>Accessible name of the bar. Defaults to <see cref="KlyMessages.Progress"/>.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;

    /// <summary>Motion of the indeterminate bar. It stops, leaving a full faded bar, when the user prefers reduced motion.</summary>
    [Parameter] public KlyProgressAnimation Animation { get; set; } = KlyProgressAnimation.Carousel;
    [Parameter] public ProgressUi? Ui { get; set; }

    private bool Indeterminate => Value is null;
    private double MaxValue => Steps is { Count: > 0 } ? Math.Max(Steps.Count - 1, 1) : Math.Max(Max, double.Epsilon);
    private double Current => Math.Clamp(Value ?? 0, 0, MaxValue);
    private double Percent => Math.Round(Current / MaxValue * 100, 1);

    private string? ValueText =>
        Indeterminate ? null
        : Steps is { Count: > 0 } ? Steps[Math.Min((int)Math.Round(Current), Steps.Count - 1)]
        : $"{Number(Percent)}%";

    private static string Number(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private string StepState(int index)
    {
        var current = (int)Math.Round(Current);
        return Indeterminate ? "inactive" : index < current ? "completed" : index == current ? "active" : "inactive";
    }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Progress, new Dictionary<string, string?>
        {
            ["size"] = VariantValue.Of(Size),
            ["animation"] = !Indeterminate ? "none" : Animation == KlyProgressAnimation.Swing ? "swing" : "carousel",
        }, Ui, "root");
}
