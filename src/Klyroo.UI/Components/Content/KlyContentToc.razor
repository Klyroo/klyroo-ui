@namespace Klyroo.UI
@implements IDisposable
@inherits KlyComponentBase
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

@*
    A table of contents. <kly-content-toc> (js/content.js) marks the link of the heading being read with
    data-active and aria-current="location", using an IntersectionObserver, and opens and closes the collapsible block
    below the breakpoint. Both happen in the browser; without it the links still jump to their headings.
    The state attributes are not rendered here, so a render never fights the browser over them.
*@
<kly-content-toc data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    <nav aria-label="@(Title ?? Messages.ContentToc)">
        @if (Collapsible)
        {
            <button type="button" data-slot="trigger" class="@_slots["trigger"]" aria-expanded="false" aria-controls="@(_id + "-content")">
                <span>@(Title ?? Messages.ContentToc)</span>
                @RenderIcon(Options.Icons.ChevronDown, _slots["chevron"])
            </button>
        }
        <p class="@_slots["title"]" data-slot="title">@(Title ?? Messages.ContentToc)</p>
        <div id="@(_id + "-content")" data-slot="content" class="@_slots["content"]">
            <ul class="@_slots["list"]">
                @foreach (var link in Links)
                {
                    <li class="@_slots["item"]">
                        <a href="@(_page + "#" + link.Id)" data-level="@Math.Clamp(link.Level, 2, 5)" class="@_slots["link"]">@link.Text</a>
                    </li>
                }
            </ul>
        </div>
    </nav>
</kly-content-toc>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;

    // A bare "#id" resolves against the <base href> of a Blazor app, which is the root: the link would leave the page. The address of the page is
    // relative to that base, never absolute: behind a reverse proxy the absolute address of the request is the internal one (host, port).
    private string _page = "";

    /// <summary>The headings of the page, in document order. Each <c>Id</c> must be the id of an element on the page.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyContentTocLink> Links { get; set; } = [];

    /// <summary>The title, and the accessible name of the navigation. Defaults to the built-in text.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The color of the link of the heading being read.</summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;

    /// <summary>
    /// Collapses the list behind its title below <see cref="Breakpoint"/>, as a disclosure button. Above it, and without
    /// this, the list is always shown.
    /// </summary>
    [Parameter] public bool Collapsible { get; set; } = true;
    [Parameter] public KlyContentTocBreakpoint Breakpoint { get; set; } = KlyContentTocBreakpoint.Lg;
    [Parameter] public ContentTocUi? Ui { get; set; }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    // Enhanced navigation to the same page with another query string: the links keep pointing at the page being read.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var page = PageOf(e.Location);
        if (page != _page)
        {
            _page = page;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private string PageOf(string uri)
    {
        string relative;
        try
        {
            relative = Navigation.ToBaseRelativePath(uri);
        }
        catch (ArgumentException)
        {
            // An address outside the base of the app: keep it as it is.
            relative = uri;
        }
        var hash = relative.IndexOf('#');
        return hash < 0 ? relative : relative[..hash];
    }

    protected override void OnParametersSet()
    {
        _id ??= NewId("toc");
        _page = PageOf(Navigation.Uri);
        _slots = ResolveSlots(Options.ContentToc, new Dictionary<string, string?>
        {
            ["breakpoint"] = Breakpoint switch { KlyContentTocBreakpoint.Xl => "xl", KlyContentTocBreakpoint.Xxl => "2xl", _ => "lg" },
            ["collapsible"] = VariantValue.Of(Collapsible),
        }, Ui, "root");
    }
}
