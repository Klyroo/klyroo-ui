@namespace Klyroo.UI
@using System.Globalization
@using Klyroo.UI.Internal
@inherits KlyFieldBase<double>

@if (UseEditContext)
{
    <ValueBridge TValue="double" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Context="binding">@Markup(binding)</ValueBridge>
}
else
{
    @Markup(new EditBinding(Name, Field?.Invalid == true))
}

@code {

    private SlotSet _slots = default!;

    /// <summary>Number of stars. The value goes from 0 (nothing chosen) to this.</summary>
    [Parameter] public int Max { get; set; } = 5;

    /// <summary>Lets a star be chosen by halves (0.5, 1, 1.5…).</summary>
    [Parameter] public bool AllowHalf { get; set; }

    /// <summary>Shows the value without letting it change. Rendered as an image with a text alternative, still posting the value.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Accessible name of the group when no <see cref="KlyFormField"/> label is around.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the input rating, see <see cref="InputRatingUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public InputRatingUi? Ui { get; set; }

    private double StepSize => AllowHalf ? 0.5 : 1;

    /// <inheritdoc />
    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.InputRating, new Dictionary<string, string?>
        {
            ["size"] = VariantValue.Of(EffectiveSize),
            ["half"] = VariantValue.Of(AllowHalf && !ReadOnly),
            ["readonly"] = VariantValue.Of(ReadOnly),
        }, Ui, "root");

    private static string Invariant(double value) => value.ToString(CultureInfo.InvariantCulture);

    private string Describe(double value) => string.Format(FormatCulture, Messages.InputRatingValue, Invariant(value), Max);

    // Lowest value first, in reading order: the native radio keys then move like the stars look (Right raises the
    // rating, Left lowers it). A star is filled by CSS when its own radio or any later one is checked.
    private IEnumerable<double> Choices()
    {
        for (var v = StepSize; v <= Max; v += StepSize) yield return v;
    }

    private RenderFragment Star(double value, EditBinding binding)
    {
        var id = $"{ControlId}-{Invariant(value).Replace('.', '-')}";
        var half = AllowHalf ? (value % 1 == 0 ? "right" : "left") : null;
        var chosen = value;
        var onChange = ValueChanged.HasDelegate
            ? EventCallback.Factory.Create<ChangeEventArgs>(this, async () =>
            {
                Value = chosen;
                await ValueChanged.InvokeAsync(chosen);
                NotifyFieldChanged();
            })
            : default;
        return @<text>
            <input type="radio" id="@id" name="@(binding.Name ?? ControlId)" value="@Invariant(value)" checked="@(Value == value)" disabled="@Disabled"
                   class="@_slots["input"]" aria-label="@Describe(value)" @onchange="onChange" />
            <label for="@id" class="@_slots["star"]" data-half="@half" data-slot="star" aria-hidden="true">
                @RenderIcon(Options.Icons.Star, _slots["icon"])
            </label>
        </text>;
    }

    private RenderFragment Markup(EditBinding binding) =>
        ReadOnly ? ReadOnlyMarkup(binding) :
        @<div id="@ControlId" role="radiogroup" class="@binding.WithFieldClass(_slots["root"])" data-color="@Color.Value"
              aria-label="@AriaLabel" aria-labelledby="@(AriaLabel is null ? Field?.LabelId : null)" aria-describedby="@Field?.DescribedBy"
              aria-invalid="@(binding.Invalid ? "true" : null)" aria-required="@(Required || Field?.Required == true ? "true" : null)"
              @attributes="AdditionalAttributes">
            @foreach (var value in Choices())
            {
                @Star(value, binding)
            }
        </div>;

    private RenderFragment ReadOnlyMarkup(EditBinding binding) =>
        @<div id="@ControlId" role="img" class="@_slots["root"]" data-color="@Color.Value" aria-label="@Describe(Value)" aria-describedby="@Field?.DescribedBy"
              @attributes="AdditionalAttributes">
            @if (binding.Name is not null)
            {
                <input type="hidden" name="@binding.Name" value="@Invariant(Value)" />
            }
            @for (var i = 1; i <= Max; i++)
            {
                var index = i;
                var fill = Value >= index ? "full" : (Value >= index - 0.5 ? "half" : null);
                <span class="@_slots["star"]" aria-hidden="true">
                    @RenderIcon(Options.Icons.Star, _slots["icon"])
                    @if (fill is not null)
                    {
                        <span class="@_slots["fill"]" data-fill="@fill">
                            @RenderIcon(Options.Icons.Star, _slots["filledIcon"])
                        </span>
                    }
                </span>
            }
        </div>;
}
