@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A full chat panel: the messages take the room that is left and the prompt stays pinned under them. It fills the height of
    its parent, so give the parent a height (a modal body, a slideover, a bordered box). Messages inside are meant to be
    compact; KlyChatMessage has Compact for that.
*@
<div class="@_slots["root"]" @attributes="AdditionalAttributes">
    <div class="@_slots["content"]" data-slot="content">
        @ChildContent
    </div>
    @if (Prompt is not null)
    {
        <div class="@_slots["prompt"]" data-slot="prompt">
            @Prompt
        </div>
    }
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The conversation: a <see cref="KlyChatMessages"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The message form, pinned to the bottom: a <see cref="KlyChatPrompt"/>.</summary>
    [Parameter] public RenderFragment? Prompt { get; set; }
    [Parameter] public ChatPaletteUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.ChatPalette, new Dictionary<string, string?>(), Ui, "root");
}
