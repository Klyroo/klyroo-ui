@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A tool call of the assistant: its name, whether it runs or failed, and optionally what it was given and returned. With
    ChildContent the block is collapsible (<kly-chat-disclosure>); without it, it is a plain line. Streaming makes the
    name shimmer; Actions go below the name (an approval, say).
*@
@if (ChildContent is not null)
{
    <kly-chat-disclosure data-kly-seq="@(OpenChanged.HasDelegate ? _sequence : null)"
                        open="@Open"
                        data-state="@(Open ? "open" : "closed")"
                        data-streaming="@(Streaming ? "true" : null)"
                        class="@_slots["root"]"
                        @onklytoggle="ToggleHandler"
                        @onklytoggle:stopPropagation="true"
                        @attributes="AdditionalAttributes">
        <button type="button" data-kly-disclosure-trigger id="@($"{_id}-trigger")" aria-controls="@($"{_id}-content")"
                aria-expanded="@(Open ? "true" : "false")" disabled="@Disabled" class="@_slots["trigger"]">
            @Line
            @if (Chevron == ChatChevron.Trailing)
            {
                @RenderIcon(Options.Icons.ChevronDown, _slots["chevronIcon"])
            }
        </button>
        @if (Actions is not null)
        {
            <div class="@_slots["actions"]" data-slot="actions">@Actions</div>
        }
        <div id="@($"{_id}-content")" data-kly-disclosure-content hidden="@(Open ? null : "until-found")" class="@_slots["content"]">
            <div role="group" tabindex="0" aria-labelledby="@($"{_id}-trigger")" class="@_slots["body"]">
                @ChildContent
            </div>
        </div>
    </kly-chat-disclosure>
}
else
{
    <div class="@_slots["root"]" data-state="closed" @attributes="AdditionalAttributes">
        <div class="@_slots["trigger"]" data-slot="trigger">
            @Line
        </div>
        @if (Actions is not null)
        {
            <div class="@_slots["actions"]" data-slot="actions">@Actions</div>
        }
    </div>
}

@code {
    private SlotSet _slots = default!;
    private string _id = default!;
    private int _sequence;

    /// <summary>The name of the tool call: "Searching the web".</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Quieter text after the name: the query, the file.</summary>
    [Parameter] public string? Suffix { get; set; }

    /// <summary>What the tool was given and returned. Setting it makes the block collapsible.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>An icon before the name, replaced by a spinner while loading and by an alert on error.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>The call is running: a spinner replaces the icon.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The call failed: error colors, and "failed" is read out after the name.</summary>
    [Parameter] public bool Error { get; set; }

    /// <summary>The name shimmers, as the arguments or the output still stream in.</summary>
    [Parameter] public bool Streaming { get; set; }
    [Parameter] public ChatToolVariant Variant { get; set; }
    [Parameter] public ChatChevron Chevron { get; set; } = ChatChevron.Trailing;
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Below the name, outside the collapsible part: approve and deny buttons.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Open state. Bind it with <c>@bind-Open</c> to hear about changes; unbound, nothing leaves the browser.</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public ChatToolUi? Ui { get; set; }

    private EventCallback<KlyToggleEventArgs> ToggleHandler =>
        OpenChanged.HasDelegate ? EventCallback.Factory.Create<KlyToggleEventArgs>(this, OnToggle) : default;

    private RenderFragment Line => @<text>
        @if (ChildContent is not null && Chevron == ChatChevron.Leading)
        {
            @RenderIcon(Options.Icons.ChevronDown, _slots["chevronIcon"])
        }
        @if (Loading)
        {
            @RenderIcon(Options.Icons.Loading, _slots["leadingIcon"] + " " + _slots["spin"])
        }
        else if (Error)
        {
            @RenderIcon(Options.Icons.Caution, _slots["leadingIcon"])
        }
        else if (Icon is not null)
        {
            <span class="@_slots["leading"]" aria-hidden="true">@Icon</span>
        }
        <span class="@_slots["label"]">
            @if (Streaming)
            {
                <KlyChatShimmer Text="@Text" />
            }
            else
            {
                @Text
            }
        </span>
        @if (Suffix is not null)
        {
            <span class="@_slots["suffix"]">@Suffix</span>
        }
        @if (Loading)
        {
            <span class="@_slots["srOnly"]">(@Messages.ChatToolRunning)</span>
        }
        else if (Error)
        {
            <span class="@_slots["srOnly"]">(@Messages.ChatToolFailed)</span>
        }
    </text>;

    protected override void OnParametersSet()
    {
        _id ??= NewId("tool");
        _slots = ResolveSlots(Options.ChatTool, new Dictionary<string, string?>
        {
            ["variant"] = Variant == ChatToolVariant.Card ? "card" : "inline",
            ["error"] = VariantValue.Of(Error),
        }, Ui, "root");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(KlyToggleEventArgs))]
    private async Task OnToggle(KlyToggleEventArgs e)
    {
        _sequence = e.Sequence;
        if (e.Open == Open) return;
        Open = e.Open;
        await OpenChanged.InvokeAsync(e.Open);
    }
}
