@namespace Klyroo.UI
@inherits KlyComponentBase
@using Klyroo.UI.Internal

@*
    With Href the title is the one link of the feature and its box stretches over the whole feature, so there is a
    single focus stop and no nested interactive element.
*@
<div data-color="@Color.Value" class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <span class="@_slots["leading"]" aria-hidden="true" data-slot="leading">
            <KlyIcon Name="@Icon" Class="@_slots["leadingIcon"]" />
        </span>
    }
    <div class="@_slots["wrapper"]">
        @if (Title is not null)
        {
            @if (HeadingLevel is { } level)
            {
                <SectionHeading Level="level" Class="@_slots["title"]">@TitleContent</SectionHeading>
            }
            else
            {
                <p class="@_slots["title"]" data-slot="title">@TitleContent</p>
            }
        }
        @if (Description is not null)
        {
            <p class="@_slots["description"]" data-slot="description">@Description</p>
        }
        @ChildContent
    </div>
</div>

@code {
    private SlotSet _slots = default!;

    private RenderFragment TitleContent => @<text>
        @if (Href is null)
        {
            @Title
        }
        else
        {
            <a href="@Href" target="@Target" rel="@(Target == "_blank" ? "noopener noreferrer" : null)" class="@_slots["link"]" data-slot="link">@Title@if (Target == "_blank") {<span class="sr-only"> @Messages.OpensInNewTab</span>}</a>
        }
    </text>;

    /// <summary>Name of a built-in icon (see <see cref="KlyIcon"/>).</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Title of the page feature.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Secondary text of the page feature, shown under or next to its title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Makes the whole feature a link, carried by the title.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>The <c>target</c> attribute of the link of the feature, such as <c>_blank</c>. It applies when <c>Href</c> is set.</summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>Extra content under the description. Interactive content would sit under the stretched link: give it <c>relative z-10</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>
    /// Semantic color of the page feature: a built-in <see cref="KlyColor"/> or the name of a color you defined. When not set, <see cref="KlyDefaults.Color"/> applies, else the default of the component.
    /// </summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;

    /// <summary>Horizontal puts the icon before the text; vertical puts it above.</summary>
    [Parameter] public KlyOrientation Orientation { get; set; } = KlyOrientation.Horizontal;

    /// <summary>Renders the title as a heading of this level (1 to 6) instead of a paragraph.</summary>
    [Parameter] public int? HeadingLevel { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the page feature, see <see cref="PageFeatureUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public PageFeatureUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.PageFeature, new Dictionary<string, string?>
        {
            ["orientation"] = Orientation == KlyOrientation.Vertical ? "vertical" : "horizontal",
            ["link"] = VariantValue.Of(Href is not null),
        }, Ui, "root");
}
