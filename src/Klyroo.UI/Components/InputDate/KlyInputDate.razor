@namespace Klyroo.UI
@using System.Globalization
@using Klyroo.UI.Internal
@typeparam TValue
@inherits KlyFieldBase<TValue>

@*
    A native date input (typed segments in the browser's locale, always posting yyyy-MM-dd) next to a button that opens a KlyCalendar
    in a kly-popover. <kly-date-field> keeps the two in step in the browser, so it works in static rendering too.
*@
<kly-date-field class="@_slots["root"]" data-color="@Color.Value">
    @if (UseEditContext)
    {
        <InputDate TValue="TValue" Value="@Value" ValueChanged="EditChangeHandler" ValueExpression="ValueExpression" @attributes="Attributes()" />
    }
    else if (ValueChanged.HasDelegate)
    {
        <input name="@Name" type="date" value="@Iso.Date(Day)" @onchange="OnNativeChange" @attributes="Attributes()" />
    }
    else
    {
        <input name="@Name" type="date" value="@Iso.Date(Day)" @attributes="Attributes()" />
    }
    <span class="@_slots["trigger"]">
        <KlyPopover Placement="KlyPlacement.BottomEnd" AriaLabel="@Messages.ChooseDate" Class="@_slots["content"]">
            <ChildContent>
                <button type="button" class="@_slots["triggerButton"]" aria-label="@Messages.ChooseDate" disabled="@Disabled">
                    @RenderIcon(Options.Icons.Calendar, _slots["triggerIcon"])
                </button>
            </ChildContent>
            <Content>
                <KlyCalendar Value="@Day" Min="Min" Max="Max" Culture="Culture" WeekStart="WeekStart" Size="EffectiveSize" Color="Color" />
            </Content>
        </KlyPopover>
    </span>
</kly-date-field>

@code {
    private SlotSet _slots = default!;

    private static DateCodec<TValue> Codec => DateCodec<TValue>.Instance;

    // The day the field shows, whatever the type of the bound value.
    private DateOnly? Day => Codec.ToDate(Value);

    /// <summary>Earliest date, for the input and the calendar. A day (<c>DateOnly</c>) whatever the bound type: use <c>DateOnly.FromDateTime(...)</c> to limit a <c>DateTime</c> field.</summary>
    [Parameter] public DateOnly? Min { get; set; }

    /// <summary>Latest date, for the input and the calendar.</summary>
    [Parameter] public DateOnly? Max { get; set; }

    /// <summary>Source of the calendar's month and day names. Defaults to the format culture of the locale in effect (the regional current culture when it has the same language).</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>First column of the calendar. Defaults to the culture's first day of the week.</summary>
    [Parameter] public DayOfWeek? WeekStart { get; set; }
    /// <summary>Look of the field: <c>Outline</c>, <c>Soft</c>, <c>Subtle</c>, <c>Ghost</c> or <c>None</c>.</summary>
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Outline;
    /// <summary>
    /// Per-instance class overrides of the slots of the input date, see <see cref="InputDateUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public InputDateUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.InputDate, new Dictionary<string, string?>
        {
            ["variant"] = VariantValue.Of(Variant),
            ["size"] = VariantValue.Of(EffectiveSize),
        }, Ui, "root");

    private EventCallback<TValue> EditChangeHandler => EventCallback.Factory.Create<TValue>(this, OnEditChange);

    // InputDate parses the day to midnight; the value keeps the time (and offset) of the one it replaces.
    private async Task OnEditChange(TValue parsed)
    {
        var value = Codec.FromDate(Codec.ToDate(parsed), Value);
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task OnNativeChange(ChangeEventArgs e)
    {
        var date = Iso.ParseDate(e.Value?.ToString());
        if (date == Day)
        {
            return;
        }
        var value = Codec.FromDate(date, Value);
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private Dictionary<string, object> Attributes()
    {
        var attributes = ControlAttributes(_slots["base"]);
        if (Min is not null) attributes["min"] = Iso.Date(Min)!;
        if (Max is not null) attributes["max"] = Iso.Date(Max)!;
        return attributes;
    }
}
