@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    The root wrapper of an app, placed once in the layout around @Body. It renders the toaster (so IToastService
    works), sets the language and text direction of the tree, and cascades global class overrides to every component
    through a KlyTheme. It also resolves the locale (its Locale parameter, else the one of AddKlyrooUi, else the one matching
    the current UI culture), cascades it to every component and writes it as lang and dir. The locale is cascaded as a
    fixed value, so a re-render of the app (each navigation re-renders the layout) does not re-render every component
    below it; changing the locale re-creates the subtree (and the state of the components in it) with the new texts. Replace a hand-placed <KlyToaster /> with it, never keep both.
    The overrides are cascading values: they do not cross a render mode boundary. Where a page or a component sets its
    own @rendermode (per-page interactivity), the components inside it do not see them: place a KlyApp or KlyTheme inside
    that island too, or use AddKlyrooUi for overrides that must apply everywhere.
    In a Blazor Hybrid web view the culture chosen with KlyLocaleSelect (IKlyCultureStore) is applied before the content renders.
    SpatialNavigation turns on the remote control mode for TV screens (experimental).
*@
@if (_locale is not null)
{
    <CascadingValue Value="_locale" IsFixed="true" @key="_localeKey">
        <KlyTheme Overrides="Overrides">
            <div class="@_slots["root"]" lang="@(Lang ?? _locale.Code)" dir="@(Dir ?? _locale.DirAttribute)" @attributes="AdditionalAttributes">
                @if (SpatialNavigation)
                {
                    <kly-spatial hidden></kly-spatial>
                }
                @ChildContent
                @if (Toaster)
                {
                    <KlyToaster Duration="ToastDuration" />
                }
            </div>
        </KlyTheme>
    </CascadingValue>
}

@code {
    private SlotSet _slots = default!;
    private KlyLocale? _locale;
    private int _localeKey;

    [Inject] private IServiceProvider Services { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Renders the <see cref="KlyToaster"/> after the content. Turn it off when the app places its own.</summary>
    [Parameter] public bool Toaster { get; set; } = true;

    /// <summary>How long a toast stays on screen.</summary>
    [Parameter] public TimeSpan ToastDuration { get; set; } = TimeSpan.FromSeconds(5);

    /// <summary>
    /// The locale of every component below: texts, writing direction and the culture used to format dates and numbers.
    /// Defaults to the locale of an enclosing <c>KlyApp</c>, then <see cref="KlyrooOptions.Locale"/>, then the one matching
    /// the current UI culture among <see cref="KlyrooOptions.Locales"/>.
    /// </summary>
    [Parameter] public KlyLocale? Locale { get; set; }

    /// <summary>Language of the content (the <c>lang</c> attribute), for example "fr". Defaults to the code of the locale.</summary>
    [Parameter] public string? Lang { get; set; }

    /// <summary>Text direction (the <c>dir</c> attribute): "ltr", "rtl" or "auto". Defaults to the direction of the locale.</summary>
    [Parameter] public string? Dir { get; set; }

    /// <summary>
    /// Turns on the remote control mode for TV screens (experimental, opt in): the arrow keys move focus to the nearest focusable element in
    /// that direction, the focus ring is thick and the sizes are larger (<c>data-kly-tv</c> on the <c>html</c> element). See the MAUI guide.
    /// </summary>
    [Parameter] public bool SpatialNavigation { get; set; }

    /// <summary>
    /// In a Blazor Hybrid web view, applies the culture saved by <see cref="KlyLocaleSelect"/> (<see cref="IKlyCultureStore"/>) before the content
    /// renders, unless <see cref="Locale"/> is set. Turn it off when the app applies its own culture in <c>MauiProgram</c>. It does nothing in a browser.
    /// </summary>
    [Parameter] public bool ApplyStoredCulture { get; set; } = true;

    /// <summary>Class overrides for every component below, by component type. See <see cref="KlyTheme"/>.</summary>
    [Parameter] public IReadOnlyDictionary<Type, Klyroo.UI.Theming.ISlotOverrides>? Overrides { get; set; }
    [Parameter] public AppUi? Ui { get; set; }

    private System.Globalization.CultureInfo? _stored;
    private bool _storedApplied;

    // Only reads the store here: a culture assigned inside an async method does not flow back to the caller.
    protected override async Task OnInitializedAsync()
    {
        if (!IsHybrid || !ApplyStoredCulture || Locale is not null) return;
        if (Services.GetService(typeof(IKlyCultureStore)) is not IKlyCultureStore store) return;
        var supported = Options.Locales.Select(l => l.Code).ToArray();
        _stored = KlyCultureStoreMatch.Match(await store.GetAsync(), supported);
    }

    protected override void OnParametersSet()
    {
        if (_stored is not null && !_storedApplied)
        {
            _storedApplied = true;
            KlyCultureStoreMatch.Apply(_stored);
        }
        var locale = Locale ?? (_stored is not null ? Options.ResolveLocale(_stored) : CurrentLocale);
        if (_locale is null)
        {
            _locale = locale;
        }
        else if (!_locale.Equals(locale))
        {
            // The value is cascaded as fixed, so components below do not re-render each time this app does. A new locale
            // gets a new key: the cascading value and everything below it are created again with the new texts.
            _locale = locale;
            _localeKey++;
        }
        _slots = ResolveSlots(Options.App, new Dictionary<string, string?>(), Ui, "root");
    }
}
