@namespace Klyroo.UI
@inherits KlyComponentBase

<div role="group" aria-label="@AriaLabel" class="@_slots["root"]" @attributes="AdditionalAttributes">
    @foreach (var item in Visible)
    {
        var label = Label(item);
        <KlyAvatar Src="@item.Src" Alt="@label" Text="@(item.Text ?? (item.Alt is null ? null : Initials(item.Alt)))" Color="item.Color" Size="@Size" Class="@_slots["avatar"]" title="@label" />
    }
    @if (Hidden > 0)
    {
        <KlyAvatar Text="@($"+{Hidden}")" Alt="@string.Format(Messages.MoreAvatars, Hidden)" Size="@Size" Class="@_slots["avatar"]" />
    }
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The avatars to show, as <see cref="KlyAvatarItem"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyAvatarItem> Items { get; set; } = [];

    /// <summary>Most avatars to show; the others collapse into a "+N" avatar. Null shows them all.</summary>
    [Parameter] public int? Max { get; set; }
    /// <summary>Size of the avatar group, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;

    /// <summary>Accessible name of the group ("Project members").</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the avatar group, see <see cref="AvatarGroupUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public AvatarGroupUi? Ui { get; set; }

    // The tooltip and the accessible name: the name, then the description and the badge when there are any (the stack has no room for text).
    private static string? Label(KlyAvatarItem item) =>
        item.Description is null && item.Badge is null
            ? item.Alt
            : string.Join(" · ", new[] { item.Alt, item.Description, item.Badge?.Label }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // The initials KlyAvatar derives from a name (the first letters of its first two words), taken from the name alone so a tooltip text does not leak into them.
    private static string Initials(string? name) =>
        string.Concat((name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));

    private IEnumerable<KlyAvatarItem> Visible => Max is { } max && max >= 0 ? Items.Take(max) : Items;
    private int Hidden => Max is { } max && max >= 0 ? Math.Max(Items.Count - max, 0) : 0;

    /// <inheritdoc />
    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.AvatarGroup, new Dictionary<string, string?>(), Ui, "root");
}
