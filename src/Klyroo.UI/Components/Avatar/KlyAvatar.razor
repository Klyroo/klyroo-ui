@namespace Klyroo.UI
@inherits KlyComponentBase

@* The root is the image and carries the name, so it stays named when the picture fails and the fallback shows. *@
<span class="@_slots["root"]"
      role="img"
      aria-label="@(Alt ?? Text)"
      @attributes="AdditionalAttributes">
    <span class="@_slots["fallback"]" aria-hidden="true">
        @if (Icon is not null)
        {
            @Icon
        }
        else
        {
            @Initials
        }
    </span>
    @if (Src is not null)
    {
        @* Hidden by Klyroo.UI.lib.module.js when it fails to load, uncovering the fallback. *@
        <KlyImage Src="@Src" Alt="" Width="_pixels" Height="_pixels" ImageOptions="ImageOptions" Class="@_slots["image"]" data-kly-avatar-image />
    }
</span>

@code {
    private SlotSet _slots = default!;

    [Parameter] public string? Src { get; set; }

    /// <summary>Text alternative; its initials are shown when there is no image or it fails to load.</summary>
    [Parameter] public string? Alt { get; set; }

    /// <summary>Fallback text instead of the initials of <see cref="Alt"/>.</summary>
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;
    [Parameter] public AvatarUi? Ui { get; set; }

    /// <summary>
    /// Image settings forwarded to <see cref="KlyImage"/>: <c>new KlyImageOptions { Format = "webp", Quality = 80 }</c>.
    /// The avatar passes its size in pixels as the width and the height, so a provider can serve a picture of that size.
    /// </summary>
    [Parameter] public KlyImageOptions? ImageOptions { get; set; }

    private int _pixels;

    private string Initials => Text ?? string.Concat((Alt ?? "")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(word => char.ToUpperInvariant(word[0])));

    // The pixel sizes of the size-6 to size-12 classes of the theme.
    internal static int Pixels(KlySize size) => size switch
    {
        KlySize.Xs => 24,
        KlySize.Sm => 28,
        KlySize.Lg => 40,
        KlySize.Xl => 48,
        _ => 32,
    };

    protected override void OnParametersSet()
    {
        _pixels = Pixels(Size);
        _slots = ResolveSlots(Options.Avatar, new Dictionary<string, string?> { ["size"] = VariantValue.Of(Size) }, Ui, "root");
    }
}
