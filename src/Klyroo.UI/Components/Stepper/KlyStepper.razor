@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A list of steps; the current one carries aria-current="step". Steps before it are completed.
    Static by default (renders in every mode). With CurrentChanged bound, steps become buttons, inert until interactive.
*@
<div data-color="@Color.Value" data-orientation="@_orientation" class="@_slots["root"]" @attributes="AdditionalAttributes">
    <ol aria-label="@AriaLabel" class="@_slots["list"]">
        @for (var i = 0; i < Items.Count; i++)
        {
            var index = i;
            var item = Items[index];
            var state = index < _current ? "completed" : index == _current ? "active" : "inactive";
            <li data-state="@state" aria-current="@(index == _current ? "step" : null)" class="@_slots["item"]">
                <div class="@_slots["track"]">
                    @if (Interactive && !item.Disabled)
                    {
                        <button type="button" disabled="@(!RendererInfo.IsInteractive)" aria-label="@($"{index + 1}. {item.Title}")" data-state="@state" class="@_slots["indicator"]"
                                @onclick="@(() => Select(index))">@Indicator(item, index, state)</button>
                    }
                    else
                    {
                        <span data-state="@state" class="@_slots["indicator"]">@Indicator(item, index, state)</span>
                    }
                    @if (index < Items.Count - 1)
                    {
                        <span aria-hidden="true" data-state="@state" class="@_slots["separator"]"></span>
                    }
                </div>
                <div class="@_slots["text"]">
                    <span class="@_slots["title"]">
                        @item.Title
                        @if (state == "completed")
                        {
                            <span class="@_slots["status"]">(@Messages.StepCompleted)</span>
                        }
                    </span>
                    @if (item.Description is not null)
                    {
                        <span class="@_slots["description"]">@item.Description</span>
                    }
                </div>
            </li>
        }
    </ol>
    @if (_current >= 0 && _current < Items.Count && Items[_current].Content is { } content)
    {
        <div class="@_slots["content"]">@content</div>
    }
</div>

@code {
    private SlotSet _slots = default!;
    private int _current;
    private string _orientation = "horizontal";

    /// <summary>The steps, as <see cref="KlyStepperItem"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyStepperItem> Items { get; set; } = [];

    /// <summary>Index of the current step, starting at 0. Earlier steps are completed.</summary>
    [Parameter] public int Current { get; set; }

    /// <summary>Bind it to let users click a step; without it the stepper only displays progress.</summary>
    [Parameter] public EventCallback<int> CurrentChanged { get; set; }
    /// <summary>Direction of the layout: <c>Horizontal</c> or <c>Vertical</c>.</summary>
    [Parameter] public KlyOrientation Orientation { get; set; } = KlyOrientation.Horizontal;
    /// <summary>
    /// Semantic color of the stepper: a built-in <see cref="KlyColor"/> or the name of a color you defined. When not set, <see cref="KlyDefaults.Color"/> applies, else the default of the component.
    /// </summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;
    /// <summary>Size of the stepper, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;

    /// <summary>Accessible name of the list of steps.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the stepper, see <see cref="StepperUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public StepperUi? Ui { get; set; }

    private bool Interactive => CurrentChanged.HasDelegate;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _current = Items.Count == 0 ? -1 : Math.Clamp(Current, 0, Items.Count - 1);
        _orientation = Orientation == KlyOrientation.Vertical ? "vertical" : "horizontal";
        _slots = ResolveSlots(Options.Stepper, new Dictionary<string, string?>
        {
            ["orientation"] = _orientation,
            ["size"] = VariantValue.Of(Size),
        }, Ui, "root");
    }

    private async Task Select(int index)
    {
        if (index == _current) return;
        Current = index;
        _current = index;
        await CurrentChanged.InvokeAsync(index);
    }

    private RenderFragment Indicator(KlyStepperItem item, int index, string state) =>
        @<text>
            @if (item.Icon is not null)
            {
                <span class="@_slots["icon"]" aria-hidden="true">@item.Icon</span>
            }
            else if (state == "completed")
            {
                @RenderIcon(Options.Icons.Check, _slots["icon"])
            }
            else
            {
                <span aria-hidden="true">@(index + 1)</span>
            }
        </text>;
}
