@namespace Klyroo.UI
@using Klyroo.UI.Internal
@inherits KlyComponentBase
@implements IDisposable
@inject NavigationManager Navigation

@* A disabled link has no href, so it cannot be followed or focused. *@
<a href="@(Disabled ? null : Href)"
   target="@Target?.Value"
   role="@(Disabled ? "link" : null)"
   aria-disabled="@(Disabled ? "true" : null)"
   aria-current="@(IsActive ? "page" : null)"
   class="@ClassValue(IsActive)"
   @attributes="AdditionalAttributes"
   rel="@LinkRel.For(Target, AdditionalAttributes)">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Label)))@if (!Disabled && Target is { IsBlank: true }) {<span class="sr-only"> @Messages.OpensInNewTab</span>}</a>

@code {
    private bool _subscribed;

    /// <summary>Address the link points to. A link without it is not followable.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>Text of the link. Use <c>ChildContent</c> for markup.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Content of the link.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The <c>target</c> attribute, such as <see cref="KlyLinkTarget.Blank"/>.</summary>
    [Parameter] public KlyLinkTarget? Target { get; set; }

    /// <summary>
    /// Requires the whole path to match to be active. Without it the link is also active on the pages below its path
    /// ("/docs" is active on "/docs/theming"), except a link to the root of the app, which is always exact.
    /// The query string and the fragment never take part in the comparison.
    /// </summary>
    [Parameter] public bool Exact { get; set; }

    /// <summary>Forces the active state instead of comparing <see cref="Href"/> with the current address.</summary>
    [Parameter] public bool? Active { get; set; }

    /// <summary>Classes added while the link is active, merged after the theme.</summary>
    [Parameter] public string? ActiveClass { get; set; }

    /// <summary>Classes added while the link is not active, merged after the theme.</summary>
    [Parameter] public string? InactiveClass { get; set; }
    /// <summary>Renders the link without an <c>href</c>, so it cannot be followed or focused.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Drops the theme classes, keeping only <see cref="KlyComponentBase.Class"/>, <see cref="ActiveClass"/> and <see cref="InactiveClass"/>.</summary>
    [Parameter] public bool Raw { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the link, see <see cref="LinkUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public LinkUi? Ui { get; set; }

    private bool IsActive => Active ?? (Href is not null && Matches(Href));

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // Static rendering never changes address in place; an interactive page follows navigation.
        if (RendererInfo.IsInteractive)
        {
            Navigation.LocationChanged += OnLocationChanged;
            _subscribed = true;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose()
    {
        if (_subscribed)
        {
            Navigation.LocationChanged -= OnLocationChanged;
        }
    }

    private string ClassValue(bool isActive)
    {
        var state = isActive ? ActiveClass : InactiveClass;
        if (Raw)
        {
            return Resolver.Merge(Class, state);
        }
        var themed = ResolveSlots(Options.Link, new Dictionary<string, string?>
        {
            ["active"] = VariantValue.Of(isActive),
            ["disabled"] = VariantValue.Of(Disabled),
        }, Ui, "base")["base"];
        return state is null ? themed : Resolver.Merge(themed, state);
    }

    private bool Matches(string href) => LinkMatcher.Matches(Navigation, href, Exact);
}
