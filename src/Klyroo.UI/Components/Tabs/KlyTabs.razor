@namespace Klyroo.UI
@inherits KlyComponentBase

@* WAI-ARIA tabs. Selection happens in the browser; the server renders the initial one, so it reads right without scripts. *@
<kly-tabs data-kly-seq="@(ValueChanged.HasDelegate ? _sequence : null)"
         value="@Current"
         orientation="@(Orientation == KlyOrientation.Vertical ? "vertical" : "horizontal")"
         class="@_slots["root"]"
         data-color="@Color.Value"
         @onklychange="ChangeHandler"
         @onklychange:stopPropagation="true"
         @attributes="AdditionalAttributes">
    <div role="tablist" aria-orientation="@(Orientation == KlyOrientation.Vertical ? "vertical" : null)" aria-label="@AriaLabel" class="@_slots["list"]">
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var value = ValueOf(item, i);
            var selected = value == Current;
            <button type="button" role="tab" id="@($"{_id}-tab-{i}")" aria-controls="@($"{_id}-panel-{i}")"
                    aria-selected="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                    data-value="@value" data-state="@(selected ? "active" : "inactive")"
                    disabled="@item.Disabled" class="@_slots["trigger"]">
                @if (item.Icon is not null)
                {
                    <span class="@_slots["icon"]" aria-hidden="true">@item.Icon</span>
                }
                <span class="@_slots["label"]">@item.Label</span>
            </button>
        }
    </div>
    @for (var i = 0; i < Items.Count; i++)
    {
        var item = Items[i];
        var value = ValueOf(item, i);
        <div role="tabpanel" id="@($"{_id}-panel-{i}")" aria-labelledby="@($"{_id}-tab-{i}")" data-value="@value"
             hidden="@(value != Current)" tabindex="0" class="@_slots["content"]">
            @item.Content
        </div>
    }
</kly-tabs>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;
    private int _sequence;

    /// <summary>The tabs, as <see cref="KlyTabItem"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KlyTabItem> Items { get; set; } = [];

    /// <summary>Value of the selected tab. Defaults to the first enabled one.</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Raised with the value of the selected tab when the user picks another one.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>Look of the tabs: <c>Pill</c> or <c>Link</c>.</summary>
    [Parameter] public TabsVariant Variant { get; set; } = TabsVariant.Pill;
    /// <summary>Direction of the layout: <c>Horizontal</c> or <c>Vertical</c>.</summary>
    [Parameter] public KlyOrientation Orientation { get; set; } = KlyOrientation.Horizontal;
    /// <summary>
    /// Semantic color of the tabs: a built-in <see cref="KlyColor"/> or the name of a color you defined. When not set, <see cref="KlyDefaults.Color"/> applies, else the default of the component.
    /// </summary>
    [Parameter] public KlyColor Color { get => _colorParameter ?? DefaultColor(KlyColor.Primary); set => _colorParameter = value; }
    private KlyColor? _colorParameter;

    /// <summary>Accessible name of the tab list.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the tabs, see <see cref="TabsUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public TabsUi? Ui { get; set; }

    private string? Current => Value ?? FirstEnabled();

    private string? FirstEnabled()
    {
        for (var i = 0; i < Items.Count; i++)
        {
            if (!Items[i].Disabled) return ValueOf(Items[i], i);
        }
        return null;
    }

    private EventCallback<KlyChangeEventArgs> ChangeHandler =>
        ValueChanged.HasDelegate ? EventCallback.Factory.Create<KlyChangeEventArgs>(this, OnChange) : default;

    private static string ValueOf(KlyTabItem item, int index) => item.Value ?? index.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _id ??= NewId("tabs");
        _slots = ResolveSlots(Options.Tabs, new Dictionary<string, string?>
        {
            ["variant"] = Variant == TabsVariant.Link ? "link" : "pill",
            ["orientation"] = Orientation == KlyOrientation.Vertical ? "vertical" : "horizontal",
        }, Ui, "root");
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(KlyChangeEventArgs))]
    private async Task OnChange(KlyChangeEventArgs e)
    {
        _sequence = e.Sequence;
        if (e.Value == Value) return;
        Value = e.Value;
        await ValueChanged.InvokeAsync(e.Value);
    }
}
