@namespace Klyroo.UI
@using Klyroo.UI.Theming

@*
    Cascades class overrides to every component of a given type below it. The classes are
    merged after the theme and AddKlyrooUi, and before the component's own Ui and Class, so an instance still wins.
    Without overrides it adds nothing and passes the enclosing scope through.
    A scope is a cascading value, so it does not cross a render mode boundary (a component with @rendermode, or a page
    that is interactive on its own): inside it the components see no scope. Put a KlyTheme (or KlyApp) inside each
    interactive island, or set app-wide overrides with AddKlyrooUi, which every render mode shares.
*@
@* Fixed: a non-fixed value of a class type notifies (and renders again) every component below on each render of this one.
   The key rebuilds the subtree when the scope really changed. *@
<CascadingValue Value="_scope" IsFixed="true" @key="_scope">@ChildContent</CascadingValue>

@code {
    private KlyThemeScope? _scope;
    private KlyThemeScope? _usedParent;
    private ISlotOverrides? _usedUi;
    private Type? _usedFor;
    private IReadOnlyDictionary<Type, ISlotOverrides>? _usedOverrides;
    private bool _built;

    [CascadingParameter] private KlyThemeScope? Parent { get; set; }

    /// <summary>The content whose components receive the overrides.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The component type the <see cref="Ui"/> applies to: <c>typeof(KlyButton)</c>, or <c>typeof(KlyTable&lt;&gt;)</c> for a generic one.</summary>
    [Parameter] public Type? For { get; set; }

    /// <summary>
    /// The overrides for <see cref="For"/>: any <c>*Ui</c> record, such as <c>new ButtonUi { Base = "font-bold" }</c>.
    /// Slots the component does not have are ignored.
    /// </summary>
    [Parameter] public ISlotOverrides? Ui { get; set; }

    /// <summary>Overrides for several component types at once. They win over <see cref="For"/> and <see cref="Ui"/> on a clash.</summary>
    [Parameter] public IReadOnlyDictionary<Type, ISlotOverrides>? Overrides { get; set; }

    protected override void OnParametersSet()
    {
        // A fresh scope rebuilds everything below: only build one when an input changed. Overrides are compared by value,
        // so an inline `new ButtonUi { ... }` on every render of the parent does not count as a change.
        if (_built && ReferenceEquals(_usedParent, Parent) && Equals(_usedUi, Ui) && _usedFor == For && SameOverrides(_usedOverrides, Overrides))
        {
            return;
        }
        (_built, _usedParent, _usedUi, _usedFor) = (true, Parent, Ui, For);
        _usedOverrides = Overrides is null ? null : new Dictionary<Type, ISlotOverrides>(Overrides);

        var map = new Dictionary<Type, ISlotOverrides>();
        if (For is not null && Ui is not null) map[For] = Ui;
        if (Overrides is not null)
        {
            foreach (var (type, ui) in Overrides) map[type] = ui;
        }
        _scope = map.Count == 0 ? Parent : new KlyThemeScope(Parent, map);
    }

    private static bool SameOverrides(IReadOnlyDictionary<Type, ISlotOverrides>? a, IReadOnlyDictionary<Type, ISlotOverrides>? b)
    {
        if (ReferenceEquals(a, b)) return true;
        if (a is null || b is null || a.Count != b.Count) return false;
        foreach (var (type, ui) in a)
        {
            if (!b.TryGetValue(type, out var other) || !Equals(ui, other)) return false;
        }
        return true;
    }
}
