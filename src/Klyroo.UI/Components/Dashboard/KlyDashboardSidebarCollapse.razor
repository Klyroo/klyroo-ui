@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    Collapses and expands the sidebar to icons; visible from the lg breakpoint up, where the sidebar is a column.
    A click is handled in the browser (js/layout.js), which also keeps aria-expanded and aria-controls up to date, so
    it works in static rendering and never goes through .NET.
*@
<KlyButton Square Variant="Variant" Color="Color" Size="Size" Class="@_slots["root"]"
          LeadingIcon="@(RenderIcon(Options.Icons.PanelClose, "size-5 rtl:-scale-x-100"))"
          aria-label="@(Label ?? Messages.CollapseSidebar)"
          data-kly-sidebar-collapse="" data-kly-sidebar-for="@(For ?? Context?.Key)"
          @attributes="AdditionalAttributes" />

@code {
    private SlotSet _slots = default!;

    [CascadingParameter] private DashboardContext? Context { get; set; }

    /// <summary>The storage id of the sidebar to collapse. Defaults to the one of the enclosing group, or the sidebar of the same dashboard.</summary>
    [Parameter] public string? For { get; set; }

    /// <summary>Accessible name. Defaults to the built-in text.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Look of the button: <c>Solid</c>, <c>Outline</c>, <c>Soft</c>, <c>Subtle</c>, <c>Ghost</c> or <c>Link</c>.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;
    /// <summary>Semantic color of the dashboard sidebar collapse: a built-in <see cref="KlyColor"/> or the name of a color you defined.</summary>
    [Parameter] public KlyColor Color { get; set; } = KlyColor.Neutral;
    /// <summary>Size of the dashboard sidebar collapse, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;

    /// <inheritdoc />
    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.DashboardSidebarCollapse, new Dictionary<string, string?>(), null, "root");
}
