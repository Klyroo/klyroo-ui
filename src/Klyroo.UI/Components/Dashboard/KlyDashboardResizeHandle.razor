@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A window splitter (WAI-ARIA separator) between two panels. Put it between two KlyDashboardPanels, or let
    KlyDashboardPanel Resizable place one inside the first. Dragging and the arrow keys, Home and End run in the browser
    (<kly-dashboard-group>); aria-valuenow is the size in percent of the panel before the handle, and the browser keeps
    it and the limits up to date. The value rendered here is what a static page shows until then.
*@
<div role="separator" tabindex="0" aria-orientation="vertical" data-kly-dash-handle data-slot="root"
     aria-valuenow="@Math.Round(Value)" aria-valuemin="0" aria-valuemax="100"
     aria-controls="@Controls"
     aria-label="@(Label ?? Messages.ResizePanels)"
     data-step="@Step.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     class="@_slots["root"]"
     @attributes="AdditionalAttributes"></div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The id of the panel before the handle.</summary>
    [Parameter] public string? Controls { get; set; }

    /// <summary>The size in percent of the panel before the handle, as shown until the browser takes over.</summary>
    [Parameter] public double Value { get; set; } = 50;

    /// <summary>Size change of an arrow key press, in percent.</summary>
    [Parameter] public double Step { get; set; } = 5;

    /// <summary>Accessible name. Defaults to the built-in text.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the dashboard resize handle, see <see cref="DashboardResizeHandleUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public DashboardResizeHandleUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.DashboardResizeHandle, new Dictionary<string, string?>(), Ui, "root");
}
