@namespace Klyroo.UI
@inherits KlyComponentBase
@implements IDisposable

@*
    A KlySidebar for a dashboard: the same browser-owned collapsed state and width, the same off-canvas panel below the
    lg breakpoint. What differs is that the controls live elsewhere: KlyDashboardSidebarCollapse collapses it and
    KlyDashboardSidebarToggle opens the panel, both usually in a navbar, so the sidebar renders neither of its own
    buttons unless Collapsible is set. The key of the enclosing KlyDashboardGroup is its storage id; with several sidebars in
    one group only the first takes it, the others take "key-2", "key-3" (or set Id, which takes no number), so they never share state.
*@
<KlySidebar Id="@(Id ?? Context?.SidebarId(_slot))"
           Header="Header" Footer="Footer"
           Collapsible="Collapsible"
           Collapsed="Collapsed" CollapsedChanged="CollapsedChanged"
           Resizable="Resizable" Width="Width" MinWidth="MinWidth" MaxWidth="MaxWidth"
           As="@As" AriaLabel="@AriaLabel" MobileTitle="@MobileTitle"
           MobileTrigger="false"
           Ui="Ui" Class="@Class"
           @attributes="AdditionalAttributes">
    @ChildContent
</KlySidebar>

@code {
    private int _slot;
    private DashboardContext? _registeredWith;

    [CascadingParameter] private DashboardContext? Context { get; set; }

    /// <summary>The scrollable middle: navigation, search button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Top of the sidebar: a logo and a title. Hidden while the sidebar is collapsed.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Bottom of the sidebar: the signed-in user.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Overrides the storage id taken from the group. The first sidebar of a group uses the key of the group, the next ones
    /// that key followed by "-2", "-3"; set an Id to name one yourself, and give it to the controls with <c>For</c>. A sidebar
    /// with an Id takes no number, so the first sidebar without one still gets the key of the group. Don't give it the key
    /// of the group itself, or it shares its saved state and the controls without a target with that first sidebar.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Also shows a collapse button in the header of the sidebar, besides <see cref="KlyDashboardSidebarCollapse"/>.</summary>
    [Parameter] public bool Collapsible { get; set; }

    /// <summary>The collapsed state when nothing is remembered. <c>@bind-Collapsed</c> follows and sets it from .NET.</summary>
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>Adds a handle on the edge to resize the sidebar with the mouse or the keyboard. Sizes are in pixels, unlike the panels.</summary>
    [Parameter] public bool Resizable { get; set; }
    [Parameter] public int Width { get; set; } = 256;
    [Parameter] public int MinWidth { get; set; } = 192;
    [Parameter] public int MaxWidth { get; set; } = 448;

    /// <summary>The element to render, "aside" by default; use "div" inside another landmark.</summary>
    [Parameter] public string As { get; set; } = "aside";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? MobileTitle { get; set; }

    /// <summary>Slot overrides, the same as <see cref="KlySidebar"/>.</summary>
    [Parameter] public SidebarUi? Ui { get; set; }

    protected override void OnInitialized() => _registeredWith = Context;

    /// <summary>Gives the slot back, so the next sidebar of the group takes it and keeps the cookie of the key.</summary>
    public void Dispose() => ReleaseSlot();

    protected override void OnParametersSet()
    {
        // Only a sidebar named by the group takes a slot: one with its own Id leaves "key" to the next sidebar without one.
        if (Id is null && _slot == 0) _slot = _registeredWith?.RegisterSidebar() ?? 0;
        else if (Id is not null) ReleaseSlot();
    }

    private void ReleaseSlot()
    {
        if (_slot != 0) _registeredWith?.ReleaseSidebar(_slot);
        _slot = 0;
    }
}
