@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A column of a dashboard with a header, a scrollable body and a footer. Panels share the width the sidebar leaves,
    as weights in percent that <kly-dashboard-group> adjusts when a resize handle moves; before it runs, a panel
    without a Size takes an equal share. Resizable adds a handle on the trailing edge.
*@
<div id="@_id" data-kly-dash-panel data-slot="root"
     data-size="@(Size.HasValue ? Num(Size.Value) : null)" data-min="@Num(MinSize)" data-max="@Num(MaxSize)"
     style="@($"flex: {Num(Size ?? 1)} 1 0%")"
     class="@_slots["root"]"
     @attributes="AdditionalAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @if (Header is not null)
        {
            <div class="@_slots["header"]" data-slot="header">@Header</div>
        }
        @if (Body is not null)
        {
            <div class="@_slots["body"]" data-slot="body">@Body</div>
        }
        @if (Footer is not null)
        {
            <div class="@_slots["footer"]" data-slot="footer">@Footer</div>
        }
    }
    @if (Resizable)
    {
        <KlyDashboardResizeHandle Controls="@_id" Value="@(Size ?? 50)" Label="@ResizeLabel"
                                 Class="absolute inset-y-0 end-0 mx-0 translate-x-1/2 rtl:-translate-x-1/2" />
    }
</div>

@code {
    private SlotSet _slots = default!;
    private string _id = default!;

    /// <summary>Replaces the header, the body and the footer.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The top of the panel: usually a <see cref="KlyDashboardNavbar"/> and a <see cref="KlyDashboardToolbar"/>.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>The scrollable middle.</summary>
    [Parameter] public RenderFragment? Body { get; set; }
    /// <summary>Content of the footer of the panel, below its scrollable body.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Adds a <see cref="KlyDashboardResizeHandle"/> on the trailing edge, to resize the panel against the next one.</summary>
    [Parameter] public bool Resizable { get; set; }

    /// <summary>Size in percent when nothing is remembered. Panels without one share what the others leave.</summary>
    [Parameter] public double? Size { get; set; }
    /// <summary>Smallest share of the group the panel can take, in percent.</summary>
    [Parameter] public double MinSize { get; set; }
    /// <summary>Largest share of the group the panel can take, in percent. Defaults to 100.</summary>
    [Parameter] public double MaxSize { get; set; } = 100;

    /// <summary>Accessible name of the resize handle. Defaults to the built-in text.</summary>
    [Parameter] public string? ResizeLabel { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the dashboard panel, see <see cref="DashboardPanelUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public DashboardPanelUi? Ui { get; set; }

    private static string Num(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _id ??= NewId("dashboard-panel");
        _slots = ResolveSlots(Options.DashboardPanel, new Dictionary<string, string?>(), Ui, "root");
    }
}
