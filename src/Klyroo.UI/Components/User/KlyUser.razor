@namespace Klyroo.UI
@inherits KlyComponentBase

@if (Href is null)
{
    <div class="@_slots["root"]" @attributes="AdditionalAttributes">@Inner</div>
}
else
{
    <a href="@Href" target="@Target?.Value" rel="@(Target is { IsBlank: true } ? "noopener noreferrer" : null)" class="@_slots["root"]" @attributes="AdditionalAttributes">@Inner</a>
}

@code {
    private SlotSet _slots = default!;

    // The name is next to the avatar, so the avatar is decoration: hidden from assistive technology.
    private RenderFragment Inner => @<text>
        @if (ShowAvatar)
        {
            <span class="@_slots["avatar"]" aria-hidden="true">
                <KlyAvatar Src="@AvatarSrc" Alt="@Name" Icon="@AvatarIcon" Size="@Size" />
            </span>
        }
        @if (Name is not null || Description is not null)
        {
            <span class="@_slots["wrapper"]">
                @if (Name is not null)
                {
                    <span class="@_slots["name"]" data-slot="name">@Name</span>
                }
                @if (Description is not null)
                {
                    <span class="@_slots["description"]" data-slot="description">@Description</span>
                }
            </span>
        }
    </text>;

    /// <summary>Name of the person or entity.</summary>
    [Parameter] public string? Name { get; set; }
    /// <summary>Text under the name, such as a role or an email address.</summary>
    [Parameter] public string? Description { get; set; }
    /// <summary>Address of the avatar picture.</summary>
    [Parameter] public string? AvatarSrc { get; set; }
    /// <summary>Icon of the avatar when there is no picture, as markup such as a <see cref="KlyIcon"/>.</summary>
    [Parameter] public RenderFragment? AvatarIcon { get; set; }

    /// <summary>Shows the avatar: the image, else the initials of <see cref="Name"/>.</summary>
    [Parameter] public bool ShowAvatar { get; set; } = true;

    /// <summary>Makes the whole user a link.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>The <c>target</c> attribute of the link, such as <see cref="KlyLinkTarget.Blank"/>. It applies when <c>Href</c> is set.</summary>
    [Parameter] public KlyLinkTarget? Target { get; set; }
    /// <summary>Whether the name sits beside the avatar (<c>Horizontal</c>) or under it (<c>Vertical</c>).</summary>
    [Parameter] public KlyOrientation Orientation { get; set; } = KlyOrientation.Horizontal;
    /// <summary>Size of the user, from <c>Xs</c> to <c>Xl</c>. When not set, <see cref="KlyDefaults.Size"/> applies, else the default of the component.</summary>
    [Parameter] public KlySize Size { get => _sizeParameter ?? DefaultSize(KlySize.Md); set => _sizeParameter = value; }
    private KlySize? _sizeParameter;
    /// <summary>
    /// Per-instance class overrides of the slots of the user, see <see cref="UserUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public UserUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.User, new Dictionary<string, string?>
        {
            ["orientation"] = Orientation == KlyOrientation.Vertical ? "vertical" : "horizontal",
            ["link"] = VariantValue.Of(Href is not null),
            ["size"] = VariantValue.Of(Size),
        }, Ui, "root");
}
