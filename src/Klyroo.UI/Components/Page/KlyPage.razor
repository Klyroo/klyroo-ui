@namespace Klyroo.UI
@inherits KlyComponentBase

@*
    A grid of up to three columns. Left and right are optional; the center takes the width they leave.
    Below the lg breakpoint the columns stack in reading order: left, center, right.
*@
<div class="@_slots["root"]" @attributes="AdditionalAttributes">
    @if (Left is not null)
    {
        <div class="@_slots["left"]" data-slot="left">@Left</div>
    }
    <div class="@_slots["center"]" data-slot="center">@ChildContent</div>
    @if (Right is not null)
    {
        <div class="@_slots["right"]" data-slot="right">@Right</div>
    }
</div>

@code {
    private SlotSet _slots = default!;

    /// <summary>The main column.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The left column, typically a <see cref="KlyPageAside"/> holding navigation.</summary>
    [Parameter] public RenderFragment? Left { get; set; }

    /// <summary>The right column, typically a <see cref="KlyPageAside"/> holding a table of contents.</summary>
    [Parameter] public RenderFragment? Right { get; set; }
    /// <summary>
    /// Per-instance class overrides of the slots of the page, see <see cref="PageUi"/>. They are merged after the theme and the <c>Class</c> parameter wins on the root slot.
    /// </summary>
    [Parameter] public PageUi? Ui { get; set; }

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(Options.Page, new Dictionary<string, string?>
        {
            ["center"] = (Left is not null, Right is not null) switch
            {
                (true, true) => "6",
                (false, false) => "10",
                _ => "8",
            },
        }, Ui, "root");
}
