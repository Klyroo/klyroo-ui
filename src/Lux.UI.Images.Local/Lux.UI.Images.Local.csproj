<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same version as the library: build/Version.props. -->
  <Import Project="..\..\build\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lux.UI.Images.Local</RootNamespace>
    <PackageId>Lux.UI.Images.Local</PackageId>
    <Description>An ASP.NET Core image optimization endpoint for Lux.UI (resize and convert with libvips through NetVips), with the "local" provider for BxImage.</Description>
    <PackageTags>blazor;images;optimization;libvips;netvips;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>lux-ui contributors</Authors>
    <Copyright>Copyright (c) 2026 lux-ui contributors</Copyright>
    <PackageReleaseNotes>See CHANGELOG.md in the Lux.UI package. The native libvips binaries of NetVips.Native are LGPL licensed.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
    <ProjectReference Include="..\Lux.UI.Images\Lux.UI.Images.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lux.UI.Images.Local.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\Lux.UI\assets\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
