<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Entity Framework Core adapter of Blux.UI.Tools: an IDataListQueryExecutor that runs the queries of a data list with CountAsync and ToListAsync, with the
       cancellation token of the request. Same version as the library: build/Version.props. -->
  <Import Project="..\..\build\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.Tools</RootNamespace>
    <PackageId>Blux.UI.Tools.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core adapter for Blux.UI.Tools data lists: runs the queries of a Queryable source asynchronously, with cancellation.</Description>
    <PackageTags>blazor;datalist;entityframeworkcore;efcore;table</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>blux-ui contributors</Authors>
    <Copyright>Copyright (c) 2026 blux-ui contributors</Copyright>
    <PackageReleaseNotes>See CHANGELOG.md in the Blux.UI package.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Exact dependency version ([x.y.z]) on Blux.UI.Tools in the nuspec. -->
  <Import Project="..\..\build\ExactProjectReferences.targets" />

  <ItemGroup>
    <ProjectReference Include="..\Blux.UI.Tools\Blux.UI.Tools.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\Blux.UI\assets\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
