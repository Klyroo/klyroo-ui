<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same version as the library: build/Version.props. URL builders only, no runtime dependency besides Klyroo.UI. -->
  <Import Project="..\..\build\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.UI.Images</RootNamespace>
    <PackageId>Klyroo.UI.Images</PackageId>
    <Description>Image providers for Klyroo.UI's KlyImage: Cloudinary, imgix, ImageKit, Cloudflare Images, Netlify Image CDN, Vercel, Bunny Optimizer and URL templates.</Description>
    <PackageTags>blazor;images;cdn;cloudinary;imgix;imagekit;cloudflare;netlify;vercel;bunny</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Klyroo Contributors</Authors>
    <Copyright>Copyright (c) 2026 Klyroo Contributors</Copyright>
    <PackageReleaseNotes>See CHANGELOG.md in the Klyroo.UI package.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klyroo.UI\Klyroo.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Klyroo.UI.Images.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\Klyroo.UI\assets\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
