<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Blazor-free half of Blux.UI.Tools: the request, filter and result records a data list sends to a provider, and the code that
       applies them to an IQueryable or an in-memory list. An API server references it without ASP.NET Core or Blux.UI. Same version as the library: build/Version.props. -->
  <Import Project="..\..\build\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.Tools.Query</RootNamespace>
    <PackageId>Blux.UI.Tools.Query</PackageId>
    <Description>Request, filter and result models for Blux.UI.Tools data lists, with an IQueryable applier and an in-memory executor. No ASP.NET Core or Blazor dependency.</Description>
    <PackageTags>blazor;data;query;filter;paging;sorting</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>blux-ui contributors</Authors>
    <Copyright>Copyright (c) 2026 blux-ui contributors</Copyright>
    <PackageReleaseNotes>See CHANGELOG.md in the Blux.UI package.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blux.UI.Tools" />
    <InternalsVisibleTo Include="Blux.UI.Tools.Tests" />
    <InternalsVisibleTo Include="Blux.UI.Tools.Query.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\Blux.UI\assets\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
