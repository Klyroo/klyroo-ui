<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Same version as the library: build/Version.props. -->
  <Import Project="..\..\build\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.Tools</RootNamespace>
    <PackageId>Blux.UI.Tools</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Blux UI Tools: data-heavy components (a data list with URL state, and more) built on Blux.UI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;components;ui;tailwind;datalist;table</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;BL0007</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>blux-ui contributors</Authors>
    <Copyright>Copyright (c) 2026 blux-ui contributors</Copyright>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md in the Blux.UI package.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Exact dependency versions ([x.y.z]) on Blux.UI and Blux.UI.Tools.Query in the nuspec. -->
  <Import Project="..\..\build\ExactProjectReferences.targets" />

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not private: the build assets of Blux.UI (its Tailwind and icon targets) must reach an app that only references this package. -->
    <ProjectReference Include="..\Blux.UI\Blux.UI.csproj" PrivateAssets="contentfiles;analyzers" />
    <ProjectReference Include="..\Blux.UI.Tools.Query\Blux.UI.Tools.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blux.UI.Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\Blux.UI\assets\icon.png" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/Blux.UI.Tools.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <!-- Sources of the generated assets: not shipped as content. -->
  <ItemGroup>
    <Content Remove="js/**;styles/**" />
    <None Include="js/**;styles/**" Pack="false" />
  </ItemGroup>

</Project>
