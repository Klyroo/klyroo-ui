@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>

@*
    Cursor paging: appends the next page as the user approaches the end of the list (Auto = true, via BxInfiniteScroll) or on click (Auto = false).
    Statically rendered (and prerendered), the button is a link to the next cursor (?c=...) so paging works without JavaScript, alongside a link back to the start once past the first page.
    A load-more failure keeps the rows loaded so far and shows an inline retry alert.
*@
@if (Context.PagingMode == DataListPagingMode.Cursor && Context.Result is not null)
{
    var hasResetLink = !Context.IsInteractive && Context.CanLink && !string.IsNullOrEmpty(Context.State.Cursor);
    if (Context.HasLoadMoreError)
    {
        <div class="@_slots["infiniteLoader"]" data-slot="infinite-loader" @attributes="AdditionalAttributes">
            <div class="@_slots["loadMoreError"]" data-slot="load-more-error" role="alert">
                @if (ErrorTemplate is not null)
                {
                    @ErrorTemplate(Context)
                }
                else
                {
                    <span class="@_slots["loadMoreErrorText"]">@ToolsMessages.LoadMoreError</span>
                    <BxButton Label="@ToolsMessages.Retry" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="BxSize.Sm"
                              OnClick="OnLoadMoreAsync" data-slot="load-more-retry" />
                }
            </div>
        </div>
    }
    else if (Context.Rows.Count > 0)
    {
        <div class="@_slots["infiniteLoader"]" data-slot="infinite-loader" @attributes="AdditionalAttributes">
            @if (Auto)
            {
                <BxInfiniteScroll HasMore="Context.HasMore" Loading="Context.IsLoadingMore" OnLoadMore="OnLoadMoreAsync"
                                  Root="@Root" RootMargin="@RootMargin" Href="@NextHref" Label="@Label" ShowEnd="ShowEnd" />
            }
            else
            {
                @if (Context.HasMore)
                {
                    <BxButton Variant="ButtonVariant.Outline" Label="@(Label ?? Messages.LoadMore)" Href="@(Context.IsInteractive ? null : NextHref)"
                              Disabled="@(!Context.IsInteractive && NextHref is null)" Loading="Context.IsLoadingMore"
                              OnClick="@(Context.IsInteractive ? EventCallback.Factory.Create(this, OnLoadMoreAsync) : default)"
                              data-slot="load-more-trigger" />
                }
                else if (ShowEnd)
                {
                    <p class="@_slots["infiniteEnd"]" data-slot="end" aria-hidden="true">@Messages.NoMoreItems</p>
                }
                <div role="status" aria-live="polite" aria-atomic="true" class="@_slots["infiniteStatus"]" data-slot="status">@ManualAnnouncement</div>
            }
            @if (hasResetLink && ResetHref is { } reset)
            {
                <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="BxSize.Sm" Label="@ToolsMessages.BackToStart"
                          Href="@reset" Class="@_slots["cursorReset"]" data-slot="cursor-reset" />
            }
        </div>
    }
    else if (hasResetLink && ResetHref is { } reset)
    {
        <div class="@_slots["infiniteLoader"]" data-slot="infinite-loader" @attributes="AdditionalAttributes">
            <BxButton Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="BxSize.Sm" Label="@ToolsMessages.BackToStart"
                      Href="@reset" Class="@_slots["cursorReset"]" data-slot="cursor-reset" />
        </div>
    }
}

@code {
    private SlotSet _slots = default!;

    /// <summary>Automatically loads the next page when the sentinel approaches the viewport (<see langword="true"/> by default). Set to <see langword="false"/> for a manual Load more button only.</summary>
    [Parameter] public bool Auto { get; set; } = true;

    /// <summary>Margin of the <c>IntersectionObserver</c> when <see cref="Auto"/> is <see langword="true"/> (<c>"0px 0px 320px 0px"</c> by default).</summary>
    [Parameter] public string RootMargin { get; set; } = "0px 0px 320px 0px";

    /// <summary>Optional CSS selector of the scrolling element when <see cref="Auto"/> is <see langword="true"/>. Without it, watches the closest scrollable ancestor or the viewport.</summary>
    [Parameter] public string? Root { get; set; }

    /// <summary>Text of the Load more button. Defaults to the localized "Load more".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Shows the localized "No more items" text once the last page has been loaded. It is announced to assistive technologies either way.</summary>
    [Parameter] public bool ShowEnd { get; set; }

    /// <summary>Custom content shown when loading the next page fails (replaces the default message and Retry button).</summary>
    [Parameter] public RenderFragment<DataListContext<TItem>>? ErrorTemplate { get; set; }

    private string? NextHref =>
        !Context.IsInteractive && Context.CanLink && Context.HasMore && Context.NextCursor is { } next
            ? Context.HrefWith(s => s with { Cursor = next, Page = 1 })
            : null;

    private string? ResetHref => Context.HrefWith(s => s with { Cursor = null, Page = 1 });

    private string ManualAnnouncement => Context.IsLoadingMore ? Messages.LoadingMore : !Context.HasMore ? Messages.NoMoreItems : "";

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "infiniteLoader");

    private Task OnLoadMoreAsync() => Context.LoadMoreAsync();
}
