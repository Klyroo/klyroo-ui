@namespace Blux.UI.Tools
@typeparam TItem
@inherits BxToolsComponentBase
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop

@* The actions of one row: buttons up to MaxVisible, the others in a menu (groups with dividers, submenus) on a wide screen; below md one button opens a bottom sheet with every action and the
   reason of the disabled ones. The sheet is rendered once, with the row: CSS shows the desktop controls or the phone button, so no component tree is duplicated.
   Interactive only, except the actions that are links: statically rendered, those are plain links and the rest is not drawn. *@
@{
    var context = NewContext();
    var states = Visible(context);
    var ordered = DataListRowActionRunner<TItem>.Group(states.Keys).SelectMany(g => g).ToList();
}
@if (ordered.Count > 0)
{
    if (!Context.IsInteractive)
    {
        <div class="@_slots["rowActions"]" data-slot="row-actions" @attributes="AdditionalAttributes">
            @foreach (var action in ordered)
            {
                foreach (var link in Links(action, context))
                {
                    <BxButton Label="@link.Label" Href="@link.Href" Variant="ButtonVariant.Ghost" Color="link.Color" Size="BxSize.Sm"
                              LeadingIcon="@(link.Icon is null ? null : RenderIcon(link.Icon, "size-4"))" data-slot="row-action" data-action="@link.Key" />
                }
            }
        </div>
    }
    else
    {
        var inline = ordered.Where(a => a.Children is not { Count: > 0 }).Take(Math.Max(0, MaxVisible)).ToList();
        var overflow = ordered.Except(inline).ToList();
        var label = AccessibleName();
        <div @ref="_root" class="@_slots["rowActions"]" data-slot="row-actions" @attributes="AdditionalAttributes">
            @if (inline.Count > 0)
            {
                <div class="@_slots["rowActionsInline"]" data-slot="row-actions-inline">
                    @foreach (var action in inline)
                    {
                        var item = action;
                        var state = states[item];
                        <BxButton Label="@item.Label" Variant="ButtonVariant.Ghost" Color="item.Color" Size="Size" Loading="state.Loading" Disabled="@state.Disabled"
                                  Href="@(state.Disabled ? null : state.Href)" LeadingIcon="@(item.Icon is null ? null : RenderIcon(item.Icon, "size-4"))"
                                  OnClick="@(() => RequestAsync(item))" data-slot="row-action" data-action="@item.Key" data-row-action-anchor />
                    }
                </div>
            }
            @if (overflow.Count > 0)
            {
                <div class="@_slots["rowActionsMenu"]" data-slot="row-actions-menu">
                    <BxDropdownMenu Items="MenuItems(overflow, context)" OnSelect="OnMenuSelect" Placement="bottom-end">
                        <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="Size" Square="true" aria-label="@label"
                                  LeadingIcon="@RenderIcon("ellipsis", "size-4")" data-slot="row-actions-trigger" data-row-action-anchor />
                    </BxDropdownMenu>
                </div>
            }
            <BxSlideover Title="@label" Side="SlideoverSide.Bottom" data-slot="row-actions-sheet">
                <ChildContent>
                    <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="Size" Square="true" Class="@_slots["rowActionsPhone"]" aria-label="@label"
                              LeadingIcon="@RenderIcon("ellipsis", "size-4")" data-slot="row-actions-phone" data-row-action-anchor />
                </ChildContent>
                <Body>
                    <ul class="@_slots["sheetList"]" data-slot="row-actions-sheet-list">
                        @{ var groups = DataListRowActionRunner<TItem>.Group(ordered); }
                        @for (var g = 0; g < groups.Count; g++)
                        {
                            @foreach (var action in groups[g])
                            {
                                @SheetEntry(action, context, g > 0 && action == groups[g][0])
                            }
                        }
                    </ul>
                </Body>
            </BxSlideover>
            @if (_pending is { Confirm: not null })
            {
                var confirm = _pending.Confirm;
                <DataListActionDialog Open="_confirmOpen" OpenChanged="OnConfirmOpenChanged" Title="@confirm.Title" Description="@confirm.Description?.Invoke(context)"
                                      ConfirmLabel="@(confirm.ConfirmLabel ?? ToolsMessages.ActionConfirm)" Color="confirm.Color ?? _pending.Color" OnConfirm="ConfirmAsync" />
            }
        </div>
    }
}

@code {
    private SlotSet _slots = default!;
    private readonly DataListRowActionRunner<TItem> _runner = new();
    private ElementReference _root;
    private string _key = "";
    private DataListRowAction<TItem>? _pending;
    private bool _confirmOpen;
    private bool _disposed;
    private readonly string _id = NewId("row-actions");

    [CascadingParameter] private DataListContext<TItem> Context { get; set; } = default!;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>The row.</summary>
    [Parameter, EditorRequired] public TItem Item { get; set; } = default!;

    /// <summary>The place of the row on the page, from 1: it names the actions of a row that has no <c>RowLabel</c> in the schema.</summary>
    [Parameter] public int Position { get; set; }

    /// <summary>The actions, in the order they are shown. Their keys are unique, children included.</summary>
    [Parameter] public IReadOnlyList<DataListRowAction<TItem>> Actions { get; set; } = [];

    /// <summary>How many actions show as buttons on a wide screen; the others go into a menu (3 by default). 0 puts them all behind one button. Below the <c>md</c> breakpoint every action is in a sheet.</summary>
    [Parameter] public int MaxVisible { get; set; } = 3;

    /// <summary>The size of the buttons.</summary>
    [Parameter] public BxSize Size { get; set; } = BxSize.Sm;

    /// <summary>Raised when an action threw or reported a failure; the list is not refreshed and nothing is rethrown. Without a handler an exception is logged.</summary>
    [Parameter] public EventCallback<DataListRowActionFailure<TItem>> OnError { get; set; }

    /// <summary>Per-instance classes for each slot.</summary>
    [Parameter] public DataListUi? Ui { get; set; }

    protected override void OnParametersSet()
    {
        if (Context is null) throw new InvalidOperationException($"{nameof(BxDataListRowActions<TItem>)} must be placed inside a {nameof(BxDataList<TItem>)}.");
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "rowActions");
        _key = Context.CreateRowActionContext(Item, Position).Key;
    }

    private DataListRowActionContext<TItem> NewContext() => Context.CreateRowActionContext(Item, Position);

    // The visible top-level actions with their state.
    private Dictionary<DataListRowAction<TItem>, RowActionState> Visible(DataListRowActionContext<TItem> context)
    {
        var states = new Dictionary<DataListRowAction<TItem>, RowActionState>();
        foreach (var action in Actions)
        {
            var state = _runner.StateOf(_key, action, context);
            if (state.Visible) states[action] = state;
        }
        return states;
    }

    private string AccessibleName()
    {
        var label = Context.Schema?.GetRowLabel(Item);
        if (!string.IsNullOrWhiteSpace(label)) return string.Format(FormatCulture, ToolsMessages.RowActionsLabel, label);
        return Position > 0 ? string.Format(FormatCulture, ToolsMessages.RowActionsLabelAt, Position) : ToolsMessages.ActionsMenu;
    }

    // The actions of a static page: the links among the action and its children.
    private IEnumerable<DataListRowAction<TItem>> Flatten(DataListRowAction<TItem> action) =>
        action.Children is { Count: > 0 } ? action.Children.SelectMany(Flatten) : [action];

    private IEnumerable<(string Key, string Label, string? Icon, BxColor Color, string Href)> Links(DataListRowAction<TItem> action, DataListRowActionContext<TItem> context)
    {
        foreach (var leaf in Flatten(action))
        {
            var state = _runner.StateOf(_key, leaf, context);
            if (state.Visible && !state.Disabled && state.Href is { } href) yield return (leaf.Key, leaf.Label, leaf.Icon, leaf.Color, href);
        }
    }

    private RenderFragment Spinner(string @class) => RenderIcon(Options.Icons.Loading, @class + " animate-spin");

    private List<BxMenuItem> MenuItems(IEnumerable<DataListRowAction<TItem>> actions, DataListRowActionContext<TItem> context)
    {
        var items = new List<BxMenuItem>();
        var visible = actions.Where(a => _runner.StateOf(_key, a, context).Visible);
        foreach (var group in DataListRowActionRunner<TItem>.Group(visible))
        {
            if (items.Count > 0) items.Add(BxMenuItem.Separator());
            foreach (var action in group)
            {
                var state = _runner.StateOf(_key, action, context);
                items.Add(new BxMenuItem
                {
                    Label = action.Label,
                    Value = action.Key,
                    Icon = state.Loading ? Spinner("size-4") : action.Icon is null ? null : RenderIcon(action.Icon, "size-4"),
                    Href = state.Disabled ? null : state.Href,
                    Disabled = state.Disabled || state.Loading,
                    Color = action.Color.Equals(BxColor.Neutral) ? default(BxColor?) : action.Color,
                    Children = action.Children is { Count: > 0 } ? MenuItems(action.Children, context) : null,
                });
            }
        }
        return items;
    }

    private DataListRowAction<TItem>? Find(string? key, IEnumerable<DataListRowAction<TItem>>? within = null)
    {
        foreach (var action in within ?? Actions)
        {
            if (action.Key == key) return action;
            if (action.Children is { Count: > 0 } && Find(key, action.Children) is { } found) return found;
        }
        return null;
    }

    private Task OnMenuSelect(BxMenuItem item) => Find(item.Value) is { } action ? RequestAsync(action) : Task.CompletedTask;

    // An entry of the sheet: a button or a link; an action with children is a heading over its own list.
    private RenderFragment SheetEntry(DataListRowAction<TItem> action, DataListRowActionContext<TItem> context, bool divider) =>
        @<li class="@(divider ? _slots["sheetEntry"] + " " + _slots["sheetDivider"] : _slots["sheetEntry"])" data-divider="@(divider ? "true" : null)" data-slot="row-actions-sheet-entry">
            @{
                var state = _runner.StateOf(_key, action, context);
                var blocked = state.Disabled || state.Loading;
                var reasonId = $"{_id}-{action.Key}-reason";
                var reason = blocked ? state.Reason : null;
            }
            @if (state.Visible && action.Children is { Count: > 0 })
            {
                <p class="@_slots["sheetHeading"]">@action.Label</p>
                <ul class="@_slots["sheetList"]">
                    @foreach (var group in DataListRowActionRunner<TItem>.Group(action.Children.Where(c => _runner.StateOf(_key, c, context).Visible)))
                    {
                        @foreach (var child in group)
                        {
                            @SheetEntry(child, context, false)
                        }
                    }
                </ul>
            }
            else if (state.Visible && state.Href is { } href && !blocked)
            {
                <a href="@href" class="@_slots["sheetItem"]" data-color="@(action.Color.Equals(BxColor.Neutral) ? null : action.Color.Value)" data-action="@action.Key" data-bx-close>
                    @SheetLabel(action, false)
                </a>
            }
            else if (state.Visible)
            {
                <button type="button" class="@_slots["sheetItem"]" data-color="@(action.Color.Equals(BxColor.Neutral) ? null : action.Color.Value)" data-action="@action.Key"
                        aria-disabled="@(blocked ? "true" : null)" aria-describedby="@(reason is null ? null : reasonId)"
                        data-bx-close="@(blocked ? null : "")"
                        @onclick="@(blocked ? default : EventCallback.Factory.Create(this, () => RequestAsync(action)))">
                    @SheetLabel(action, state.Loading)
                </button>
                @if (reason is not null)
                {
                    <p id="@reasonId" class="@_slots["sheetReason"]" data-slot="row-action-reason">@reason</p>
                }
            }
        </li>;

    private RenderFragment SheetLabel(DataListRowAction<TItem> action, bool loading) =>
        @<text>
            @if (loading)
            {
                @Spinner("size-5 shrink-0")
            }
            else if (action.Icon is not null)
            {
                <span class="@_slots["sheetIcon"]" aria-hidden="true">@RenderIcon(action.Icon, "size-5")</span>
            }
            <span>@action.Label</span>
        </text>;

    private async Task RequestAsync(DataListRowAction<TItem> action)
    {
        var context = NewContext();
        var state = _runner.StateOf(_key, action, context);
        if (!state.Visible || state.Disabled || state.Loading || state.Href is not null || action.Children is { Count: > 0 }) return;
        if (action.Confirm is not null)
        {
            _pending = action;
            _confirmOpen = true;
            return;
        }
        await RunAsync(action);
    }

    private async Task ConfirmAsync()
    {
        _confirmOpen = false;
        // The pending action stays: the dialog is still on screen while it closes and reads its text from it.
        if (_pending is { } action) await RunAsync(action);
    }

    private void OnConfirmOpenChanged(bool open) => _confirmOpen = open;

    private async Task RunAsync(DataListRowAction<TItem> action)
    {
        var context = NewContext();
        var outcome = await _runner.RunAsync(_key, action, context, StateHasChanged, async (exception, message) =>
        {
            if (exception is not null) Context.Logger?.LogError(exception, "The data list row action '{Action}' failed.", action.Key);
            if (OnError.HasDelegate) await OnError.InvokeAsync(new DataListRowActionFailure<TItem>(action, Item, exception, message));
        }, Context.LifetimeToken);
        if (_disposed) return;
        if (outcome == RowActionOutcome.Succeeded && action.RefreshOnSuccess) await Context.RefreshAsync();
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
        if (outcome == RowActionOutcome.Succeeded) await KeepFocusAsync();
    }

    // The action may have removed the row, and the control that had the focus with it: the focus goes to the actions of the next row, else to the table.
    private async Task KeepFocusAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("Blux.tools.focusAfterRowRemoval", _root);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No browser side (a test, a circuit that ended).
        }
    }

    public void Dispose() => _disposed = true;
}
