    private IReadOnlyList<BxMenuItem> BuildHeaderMenuItems(View column)
    {
        var items = new List<BxMenuItem>();
        var key = column.Key;
        if (column.Sortable && key is not null)
        {
            var dir = Context.SortDescending(key);
            items.Add(new BxMenuItem
            {
                Label = ToolsMessages.ColumnMenuSortAsc,
                Value = "sort-asc",
                Icon = RenderIcon(Options.Icons.ArrowUp, "size-4"),
                Disabled = dir == false,
            });
            items.Add(new BxMenuItem
            {
                Label = ToolsMessages.ColumnMenuSortDesc,
                Value = "sort-desc",
                Icon = RenderIcon(Options.Icons.ArrowDown, "size-4"),
                Disabled = dir == true,
            });
            if (dir is not null)
            {
                items.Add(new BxMenuItem
                {
                    Label = ToolsMessages.ColumnMenuClearSort,
                    Value = "sort-clear",
                    Icon = RenderIcon(Options.Icons.Close, "size-4"),
                });
            }
        }
        if (key is not null && column.Source is { } src)
        {
            var pinAndHide = new List<BxMenuItem>();
            if (!src.Required)
            {
                if (column.Pinned != DataListPin.Start)
                {
                    pinAndHide.Add(new BxMenuItem
                    {
                        Label = string.Format(FormatCulture, ToolsMessages.ColumnPinStart, column.Title),
                        Value = "pin-start",
                        Icon = RenderIcon("pin", "size-4"),
                    });
                }
                if (column.Pinned != DataListPin.End)
                {
                    pinAndHide.Add(new BxMenuItem
                    {
                        Label = string.Format(FormatCulture, ToolsMessages.ColumnPinEnd, column.Title),
                        Value = "pin-end",
                        Icon = RenderIcon("pin", "size-4"),
                    });
                }
                if (column.Pinned != DataListPin.None)
                {
                    pinAndHide.Add(new BxMenuItem
                    {
                        Label = string.Format(FormatCulture, ToolsMessages.ColumnUnpin, column.Title),
                        Value = "unpin",
                        Icon = RenderIcon("pin-off", "size-4"),
                    });
                }
                if (Context.CanHideColumn(src))
                {
                    pinAndHide.Add(new BxMenuItem
                    {
                        Label = ToolsMessages.ColumnMenuHide,
                        Value = "hide",
                        Icon = RenderIcon("eye-off", "size-4"),
                    });
                }
            }
            if (pinAndHide.Count > 0)
            {
                if (items.Count > 0) items.Add(BxMenuItem.Separator());
                items.AddRange(pinAndHide);
            }
        }
        return items;
    }

    private void OnHeaderMenuSelect(View column, BxMenuItem item)
    {
        if (column.Key is not { } key) return;
        switch (item.Value)
        {
            case "sort-asc":
                Context.SetState(s => Context.WithSort(s, key, descending: false), QueryHistory.Push);
                break;
            case "sort-desc":
                Context.SetState(s => Context.WithSort(s, key, descending: true), QueryHistory.Push);
                break;
            case "sort-clear":
                Context.SetState(Context.ClearSort, QueryHistory.Push);
                break;
            case "pin-start":
                Context.SetColumnPinned(key, DataListPin.Start);
                break;
            case "pin-end":
                Context.SetColumnPinned(key, DataListPin.End);
                break;
            case "unpin":
                Context.SetColumnPinned(key, DataListPin.None);
                break;
            case "hide":
                Context.SetColumnVisible(key, false);
                break;
        }
    }

