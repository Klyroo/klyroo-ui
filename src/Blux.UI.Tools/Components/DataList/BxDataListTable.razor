@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>
@attribute [CascadingTypeParameter(nameof(TItem))]
@using Blux.UI.Internal
@using Blux.UI.Tools.Query
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop

    @ChildContent
    @* After the columns above, which register while they render; a list without a schema is loaded from here, once its columns describe one. *@
    <DataListLoadTrigger TItem="TItem" />
    <Defer>
        @{
            var columns = Columns();
            var selecting = Context.SelectionVisible;
            var acting = RowActions is { Count: > 0 };
            var label = Caption ?? AriaLabel ?? Context.Label ?? ToolsMessages.Results;
            var empty = Context.Result is not null && Context.Rows.Count == 0 && !Context.HasError;
            var entries = Context.IsInitial || empty ? null : RowEntries();
            var virtualizing = IsVirtualized && entries is { Count: > 0 };
            var resizing = Resizable && Context.IsInteractive;
            var showColgroup = resizing || columns.Any(c => c.Width is not null);
            var pinStart = columns.Any(c => c.Pinned == DataListPin.Start);
            var pinEnd = columns.Any(c => c.Pinned == DataListPin.End);
            // Every column has a width: the table is as wide as their sum, so each column is exactly the width it was given. With a column that sizes to its content, that column takes what is left.
            var allSized = columns.Count > 0 && columns.All(c => c.Width is not null);
        }
        @* A scrolling region that can take focus needs a name; the table inside has the same one. *@
        <div @ref="_root" class="@_slots["tableRoot"]" data-slot="table-root" data-virtualized="@(IsVirtualized ? "true" : null)" data-bx-scroll-root="@(IsVirtualized ? _scrollId : null)" tabindex="0" role="region" aria-label="@label"
             @attributes="AdditionalAttributes">
            <table class="@(allSized ? _sizedSlots["table"] : _slots["table"])" data-slot="table" aria-label="@(Caption is null ? label : null)" aria-rowcount="@(virtualizing ? entries!.Count + 1 : null)">
                @if (Caption is not null)
                {
                    <caption class="@_slots["caption"]">@Caption</caption>
                }
                @if (showColgroup)
                {
                    <colgroup>
                        @if (selecting)
                        {
                            <col />
                        }
                        @foreach (var column in columns)
                        {
                            <col data-col-key="@column.Key" style="@(column.Width is { } w ? $"width:{w}px" : null)" />
                        }
                        @if (acting)
                        {
                            <col />
                        }
                    </colgroup>
                }
                <thead class="@_slots["thead"]">
                    <tr class="@_slots["tr"]" aria-rowindex="@(virtualizing ? 1 : null)">
                        @if (selecting)
                        {
                            @* The box of the header is named by itself: the cell has no text. *@
                            <th scope="col" class="@SelectClass("th", pinStart)" style="@(pinStart ? "inset-inline-start:0" : null)" data-pinned="@(pinStart ? "start" : null)" data-key="select"><DataListSelectAll TItem="TItem" /></th>
                        }
                        @foreach (var column in columns)
                        {
                            <th scope="col" class="@HeaderClass(column)" style="@CellStyle(column)" data-pinned="@PinAttr(column)" aria-sort="@AriaSort(column)" data-key="@column.Key">
                                @Header(column)
                                @if (resizing && column.Resizable && column.Key is not null)
                                {
                                    var col = column;
                                    @* A separator the keyboard and the pointer both move (js/column-resize.js): the width is changed in the browser and reported once, as the value of bx-change. *@
                                    <div role="separator" tabindex="0" aria-orientation="vertical" aria-label="@string.Format(FormatCulture, ToolsMessages.ColumnResize, col.Title)"
                                         aria-valuemin="@col.MinWidth" aria-valuemax="@col.MaxWidth" aria-valuenow="@(col.Width ?? col.DeclaredWidth)"
                                         aria-valuetext="@((col.Width ?? col.DeclaredWidth) is { } known ? string.Format(FormatCulture, ToolsMessages.ColumnWidthPixels, known) : null)"
                                         class="@_slots["colResize"]" data-slot="col-resize" data-col-key="@col.Key" data-min-width="@col.MinWidth" data-max-width="@col.MaxWidth"
                                         data-default-width="@col.DeclaredWidth" data-value-text="@ToolsMessages.ColumnWidthPixels"
                                         @onbxchange="@(e => OnResizeReported(col, e))" @onbxchange:stopPropagation="true"></div>
                                }
                            </th>
                        }
                        @if (acting)
                        {
                            @* The header is read by assistive technology only: the cells hold buttons that name themselves. *@
                            <th scope="col" class="@ActionsClass("th", pinEnd)" style="@(pinEnd ? "inset-inline-end:0" : null)" data-pinned="@(pinEnd ? "end" : null)" data-key="actions"><span class="sr-only">@ToolsMessages.ActionsMenu</span></th>
                        }
                    </tr>
                </thead>
                <tbody class="@_slots["tbody"]" aria-busy="@(Context.IsLoading || Context.IsInitial ? "true" : null)">
                    @if (Context.IsInitial)
                    {
                        @* Placeholders keep the height of the page while the first rows load. *@
                        @for (var row = 0; row < Math.Clamp(Context.State.PageSize, 3, 10); row++)
                        {
                            <tr class="@_slots["tr"]" data-slot="skeleton-row">
                                @if (selecting)
                                {
                                    <td class="@SelectClass("td", pinStart)" style="@(pinStart ? "inset-inline-start:0" : null)" data-pinned="@(pinStart ? "start" : null)"></td>
                                }
                                @foreach (var column in columns)
                                {
                                    <td class="@CellClass(column)" style="@CellStyle(column)" data-pinned="@PinAttr(column)"><BxSkeleton Class="@_slots["skeleton"]" /></td>
                                }
                                @if (acting)
                                {
                                    <td class="@ActionsClass("td", pinEnd)" style="@(pinEnd ? "inset-inline-end:0" : null)" data-pinned="@(pinEnd ? "end" : null)"></td>
                                }
                            </tr>
                        }
                    }
                    else if (empty)
                    {
                        <tr class="@_slots["tr"]" data-slot="empty-row">
                            <td colspan="@Math.Max(1, columns.Count + (selecting ? 1 : 0) + (acting ? 1 : 0))" class="@_slots["empty"]">
                                @if (Empty is not null)
                                {
                                    @Empty(Context)
                                }
                                else if (Context.IsFilteredFor(Context.LoadedState ?? Context.State))
                                {
                                    @* A search or filters are on: nothing matches, which is not the same as nothing existing. *@
                                    <BxDataListEmpty Title="@FilteredTitle" Description="@FilteredDescription" data-filtered="true">
                                        <Actions>@FilteredAction</Actions>
                                    </BxDataListEmpty>
                                }
                                else
                                {
                                    <BxDataListEmpty />
                                }
                            </td>
                        </tr>
                    }
                    else if (virtualizing)
                    {
                        <Virtualize TItem="RowEntry" Items="entries" ItemSize="EffectiveItemSize" OverscanCount="OverscanCount" SpacerElement="tr" Context="row">
                            <DataListRowView TItem="TItem" @key="row.Key" Item="row.Item" Revision="Revision" RowIndex="row.Position + 1" Class="@RowClass(selecting)">
                                @Cells(row, selecting, acting, columns, pinStart, pinEnd)
                            </DataListRowView>
                        </Virtualize>
                    }
                    else
                    {
                        @* The key is on the component itself, directly in the loop: a keyed element inside a RenderFragment would sit in a region of its own, where a key cannot match a row of another position, and every row after a removed one would be rebuilt. *@
                        @foreach (var row in entries!)
                        {
                            <DataListRowView TItem="TItem" @key="row.Key" Item="row.Item" Revision="Revision" RowIndex="null" Class="@RowClass(selecting)">
                                @Cells(row, selecting, acting, columns, pinStart, pinEnd)
                            </DataListRowView>
                        }
                    }
                </tbody>
            </table>
            @* The loader of a virtualized list (cursor paging) is drawn here, in the box that scrolls: a sentinel after the box would never move while the rows scroll inside it. *@
            @if (IsVirtualized && Context.TableFooter is { } footer)
            {
                @footer
            }
        </div>
        @* What a resize changed, said once in words: the separator itself says its value while it has the focus. *@
        @if (resizing)
        {
            <div class="sr-only" role="status" aria-live="polite" data-slot="col-live">@Context.WidthAnnouncement</div>
        }
    </Defer>

@code {
    private SlotSet _slots = default!;
    private SlotSet _sizedSlots = default!;
    private int _parentRenders;
    private ElementReference _root;
    private bool _watching;
    private bool _keepingFocus;
    private readonly string _scrollId = NewId("table-scroll");

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>The columns: <see cref="BxDataListColumn{TItem}"/> components. Without any, the table shows one column per field of the schema.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Names the table for assistive technologies (visually hidden), and the scrolling region around it. Without it, the <c>AriaLabel</c> of the table, then the label of the list, then the localized "Results".</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>
    /// The actions of each row: a last column with buttons up to <see cref="RowActionsMaxVisible"/>, then a menu, and below the <c>md</c> breakpoint one button that opens a sheet
    /// (<see cref="BxDataListRowActions{TItem}"/>). Interactive only, except the actions that are links.
    /// </summary>
    [Parameter] public IReadOnlyList<DataListRowAction<TItem>>? RowActions { get; set; }

    /// <summary>How many row actions show as buttons on a wide screen (3 by default); 0 keeps a single "Actions for ..." button per row.</summary>
    [Parameter] public int RowActionsMaxVisible { get; set; } = 3;

    /// <summary>Raised when a row action threw or reported a failure.</summary>
    [Parameter] public EventCallback<DataListRowActionFailure<TItem>> OnRowActionError { get; set; }

    /// <summary>The accessible name of the table when there is no <see cref="Caption"/>.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Shown when the list has no rows. It receives the list, whose <see cref="DataListContext{TItem}.IsFiltered"/> tells "nothing matches" from "nothing exists". Without it, <see cref="BxDataListEmpty"/>.</summary>
    [Parameter] public RenderFragment<DataListContext<TItem>>? Empty { get; set; }

    /// <summary>
    /// Renders only the rows around the scroll viewport with Blazor's <c>Virtualize</c>, using <c>tr</c> spacers, a sticky header and fixed single-line row heights matching
    /// <see cref="DataListDensity"/> (36 px compact, 44 px default, 60 px comfortable). Meant for <see cref="DataListPagingMode.None"/> and <see cref="DataListPagingMode.Cursor"/> lists
    /// with many loaded rows. Interactive only: static renders and prerenders draw regular rows without virtualization.
    /// </summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>Height in pixels of one row when <see cref="Virtualize"/> is on. Without it, follows <see cref="DataListDensity"/> (36, 44 or 60 px).</summary>
    [Parameter] public float? ItemSize { get; set; }

    /// <summary>Extra rows rendered above and below the viewport when <see cref="Virtualize"/> is on (3 by default).</summary>
    [Parameter] public int OverscanCount { get; set; } = 3;

    /// <summary>
    /// Puts a resize handle (a vertical separator) on the end edge of the header of each <see cref="BxDataListColumn{TItem}.Resizable"/> column (false by default): drag it, or focus it and press ArrowLeft and ArrowRight
    /// (16 px, 64 with Shift; in right-to-left text the arrow that points away from the start edge grows the column), Home and End for the limits, Delete or a double click for the declared width.
    /// The browser changes the width while the gesture runs and reports it once; the list keeps it in its column preferences (<see cref="BxDataList{TItem}.PreferencesKey"/>). Interactive only: a static render has no handle
    /// but still applies a saved width.
    /// </summary>
    [Parameter] public bool Resizable { get; set; }

    private bool IsVirtualized => Virtualize && Context.IsInteractive;

    private float EffectiveItemSize => ItemSize is > 0 ? ItemSize.Value : Context.Density switch
    {
        DataListDensity.Compact => 36f,
        DataListDensity.Comfortable => 60f,
        _ => 44f,
    };

    // Parts that list the columns (a columns panel) render before the columns exist: they hear about a change in the registry once the table has rendered.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!_watching && Context.IsInteractive && RowActions is { Count: > 0 } && Context.Columns.Any(c => Context.EffectiveColumnPin(c) == DataListPin.End))
        {
            _watching = true;
            _ = WatchActionsWidthAsync();
        }
        if (!_keepingFocus && IsVirtualized)
        {
            _keepingFocus = true;
            _ = KeepVirtualFocusAsync();
        }
        var signature = string.Join('|', Context.Columns.Select(c => $"{c.EffectiveKey}:{c.Visible}:{c.EffectiveTitle}"));
        if (signature == Context.ColumnsSignature) return;
        Context.ColumnsSignature = signature;
        Context.NotifyChanged();
    }

    // A row that scrolls out of the window takes the focus it held with it: the browser gives it back when the row returns.
    private async Task KeepVirtualFocusAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("Blux.tools.keepVirtualFocus", _root);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No browser side (a test, a circuit that ended).
        }
    }

    private async Task WatchActionsWidthAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("Blux.tools.watchActionsWidth", _root);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No browser side (a test, a circuit that ended).
        }
    }

    // A render caused by the parent (new templates, new parameters) rebuilds the rows; one caused by the list (a flag, a new result) rebuilds them only for a new result or column change.
    private int Revision => unchecked(_parentRenders * 7919 + Context.ResultVersion * 31 + Context.ColumnsVersion);

    protected override void OnParametersSet()
    {
        _parentRenders++;
        var variants = new Dictionary<string, string?>
        {
            ["density"] = Context.Density switch
            {
                DataListDensity.Compact => "compact",
                DataListDensity.Comfortable => "comfortable",
                _ => "default",
            },
        };
        if (IsVirtualized) variants["virtualize"] = "true";
        Context.SetTableVirtualized(IsVirtualized, IsVirtualized ? $"[data-bx-scroll-root='{_scrollId}']" : null);
        _slots = ResolveSlots(ToolsOptions.DataList, variants, Ui, "tableRoot");
        _sizedSlots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(variants) { ["sized"] = "true" }, Ui, "tableRoot");
    }

    public override void Dispose()
    {
        Context.SetTableVirtualized(false, null);
        base.Dispose();
    }

    // The state the rows on screen were loaded for: the text of the empty state is about what was searched, not about what is being typed.
    private DataListState Shown => Context.LoadedState ?? Context.State;

    private bool OnlySearch => Shown.Filters.SequenceEqual(Context.ResetState(Shown).Filters);

    private string FilteredTitle => string.IsNullOrWhiteSpace(Shown.Search)
        ? ToolsMessages.NoResultsFiltered
        : string.Format(FormatCulture, ToolsMessages.NoResultsFor, Shown.Search.Trim());

    private string FilteredDescription => string.IsNullOrWhiteSpace(Shown.Search) ? ToolsMessages.NoResultsDescription : ToolsMessages.NoResultsForDescription;

    // A button that takes the search (and the filters) off: interactive it also puts the focus back in the search field, whose clear button is gone with the text; statically it is a link.
    private RenderFragment FilteredAction => builder =>
    {
        var label = OnlySearch ? ToolsMessages.ClearSearch : ToolsMessages.ResetFilters;
        if (Context.IsInteractive)
        {
            builder.OpenComponent<BxButton>(0);
            builder.AddAttribute(1, nameof(BxButton.Label), label);
            builder.AddAttribute(2, nameof(BxButton.Variant), ButtonVariant.Outline);
            builder.AddAttribute(3, nameof(BxButton.Color), BxColor.Neutral);
            builder.AddAttribute(4, nameof(BxButton.OnClick), EventCallback.Factory.Create<MouseEventArgs>(this, () =>
            {
                Context.Reset(QueryHistory.Push);
                Context.RequestSearchFocus();
            }));
            builder.AddAttribute(5, "data-slot", "reset");
            builder.CloseComponent();
        }
        else if (Context.HrefWith(Context.ResetState) is { } href)
        {
            builder.OpenComponent<BxButton>(6);
            builder.AddAttribute(7, nameof(BxButton.Label), label);
            builder.AddAttribute(8, nameof(BxButton.Variant), ButtonVariant.Outline);
            builder.AddAttribute(9, nameof(BxButton.Color), BxColor.Neutral);
            builder.AddAttribute(10, nameof(BxButton.Href), href);
            builder.AddAttribute(11, "data-slot", "reset");
            builder.CloseComponent();
        }
    };

    private sealed record RowEntry(object Key, TItem Item, int Position);

    private string RowClass(bool selecting) => selecting ? _slots["tr"] + " " + _slots["rowSelected"] : _slots["tr"];

    private RenderFragment Cells(RowEntry row, bool selecting, bool acting, List<View> columns, bool pinStart, bool pinEnd) =>
        @<text>
            @if (selecting)
            {
                <td class="@SelectClass("td", pinStart)" style="@(pinStart ? "inset-inline-start:0" : null)" data-pinned="@(pinStart ? "start" : null)"><DataListRowSelect TItem="TItem" Item="row.Item" Position="row.Position" /></td>
            }
            @foreach (var column in columns)
            {
                <td class="@CellClass(column)" style="@CellStyle(column)" data-pinned="@PinAttr(column)">@Cell(column, row.Item)</td>
            }
            @if (acting)
            {
                <td class="@ActionsClass("td", pinEnd)" style="@(pinEnd ? "inset-inline-end:0" : null)" data-pinned="@(pinEnd ? "end" : null)">
                    <BxDataListRowActions TItem="TItem" Item="row.Item" Position="row.Position" Actions="RowActions!" MaxVisible="RowActionsMaxVisible" OnError="OnRowActionError" />
                </td>
            }
        </text>;

    // The rows with a key each: the row key of the schema, else the identity of the row (the reference). A schema whose keys repeat (a data error) falls back to the identity of the rows, and a row that is itself listed twice to its position.
    private List<RowEntry> RowEntries()
    {
        var schema = Context.Schema;
        var rows = Context.Rows;
        var entries = new List<RowEntry>(rows.Count);
        if (schema is { HasRowKey: true })
        {
            var seen = new HashSet<object>();
            var unique = true;
            var pos = 0;
            foreach (var item in rows)
            {
                pos++;
                var key = schema.GetRowKey(item);
                unique &= seen.Add(key);
                entries.Add(new RowEntry(key, item, pos));
            }
            if (unique) return entries;
            entries.Clear();
        }
        var identities = new HashSet<object>();
        var index = 0;
        foreach (var item in rows)
        {
            object key = item is not null && identities.Add(new RowReferenceKey(item)) ? new RowReferenceKey(item) : index;
            entries.Add(new RowEntry(key, item, index + 1));
            index++;
        }
        return entries;
    }

    private sealed record View(
        BxDataListColumn<TItem>? Source,
        string? Key,
        string Title,
        DataListAlign Align,
        bool Sortable,
        string? Class,
        DataListPin Pinned,
        int? Width,
        int? DeclaredWidth,
        int MinWidth,
        int MaxWidth,
        bool Resizable,
        string? PinOffset);

    // The room the selection column takes at the start edge (the w-10 of its slot): a column pinned to the start sticks after it.
    private const string SelectionWidth = "2.5rem";

    // The columns as declared (filtered, ordered and grouped by pin edge), or one per field of the schema when none was.
    private List<View> Columns()
    {
        var schema = Context.Schema;
        if (Context.Columns.Count > 0)
        {
            var raw = Context.TableColumns();
            var selecting = Context.SelectionVisible;
            var acting = RowActions is { Count: > 0 };
            // A pinned column needs a width of its own: the offset of the next one is the sum of the widths before it. Without one it gets BxDataList<TItem>.DefaultPinnedWidth.
            int? WidthOf(BxDataListColumn<TItem> c, DataListPin pin)
            {
                var min = Math.Max(DataListColumnPreferences.MinAllowedWidth, c.MinWidth);
                var max = Math.Clamp(c.MaxWidth, min, DataListColumnPreferences.MaxAllowedWidth);
                var width = Context.EffectiveColumnWidth(c);
                return width ?? (pin == DataListPin.None ? null : Math.Clamp(BxDataList<TItem>.DefaultPinnedWidth, min, max));
            }
            var pins = raw.Select(Context.EffectiveColumnPin).ToArray();
            var widths = new int?[raw.Count];
            for (var i = 0; i < raw.Count; i++) widths[i] = WidthOf(raw[i], pins[i]);
            var offsets = new string?[raw.Count];
            var sum = 0;
            for (var i = 0; i < raw.Count; i++)
            {
                if (pins[i] != DataListPin.Start) continue;
                offsets[i] = selecting ? $"calc({SelectionWidth} + {sum}px)" : $"{sum}px";
                sum += widths[i] ?? 0;
            }
            sum = 0;
            for (var i = raw.Count - 1; i >= 0; i--)
            {
                if (pins[i] != DataListPin.End) continue;
                offsets[i] = acting ? $"calc(var(--bx-actions-w, 0px) + {sum}px)" : $"{sum}px";
                sum += widths[i] ?? 0;
            }
            var views = new List<View>(raw.Count);
            for (var i = 0; i < raw.Count; i++)
            {
                var c = raw[i];
                var key = c.ResolvedKey;
                var sortable = key is not null && schema is not null && schema.SortKeys.Contains(key) && (c.Sortable ?? true);
                var min = Math.Max(DataListColumnPreferences.MinAllowedWidth, c.MinWidth);
                var max = Math.Clamp(c.MaxWidth, min, DataListColumnPreferences.MaxAllowedWidth);
                int? declared = c.Width is { } w ? Math.Clamp(w, min, max) : pins[i] != DataListPin.None ? Math.Clamp(BxDataList<TItem>.DefaultPinnedWidth, min, max) : null;
                views.Add(new View(c, key, c.ResolvedTitle, c.Align, sortable, c.Class, pins[i], widths[i], declared, min, max, c.Resizable, offsets[i]));
            }
            return views;
        }
        if (schema is null) return [];
        return [.. schema.Fields.Where(f => !f.IsCollection)
            .Select(f => new View(null, f.Key, DataListText.Humanize(f.Key), DataListAlign.Start, f.Sortable, null, DataListPin.None, null, null, DataListColumnPreferences.MinAllowedWidth, DataListColumnPreferences.MaxAllowedWidth, false, null))];
    }

    // The selection and actions columns are fixed: never hidden, never moved. They stick only to give way to the columns pinned on their side.
    private string ActionsClass(string kind, bool stuck) =>
        $"{_slots[kind]} {_slots[kind + "End"]} {_slots["rowActionsCell"]} {(stuck ? _slots[kind == "th" ? "thPinnedEnd" : "tdPinnedEnd"] : "")}".TrimEnd();

    private string SelectClass(string kind, bool stuck) =>
        $"{_slots[kind]} {_slots[kind + "Start"]} {_slots["selectCell"]} {(stuck ? _slots[kind == "th" ? "thPinnedStart" : "tdPinnedStart"] : "")}".TrimEnd();

    private string HeaderClass(View column)
    {
        var pin = column.Pinned switch
        {
            DataListPin.Start => _slots["thPinnedStart"],
            DataListPin.End => _slots["thPinnedEnd"],
            _ => "",
        };
        // The handle sits at the end edge of the cell: a pinned cell is already a positioned box.
        var resize = Resizable && Context.IsInteractive && column.Resizable && column.Pinned == DataListPin.None ? "relative" : "";
        var sized = column.Width is not null ? _slots["colSized"] : "";
        return $"{_slots["th"]} {AlignClass(column.Align, "th")} {pin} {resize} {sized} {column.Class}".Trim();
    }

    private string CellClass(View column)
    {
        var pin = column.Pinned switch
        {
            DataListPin.Start => _slots["tdPinnedStart"],
            DataListPin.End => _slots["tdPinnedEnd"],
            _ => "",
        };
        var sized = column.Width is not null ? _slots["colSized"] : "";
        return $"{_slots["td"]} {AlignClass(column.Align, "td")} {pin} {sized} {column.Class}".Trim();
    }

    private static string? PinAttr(View column) => column.Pinned switch
    {
        DataListPin.Start => "start",
        DataListPin.End => "end",
        _ => null,
    };

    // The inline style of a cell of the column: the width it was given (a column the user resized keeps it whatever its content) and, when pinned, the distance from its edge.
    private static string? CellStyle(View column)
    {
        var width = column.Width is { } px ? $"width:{px}px;min-width:{px}px;max-width:{px}px" : null;
        var pin = column.Pinned switch
        {
            DataListPin.Start => $"inset-inline-start:{column.PinOffset}",
            DataListPin.End => $"inset-inline-end:{column.PinOffset}",
            _ => null,
        };
        return width is null ? pin : pin is null ? width : $"{width};{pin}";
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private void OnResizeReported(View column, BxChangeEventArgs e)
    {
        if (column.Key is null || e.Value is not { } value) return;
        if (value == "reset") Context.SetColumnWidth(column.Key, null);
        else if (int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var width)) Context.SetColumnWidth(column.Key, width);
    }

    private string AlignClass(DataListAlign align, string kind) => align switch
    {
        DataListAlign.Center => _slots[kind + "Center"],
        DataListAlign.End => _slots[kind + "End"],
        _ => _slots[kind + "Start"],
    };

    private string? AriaSort(View column) =>
        !column.Sortable ? null : Context.SortDescending(column.Key!) switch
        {
            null => "none",
            false => "ascending",
            true => "descending",
        };

    // What a click on the sort control of the column does, as its accessible name.
    private string SortLabel(View column)
    {
        var template = Context.SortDescending(column.Key!) switch
        {
            null => ToolsMessages.SortAscending,
            false => ToolsMessages.SortDescending,
            true => ToolsMessages.SortClear,
        };
        return string.Format(FormatCulture, template, column.Title);
    }

    private RenderFragment Header(View column) => builder =>
    {
        if (column.Source?.HeaderTemplate is { } headerTemplate)
        {
            builder.AddContent(15, headerTemplate);
            return;
        }
        if (!column.Sortable)
        {
            builder.AddContent(0, column.Title);
            return;
        }
        var key = column.Key!;
        var direction = Context.SortDescending(key);
        var icon = direction switch
        {
            null => RenderIcon(Options.Icons.ChevronUpDown, _slots["sortIcon"]),
            false => RenderIcon(Options.Icons.ArrowUp, _slots["sortIconActive"]),
            true => RenderIcon(Options.Icons.ArrowDown, _slots["sortIconActive"]),
        };
        if (Context.IsInteractive)
        {
            builder.OpenElement(1, "button");
            builder.AddAttribute(2, "type", "button");
            builder.AddAttribute(3, "class", _slots["sortButton"]);
            builder.AddAttribute(4, "aria-label", SortLabel(column));
            builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => Context.SetState(s => Context.NextSort(s, key), QueryHistory.Push)));
            builder.AddContent(6, column.Title);
            builder.AddContent(7, icon);
            builder.CloseElement();
        }
        else if (Context.HrefWith(s => Context.NextSort(s, key)) is { } href)
        {
            builder.OpenElement(8, "a");
            builder.AddAttribute(9, "href", href);
            builder.AddAttribute(10, "class", _slots["sortButton"]);
            builder.AddAttribute(11, "aria-label", SortLabel(column));
            builder.AddContent(12, column.Title);
            builder.AddContent(13, icon);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(14, column.Title);
        }
    };

    private RenderFragment Cell(View column, TItem item) => builder =>
    {
        if (column.Source?.Template is { } template)
        {
            builder.AddContent(0, template(item));
            return;
        }
        var value = column.Source is { } source ? source.ReadValue(item, Context.Schema) : column.Key is not null ? Context.Schema?.ReadField(item, column.Key) : null;
        var text = column.Source is { } formatter
            ? formatter.FormatValue(value, FormatCulture)
            : value is IFormattable formattable ? formattable.ToString(null, FormatCulture) : value?.ToString();
        builder.AddContent(1, text);
    };
}
