    private string TreeToggleLabel(DataListTreeNode<TItem> node, int position, bool expanded)
    {
        var label = Context.Schema?.GetRowLabel(node.Item);
        var name = !string.IsNullOrWhiteSpace(label) ? label : "#" + position;
        return string.Format(FormatCulture, expanded ? ToolsMessages.TreeCollapse : ToolsMessages.TreeExpand, name);
    }

    private void OnTreeKeyDown(KeyboardEventArgs e, DataListTreeNode<TItem> node, bool expanded)
    {
        if (!Context.IsInteractive) return;
        if (e.Key == "ArrowRight" && !expanded)
        {
            Context.SetNodeExpanded(node, true);
        }
        else if (e.Key == "ArrowLeft" && expanded)
        {
            Context.SetNodeExpanded(node, false);
        }
    }

    // The rows with a key each: the row key of the schema, else the identity of the row (the reference). A schema whose keys repeat (a data error) falls back to the identity of the rows, and a row that is itself listed twice to its position.
    private List<RowEntry> RowEntries() => BuildRowEntries(Context.Rows);

    private List<RowEntry> TreeRowEntries()
    {
        var nodes = Context.VisibleTreeNodes();
        var entries = new List<RowEntry>(nodes.Count);
        for (var i = 0; i < nodes.Count; i++)
        {
            var node = nodes[i];
            entries.Add(new RowEntry(node.Key, node.Item, i + 1, node));
        }
        return entries;
    }

    private List<GroupedRowEntries> GroupRowEntries()
    {
        if (GroupBy is null) return [];
        var built = GroupBy.BuildGroups(Context.Rows, Context.Schema, ToolsMessages, FormatCulture);
        var flattened = new List<TItem>(Context.Rows.Count);
        foreach (var g in built) flattened.AddRange(g.Items);
        var allEntries = BuildRowEntries(flattened);
        var result = new List<GroupedRowEntries>(built.Count);
        var offset = 0;
        foreach (var g in built)
        {
            var count = g.Items.Count;
            result.Add(new GroupedRowEntries(g, allEntries.GetRange(offset, count)));
            offset += count;
        }
        return result;
    }

    private List<RowEntry> BuildRowEntries(IReadOnlyList<TItem> rows)
    {
        var schema = Context.Schema;
        var entries = new List<RowEntry>(rows.Count);
        if (schema is { HasRowKey: true })
        {
            var seen = new HashSet<object>();
            var unique = true;
            var pos = 0;
            foreach (var item in rows)
            {
                pos++;
                var key = schema.GetRowKey(item);
                unique &= seen.Add(key);
                entries.Add(new RowEntry(key, item, pos));
            }
            if (unique) return entries;
            entries.Clear();
        }
        var identities = new HashSet<object>();
        var index = 0;
        foreach (var item in rows)
        {
            object key = item is not null && identities.Add(new RowReferenceKey(item)) ? new RowReferenceKey(item) : index;
            entries.Add(new RowEntry(key, item, index + 1));
            index++;
        }
        return entries;
    }

    private sealed record View(
        BxDataListColumn<TItem>? Source,
        string? Key,
        string Title,
        DataListAlign Align,
        bool Sortable,
        string? Class,
        DataListPin Pinned,
        int? Width,
        int? DeclaredWidth,
        int MinWidth,
        int MaxWidth,
        bool Resizable,
        string? PinOffset);

    // The room the selection column takes at the start edge (the w-10 of its slot): a column pinned to the start sticks after it.
    private const string SelectionWidth = "2.5rem";

    // The columns as declared (filtered, ordered and grouped by pin edge), or one per field of the schema when none was.
    private List<View> Columns()
    {
        var schema = Context.Schema;
        if (Context.Columns.Count > 0)
        {
            var raw = Context.TableColumns();
            var selecting = Context.SelectionVisible;
            var acting = RowActions is { Count: > 0 };
            // A pinned column needs a width of its own: the offset of the next one is the sum of the widths before it. Without one it gets BxDataList<TItem>.DefaultPinnedWidth.
            int? WidthOf(BxDataListColumn<TItem> c, DataListPin pin)
            {
                var min = Math.Max(DataListColumnPreferences.MinAllowedWidth, c.MinWidth);
                var max = Math.Clamp(c.MaxWidth, min, DataListColumnPreferences.MaxAllowedWidth);
                var width = Context.EffectiveColumnWidth(c);
                return width ?? (pin == DataListPin.None ? null : Math.Clamp(BxDataList<TItem>.DefaultPinnedWidth, min, max));
            }
            var pins = raw.Select(Context.EffectiveColumnPin).ToArray();
            var widths = new int?[raw.Count];
            for (var i = 0; i < raw.Count; i++) widths[i] = WidthOf(raw[i], pins[i]);
            var offsets = new string?[raw.Count];
            var sum = 0;
            for (var i = 0; i < raw.Count; i++)
            {
                if (pins[i] != DataListPin.Start) continue;
                offsets[i] = selecting ? $"calc({SelectionWidth} + {sum}px)" : $"{sum}px";
                sum += widths[i] ?? 0;
            }
            sum = 0;
            var actionsFallback = acting ? ActionsFallbackWidth() : 0;
            for (var i = raw.Count - 1; i >= 0; i--)
            {
                if (pins[i] != DataListPin.End) continue;
                offsets[i] = acting ? $"calc(var(--bx-actions-w, {actionsFallback}px) + {sum}px)" : $"{sum}px";
                sum += widths[i] ?? 0;
            }
            var views = new List<View>(raw.Count);
            for (var i = 0; i < raw.Count; i++)
            {
                var c = raw[i];
                var key = c.ResolvedKey;
                var sortable = key is not null && schema is not null && schema.SortKeys.Contains(key) && (c.Sortable ?? true);
                var min = Math.Max(DataListColumnPreferences.MinAllowedWidth, c.MinWidth);
                var max = Math.Clamp(c.MaxWidth, min, DataListColumnPreferences.MaxAllowedWidth);
                int? declared = c.Width is { } w ? Math.Clamp(w, min, max) : pins[i] != DataListPin.None ? Math.Clamp(BxDataList<TItem>.DefaultPinnedWidth, min, max) : null;
                views.Add(new View(c, key, c.ResolvedTitle, c.Align, sortable, c.Class, pins[i], widths[i], declared, min, max, c.Resizable, offsets[i]));
            }
            return views;
        }
        if (schema is null) return [];
        return [.. schema.Fields.Where(f => !f.IsCollection)
            .Select(f => new View(null, f.Key, DataListText.Humanize(f.Key), DataListAlign.Start, f.Sortable, null, DataListPin.None, null, null, DataListColumnPreferences.MinAllowedWidth, DataListColumnPreferences.MaxAllowedWidth, false, null))];
    }

    // Deterministic fallback width in pixels for the row-actions column before ResizeObserver measures --bx-actions-w (or in static SSR where no script runs),
    // so an end-pinned column never overlaps the actions column on first paint.
    private int ActionsFallbackWidth()
    {
        if (RowActions is not { Count: > 0 }) return 0;
        var maxInline = Math.Max(0, RowActionsMaxVisible);
        var inlineCount = Math.Min(maxInline, RowActions.Count(a => a.Children is not { Count: > 0 }));
        var hasOverflow = RowActions.Count > inlineCount;
        return Math.Max(56, 24 + inlineCount * 68 + (hasOverflow ? 36 : 0));
    }

    // The selection and actions columns are fixed: never hidden, never moved. They stick only to give way to the columns pinned on their side.
    private string ActionsClass(string kind, bool stuck) =>
        $"{_slots[kind]} {_slots[kind + "End"]} {_slots["rowActionsCell"]} {(stuck ? _slots[kind == "th" ? "thPinnedEnd" : "tdPinnedEnd"] : "")}".TrimEnd();

    private string SelectClass(string kind, bool stuck) =>
        $"{_slots[kind]} {_slots[kind + "Start"]} {_slots["selectCell"]} {(stuck ? _slots[kind == "th" ? "thPinnedStart" : "tdPinnedStart"] : "")}".TrimEnd();

    private string ActionsFooterClass(bool stuck) =>
        $"{_slots["td"]} {_slots["tfootCell"]} {_slots["tdEnd"]} {_slots["rowActionsCell"]} {(stuck ? _slots["tfootCellPinnedEnd"] : "")}".TrimEnd();

    private string SelectFooterClass(bool stuck) =>
        $"{_slots["td"]} {_slots["tfootCell"]} {_slots["tdStart"]} {_slots["selectCell"]} {(stuck ? _slots["tfootCellPinnedStart"] : "")}".TrimEnd();

    private string FooterCellClass(View column)
    {
        var pin = column.Pinned switch
        {
            DataListPin.Start => _slots["tfootCellPinnedStart"],
            DataListPin.End => _slots["tfootCellPinnedEnd"],
            _ => "",
        };
        var sized = column.Width is not null ? _slots["colSized"] : "";
        return $"{_slots["td"]} {_slots["tfootCell"]} {AlignClass(column.Align, "td")} {pin} {sized} {column.Class}".Trim();
    }

    private bool HasActiveSummaries(List<View> columns) =>
        Summaries is not null || columns.Any(c => c.Source?.HasSummary == true);

    private IReadOnlyList<DataListSummaryScope> EffectiveSummaryScopes() =>
        Summaries?.EffectiveScopes ?? [DataListSummaryScope.Filtered];

    private IReadOnlyList<TItem> RowsForSummaryScope(DataListSummaryScope scope) => scope switch
    {
        DataListSummaryScope.Page => Context.Rows,
        DataListSummaryScope.Selection => Context.SelectedItems,
        _ => Context.FilteredRows(),
    };

    private static string SummaryScopeKey(DataListSummaryScope scope) => scope switch
    {
        DataListSummaryScope.Page => "page",
        DataListSummaryScope.Selection => "selection",
        _ => "filtered",
    };

    private string SummaryScopeLabel(DataListSummaryScope scope, bool multipleScopes)
    {
        if (!multipleScopes)
        {
            if (!string.IsNullOrWhiteSpace(Summaries?.Label)) return Summaries.Label;
            return scope switch
            {
                DataListSummaryScope.Page => ToolsMessages.SummaryPage,
                DataListSummaryScope.Selection => ToolsMessages.SummarySelection,
                _ => ToolsMessages.SummaryTotal,
            };
        }
        return scope switch
        {
            DataListSummaryScope.Page => ToolsMessages.SummaryPage,
            DataListSummaryScope.Selection => ToolsMessages.SummarySelection,
            _ => !string.IsNullOrWhiteSpace(Summaries?.Label) ? Summaries.Label : ToolsMessages.SummaryFiltered,
        };
    }

    private bool HasSummaryForColumn(View column, DataListSummaryScope scope)
    {
        if (column.Source?.HasSummary == true) return true;
        if (column.Key is not null && _resolvedSummaries.TryGetValue(scope, out var map) && map.ContainsKey(column.Key)) return true;
        return false;
    }

    private RenderFragment RenderSummaryCell(View column, DataListSummaryScope scope, IReadOnlyList<TItem> scopeRows) => builder =>
    {
        var src = column.Source;
        object? rawValue = null;
        var hasAsync = column.Key is not null && _resolvedSummaries.TryGetValue(scope, out var map) && map.TryGetValue(column.Key, out rawValue);
        if (!hasAsync && src is not null)
        {
            if (src.SummaryValue is not null)
            {
                rawValue = src.SummaryValue(scopeRows);
            }
            else if (src.Summary != DataListSummaryKind.None)
            {
                rawValue = DataListSummaryCalculator.Compute(src.Summary, scopeRows, item => src.ReadValue(item, Context.Schema));
            }
        }
        var formatted = src is not null
            ? src.FormatSummaryValue(rawValue, FormatCulture, ToolsMessages)
            : (rawValue is IFormattable f ? f.ToString(null, FormatCulture) : rawValue?.ToString());

        if (src?.SummaryTemplate is { } template)
        {
            var ctx = new DataListSummaryCellContext<TItem>(Context, column.Key, scope, scopeRows, rawValue, formatted, _summaryLoading);
            builder.AddContent(0, template(ctx));
            return;
        }
        if (_summaryLoading && !hasAsync && Summaries?.ResolveAsync is not null)
        {
            builder.OpenComponent<BxSkeleton>(1);
            builder.AddAttribute(2, nameof(BxSkeleton.Class), "inline-block h-4 w-16");
            builder.CloseComponent();
            return;
        }
        if (!string.IsNullOrEmpty(formatted))
        {
            builder.AddContent(3, formatted);
        }
    };

    private void SyncSummarySelectionSubscription()
    {
        var shouldSubscribe = Summaries is not null || Context.Columns.Any(c => c.HasSummary);
        if (shouldSubscribe && !_subscribedSelectionForSummary)
        {
            Context.SelectionChanged += OnSummarySelectionChanged;
            _subscribedSelectionForSummary = true;
        }
    }

    private void OnSummarySelectionChanged()
    {
        if (!EffectiveSummaryScopes().Contains(DataListSummaryScope.Selection)) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                EnsureSummariesResolved();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void EnsureSummariesResolved()
    {
        SyncSummarySelectionSubscription();
        if (Summaries?.ResolveAsync is not { } resolver || Context.IsInitial) return;
        var scopes = EffectiveSummaryScopes();
        var selectionPart = scopes.Contains(DataListSummaryScope.Selection)
            ? string.Join(',', Context.SelectedKeys.Order(StringComparer.Ordinal))
            : "";
        var sig = $"{Context.ResultVersion}|{string.Join(',', scopes)}|{selectionPart}";
        if (sig == _summaryResolveSignature) return;
        _summaryResolveSignature = sig;
        _summaryCts?.Cancel();
        _summaryCts?.Dispose();
        var cts = CancellationTokenSource.CreateLinkedTokenSource(Context.LifetimeToken);
        _summaryCts = cts;
        _ = RunSummaryResolveAsync(resolver, scopes, cts.Token);
    }

    private async Task RunSummaryResolveAsync(
        Func<DataListSummaryResolveContext<TItem>, ValueTask<IReadOnlyDictionary<string, object?>>> resolver,
        IReadOnlyList<DataListSummaryScope> scopes,
        CancellationToken ct)
    {
        _summaryLoading = true;
        try
        {
            var next = new Dictionary<DataListSummaryScope, IReadOnlyDictionary<string, object?>>();
            foreach (var scope in scopes)
            {
                ct.ThrowIfCancellationRequested();
                var rows = RowsForSummaryScope(scope);
                var ctx = new DataListSummaryResolveContext<TItem>(Context, scope, rows, Context.AllResultsRequest, ct);
                var values = await resolver(ctx);
                if (values is not null) next[scope] = values;
            }
            if (ct.IsCancellationRequested) return;
            _resolvedSummaries.Clear();
            foreach (var (s, map) in next) _resolvedSummaries[s] = map;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _summaryLoading = false;
                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch (ObjectDisposedException)
                {
                }
            }
        }
    }

    private string HeaderClass(View column)
    {
        var pin = column.Pinned switch
        {
            DataListPin.Start => _slots["thPinnedStart"],
            DataListPin.End => _slots["thPinnedEnd"],
            _ => "",
        };
        // The handle sits at the end edge of the cell: from sm up a pinned cell is sticky (already a positioned box), below sm it is not sticky so it needs max-sm:relative.
        var resize = Resizable && Context.IsInteractive && column.Resizable ? (column.Pinned == DataListPin.None ? "relative" : "max-sm:relative") : "";
        var sized = column.Width is not null ? _slots["colSized"] : "";
        return $"{_slots["th"]} {AlignClass(column.Align, "th")} {pin} {resize} {sized} {column.Class}".Trim();
    }

    private string CellClass(View column)
    {
        var pin = column.Pinned switch
        {
            DataListPin.Start => _slots["tdPinnedStart"],
            DataListPin.End => _slots["tdPinnedEnd"],
            _ => "",
        };
        var sized = column.Width is not null ? _slots["colSized"] : "";
        return $"{_slots["td"]} {AlignClass(column.Align, "td")} {pin} {sized} {column.Class}".Trim();
    }

    private static string? PinAttr(View column) => column.Pinned switch
    {
        DataListPin.Start => "start",
        DataListPin.End => "end",
        _ => null,
    };

    // The inline style of a cell of the column: the width it was given (a column the user resized keeps it whatever its content) and, when pinned, the distance from its edge.
    private static string? CellStyle(View column)
    {
        var width = column.Width is { } px ? $"width:{px}px;min-width:{px}px;max-width:{px}px" : null;
        var pin = column.Pinned switch
        {
            DataListPin.Start => $"inset-inline-start:{column.PinOffset}",
            DataListPin.End => $"inset-inline-end:{column.PinOffset}",
            _ => null,
        };
        return width is null ? pin : pin is null ? width : $"{width};{pin}";
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private void OnResizeReported(View column, BxChangeEventArgs e)
    {
        if (column.Key is null || e.Value is not { } value) return;
        if (value == "reset") Context.SetColumnWidth(column.Key, null);
        else if (int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var width)) Context.SetColumnWidth(column.Key, width);
    }

    private string AlignClass(DataListAlign align, string kind) => align switch
    {
        DataListAlign.Center => _slots[kind + "Center"],
        DataListAlign.End => _slots[kind + "End"],
        _ => _slots[kind + "Start"],
    };

    private string? AriaSort(View column) =>
        !column.Sortable ? null : Context.SortDescending(column.Key!) switch
        {
            null => "none",
            false => "ascending",
            true => "descending",
        };

    // What a click on the sort control of the column does, as its accessible name.
    private string SortLabel(View column)
    {
        var template = Context.SortDescending(column.Key!) switch
        {
            null => ToolsMessages.SortAscending,
            false => ToolsMessages.SortDescending,
            true => ToolsMessages.SortClear,
        };
        return string.Format(FormatCulture, template, column.Title);
    }

    private RenderFragment Header(View column) => builder =>
    {
        if (column.Source?.HeaderTemplate is { } headerTemplate)
        {
            builder.AddContent(15, headerTemplate);
            return;
        }
        if (!column.Sortable)
        {
            builder.AddContent(0, column.Title);
            return;
        }
        var key = column.Key!;
        var direction = Context.SortDescending(key);
        var icon = direction switch
        {
            null => RenderIcon(Options.Icons.ChevronUpDown, _slots["sortIcon"]),
            false => RenderIcon(Options.Icons.ArrowUp, _slots["sortIconActive"]),
            true => RenderIcon(Options.Icons.ArrowDown, _slots["sortIconActive"]),
        };
        if (Context.IsInteractive)
        {
            builder.OpenElement(1, "button");
            builder.AddAttribute(2, "type", "button");
            builder.AddAttribute(3, "class", _slots["sortButton"]);
            builder.AddAttribute(4, "aria-label", SortLabel(column));
            builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => Context.SetState(s => Context.NextSort(s, key), QueryHistory.Push)));
            builder.AddContent(6, column.Title);
            builder.AddContent(7, icon);
            builder.CloseElement();
        }
        else if (Context.HrefWith(s => Context.NextSort(s, key)) is { } href)
        {
            builder.OpenElement(8, "a");
            builder.AddAttribute(9, "href", href);
            builder.AddAttribute(10, "class", _slots["sortButton"]);
            builder.AddAttribute(11, "aria-label", SortLabel(column));
            builder.AddContent(12, column.Title);
            builder.AddContent(13, icon);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(14, column.Title);
        }
    };

    private RenderFragment Cell(View column, TItem item) => builder =>
    {
        if (column.Source?.Template is { } template)
        {
            builder.AddContent(0, template(item));
            return;
        }
        builder.AddContent(1, ColumnText(column, item));
    };

    private string? ColumnText(View column, TItem item)
    {
        var value = column.Source is { } source ? source.ReadValue(item, Context.Schema) : column.Key is not null ? Context.Schema?.ReadField(item, column.Key) : null;
        return column.Source is { } formatter
            ? formatter.FormatValue(value, FormatCulture)
            : value is IFormattable formattable ? formattable.ToString(null, FormatCulture) : value?.ToString();
    }

    private string SummaryTitle(DataListRowSummary<TItem> summary, List<View> columns, TItem item)
    {
        if (summary.Title is not null) return summary.Title(item) ?? "";
        if (Context.Schema?.GetRowLabel(item) is { Length: > 0 } rowLabel) return rowLabel;
        return columns.Count > 0 ? ColumnText(columns[0], item) ?? "" : item?.ToString() ?? "";
    }

    private string SummaryDetails(DataListRowSummary<TItem> summary, List<View> columns, TItem item)
    {
        if (summary.Details is not null)
        {
            return string.Join(" · ", summary.Details(item).Where(s => !string.IsNullOrWhiteSpace(s)));
        }
        if (columns.Count <= 1) return "";
        return string.Join(" · ", columns.Skip(1).Select(c => ColumnText(c, item)).Where(s => !string.IsNullOrWhiteSpace(s)));
    }
}
