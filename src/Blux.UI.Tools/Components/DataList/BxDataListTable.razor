    private RenderFragment RenderEmptyState() => builder =>
    {
        if (Empty is not null)
        {
            builder.AddContent(0, Empty(Context));
            return;
        }
        if (Context.IsFilteredFor(Context.LoadedState ?? Context.State))
        {
            builder.OpenComponent<BxDataListEmpty>(1);
            builder.AddAttribute(2, nameof(BxDataListEmpty.Title), FilteredTitle);
            builder.AddAttribute(3, nameof(BxDataListEmpty.Description), FilteredDescription);
            builder.AddAttribute(4, nameof(BxDataListEmpty.Actions), FilteredAction);
            builder.AddAttribute(5, "data-filtered", "true");
            builder.CloseComponent();
            return;
        }
        builder.OpenComponent<BxDataListEmpty>(6);
        if (EmptyState is { } es)
        {
            if (es.Icon is not null) builder.AddAttribute(7, nameof(BxDataListEmpty.Icon), es.Icon);
            if (es.Title is not null) builder.AddAttribute(8, nameof(BxDataListEmpty.Title), es.Title);
            if (es.HideDescription) builder.AddAttribute(9, nameof(BxDataListEmpty.Description), "");
            else if (es.Description is not null) builder.AddAttribute(10, nameof(BxDataListEmpty.Description), es.Description);
            if (es.Action is { } act && (!string.IsNullOrEmpty(act.Href) || Context.IsInteractive))
            {
                builder.AddAttribute(11, nameof(BxDataListEmpty.Actions), (RenderFragment)(b =>
                {
                    b.OpenComponent<BxButton>(0);
                    b.AddAttribute(1, nameof(BxButton.Label), act.Label);
                    b.AddAttribute(2, nameof(BxButton.Color), act.Color);
                    b.AddAttribute(3, nameof(BxButton.Variant), act.Variant);
                    if (!string.IsNullOrEmpty(act.Icon)) b.AddAttribute(4, nameof(BxButton.LeadingIcon), RenderIcon(act.Icon, "size-4"));
                    if (!string.IsNullOrEmpty(act.Href)) b.AddAttribute(5, nameof(BxButton.Href), act.Href);
                    if (Context.IsInteractive && act.OnClick.HasDelegate)
                        b.AddAttribute(6, nameof(BxButton.OnClick), EventCallback.Factory.Create<MouseEventArgs>(this, () => act.OnClick.InvokeAsync()));
                    b.AddAttribute(7, "data-slot", "empty-action");
                    b.CloseComponent();
                }));
            }
        }
        builder.CloseComponent();
    };

