@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>
@using Blux.UI.Tools.Query

@*
    Sort menu: picks the sort field, its direction (ascending or descending), or restores the default sort order.
    Essential in Grid layout (where there are no table column headers) and on small screens, and usable in any toolbar.
    Works in every render mode: in static rendering the popover opens via the native Popover API and the choices inside are links (?s=...).
*@
@if (ShouldShow)
{
    var options = Context.SortOptions(Items);
    if (options.Count > 0)
    {
        var active = Context.EffectiveSort is { Count: > 0 } s ? s[0] : null;
        var activeOption = active is null ? null : options.FirstOrDefault(o => string.Equals(o.Key, active.Key, StringComparison.Ordinal));
        var activeLabel = activeOption?.Label ?? (active is not null ? DataListText.Humanize(active.Key) : null);
        var descending = active?.Descending ?? false;
        var targetKey = active?.Key ?? options[0].Key;
        var isDefault = Context.IsDefaultSort(Context.State);
        var triggerText = activeLabel is not null
            ? (Label is not null ? $"{Label}: {activeLabel}" : string.Format(FormatCulture, ToolsMessages.SortBy, activeLabel))
            : (Label ?? ToolsMessages.Sort);
        var triggerIcon = active is null ? "arrow-up-down" : descending ? Options.Icons.ArrowDown : Options.Icons.ArrowUp;

        <div class="@_slots["sortMenu"]" data-slot="sort-menu" @attributes="AdditionalAttributes">
            <BxPopover Placement="bottom-end" Ui="_popoverUi">
                <ChildContent>
                    <BxButton Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="Size"
                              Label="@triggerText" LeadingIcon="@RenderIcon(triggerIcon, "size-4")" data-slot="sort-trigger" />
                </ChildContent>
                <Content>
                    <div class="@_slots["sortMenuContent"]" data-slot="sort-content">
                        <div class="@_slots["sortMenuHeader"]">
                            <p class="@_slots["sortMenuTitle"]">@(Label ?? ToolsMessages.Sort)</p>
                            @if (Context.IsInteractive)
                            {
                                <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="BxSize.Xs"
                                          Label="@ToolsMessages.SortDefault" Disabled="@isDefault"
                                          OnClick="@(() => Context.SetState(Context.ClearSort, QueryHistory.Push))" data-slot="sort-reset" />
                            }
                            else if (!isDefault && Context.CanLink && Context.HrefWith(Context.ClearSort) is { } resetHref)
                            {
                                <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="BxSize.Xs"
                                          Label="@ToolsMessages.SortDefault" Href="@resetHref" data-slot="sort-reset" />
                            }
                        </div>
                        <div class="@_slots["sortMenuDirections"]" role="group" aria-label="@(Label ?? ToolsMessages.Sort)" data-slot="sort-directions">
                            @DirectionControl(targetKey, isDescending: false, active is not null && !descending, ToolsMessages.SortDirectionAscending, Options.Icons.ArrowUp, "asc")
                            @DirectionControl(targetKey, isDescending: true, active is not null && descending, ToolsMessages.SortDirectionDescending, Options.Icons.ArrowDown, "desc")
                        </div>
                        <ul class="@_slots["sortMenuList"]" data-slot="sort-list">
                            @foreach (var opt in options)
                            {
                                var key = opt.Key;
                                var label = opt.Label ?? DataListText.Humanize(key);
                                var isCurrent = active is not null && string.Equals(active.Key, key, StringComparison.Ordinal);
                                var nextDesc = isCurrent ? !descending : descending;
                                <li>
                                    @if (Context.IsInteractive)
                                    {
                                        <button type="button" class="@_slots["sortMenuItem"]" aria-current="@(isCurrent ? "true" : null)"
                                                data-slot="sort-item" data-sort-key="@key"
                                                @onclick="@(() => Context.SetState(s => Context.WithSort(s, key, nextDesc), QueryHistory.Push))">
                                            <span class="truncate">@label</span>
                                            @if (isCurrent)
                                            {
                                                @RenderIcon(descending ? Options.Icons.ArrowDown : Options.Icons.ArrowUp, "size-4 shrink-0")
                                            }
                                        </button>
                                    }
                                    else if (Context.CanLink && Context.HrefWith(s => Context.WithSort(s, key, nextDesc)) is { } href)
                                    {
                                        <a href="@href" class="@_slots["sortMenuItem"]" aria-current="@(isCurrent ? "true" : null)"
                                           data-slot="sort-item" data-sort-key="@key">
                                            <span class="truncate">@label</span>
                                            @if (isCurrent)
                                            {
                                                @RenderIcon(descending ? Options.Icons.ArrowDown : Options.Icons.ArrowUp, "size-4 shrink-0")
                                            }
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="@_slots["sortMenuItem"]" aria-current="@(isCurrent ? "true" : null)" data-slot="sort-item" data-sort-key="@key">
                                            <span class="truncate">@label</span>
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </Content>
            </BxPopover>
        </div>
    }
}

@code {
    private SlotSet _slots = default!;
    private PopoverUi _popoverUi = new();

    /// <summary>Label of the trigger button and heading of the popover. Defaults to the localized "Sort".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Size of the trigger button (small by default).</summary>
    [Parameter] public BxSize Size { get; set; } = BxSize.Sm;

    /// <summary>
    /// Explicit sortable field options. When <see langword="null"/>, the menu lists the sortable <see cref="BxDataListColumn{TItem}"/>s in user order followed by any other sortable fields of the schema.
    /// </summary>
    [Parameter] public IReadOnlyList<DataListSortOption>? Items { get; set; }

    /// <summary>
    /// Layouts in which the sort menu is shown (for example <c>[DataListLayout.Grid]</c> when the table headers already sort). When <see langword="null"/>, shown in every layout.
    /// </summary>
    [Parameter] public IReadOnlyList<DataListLayout>? Layouts { get; set; }

    private bool ShouldShow => Layouts is null || Layouts.Contains(Context.EffectiveLayout) || (Context.EffectiveLayout == DataListLayout.Table && Context.SummaryViewActive);

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "sortMenu");
        _popoverUi = new PopoverUi { Content = _slots["sortMenuPopover"] };
    }

    private RenderFragment DirectionControl(string targetKey, bool isDescending, bool isActive, string text, string icon, string slotDir) =>
        @<text>
            @if (Context.IsInteractive)
            {
                <button type="button" class="@_slots["sortMenuDirection"]" aria-pressed="@(isActive ? "true" : "false")"
                        data-slot="sort-direction" data-direction="@slotDir"
                        @onclick="@(() => Context.SetState(s => Context.WithSort(s, targetKey, isDescending), QueryHistory.Push))">
                    @RenderIcon(icon, "size-3.5 shrink-0")
                    <span>@text</span>
                </button>
            }
            else if (Context.CanLink && Context.HrefWith(s => Context.WithSort(s, targetKey, isDescending)) is { } href)
            {
                <a href="@href" class="@_slots["sortMenuDirection"]" aria-current="@(isActive ? "true" : null)"
                   data-slot="sort-direction" data-direction="@slotDir">
                    @RenderIcon(icon, "size-3.5 shrink-0")
                    <span>@text</span>
                </a>
            }
        </text>;
}
