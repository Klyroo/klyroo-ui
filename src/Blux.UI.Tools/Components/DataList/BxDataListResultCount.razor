@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>

@* A polite live region: the count is what changes when a page, a sort or a refresh brings other rows, so it is what a screen reader announces. *@
<p class="@_slots["resultCount"]" data-slot="result-count" role="status" aria-live="polite" aria-atomic="true" @attributes="AdditionalAttributes">@Text</p>

@code {
    private SlotSet _slots = default!;

    protected override void OnParametersSet() =>
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "resultCount");

    // The rows on screen, not the ones being loaded: the text changes when they do.
    private string Text
    {
        get
        {
            if (Context.IsInitial) return ToolsMessages.Loading;
            if (Context.Result is not { } result) return "";
            if (result.Items.Count == 0)
            {
                // Said once the search matched nothing: the polite region is what tells a screen reader, which cannot see the empty state appear.
                var search = (Context.LoadedState ?? Context.State).Search.Trim();
                return search.Length > 0 ? string.Format(FormatCulture, ToolsMessages.NoResultsFor, search) : ToolsMessages.NoResults;
            }
            var loaded = Context.LoadedState ?? Context.State;
            // Numbers are written with the group separator of the culture.
            string Number(long value) => value.ToString("N0", FormatCulture);
            if (Context.PagingMode == DataListPagingMode.Cursor && !string.IsNullOrEmpty(loaded.Cursor))
            {
                // A cursor page loaded directly from the address (static SSR): the 1-based start offset is unknown.
                return result.TotalCount is { } cursorTotal
                    ? string.Format(FormatCulture, ToolsMessages.ResultCountLoaded, Number(result.Items.Count), Number(cursorTotal))
                    : string.Format(FormatCulture, ToolsMessages.ResultCountShown, Number(result.Items.Count));
            }
            var first = Context.PagingMode == DataListPagingMode.Offset ? (long)(loaded.Page - 1) * loaded.PageSize + 1 : 1;
            var last = first + result.Items.Count - 1;
            return result.TotalCount is { } total
                ? string.Format(FormatCulture, ToolsMessages.ResultCount, Number(first), Number(last), Number(total))
                : string.Format(FormatCulture, ToolsMessages.ResultRange, Number(first), Number(last));
        }
    }
}
