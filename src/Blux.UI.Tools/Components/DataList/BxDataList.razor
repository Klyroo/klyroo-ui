@namespace Blux.UI.Tools
@typeparam TItem
@inherits BxToolsComponentBase
@implements IDisposable
@attribute [CascadingTypeParameter(nameof(TItem))]
@using System.Linq.Expressions
@using System.Text.Json
@using System.Text.Json.Serialization.Metadata
@using Blux.UI.Tools.Query
@using System.Diagnostics.CodeAnalysis
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging

<CascadingValue TValue="DataListContext<TItem>" Value="_context" IsFixed="true">
    <div class="@_slots["root"]" data-slot="root" @attributes="AdditionalAttributes">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <div class="@_slots["toolbar"]" data-slot="toolbar">
                @if (_schema is { HasSearch: true })
                {
                    <BxDataListSearch TItem="TItem" />
                }
                <BxDataListResultCount TItem="TItem" />
                <BxDataListRefresh TItem="TItem" />
            </div>
            @if (_schema is { FilterKeys.Count: > 0 })
            {
                <BxDataListFilterTags TItem="TItem" ShowAdd="true" ShowClear="true" />
            }
            <BxDataListErrorState TItem="TItem" />
            <BxDataListTable TItem="TItem" />
            @if (PagingMode == DataListPagingMode.Cursor)
            {
                <BxDataListInfiniteLoader TItem="TItem" />
            }
            else if (PagingMode == DataListPagingMode.Offset)
            {
                <BxDataListPagination TItem="TItem" />
            }
        }
    </div>
</CascadingValue>

@code {
    // The persisted keys of the lists alive in a scope: two lists of the same row type under the same key would hand each other's result over.
    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<IServiceProvider, HashSet<string>> PersistedKeys = new();

    private readonly DataListContext<TItem> _context;
    private SlotSet _slots = default!;
    private DataListSchema<TItem>? _schema;
    private DataListState _state = DataListState.Initial;
    private DataListState? _lastStateParam;
    private IEnumerable<TItem>? _lastItems;
    private IQueryable<TItem>? _lastQueryable;
    private DataListProvider<TItem>? _lastProvider;
    private Task? _init;
    private QueryClaim? _claim;
    private IDisposable? _subscription;
    private IDisposable? _persistSubscription;
    private PersistentComponentState? _persistent;
    private IDataListQueryExecutor? _executor;
    private string? _claimedKey;
    private string? _timeZone;
    private bool _writeInitialState;
    private bool _stateFromUrl;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();

    public BxDataList() => _context = new DataListContext<TItem>(this);

    [Inject] private QueryState Query { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>
    /// What a request may ask for: which fields sort, which filter, the default sort and page size. The schema is fixed for the life of the list: a new instance given after the first render is ignored
    /// (build it once, in a static field or a cached service; an inline <c>DataListSchema.For&lt;T&gt;(...)</c> in markup would create a new one on every render), and giving another schema means re-keying the list with <c>@@key</c>. Optional for a list of rows in memory whose
    /// <see cref="BxDataListColumn{TItem}"/>s name a <c>Property</c>: those columns then describe the schema (every one sortable unless it says otherwise).
    /// A provider or a queryable needs a schema, because it is the schema that drops what a request must not ask for.
    /// </summary>
    [Parameter] public DataListSchema<TItem>? Schema { get; set; }

    /// <summary>
    /// The rows, kept in memory: the list sorts and pages them itself, with the semantics of <see cref="InMemoryDataList"/>. Give a stable collection (a field, not a new list on every render): a new reference loads the list again.
    /// A list takes one source: <see cref="Items"/>, <see cref="Queryable"/> or <see cref="Provider"/>.
    /// </summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// A query of a database provider (an EF Core <c>DbSet</c>, with the filters that are not the user's already applied): the list turns each request into queries with
    /// <see cref="QueryableDataList"/> and runs them through the <see cref="IDataListQueryExecutor"/> of the container. Needs a <see cref="Schema"/>. The default executor
    /// <b>blocks the thread</b> while the database answers: register an asynchronous one (<c>AddBluxUiToolsEntityFrameworkAdapter()</c> for EF Core). An <c>AsQueryable()</c> over a list is rejected: use <see cref="Items"/>.
    /// A DbContext allows one query at a time: give the list a context of its own (a factory) when the page has several.
    /// </summary>
    [Parameter] public IQueryable<TItem>? Queryable { get; set; }

    /// <summary>Loads a page of rows for a request, from a database, an HTTP API or anything else. It receives a token that is cancelled when a newer request replaces it.</summary>
    [Parameter] public DataListProvider<TItem>? Provider { get; set; }

    /// <summary>
    /// The search, filters, sort, page and page size. Bind it with <c>@bind-State</c> to read or set it from outside: a value you set (a reset button) is written to the URL
    /// (a history entry) with <see cref="UrlSync"/>, or loaded directly without it. With <see cref="UrlSync"/> the URL wins at the start: this value only starts the list
    /// when the URL holds none of its keys.
    /// </summary>
    [Parameter] public DataListState? State { get; set; }

    /// <summary>Raised when the state changes, from the list or, with URL sync, from the URL (a link, Back and Forward, a typed address).</summary>
    [Parameter] public EventCallback<DataListState> StateChanged { get; set; }

    /// <summary>
    /// A prefix for the URL keys of this list (<c>users</c> gives <c>users.s</c>, <c>users.p</c>): needed when a page has several lists that sync with the URL. Without it the keys are <c>q</c>, <c>p</c>, <c>ps</c>, <c>s</c>, <c>f.&lt;key&gt;</c>, <c>c</c> and <c>l</c>.
    /// </summary>
    [Parameter] public string? UrlKey { get; set; }

    /// <summary>
    /// Keeps the state in the URL (true by default): a page or a sort is pushed as a history entry, so Back restores it, and a typed or shared address loads its state.
    /// In static server rendering the controls are links and GET forms. Turn it off for a list in a dialog.
    /// </summary>
    [Parameter] public bool UrlSync { get; set; } = true;

    /// <summary>
    /// Metadata to serialize the result of the prerender (<c>MyJson.Default.DataListResultMyRow</c>, from a <c>JsonSerializerContext</c> of the app with
    /// <c>[JsonSerializable(typeof(DataListResult&lt;MyRow&gt;))]</c>). The result of a prerendered list is then handed to the interactive render (WebAssembly, Server or Auto), which shows it at
    /// once and does not load it again. Without it nothing is persisted and the interactive render loads the list a second time. Lists that persist need distinct <see cref="UrlKey"/> or <see cref="PersistKey"/> values (two of the same row type under the same key throw).
    /// </summary>
    [Parameter] public JsonTypeInfo<DataListResult<TItem>>? ResultJson { get; set; }

    /// <summary>The key the prerendered result is persisted under, when the list has no <see cref="UrlKey"/> or two lists share it. The row type is part of the key.</summary>
    [Parameter] public string? PersistKey { get; set; }

    /// <summary>How tight the rows are.</summary>
    [Parameter] public DataListDensity Density { get; set; }

    /// <summary>
    /// How the list pages its rows: numbered pages (<see cref="DataListPagingMode.Offset"/>, the default), keyset cursor paging (<see cref="DataListPagingMode.Cursor"/>, with
    /// <see cref="BxDataListInfiniteLoader{TItem}"/>) or no paging (<see cref="DataListPagingMode.None"/>, every matching row at once, for virtualized tables). Changing it after the first render
    /// starts the list again from its first rows (page 1, no cursor) and loads it in the new mode; a cursor in the address of a list that does not page by cursor is dropped.
    /// </summary>
    [Parameter] public DataListPagingMode PagingMode { get; set; }

    /// <summary>
    /// The name of the list. Its table is named by it (<c>Results</c> when it has none), and its pagination landmark is "Pagination, &lt;label&gt;": give the lists of a page distinct labels, because two landmarks with the same name cannot be told apart.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The parts of the list: toolbar items, the table with its columns, the pagination. Without it the list renders a default layout: result count, refresh, error state, table and pagination.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Per-instance classes for each slot.</summary>
    [Parameter] public DataListUi? Ui { get; set; }

    internal DataListController<TItem>? Controller { get; private set; }

    internal CancellationToken LifetimeToken => _lifetime.Token;

    internal ILogger? Logger => (Services.GetService(typeof(ILoggerFactory)) as ILoggerFactory)?.CreateLogger("Blux.UI.Tools.DataList");

    internal DataListSchema<TItem>? CurrentSchema => _schema;

    internal DataListState CurrentState => _state;

    internal bool IsInteractive => RendererInfo.IsInteractive;

    internal bool CanLink => UrlSync && !RendererInfo.IsInteractive;

    // The time zone of the user once known (the browser's, after the first interactive render): the days of a date filter and its presets are in it. UTC until then and in static rendering.
    internal string? TimeZoneId => _timeZone;

    // The instant the presets of a date editor count from: the TimeProvider of the app (a test sets its own), else the clock.
    internal DateTimeOffset Now => (Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System).GetUtcNow();

    internal string? NormalizedUrlKey => string.IsNullOrWhiteSpace(UrlKey) ? null : UrlKey;

    internal string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;

    internal bool IsFiltered => IsFilteredFor(_state);

    internal bool IsFilteredFor(DataListState state) =>
        !string.IsNullOrWhiteSpace(state.Search)
        || (_schema is not null && !state.Filters.SequenceEqual(_schema.DefaultState.Filters));

    // No search, the filters of the schema, the first page: sort, page size and layout are how the user looks at the rows, not what they ask for.
    internal DataListState ResetState(DataListState state) =>
        state with { Search = "", Filters = _schema?.DefaultState.Filters ?? [], Page = 1, Cursor = null };

    /// <summary>
    /// Replaces a row in the loaded result in place by its schema <c>RowKey</c>, refreshing any matching entry in the selection without re-querying the source.
    /// </summary>
    public bool UpdateRow(TItem item) => item is not null && UpdateRows([item]) > 0;

    /// <summary>
    /// Replaces matching rows in the loaded result in place by their schema <c>RowKey</c>, refreshing any matching entries in the selection without re-querying the source.
    /// </summary>
    public int UpdateRows(IEnumerable<TItem> items)
    {
        if (Controller is null) return 0;
        MarkSelectionStale();
        return Controller.UpdateRows(items);
    }

    /// <summary>
    /// Resets the search and filters to the schema defaults (on page 1), clears the row selection, and resets tree expansion to its defaults.
    /// </summary>
    public void ResetAll(QueryHistory history = QueryHistory.Push)
    {
        ClearSelection();
        ResetTreeExpansion();
        SetState(ResetState, history);
    }

    protected override void OnInitialized()
    {
        var sources = (Items is not null ? 1 : 0) + (Queryable is not null ? 1 : 0) + (Provider is not null ? 1 : 0);
        if (sources > 1)
        {
            throw new InvalidOperationException($"{nameof(BxDataList<TItem>)} takes one source: give it Items, a Queryable or a Provider, not several.");
        }
        if (sources == 0)
        {
            throw new InvalidOperationException($"{nameof(BxDataList<TItem>)} needs a source: give it Items, a Queryable or a Provider.");
        }
        if ((Provider is not null || Queryable is not null) && Schema is null)
        {
            throw new InvalidOperationException($"{nameof(BxDataList<TItem>)} with a Provider or a Queryable needs a Schema: it is the schema that drops what a request must not ask for.");
        }
        UpdateSlots();
        InitializeColumnPreferences();
        _schema = Schema;
        _executor = Services.GetService(typeof(IDataListQueryExecutor)) as IDataListQueryExecutor;
        if (UrlSync)
        {
            // Only an interactive renderer can navigate: until it is known, a write would turn into a redirect of the request.
            Query.UseRenderer(RendererInfo);
            var prefix = NormalizedUrlKey ?? "";
            _claim = Query.Claim(prefix, nameof(BxDataList<TItem>) + (prefix.Length == 0 ? "" : $" '{prefix}'"));
            _subscription = Query.Subscribe(prefix, OnUrlChanged);
        }
        if (ResultJson is not null)
        {
            ClaimPersistedKey();
            _persistent = Services.GetService(typeof(PersistentComponentState)) as PersistentComponentState;
            if (_persistent is not null && AssignedRenderMode is not null && !RendererInfo.IsInteractive)
            {
                // Prerendering a component of an interactive mode: hand the result to the interactive render.
                _persistSubscription = _persistent.RegisterOnPersisting(PersistAsync, AssignedRenderMode);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The columns the user chose are known before the rows: an interactive render that no prerender handed them to asks the browser first, so the rows never show up in other columns.
        await LoadBrowserColumnPreferencesAsync();
        // A list without a schema waits for its table: the columns describe the schema, and they exist once the table rendered.
        if (Schema is not null) await EnsureLoadedAsync();
    }

    // Also from OnInitialized: with a source that loads asynchronously the first render happens before the first OnParametersSet.
    private void UpdateSlots() =>
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>
        {
            ["density"] = Density switch
            {
                DataListDensity.Compact => "compact",
                DataListDensity.Comfortable => "comfortable",
                _ => "default",
            },
        }, Ui, "root");

    protected override void OnParametersSet()
    {
        _claim?.ThrowIfConflicted();
        UpdateSlots();
        ApplySelectedKeysParameter();
    }

    protected override Task OnParametersSetAsync() =>
        // While the first load runs, what changed is applied when it ends.
        _init is { IsCompletedSuccessfully: true } ? ApplyParameterChangesAsync() : Task.CompletedTask;

    // What the parent changed since the list last looked: new rows, a new provider, a new state.
    private async Task ApplyParameterChangesAsync()
    {
        var controller = Controller;
        if (controller is null || _disposed) return;
        var reload = false;
        if (controller.PagingMode != PagingMode)
        {
            // Pages of one mode mean nothing in another (a cursor of the address in a list with numbered pages, a page number in a list with a cursor): the list starts again from its first rows.
            controller.PagingMode = PagingMode;
            var restart = controller.Normalize(_state with { Page = 1, Cursor = null });
            if (UrlSync && Query.Interactive == true && !restart.Equals(_state))
            {
                // The URL stays the one source of the state: the write notifies the subscription, which loads.
                Query.SetMany(Changes(restart), QueryHistory.Replace);
            }
            else
            {
                _state = restart;
                reload = true;
            }
        }
        if (!ReferenceEquals(Items, _lastItems) || !ReferenceEquals(Queryable, _lastQueryable) || !ReferenceEquals(Provider, _lastProvider))
        {
            // A provider is usually a lambda or a method group, new on every render of the parent: it replaces the old one without loading again. New rows or a new query load again.
            var sourceChanged = !ReferenceEquals(Items, _lastItems) || !ReferenceEquals(Queryable, _lastQueryable);
            _lastItems = Items;
            _lastQueryable = Queryable;
            _lastProvider = Provider;
            if (Items is not null || Queryable is not null || Provider is not null)
            {
                controller.Provider = DataListController<TItem>.CreateProvider(controller.Schema, Items, Provider, Queryable, _executor);
                reload = sourceChanged;
                // Other rows: the counts of the old ones do not hold.
                if (sourceChanged)
                {
                    controller.DropFacets();
                    MarkSelectionStale();
                }
            }
        }
        if (State is not null && !State.Equals(_lastStateParam))
        {
            _lastStateParam = State;
            var next = controller.Normalize(State);
            // The parent feeding back the state the list reported (@bind-State) is not a change.
            if (!next.Equals(_state))
            {
                if (UrlSync)
                {
                    // The URL stays the one source of the state: the write notifies the subscription, which loads.
                    if (Query.Interactive == true) Query.SetMany(Changes(next), QueryHistory.Push);
                }
                else if (!reload && controller.TryAdoptLayout(next))
                {
                    _state = next;
                    _context.NotifyChanged();
                }
                else
                {
                    _state = next;
                    reload = true;
                }
            }
        }
        if (reload) await LoadAsync(_state);
    }

    /// <summary>Loads the list once, the first time something asks: the list itself, or its table once the columns registered.</summary>
    internal Task EnsureLoadedAsync() => _init ??= InitializeAsync();

    private async Task InitializeAsync()
    {
        _schema ??= BuildImplicitSchema();
        var controller = Controller = new DataListController<TItem>(_schema, DataListController<TItem>.CreateProvider(_schema, Items, Provider, Queryable, _executor))
        {
            PagingMode = PagingMode,
        };
        controller.Changed += OnControllerChanged;
        _lastItems = Items;
        _lastQueryable = Queryable;
        _lastProvider = Provider;
        _lastStateParam = State;
        // The time zone of the user cuts the days of the date filters, and a date-time of the URL without an offset is read in it. A static render and a prerender have the one the browser left in its cookie (UTC on the first visit); an interactive render asks the browser.
        if (!RendererInfo.IsInteractive)
        {
            _timeZone = ServerTimeZone.Read(Services);
            controller.TimeZone = _timeZone;
        }
        _state = controller.Normalize(InitialState());
        var taken = TakePersisted();
        // The labels the prerender resolved are good whatever the state: shown at once, and not asked of the resolver again.
        if (taken?.Labels is { } persistedLabels) _context.AdoptLabels(persistedLabels);

        // A result that does not depend on the zone shows at once, before the call to the browser: the render waits for that call, not for the rows.
        var adopted = taken is { } early && early.Requested.Equals(_state) && !NeedsTimeZone(early.Request.Filter) && Adopt(early);
        if (RendererInfo.IsInteractive)
        {
            _timeZone = await TimeZoneAsync();
            controller.TimeZone = _timeZone;
            // The state was read before the zone was known: a date-time without an offset in the URL means another instant in the zone of the browser.
            if (_stateFromUrl && !DataListDates.SameZone(null, _timeZone) && controller.Normalize(ReadState()) is var again && !again.Equals(_state))
            {
                _state = again;
                adopted = false;
            }
            // A result whose days were cut in the zone the browser has is as good as a new one.
            if (!adopted && taken is { } late && late.Requested.Equals(_state) && DataListDates.SameZone(late.Zone, _timeZone)) adopted = Adopt(late);
            if (adopted) controller.SetLoadedTimeZone(_timeZone);
        }
        if (adopted)
        {
            AfterLoad(force: true);
            await LabelRemoteValuesAsync(_state, includeCounted: true, retryFailed: true);
        }
        else
        {
            await LoadAsync(_state);
        }
        if (_writeInitialState && Query.Interactive == true && !controller.HasError)
        {
            // The state of the parent starts a list whose URL holds nothing: the address says so, without a history entry.
            Query.SetMany(Changes(_state), QueryHistory.Replace);
        }
        else if (UrlSync && Query.Interactive == true && !controller.HasError && !ReadState().Equals(_state))
        {
            // A typed address that normalization changed (spaces around the search, a page size past the maximum): the address shows what is there, without a history entry.
            Query.SetMany(Changes(_state), QueryHistory.Replace);
        }
        if (State is not null && !_state.Equals(State)) _ = StateChanged.InvokeAsync(_state);
        // A parameter that changed while this ran (a list without a schema loads when its table renders).
        await ApplyParameterChangesAsync();
    }

    private DataListSchema<TItem> BuildImplicitSchema()
    {
        var columns = _context.Columns.Where(c => c.Property is not null).ToList();
        if (columns.Count == 0)
        {
            throw new InvalidOperationException($"{nameof(BxDataList<TItem>)} has no Schema and its table has no column with a Property: give it a Schema, or name a Property on its columns.");
        }
        return DataListSchema.For<TItem>(s =>
        {
            foreach (var column in columns)
            {
                // The property of a column is an expression returning object: the schema reads its member chain (the boxing is dropped).
                s.Field(column.Property!, f =>
                {
                    if (column.Key is not null) f.Key(column.Key);
                    f.Sortable(column.Sortable ?? true);
                });
            }
        });
    }

    private bool HoldsOwnKeys() => Query.Snapshot(NormalizedUrlKey ?? "").Any(pair => IsOwned(pair.Key));

    // The state the URL holds, with defaults for what it does not say.
    // A date-time of the URL without an offset (what a static form posts) is a wall clock in the zone of the request.
    private DataListState ReadState() => DataListStateQuery.FromQuery(Query.Snapshot(NormalizedUrlKey ?? ""), _schema!, NormalizedUrlKey, _timeZone);

    // The state a list starts from: its URL; the State of the parent when the URL holds none of the keys of the list.
    private DataListState InitialState()
    {
        if (!UrlSync) return State ?? _schema!.DefaultState;
        if (State is not null && !HoldsOwnKeys())
        {
            _writeInitialState = true;
            return State;
        }
        _stateFromUrl = true;
        return ReadState();
    }

    private async Task LoadAsync(DataListState state, bool refresh = false)
    {
        // The labels of the values in the state do not wait for the rows.
        var labelling = LabelRemoteValuesAsync(state, includeCounted: false, retryFailed: true);
        await Controller!.LoadAsync(state, refresh);
        if (_disposed) return;
        AfterLoad(force: false);
        await LabelRemoteValuesAsync(state, includeCounted: true);
        await labelling;
    }

    // The values of a remote option filter that the address restored have no label until the resolver gives one. A static render and a prerender wait for it (nothing renders again afterwards);
    // an interactive list shows the raw values and swaps in the labels when they arrive. Counted options are labelled only for the static editor, which lists them.
    private Task LabelRemoteValuesAsync(DataListState state, bool includeCounted, bool retryFailed = false)
    {
        if (_schema is null || _disposed) return Task.CompletedTask;
        var interactive = RendererInfo.IsInteractive;
        var resolving = _context.ResolveLabelsAsync(state, includeCounted && !interactive, _lifetime.Token, Logger, retryFailed);
        if (!interactive) return resolving;
        // ResolveLabelsAsync does not throw; the task is observed all the same.
        _ = resolving.ContinueWith(static t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted | TaskContinuationOptions.ExecuteSynchronously);
        return Task.CompletedTask;
    }

    // The rows on screen are for a state that may differ from the requested one (a page past the end): show that one, in the URL too.
    private void AfterLoad(bool force)
    {
        var controller = Controller!;
        var changed = false;
        if (!controller.IsLoading && !controller.HasError && controller.LoadedState is { } loaded && !loaded.Equals(_state))
        {
            _state = loaded;
            changed = true;
            if (UrlSync && Query.Interactive == true) Query.SetMany(Changes(loaded), QueryHistory.Replace);
            _ = StateChanged.InvokeAsync(loaded);
        }
        ReconcileSelection();
        // The controller announced the load; this announces what only the list knows.
        if (changed || force) _context.NotifyChanged();
    }

    internal void SetState(Func<DataListState, DataListState> change, QueryHistory history)
    {
        ArgumentNullException.ThrowIfNull(change);
        var controller = Controller;
        if (controller is null || !RendererInfo.IsInteractive) return;
        var next = controller.Normalize(change(_state));
        if (next.Equals(_state)) return;
        if (UrlSync)
        {
            // The write notifies the subscription below, which loads: the URL stays the one source of the state.
            Query.SetMany(Changes(next), history);
            return;
        }
        _state = next;
        _ = StateChanged.InvokeAsync(next);
        if (controller.TryAdoptLayout(next))
        {
            _context.NotifyChanged();
            return;
        }
        _ = InvokeAsync(() => LoadAsync(next));
    }

    internal string? HrefWith(Func<DataListState, DataListState> change)
    {
        ArgumentNullException.ThrowIfNull(change);
        if (!UrlSync || _schema is null) return null;
        return Query.HrefWith(Changes(Controller?.Normalize(change(_state)) ?? change(_state)));
    }

    internal IReadOnlyList<KeyValuePair<string, string>> FormFields(DataListState state, string[] exclude)
    {
        var fields = new List<KeyValuePair<string, string>>();
        if (!UrlSync || _schema is null) return fields;
        foreach (var (key, value) in Query.Snapshot(""))
        {
            if (!IsOwned(key) && value is not null) fields.Add(new(key, value));
        }
        var skipped = exclude.Select(name => NormalizedUrlKey is null ? name : NormalizedUrlKey + "." + name).ToHashSet(StringComparer.Ordinal);
        foreach (var (key, value) in DataListStateQuery.ToQuery(state, _schema, NormalizedUrlKey))
        {
            if (!skipped.Contains(key)) fields.Add(new(key, value));
        }
        return fields;
    }

    internal Task RefreshAsync() => Controller is null ? Task.CompletedTask : InvokeAsync(async () =>
    {
        MarkSelectionStale();
        await Controller.RefreshAsync();
        if (!_disposed) AfterLoad(force: false);
    });

    internal Task LoadMoreAsync() => Controller is null || !RendererInfo.IsInteractive ? Task.CompletedTask : InvokeAsync(async () =>
    {
        await Controller.LoadMoreAsync();
        if (!_disposed) AfterLoad(force: false);
    });

    // The query keys this list owns: its own names under its prefix. Anything else in the URL is not touched.
    private bool IsOwned(string key)
    {
        string name;
        var prefix = NormalizedUrlKey;
        if (prefix is null) name = key;
        else if (key.Length > prefix.Length + 1 && key.StartsWith(prefix, StringComparison.Ordinal) && key[prefix.Length] == '.') name = key[(prefix.Length + 1)..];
        else return false;
        return name is "q" or "p" or "ps" or "s" or "c" or "l" || name.StartsWith("f.", StringComparison.Ordinal);
    }

    // The URL keys that write a state: the ones it needs, and a null for every key of this list the URL holds and the state no longer does.
    private List<KeyValuePair<string, string?>> Changes(DataListState state)
    {
        var wanted = DataListStateQuery.ToQuery(state, _schema!, NormalizedUrlKey);
        var changes = new List<KeyValuePair<string, string?>>();
        foreach (var (key, value) in wanted) changes.Add(new(key, value));
        foreach (var (key, _) in Query.Snapshot(NormalizedUrlKey ?? ""))
        {
            if (IsOwned(key) && !wanted.ContainsKey(key)) changes.Add(new(key, null));
        }
        return changes;
    }

    private void OnUrlChanged(IReadOnlyList<string> keys)
    {
        if (_disposed || Controller is null || !keys.Any(IsOwned)) return;
        _ = InvokeAsync(ApplyUrlAsync);
    }

    private async Task ApplyUrlAsync()
    {
        var controller = Controller;
        if (_disposed || controller is null) return;
        var next = controller.Normalize(ReadState());
        if (next.Equals(_state)) return;
        _state = next;
        await StateChanged.InvokeAsync(next);
        if (controller.TryAdoptLayout(next))
        {
            _context.NotifyChanged();
            return;
        }
        await LoadAsync(next);
    }

    private string PersistedKey => "bx-dl:" + typeof(TItem).FullName + ":" + (PersistKey ?? NormalizedUrlKey ?? "");

    private void ClaimPersistedKey()
    {
        var key = PersistedKey;
        var keys = PersistedKeys.GetOrCreateValue(Services);
        lock (keys)
        {
            if (!keys.Add(key))
            {
                throw new InvalidOperationException($"Two data lists of {typeof(TItem).Name} persist their prerendered result under the key '{key}': give one of them another UrlKey or PersistKey, or leave ResultJson out of one of them.");
            }
        }
        _claimedKey = key;
    }

    [UnconditionalSuppressMessage("Trimming", "IL2026", Justification = "Only strings go through the reflection-based serializer of PersistentComponentState, and string has a built-in converter; the result itself is written with the JsonTypeInfo of the app.")]
    private Task PersistAsync()
    {
        if (Controller is { Result: { } result, LoadedState: { } loaded, RequestedState: { } requested } && ResultJson is not null && _persistent is not null)
        {
            // The text itself is written with the metadata of the app, so the result needs no reflection; facets are part of the result and count.
            var stateText = JsonSerializer.Serialize(requested, DataListJsonContext.Default.DataListState);
            var loadedText = JsonSerializer.Serialize(loaded, DataListJsonContext.Default.DataListState);
            var resultText = JsonSerializer.Serialize(result, ResultJson);
            // The labels remote options resolved (a tag writes them) travel with the result and count in its size.
            // Nothing at all when no remote filter was labelled: every key persisted adds to what the client sends back to the server.
            var labelsText = _context.RemoteLabels.Any(p => p.Value.Count > 0)
                ? JsonSerializer.Serialize(_context.RemoteLabels.ToDictionary(p => p.Key, p => p.Value), DataListJsonContext.Default.DictionaryStringDictionaryStringString)
                : "";
            var bytes = (long)System.Text.Encoding.UTF8.GetByteCount(stateText) + System.Text.Encoding.UTF8.GetByteCount(loadedText) + System.Text.Encoding.UTF8.GetByteCount(resultText)
                + System.Text.Encoding.UTF8.GetByteCount(labelsText);
            // The client sends the whole persisted state to the server when a circuit starts, and SignalR refuses a message past 32 KB: one list over its own limit, or lists that together pass the page budget, are not persisted.
            var allowed = DataListPersistBudget.Reserve(Services, bytes, ToolsOptions.PersistMaxBytes, ToolsOptions.PersistPageMaxBytes);
            if (!allowed)
            {
                if (Services.GetService(typeof(ILoggerFactory)) is ILoggerFactory factory) Log(factory, PersistedKey, bytes);
                return Task.CompletedTask;
            }
            // PersistAsJson<string> carries text through the built-in converter.
            _persistent.PersistAsJson(PersistedKey + ":state", stateText);
            _persistent.PersistAsJson(PersistedKey + ":loaded", loadedText);
            _persistent.PersistAsJson(PersistedKey + ":result", resultText);
            // The zone the days of the result were cut in: the interactive render adopts the result only for the same zone.
            _persistent.PersistAsJson(PersistedKey + ":zone", _timeZone ?? "");
            if (labelsText.Length > 0) _persistent.PersistAsJson(PersistedKey + ":labels", labelsText);
        }
        return Task.CompletedTask;
    }

    private void Log(ILoggerFactory factory, string key, long bytes)
    {
        factory.CreateLogger("Blux.UI.Tools.DataList").LogWarning(
            "The data list '{Key}' did not hand its prerendered result to the interactive render: it is {Bytes} bytes, over the {List}-byte limit of one list or the {Page}-byte budget of the page (BluxToolsOptions.PersistMaxBytes, PersistPageMaxBytes). The interactive render loads it again once. Use a smaller first page, or no ResultJson.",
            key, bytes, ToolsOptions.PersistMaxBytes, ToolsOptions.PersistPageMaxBytes);
    }

    // What the prerender handed over, with the state it was loaded for (it is used only when that is the state this render starts from); the keys are taken whether or not it is used.
    private sealed record Persisted(DataListState Requested, DataListState Loaded, DataListRequest Request, DataListResult<TItem> Result, string? Zone, Dictionary<string, Dictionary<string, string>>? Labels);

    [UnconditionalSuppressMessage("Trimming", "IL2026", Justification = "Only strings go through the reflection-based serializer of PersistentComponentState, and string has a built-in converter; the result itself is read with the JsonTypeInfo of the app.")]
    private Persisted? TakePersisted()
    {
        if (ResultJson is null || _persistent is null || !RendererInfo.IsInteractive) return null;
        var key = PersistedKey;
        // Every key is taken (a bitwise and, not a short circuit): what is left unread would be offered to another list.
        var found = _persistent.TryTakeFromJson<string>(key + ":state", out var stateText) & _persistent.TryTakeFromJson<string>(key + ":loaded", out var loadedText)
                    & _persistent.TryTakeFromJson<string>(key + ":result", out var resultText) & _persistent.TryTakeFromJson<string>(key + ":zone", out var zone);
        _persistent.TryTakeFromJson<string>(key + ":labels", out var labelsText);
        if (!found) return null;
        try
        {
            var requested = JsonSerializer.Deserialize(stateText!, DataListJsonContext.Default.DataListState);
            var loaded = JsonSerializer.Deserialize(loadedText!, DataListJsonContext.Default.DataListState);
            var result = JsonSerializer.Deserialize(resultText!, ResultJson);
            if (requested is null || loaded is null || result is null) return null;
            var labels = labelsText is null ? null : JsonSerializer.Deserialize(labelsText, DataListJsonContext.Default.DictionaryStringDictionaryStringString);
            return new Persisted(requested, loaded, Controller!.BuildRequest(loaded), result, string.IsNullOrEmpty(zone) ? null : zone, labels);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private bool Adopt(Persisted taken)
    {
        Controller!.Adopt(_state, taken.Loaded, taken.Request, taken.Result);
        return true;
    }

    private static bool NeedsTimeZone(DataListFilterNode node) => node switch
    {
        DataListFilterGroup group => group.Children.Any(NeedsTimeZone),
        FilterRule rule => HasDate(rule.Value),
        _ => false,
    };

    // Any value that is a day or an instant is cut in a time zone: a day is the local day, an instant belongs to the hour or minute of the zone.
    private static bool HasDate(FilterValue? value) => value switch
    {
        FilterValue.Date or FilterValue.Moment => true,
        FilterValue.Range range => HasDate(range.From) || HasDate(range.To),
        _ => false,
    };

    private async Task<string?> TimeZoneAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("Blux.tools.timeZone");
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No browser side (a test, a circuit that ended): the request goes out in UTC.
            return null;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _subscription?.Dispose();
        _claim?.Dispose();
        _persistSubscription?.Dispose();
        DisposeColumnPreferences();
        if (_claimedKey is not null && PersistedKeys.TryGetValue(Services, out var keys))
        {
            lock (keys) keys.Remove(_claimedKey);
        }
        if (Controller is { } controller)
        {
            controller.Changed -= OnControllerChanged;
            controller.Dispose();
        }
    }
}
