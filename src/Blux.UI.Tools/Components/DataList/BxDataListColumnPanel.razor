@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>

@*
    Column configurator: show/hide columns, reorder them with Up/Down controls, pin to the start or end edge, and reset to defaults.
    Interactive only: hidden in static rendering (a prerender of an interactive page keeps a disabled button so the toolbar does not shift).
*@
@if (Context.IsInteractive || Context.WillBeInteractive)
{
    var all = Context.ColumnStates;
    var configurable = all.Where(c => !c.Required).ToList();
    if (configurable.Count > 0 || Context.WillBeInteractive)
    {
        var visibleCount = all.Count(c => c.Visible);
        var filtered = string.IsNullOrWhiteSpace(_query)
            ? configurable
            : configurable.Where(c => c.Title.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        <div class="@_slots["columnsPanel"]" data-slot="columns-panel" @attributes="AdditionalAttributes">
            @if (!Context.IsInteractive)
            {
                <BxButton Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="Size" Disabled="true"
                          Label="@(Label ?? ToolsMessages.Columns)" LeadingIcon="@RenderIcon("columns-3", "size-4")" data-slot="columns-trigger" />
            }
            else
            {
                <BxPopover Placement="bottom-end" Ui="_popoverUi">
                    <ChildContent>
                        <BxButton Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="Size"
                                  Label="@(Label ?? ToolsMessages.Columns)" LeadingIcon="@RenderIcon("columns-3", "size-4")" data-slot="columns-trigger" />
                    </ChildContent>
                    <Content>
                        <div class="@_slots["columnsContent"]" data-slot="columns-content">
                            <div class="@_slots["columnsHeader"]">
                                <div class="min-w-0">
                                    <p class="@_slots["columnsTitle"]">@(Label ?? ToolsMessages.Columns)</p>
                                    <p class="@_slots["columnsCount"]" data-slot="columns-count">@string.Format(FormatCulture, ToolsMessages.ColumnsVisible, visibleCount, all.Count)</p>
                                </div>
                                <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="BxSize.Xs"
                                          Label="@ToolsMessages.ColumnsReset" Disabled="@(!Context.HasCustomColumnPreferences)"
                                          OnClick="@(() => Context.ResetColumns())" data-slot="columns-reset" />
                            </div>
                            @if (configurable.Count >= SearchThreshold)
                            {
                                <input type="search" value="@_query" @oninput="OnSearch" placeholder="@ToolsMessages.ColumnsSearch"
                                       aria-label="@ToolsMessages.ColumnsSearch" class="@_slots["filterInput"]" data-slot="columns-search" />
                            }
                            <ul class="@_slots["columnsList"]" data-slot="columns-list">
                                @foreach (var col in filtered)
                                {
                                    var key = col.Key;
                                    var pos = IndexOf(all, key);
                                    var pinnedStart = col.Pinned == DataListPin.Start;
                                    var pinnedEnd = col.Pinned == DataListPin.End;
                                    <li class="@_slots["columnsItem"]" data-slot="columns-item" data-col-key="@key">
                                        <label class="@_slots["columnsLabel"]">
                                            <input type="checkbox" checked="@col.Visible" class="@_slots["filterNativeInput"]"
                                                   data-col-toggle="@key"
                                                   @onchange="@(e => Context.SetColumnVisible(key, e.Value is true))" />
                                            <span class="truncate">@col.Title</span>
                                        </label>
                                        <div class="@_slots["columnsActions"]">
                                            @if (AllowReorder)
                                            {
                                                <button type="button" class="@_slots["columnsIconBtn"]" disabled="@(pos <= 0)"
                                                        aria-label="@string.Format(FormatCulture, ToolsMessages.ColumnMoveUp, col.Title)"
                                                        data-col-up="@key" @onclick="@(() => Context.MoveColumn(key, -1))">
                                                    @RenderIcon("arrow-up", "size-3.5")
                                                </button>
                                                <button type="button" class="@_slots["columnsIconBtn"]" disabled="@(pos < 0 || pos >= all.Count - 1)"
                                                        aria-label="@string.Format(FormatCulture, ToolsMessages.ColumnMoveDown, col.Title)"
                                                        data-col-down="@key" @onclick="@(() => Context.MoveColumn(key, 1))">
                                                    @RenderIcon("arrow-down", "size-3.5")
                                                </button>
                                            }
                                            @if (AllowPinning)
                                            {
                                                <button type="button" class="@(_slots["columnsIconBtn"] + (pinnedStart ? " " + _slots["columnsIconBtnActive"] : ""))"
                                                        aria-pressed="@(pinnedStart ? "true" : "false")"
                                                        aria-label="@string.Format(FormatCulture, pinnedStart ? ToolsMessages.ColumnUnpin : ToolsMessages.ColumnPinStart, col.Title)"
                                                        data-col-pin-start="@key"
                                                        @onclick="@(() => Context.SetColumnPinned(key, pinnedStart ? DataListPin.None : DataListPin.Start))">
                                                    @RenderIcon(pinnedStart ? "pin-off" : "pin", "size-3.5")
                                                </button>
                                                <button type="button" class="@(_slots["columnsIconBtn"] + (pinnedEnd ? " " + _slots["columnsIconBtnActive"] : ""))"
                                                        aria-pressed="@(pinnedEnd ? "true" : "false")"
                                                        aria-label="@string.Format(FormatCulture, pinnedEnd ? ToolsMessages.ColumnUnpin : ToolsMessages.ColumnPinEnd, col.Title)"
                                                        data-col-pin-end="@key"
                                                        @onclick="@(() => Context.SetColumnPinned(key, pinnedEnd ? DataListPin.None : DataListPin.End))">
                                                    @RenderIcon("panel-left", "size-3.5 rotate-180")
                                                </button>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </Content>
                </BxPopover>
            }
        </div>
    }
}

@code {
    private SlotSet _slots = default!;
    private PopoverUi _popoverUi = new();
    private string _query = "";

    /// <summary>Label of the trigger button and heading of the popover. Defaults to the localized "Columns".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Size of the trigger button (small by default).</summary>
    [Parameter] public BxSize Size { get; set; } = BxSize.Sm;

    /// <summary>Shows Move up / Move down buttons to reorder columns (true by default).</summary>
    [Parameter] public bool AllowReorder { get; set; } = true;

    /// <summary>Shows Pin to start / Pin to end controls (true by default).</summary>
    [Parameter] public bool AllowPinning { get; set; } = true;

    /// <summary>Shows a search box inside the panel when at least this many configurable columns exist (30 by default; 0 always shows it).</summary>
    [Parameter] public int SearchThreshold { get; set; } = 30;

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "columnsPanel");
        _popoverUi = new PopoverUi { Content = _slots["columnsPopover"] };
    }

    private void OnSearch(ChangeEventArgs e) => _query = e.Value?.ToString() ?? "";

    private static int IndexOf(IReadOnlyList<DataListColumnState> list, string key)
    {
        for (var i = 0; i < list.Count; i++)
            if (string.Equals(list[i].Key, key, StringComparison.Ordinal)) return i;
        return -1;
    }
}
