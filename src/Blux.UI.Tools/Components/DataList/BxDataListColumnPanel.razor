@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>
@using Microsoft.JSInterop

@*
    Column configurator: show or hide columns, show or hide them all, reorder them (drag the grip, or the Move up and Move down buttons), pin them to the start or end edge, and reset to the defaults.
    Required columns, the selection column and the row actions column are not listed: they stay. The popover is one list of controls on every screen; below the sm breakpoint the targets are larger
    and the pin buttons are left out (pinned columns scroll with the table on a phone).
    Interactive only: hidden in static rendering (a prerender of an interactive page keeps a disabled button so the toolbar does not shift). Every change is said in a polite live region.
*@
@if (Context.IsInteractive || Context.WillBeInteractive)
{
    var all = Context.ColumnStates;
    var configurable = all.Where(c => !c.Required).ToList();
    if (configurable.Count > 0 || Context.WillBeInteractive)
    {
        var visibleCount = all.Count(c => c.Visible);
        var query = _query.Trim();
        var filtered = query.Length == 0
            ? configurable
            : configurable.Where(c => c.Title.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
        var lastVisible = visibleCount <= 1;
        <div @ref="_root" class="@_slots["columnsPanel"]" data-slot="columns-panel" @attributes="AdditionalAttributes">
            @if (!Context.IsInteractive)
            {
                <BxButton Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="Size" Disabled="true"
                          Label="@(Label ?? ToolsMessages.Columns)" LeadingIcon="@RenderIcon("columns-3", "size-4")" data-slot="columns-trigger" />
            }
            else
            {
                <BxPopover Placement="bottom-end" Ui="_popoverUi">
                    <ChildContent>
                        <BxButton Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="Size"
                                  Label="@(Label ?? ToolsMessages.Columns)" LeadingIcon="@RenderIcon("columns-3", "size-4")" data-slot="columns-trigger" />
                    </ChildContent>
                    <Content>
                        <div @ref="_content" class="@_slots["columnsContent"]" data-slot="columns-content">
                            <div class="@_slots["columnsHeader"]">
                                <div class="min-w-0">
                                    <p class="@_slots["columnsTitle"]">@(Label ?? ToolsMessages.Columns)</p>
                                    <p class="@_slots["columnsCount"]" data-slot="columns-count">@string.Format(FormatCulture, ToolsMessages.ColumnsVisible, visibleCount, all.Count)</p>
                                </div>
                                <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="BxSize.Xs"
                                          Label="@ToolsMessages.ColumnsReset" Disabled="@(!Context.HasCustomColumnPreferences)"
                                          OnClick="@(() => Run(() => Context.ResetColumns(), "[data-slot=columns-reset]", "input[data-col-toggle]"))" data-slot="columns-reset" />
                            </div>
                            <div class="@_slots["columnsAll"]">
                                <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="BxSize.Xs" Label="@ToolsMessages.ColumnsShowAll"
                                          Disabled="@(configurable.All(c => c.Visible))"
                                          OnClick="@(() => Run(() => Context.SetAllColumnsVisible(true), "[data-slot=columns-hide-all]", "input[data-col-toggle]"))" data-slot="columns-show-all" />
                                <BxButton Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Size="BxSize.Xs" Label="@ToolsMessages.ColumnsHideAll"
                                          Disabled="@(configurable.All(c => !c.Visible || lastVisible))"
                                          OnClick="@(() => Run(() => Context.SetAllColumnsVisible(false), "[data-slot=columns-show-all]", "input[data-col-toggle]"))" data-slot="columns-hide-all" />
                            </div>
                            @if (configurable.Count >= SearchThreshold && SearchThreshold >= 0)
                            {
                                <input type="search" value="@_query" @oninput="OnSearch" placeholder="@ToolsMessages.ColumnsSearch"
                                       aria-label="@ToolsMessages.ColumnsSearch" class="@_slots["columnsSearch"]" data-slot="columns-search" />
                            }
                            <ul class="@_slots["columnsList"]" data-slot="columns-list">
                                @foreach (var col in filtered)
                                {
                                    var key = col.Key;
                                    var pos = IndexOf(configurable, key);
                                    var pinnedStart = col.Pinned == DataListPin.Start;
                                    var pinnedEnd = col.Pinned == DataListPin.End;
                                    <li @key="key" class="@_slots["columnsItem"]" data-slot="columns-item" data-col-key="@key">
                                        <label class="@_slots["columnsLabel"]">
                                            <input type="checkbox" checked="@col.Visible" disabled="@(col.Visible && lastVisible)" class="@_slots["filterNativeInput"]"
                                                   data-col-toggle="@key"
                                                   @onchange="@(e => Run(() => Context.SetColumnVisible(key, e.Value is true), Sel("col-toggle", key)))" />
                                            <span class="truncate">@col.Title</span>
                                        </label>
                                        <div class="@_slots["columnsActions"]">
                                            @if (AllowReorder)
                                            {
                                                @* The grip is a pointer shortcut (js/column-panel-drag.js); the two buttons next to it do the same for the keyboard and for assistive technology. *@
                                                <span class="@_slots["columnsGrip"]" aria-hidden="true" data-col-grip="@key"
                                                      @onbxchange="@(e => OnGripDrop(key, e))" @onbxchange:stopPropagation="true">@RenderIcon("grip-vertical", "size-4")</span>
                                                <button type="button" class="@_slots["columnsIconBtn"]" disabled="@(pos <= 0)"
                                                        aria-label="@string.Format(FormatCulture, ToolsMessages.ColumnMoveUp, col.Title)"
                                                        data-col-up="@key" @onclick="@(() => Run(() => Context.MoveColumn(key, -1), Sel("col-up", key), Sel("col-down", key)))">
                                                    @RenderIcon("arrow-up", "size-3.5")
                                                </button>
                                                <button type="button" class="@_slots["columnsIconBtn"]" disabled="@(pos < 0 || pos >= configurable.Count - 1)"
                                                        aria-label="@string.Format(FormatCulture, ToolsMessages.ColumnMoveDown, col.Title)"
                                                        data-col-down="@key" @onclick="@(() => Run(() => Context.MoveColumn(key, 1), Sel("col-down", key), Sel("col-up", key)))">
                                                    @RenderIcon("arrow-down", "size-3.5")
                                                </button>
                                            }
                                            @if (AllowPinning)
                                            {
                                                <span class="@_slots["columnsPinGroup"]">
                                                    <button type="button" class="@(_slots["columnsIconBtn"] + (pinnedStart ? " " + _slots["columnsIconBtnActive"] : ""))"
                                                            aria-pressed="@(pinnedStart ? "true" : "false")"
                                                            aria-label="@string.Format(FormatCulture, ToolsMessages.ColumnPinStart, col.Title)"
                                                            data-col-pin-start="@key"
                                                            @onclick="@(() => Run(() => Context.SetColumnPinned(key, pinnedStart ? DataListPin.None : DataListPin.Start), Sel("col-pin-start", key)))">
                                                        @RenderIcon(pinnedStart ? "pin-off" : "pin", "size-3.5")
                                                    </button>
                                                    <button type="button" class="@(_slots["columnsIconBtn"] + (pinnedEnd ? " " + _slots["columnsIconBtnActive"] : ""))"
                                                            aria-pressed="@(pinnedEnd ? "true" : "false")"
                                                            aria-label="@string.Format(FormatCulture, ToolsMessages.ColumnPinEnd, col.Title)"
                                                            data-col-pin-end="@key"
                                                            @onclick="@(() => Run(() => Context.SetColumnPinned(key, pinnedEnd ? DataListPin.None : DataListPin.End), Sel("col-pin-end", key)))">
                                                        @RenderIcon("panel-left", "size-3.5 rotate-180")
                                                    </button>
                                                </span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            @if (lastVisible)
                            {
                                <p class="@_slots["columnsHint"]" data-slot="columns-hint">@ToolsMessages.ColumnsKeepOne</p>
                            }
                        </div>
                    </Content>
                </BxPopover>
                <div class="@_slots["columnsLive"]" role="status" aria-live="polite" data-slot="columns-live">@Context.ColumnAnnouncement</div>
            }
        </div>
    }
}

@code {
    private SlotSet _slots = default!;
    private PopoverUi _popoverUi = new();
    private string _query = "";
    private ElementReference _root;
    private ElementReference _content;
    private string[]? _focusAfter;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>Label of the trigger button and heading of the popover. Defaults to the localized "Columns".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Size of the trigger button (small by default).</summary>
    [Parameter] public BxSize Size { get; set; } = BxSize.Sm;

    /// <summary>Shows the drag grip and the Move up / Move down buttons to reorder columns (true by default).</summary>
    [Parameter] public bool AllowReorder { get; set; } = true;

    /// <summary>Shows Pin to start / Pin to end controls (true by default).</summary>
    [Parameter] public bool AllowPinning { get; set; } = true;

    /// <summary>Shows a search box inside the panel when at least this many configurable columns exist (30 by default; 0 always shows it; a negative number never).</summary>
    [Parameter] public int SearchThreshold { get; set; } = 30;

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "columnsPanel");
        _popoverUi = new PopoverUi { Content = _slots["columnsPopover"] };
    }

    private void OnSearch(ChangeEventArgs e) => _query = e.Value?.ToString() ?? "";

    // Makes a change and, once the render that follows has run, puts the focus back on a control of the item that was used: a render that moves a column can leave the focus on the button of
    // another one, or on a button that is now disabled. The first selector that finds an enabled control wins.
    private void Run(Action change, params string[] focus)
    {
        change();
        _focusAfter = focus;
    }

    // The selector of the control of a column that has a data attribute: the key is data of the app, so it is quoted.
    private static string Sel(string attribute, string key) =>
        $"[data-{attribute}=\"{key.Replace("\\", "\\\\", StringComparison.Ordinal).Replace("\"", "\\\"", StringComparison.Ordinal)}\"]";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfter is not { } selectors) return;
        _focusAfter = null;
        try
        {
            object[] args = [_content, .. selectors];
            await JS.InvokeVoidAsync("Blux.tools.focusIn", args);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No browser side (a test, a circuit that ended).
        }
    }

    [System.Diagnostics.CodeAnalysis.DynamicDependency(
        System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicConstructors | System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicProperties,
        typeof(BxChangeEventArgs))]
    private void OnGripDrop(string key, BxChangeEventArgs e)
    {
        if (e.Value is not { } value) return;
        var colon = value.IndexOf(':');
        if (colon <= 0) return;
        var side = value[..colon];
        if (side is not ("before" or "after")) return;
        Run(() => Context.MoveColumnNextTo(key, value[(colon + 1)..], side == "after"), Sel("col-up", key), Sel("col-down", key));
    }

    private static int IndexOf(IReadOnlyList<DataListColumnState> list, string key)
    {
        for (var i = 0; i < list.Count; i++)
            if (string.Equals(list[i].Key, key, StringComparison.Ordinal)) return i;
        return -1;
    }
}
