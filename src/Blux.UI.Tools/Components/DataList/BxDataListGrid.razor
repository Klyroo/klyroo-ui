@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>
@using Blux.UI.Internal
@using Blux.UI.Tools.Query

@*
    Grid layout of a data list: renders each row as a card (ItemTemplate, or a default key/value summary of the visible columns / schema fields),
    with optional selection checkboxes (top bar select-all + per-card checkbox) and per-card row actions.
    When placed alongside BxDataListTable, only the active layout (Context.EffectiveLayout, synced with ?l=grid|table) renders its body.
*@
<DataListLoadTrigger TItem="TItem" />
<Defer>
    @if (Context.EffectiveLayout == DataListLayout.Grid)
    {
        var selecting = Context.SelectionVisible;
        var acting = RowActions is { Count: > 0 };
        var label = AriaLabel ?? Context.Label ?? ToolsMessages.Results;
        var empty = Context.Result is not null && Context.Rows.Count == 0 && !Context.HasError;
        var grouping = GroupBy is not null && !Context.IsInitial && !empty;
        var groups = grouping ? GroupRowEntries() : null;
        var entries = Context.IsInitial || empty || grouping ? null : RowEntries();

        <div class="@_slots["gridRoot"]" data-slot="grid-root" tabindex="0" role="region" aria-label="@label" @attributes="AdditionalAttributes">
            @if (ShowProgressLine && (Context.IsRefreshing || Context.IsReplacing))
            {
                <div class="@_slots["progressLine"]" data-slot="progress-line" aria-hidden="true">
                    <div class="@_slots["progressLineBar"]"></div>
                </div>
            }
            @if (Context.IsInitial)
            {
                <div class="@_slots["grid"]" data-slot="grid" aria-busy="true">
                    @for (var i = 0; i < Math.Clamp(Context.State.PageSize, 3, 9); i++)
                    {
                        <div class="@_slots["gridCard"]" data-slot="skeleton-card">
                            @if (SkeletonTemplate is not null)
                            {
                                @SkeletonTemplate
                            }
                            else
                            {
                                <BxSkeleton Class="h-5 w-1/2" />
                                <BxSkeleton Class="h-4 w-3/4" />
                                <BxSkeleton Class="h-4 w-2/3" />
                            }
                        </div>
                    }
                </div>
            }
            else if (empty)
            {
                <div class="@_slots["gridEmpty"]" data-slot="empty-grid">
                    @RenderEmptyState()
                </div>
            }
            else
            {
                @if (selecting && ShowSelectionControl)
                {
                    <div class="@_slots["gridHeader"]" data-slot="grid-header">
                        <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-medium text-(--blux-text-muted)">
                            <DataListSelectAll TItem="TItem" />
                            <span>@ToolsMessages.SelectAllRows</span>
                        </label>
                    </div>
                }
                @if (grouping)
                {
                    @foreach (var grp in groups!)
                    {
                        var collapsed = Context.IsGroupCollapsed(grp.Group);
                        <section @key="@("group:" + grp.Group.Key)" class="@_slots["gridGroup"]" data-slot="grid-group" data-group-key="@grp.Group.Key" data-collapsed="@(collapsed ? "true" : null)">
                            <div class="@_slots["gridGroupHeader"]" data-slot="group-row" data-group-key="@grp.Group.Key" data-collapsed="@(collapsed ? "true" : null)">
                                <BxDataListGroupHeader TItem="TItem" Group="grp.Group" GroupBy="GroupBy" Selectable="selecting && ShowSelectionControl" Ui="Ui" />
                            </div>
                            @if (!collapsed)
                            {
                                <div class="@_slots["grid"]" data-slot="grid" aria-busy="@(Context.IsLoading ? "true" : null)">
                                    @foreach (var row in grp.Entries)
                                    {
                                        <article @key="row.Key" class="@_slots["gridCard"]" data-slot="grid-card" data-key="@row.Key" data-group-key="@grp.Group.Key">
                                            @CardInner(row, selecting, acting)
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    }
                }
                else
                {
                    <div class="@_slots["grid"]" data-slot="grid" aria-busy="@(Context.IsLoading ? "true" : null)">
                        @foreach (var row in entries!)
                        {
                            <article @key="row.Key" class="@_slots["gridCard"]" data-slot="grid-card" data-key="@row.Key">
                                @CardInner(row, selecting, acting)
                            </article>
                        }
                    </div>
                }
            }
        </div>
    }
</Defer>

@code {
    private SlotSet _slots = default!;

    /// <summary>Template for rendering the body of each card in the grid. When <see langword="null"/>, renders the visible columns or schema fields as label/value pairs.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>Custom content shown for each placeholder card while the initial result loads.</summary>
    [Parameter] public RenderFragment? SkeletonTemplate { get; set; }

    /// <summary>Shown when the list has no rows. Without it, <see cref="EmptyState"/> or <see cref="BxDataListEmpty"/> (with the filtered-empty variant when search or filters are active).</summary>
    [Parameter] public RenderFragment<DataListContext<TItem>>? Empty { get; set; }

    /// <summary>
    /// Declarative configuration for the unfiltered empty state (icon, title, description, and an optional first-use <see cref="DataListEmptyState.Action"/>).
    /// When search or filters are active, the filtered empty state is still displayed instead and the first-use action is omitted.
    /// </summary>
    [Parameter] public DataListEmptyState? EmptyState { get; set; }

    /// <summary>
    /// Draws a subtle top progress indicator while the cards on screen are being refreshed or replaced (<see langword="true"/> by default).
    /// </summary>
    [Parameter] public bool ShowProgressLine { get; set; } = true;

    /// <summary>Maximum number of card columns on wide screens (1 to 4, 3 by default).</summary>
    [Parameter] public int Columns { get; set; } = 3;

    /// <summary>Draws a selection checkbox on each card and a select-all header when selection is enabled (<see langword="true"/> by default).</summary>
    [Parameter] public bool ShowSelectionControl { get; set; } = true;

    /// <summary>Per-card actions (<see cref="BxDataListRowActions{TItem}"/>).</summary>
    [Parameter] public IReadOnlyList<DataListRowAction<TItem>>? RowActions { get; set; }

    /// <summary>How many row actions show as inline buttons on each card (0 by default, keeping one menu trigger button per card).</summary>
    [Parameter] public int RowActionsMaxVisible { get; set; }

    /// <summary>Raised when a row action threw or reported a failure.</summary>
    [Parameter] public EventCallback<DataListRowActionFailure<TItem>> OnRowActionError { get; set; }

    /// <summary>Accessible name of the grid region. Defaults to the label of the list, then the localized "Results".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Optional visual grouping of the loaded cards under collapsible <see cref="BxDataListGroupHeader{TItem}"/> headers with per-group selection checkboxes.
    /// </summary>
    [Parameter] public DataListGroupBy<TItem>? GroupBy { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Context.AddGrid();
    }

    protected override void OnParametersSet()
    {
        Context.SetGridGroupBy(GroupBy);
        var cols = Math.Clamp(Columns, 1, 4).ToString(System.Globalization.CultureInfo.InvariantCulture);
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?> { ["gridColumns"] = cols }, Ui, "gridRoot");
    }

    public override void Dispose()
    {
        Context.SetGridGroupBy(null);
        Context.RemoveGrid();
        base.Dispose();
    }

    private DataListState Shown => Context.LoadedState ?? Context.State;

    private bool OnlySearch => Shown.Filters.SequenceEqual(Context.ResetState(Shown).Filters);

    private string FilteredTitle => string.IsNullOrWhiteSpace(Shown.Search)
        ? ToolsMessages.NoResultsFiltered
        : string.Format(FormatCulture, ToolsMessages.NoResultsFor, Shown.Search.Trim());

    private string FilteredDescription => string.IsNullOrWhiteSpace(Shown.Search) ? ToolsMessages.NoResultsDescription : ToolsMessages.NoResultsForDescription;

    private RenderFragment FilteredAction => builder =>
    {
        var label = OnlySearch ? ToolsMessages.ClearSearch : ToolsMessages.ResetFilters;
        if (Context.IsInteractive)
        {
            builder.OpenComponent<BxButton>(0);
            builder.AddAttribute(1, nameof(BxButton.Label), label);
            builder.AddAttribute(2, nameof(BxButton.Variant), ButtonVariant.Outline);
            builder.AddAttribute(3, nameof(BxButton.Color), BxColor.Neutral);
            builder.AddAttribute(4, nameof(BxButton.OnClick), EventCallback.Factory.Create<MouseEventArgs>(this, () =>
            {
                Context.Reset(QueryHistory.Push);
                Context.RequestSearchFocus();
            }));
            builder.AddAttribute(5, "data-slot", "reset");
            builder.CloseComponent();
        }
        else if (Context.HrefWith(Context.ResetState) is { } href)
        {
            builder.OpenComponent<BxButton>(6);
            builder.AddAttribute(7, nameof(BxButton.Label), label);
            builder.AddAttribute(8, nameof(BxButton.Variant), ButtonVariant.Outline);
            builder.AddAttribute(9, nameof(BxButton.Color), BxColor.Neutral);
            builder.AddAttribute(10, nameof(BxButton.Href), href);
            builder.AddAttribute(11, "data-slot", "reset");
            builder.CloseComponent();
        }
    };

    private RenderFragment RenderEmptyState() => builder =>
    {
        if (Empty is not null)
        {
            builder.AddContent(0, Empty(Context));
            return;
        }
        if (Context.IsFilteredFor(Context.LoadedState ?? Context.State))
        {
            builder.OpenComponent<BxDataListEmpty>(1);
            builder.AddAttribute(2, nameof(BxDataListEmpty.Title), FilteredTitle);
            builder.AddAttribute(3, nameof(BxDataListEmpty.Description), FilteredDescription);
            builder.AddAttribute(4, nameof(BxDataListEmpty.Actions), FilteredAction);
            builder.AddAttribute(5, "data-filtered", "true");
            builder.CloseComponent();
            return;
        }
        builder.OpenComponent<BxDataListEmpty>(6);
        if (EmptyState is { } es)
        {
            if (es.Icon is not null) builder.AddAttribute(7, nameof(BxDataListEmpty.Icon), es.Icon);
            if (es.Title is not null) builder.AddAttribute(8, nameof(BxDataListEmpty.Title), es.Title);
            if (es.HideDescription) builder.AddAttribute(9, nameof(BxDataListEmpty.Description), "");
            else if (es.Description is not null) builder.AddAttribute(10, nameof(BxDataListEmpty.Description), es.Description);
            if (es.Action is { } act && (!string.IsNullOrEmpty(act.Href) || Context.IsInteractive))
            {
                builder.AddAttribute(11, nameof(BxDataListEmpty.Actions), (RenderFragment)(b =>
                {
                    b.OpenComponent<BxButton>(0);
                    b.AddAttribute(1, nameof(BxButton.Label), act.Label);
                    b.AddAttribute(2, nameof(BxButton.Color), act.Color);
                    b.AddAttribute(3, nameof(BxButton.Variant), act.Variant);
                    if (!string.IsNullOrEmpty(act.Icon)) b.AddAttribute(4, nameof(BxButton.LeadingIcon), RenderIcon(act.Icon, "size-4"));
                    if (!string.IsNullOrEmpty(act.Href)) b.AddAttribute(5, nameof(BxButton.Href), act.Href);
                    if (Context.IsInteractive && act.OnClick.HasDelegate)
                        b.AddAttribute(6, nameof(BxButton.OnClick), EventCallback.Factory.Create<MouseEventArgs>(this, () => act.OnClick.InvokeAsync()));
                    b.AddAttribute(7, "data-slot", "empty-action");
                    b.CloseComponent();
                }));
            }
        }
        builder.CloseComponent();
    };

    private sealed record RowEntry(object Key, TItem Item, int Position);
    private sealed record GroupedRowEntries(DataListGroup<TItem> Group, List<RowEntry> Entries);

    private RenderFragment CardInner(RowEntry row, bool selecting, bool acting) =>
        @<text>
            @if ((selecting && ShowSelectionControl) || acting)
            {
                <div class="@_slots["gridCardTop"]" data-slot="grid-card-top">
                    @if (selecting && ShowSelectionControl)
                    {
                        <DataListRowSelect TItem="TItem" Item="row.Item" Position="row.Position" />
                    }
                    else
                    {
                        <span></span>
                    }
                    @if (acting)
                    {
                        <BxDataListRowActions TItem="TItem" Item="row.Item" Position="row.Position" Actions="RowActions!" MaxVisible="RowActionsMaxVisible" OnError="OnRowActionError" />
                    }
                </div>
            }
            <div class="@_slots["gridCardBody"]" data-slot="grid-card-body">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(row.Item)
                }
                else
                {
                    @DefaultCard(row.Item)
                }
            </div>
        </text>;

    private List<RowEntry> RowEntries() => BuildRowEntries(Context.Rows);

    private List<GroupedRowEntries> GroupRowEntries()
    {
        if (GroupBy is null) return [];
        var built = GroupBy.BuildGroups(Context.Rows, Context.Schema, ToolsMessages, FormatCulture);
        var flattened = new List<TItem>(Context.Rows.Count);
        foreach (var g in built) flattened.AddRange(g.Items);
        var allEntries = BuildRowEntries(flattened);
        var result = new List<GroupedRowEntries>(built.Count);
        var offset = 0;
        foreach (var g in built)
        {
            var count = g.Items.Count;
            result.Add(new GroupedRowEntries(g, allEntries.GetRange(offset, count)));
            offset += count;
        }
        return result;
    }

    private List<RowEntry> BuildRowEntries(IReadOnlyList<TItem> rows)
    {
        var schema = Context.Schema;
        var entries = new List<RowEntry>(rows.Count);
        if (schema is { HasRowKey: true })
        {
            var seen = new HashSet<object>();
            var unique = true;
            var pos = 0;
            foreach (var item in rows)
            {
                pos++;
                var key = schema.GetRowKey(item);
                unique &= seen.Add(key);
                entries.Add(new RowEntry(key, item, pos));
            }
            if (unique) return entries;
            entries.Clear();
        }
        var identities = new HashSet<object>();
        var index = 0;
        foreach (var item in rows)
        {
            object key = item is not null && identities.Add(new RowReferenceKey(item)) ? new RowReferenceKey(item) : index;
            entries.Add(new RowEntry(key, item, index + 1));
            index++;
        }
        return entries;
    }

    private RenderFragment DefaultCard(TItem item) =>
        @<dl class="@_slots["gridCardFields"]">
            @if (Context.Columns.Count > 0)
            {
                @foreach (var col in Context.TableColumns())
                {
                    <div class="@_slots["gridCardField"]">
                        <dt class="@_slots["gridCardFieldLabel"]">@col.ResolvedTitle</dt>
                        <dd class="@_slots["gridCardFieldValue"]">
                            @if (col.Template is { } template)
                            {
                                @template(item)
                            }
                            else
                            {
                                @col.FormatValue(col.ReadValue(item, Context.Schema), FormatCulture)
                            }
                        </dd>
                    </div>
                }
            }
            else if (Context.Schema is { } schema)
            {
                @foreach (var field in schema.Fields.Where(f => !f.IsCollection))
                {
                    var val = schema.ReadField(item, field.Key);
                    var text = val is IFormattable formattable ? formattable.ToString(null, FormatCulture) : val?.ToString();
                    <div class="@_slots["gridCardField"]">
                        <dt class="@_slots["gridCardFieldLabel"]">@DataListText.Humanize(field.Key)</dt>
                        <dd class="@_slots["gridCardFieldValue"]">@text</dd>
                    </div>
                }
            }
        </dl>;
}
