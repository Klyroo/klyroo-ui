@namespace Blux.UI.Tools
@typeparam TItem
@inherits DataListPartBase<TItem>
@using Blux.UI.Tools.Query
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@*
    One tag per active filter: "Status is Active, Paused +2". A click opens the editor of the filter in a popover anchored to the tag, the x removes the filter. The tags are a list whose name says how many
    filters are on. Statically rendered the x is a link; the popover and the forms and links inside it need only the script of Blux.UI, no .NET.
*@
@if (Context.Schema is not null && (_active.Count > 0 || (ShowAdd && Context.EditableFilterKeys.Count > 0)))
{
    <div id="@_id" class="@_slots["filters"]" data-slot="filters" tabindex="-1" @attributes="AdditionalAttributes">
        @if (_active.Count > 0)
        {
            <ul id="@_listId" class="@_slots["filterTags"]" data-slot="filter-tags" tabindex="-1" aria-label="@string.Format(FormatCulture, ToolsMessages.FilterTagsLabel, _active.Count.ToString(FormatCulture))">
                @foreach (var rule in _active)
                {
                    var key = rule.Key;
                    var label = Context.FilterLabel(key);
                    var (op, value) = Context.Summarize(rule, ToolsMessages, FormatCulture);
                    var editable = Context.FilterOf(key) is { } filter && DataListContext<TItem>.HasEditor(filter);
                    <li class="@_slots["filterTag"]" data-slot="filter-tag" data-filter="@key" @key="key">
                        @if (editable)
                        {
                            <BxPopover Open="@IsOpen(key)" OpenChanged="@(open => OnOpen(key, open))" Placement="bottom-start" AriaLabel="@string.Format(FormatCulture, ToolsMessages.EditFilter, label)"
                                       Ui="@(IsDate(key) ? _popoverWideUi : _popoverUi)">
                                <ChildContent>
                                    <button type="button" class="@_slots["filterTagButton"]" data-slot="filter-tag-button">
                                        @TagText(label, op, value)
                                    </button>
                                </ChildContent>
                                <Content>
                                    <CascadingValue TValue="FilterEditorShown" Value="@FilterEditorShown.Of(IsOpen(key))">
                                        <BxDataListFilterEditor TItem="TItem" Key="@key" ApplyMode="ApplyMode" ResetToken="Token(key)" OnDone="@(() => Close(key))" />
                                    </CascadingValue>
                                </Content>
                            </BxPopover>
                        }
                        else
                        {
                            <span class="@_slots["filterTagButton"]" data-slot="filter-tag-button">@TagText(label, op, value)</span>
                        }
                        @if (Context.IsInteractive)
                        {
                            <button type="button" class="@_slots["filterTagRemove"]" data-slot="filter-tag-remove" aria-label="@string.Format(FormatCulture, ToolsMessages.RemoveFilter, label)" @onclick="@(() => Remove(key))">
                                @RenderIcon(Options.Icons.Close, _slots["filterTagRemoveIcon"])
                            </button>
                        }
                        else if (Context.HrefWith(s => DataListContext<TItem>.WithFilter(s, key, null)) is { } href)
                        {
                            <a href="@href" class="@_slots["filterTagRemove"]" data-slot="filter-tag-remove" aria-label="@string.Format(FormatCulture, ToolsMessages.RemoveFilter, label)">
                                @RenderIcon(Options.Icons.Close, _slots["filterTagRemoveIcon"])
                            </a>
                        }
                    </li>
                }
            </ul>
        }
        @if (ShowAdd)
        {
            <BxDataListAddFilter TItem="TItem" ApplyMode="ApplyMode" />
        }
        @if (ShowClear)
        {
            <BxDataListClearFilters TItem="TItem" />
        }
    </div>
}

@code {
    private readonly string _id = NewId("dl-filters");
    private readonly string _listId = NewId("dl-filter-tags");
    private readonly Dictionary<string, bool> _open = [];
    private readonly Dictionary<string, int> _tokens = [];
    private SlotSet _slots = default!;
    private PopoverUi _popoverUi = new();
    private PopoverUi _popoverWideUi = new();
    private IReadOnlyList<FilterRule> _active => Context.ActiveFilters;
    private DataListContext<TItem>? _focusSource;
    private int? _focusBelow;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>Shows the add filter button (<see cref="BxDataListAddFilter{TItem}"/>) after the tags. False by default; the default layout of the list shows it.</summary>
    [Parameter] public bool ShowAdd { get; set; }

    /// <summary>Shows the clear filters button (<see cref="BxDataListClearFilters{TItem}"/>) after the tags. False by default; the default layout of the list shows it.</summary>
    [Parameter] public bool ShowClear { get; set; }

    /// <summary>Whether the editors apply each change at once (<see cref="DataListApplyMode.Live"/>) or wait for an Apply button (<see cref="DataListApplyMode.Submit"/>).</summary>
    [Parameter] public DataListApplyMode ApplyMode { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _focusSource = Context;
        Context.FilterFocusRequested += OnFocusRequested;
    }

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "filters");
        _popoverUi = new PopoverUi { Content = _slots["filterPopover"] };
        _popoverWideUi = new PopoverUi { Content = _slots["filterPopoverWide"] };
    }

    // A date editor holds a calendar: its popover is wider.
    private bool IsDate(string key) => Context.FilterOf(key)?.Kind == FilterKind.Date;

    private RenderFragment TagText(string label, string op, string value) =>
        @<text>
            <span class="@_slots["filterTagLabel"]">@label</span>@(" ")<span class="@_slots["filterTagOperator"]">@op</span>
            @if (value.Length > 0)
            {
                @(" ")<span class="@_slots["filterTagValue"]">@value</span>
            }
        </text>;

    private bool IsOpen(string key) => _open.GetValueOrDefault(key);

    private int Token(string key) => _tokens.GetValueOrDefault(key);

    // The browser closes the popover on its own (Escape, a click outside): what was typed and not applied goes with it.
    private void OnOpen(string key, bool open)
    {
        _open[key] = open;
        if (!open) _tokens[key] = Token(key) + 1;
    }

    private void Close(string key) => OnOpen(key, false);

    private void Remove(string key)
    {
        _focusBelow = _active.Count;
        Context.ApplyFilter(key, null);
    }

    // After a removal the button that had the focus is gone: it goes to the list of tags (or, with no tag left, to the bar).
    private void OnFocusRequested() => _focusBelow = _active.Count;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusBelow is not { } below || !Context.IsInteractive || Context.ActiveFilters.Count >= below) return;
        _focusBelow = null;
        try
        {
            await JS.InvokeVoidAsync("Blux.tools.focusId", Context.ActiveFilters.Count > 0 ? _listId : _id);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No browser side: the focus stays where the browser leaves it.
        }
    }

    /// <summary>Unsubscribes from the list.</summary>
    public override void Dispose()
    {
        if (_focusSource is not null) _focusSource.FilterFocusRequested -= OnFocusRequested;
        base.Dispose();
    }
}
