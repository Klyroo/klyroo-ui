@namespace Blux.UI.Tools
@using System.Globalization
@inherits BxComponentBase
@implements IDisposable
@inject FilePreviewService Preview

@if (ChildContent is not null)
{
    @ChildContent
}

@if (Preview.IsOpen && Preview.CurrentFile is { } current)
{
    var displayFile = current.Rendition ?? current;
    var kind = FilePreviewService.DetectKind(displayFile);
    var originalKind = FilePreviewService.DetectKind(current);
    var fileName = current.Name ?? FilePreviewService.FileNameFromUrl(current.Src);
    var container = _expanded ? FilePreviewContainer.Fullscreen : Preview.ResolveContainer();

    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-0 sm:p-4"
         role="dialog" aria-modal="true" aria-label="@fileName"
         tabindex="0" @onkeydown="OnKeyDown"
         data-slot="file-preview-provider" data-container="@container.ToString().ToLowerInvariant()"
         @attributes="AdditionalAttributes">
        <div class="@ShellClass(container)" data-slot="file-preview-shell">
            @* Live region for gallery navigation *@
            @if (Preview.Files.Count > 1)
            {
                <div class="sr-only" aria-live="polite" data-slot="file-preview-live">
                    @($"{Preview.CurrentIndex + 1} of {Preview.Files.Count}: {fileName}")
                </div>
            }

            @* Header *@
            <header class="flex flex-wrap items-center justify-between gap-2 border-b border-(--blux-border) px-4 py-2.5" data-slot="file-preview-header">
                <div class="flex min-w-0 items-center gap-2.5">
                    <span class="inline-flex h-7 min-w-8 shrink-0 items-center justify-center rounded-(--blux-radius) bg-(--blux-bg-muted) px-1.5 text-[10px] font-bold uppercase text-(--blux-text-highlighted)"
                          data-slot="file-preview-ext">
                        @FilePreviewService.ExtensionLabel(fileName, current.Mime)
                    </span>
                    <div class="flex min-w-0 flex-col">
                        <span class="truncate text-sm font-semibold text-(--blux-text-highlighted)" title="@fileName" data-slot="file-preview-title">@fileName</span>
                        <div class="flex flex-wrap items-center gap-1.5 text-xs text-(--blux-text-muted)" data-slot="file-preview-meta">
                            <span>@kind</span>
                            @if (current.Size is { } sz)
                            {
                                <span>·</span>
                                <span>@FilePreviewService.FormatFileSize(sz, CultureInfo.InvariantCulture)</span>
                            }
                            @if (current.UpdatedAt is { } updated)
                            {
                                <span>·</span>
                                <span>@updated.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-1.5" data-slot="file-preview-toolbar">
                    @if (Preview.Files.Count > 1)
                    {
                        <button type="button"
                                class="inline-flex size-8 items-center justify-center rounded-(--blux-radius) border border-(--blux-border) text-(--blux-text) hover:bg-(--blux-bg-muted) disabled:opacity-40"
                                disabled="@(!Preview.Options.Loop && Preview.CurrentIndex <= 0)"
                                aria-label="Previous file"
                                data-slot="file-preview-prev"
                                @onclick="OnPrevious">
                            ‹
                        </button>
                        <span class="px-1.5 text-xs font-medium tabular-nums text-(--blux-text-muted)" data-slot="file-preview-counter">
                            @($"{Preview.CurrentIndex + 1} / {Preview.Files.Count}")
                        </span>
                        <button type="button"
                                class="inline-flex size-8 items-center justify-center rounded-(--blux-radius) border border-(--blux-border) text-(--blux-text) hover:bg-(--blux-bg-muted) disabled:opacity-40"
                                disabled="@(!Preview.Options.Loop && Preview.CurrentIndex >= Preview.Files.Count - 1)"
                                aria-label="Next file"
                                data-slot="file-preview-next"
                                @onclick="OnNext">
                            ›
                        </button>
                    }

                    @if (kind == FilePreviewKind.Image)
                    {
                        <button type="button" class="inline-flex size-8 items-center justify-center rounded-(--blux-radius) text-xs font-semibold text-(--blux-text) hover:bg-(--blux-bg-muted)"
                                aria-label="Zoom out" data-slot="image-zoom-out" @onclick="ZoomOut">−</button>
                        <button type="button" class="inline-flex h-8 items-center justify-center rounded-(--blux-radius) px-2 text-xs font-semibold tabular-nums text-(--blux-text) hover:bg-(--blux-bg-muted)"
                                aria-label="Reset zoom" data-slot="image-zoom-reset" @onclick="ResetImageTransform">@($"{Math.Round(_zoom * 100)}%")</button>
                        <button type="button" class="inline-flex size-8 items-center justify-center rounded-(--blux-radius) text-xs font-semibold text-(--blux-text) hover:bg-(--blux-bg-muted)"
                                aria-label="Zoom in" data-slot="image-zoom-in" @onclick="ZoomIn">+</button>
                        <button type="button" class="inline-flex size-8 items-center justify-center rounded-(--blux-radius) text-xs font-semibold text-(--blux-text) hover:bg-(--blux-bg-muted)"
                                aria-label="Rotate 90 degrees" data-slot="image-rotate" @onclick="RotateImage">↻</button>
                    }

                    @if (current.Actions is { Count: > 0 })
                    {
                        @foreach (var act in current.Actions)
                        {
                            <button type="button"
                                    class="inline-flex h-8 items-center gap-1 rounded-(--blux-radius) border border-(--blux-border) px-2.5 text-xs font-medium text-(--blux-text) hover:bg-(--blux-bg-muted)"
                                    data-slot="file-preview-custom-action"
                                    @onclick="@(() => OnCustomActionAsync(act, current))">
                                @act.Label
                            </button>
                        }
                    }

                    <button type="button"
                            class="inline-flex h-8 items-center rounded-(--blux-radius) px-2 text-xs font-medium text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                            aria-pressed="@(_showDetails ? "true" : "false")"
                            data-slot="file-preview-details-toggle"
                            @onclick="@(() => _showDetails = !_showDetails)">
                        Details
                    </button>

                    <a href="@(current.DownloadUrl ?? current.Src)" download="@fileName"
                       class="inline-flex h-8 items-center rounded-(--blux-radius) px-2 text-xs font-medium text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                       data-slot="file-preview-download">
                        Download
                    </a>

                    @if (Preview.ResolveContainer() != FilePreviewContainer.Fullscreen)
                    {
                        <button type="button"
                                class="inline-flex size-8 items-center justify-center rounded-(--blux-radius) text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                                aria-label="@(_expanded ? "Restore preview size" : "Expand preview")"
                                aria-pressed="@(_expanded ? "true" : "false")"
                                data-slot="file-preview-expand"
                                @onclick="@(() => _expanded = !_expanded)">
                            ⛶
                        </button>
                    }

                    <button type="button"
                            class="inline-flex size-8 items-center justify-center rounded-(--blux-radius) text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                            aria-label="Close preview"
                            data-slot="file-preview-close"
                            @onclick="Preview.Close">
                        ✕
                    </button>
                </div>
            </header>

            @* Rendition banner *@
            @if (current.Rendition is not null)
            {
                <div class="flex items-center justify-between gap-2 border-b border-(--blux-border) bg-(--blux-bg-muted) px-4 py-1.5 text-xs text-(--blux-text-muted)"
                     data-slot="file-preview-rendition-banner">
                    <span>Converted preview · The original is a <strong>@originalKind</strong> file.</span>
                    <a href="@(current.DownloadUrl ?? current.Src)" download="@fileName" class="font-medium text-(--blux-primary-text) hover:underline">
                        Download original
                    </a>
                </div>
            }

            @* Main Stage + Optional Details Aside *@
            <div class="relative flex min-h-0 flex-1 overflow-hidden">
                <div class="flex min-h-0 flex-1 items-center justify-center overflow-auto p-4" data-slot="file-preview-stage" data-kind="@kind.ToString().ToLowerInvariant()">
                    @RenderStage(displayFile, kind, fileName)
                </div>

                @if (_showDetails)
                {
                    <aside class="w-72 shrink-0 overflow-y-auto border-s border-(--blux-border) bg-(--blux-bg-elevated) p-4 text-xs" data-slot="file-preview-details">
                        <h3 class="m-0 mb-3 text-xs font-semibold uppercase tracking-wide text-(--blux-text-muted)">Details</h3>
                        <dl class="m-0 flex flex-col gap-2">
                            <div class="flex justify-between gap-2">
                                <dt class="text-(--blux-text-muted)">Name</dt>
                                <dd class="m-0 truncate font-medium text-(--blux-text-highlighted)">@fileName</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-(--blux-text-muted)">Type</dt>
                                <dd class="m-0 font-medium text-(--blux-text-highlighted)">@(current.Mime ?? kind.ToString())</dd>
                            </div>
                            @if (current.Size is { } sizeBytes)
                            {
                                <div class="flex justify-between gap-2">
                                    <dt class="text-(--blux-text-muted)">Size</dt>
                                    <dd class="m-0 tabular-nums font-medium text-(--blux-text-highlighted)">@FilePreviewService.FormatFileSize(sizeBytes, CultureInfo.InvariantCulture)</dd>
                                </div>
                            }
                            @if (current.Details is { Count: > 0 })
                            {
                                @foreach (var d in current.Details)
                                {
                                    <div class="flex justify-between gap-2" data-slot="file-preview-detail-row">
                                        <dt class="text-(--blux-text-muted)">@d.Label</dt>
                                        <dd class="m-0 font-medium text-(--blux-text-highlighted)">@d.Value</dd>
                                    </div>
                                }
                            }
                        </dl>
                    </aside>
                }
            </div>

            @* Gallery thumbnail strip *@
            @if (Preview.Files.Count > 1)
            {
                <footer class="flex items-center gap-2 overflow-x-auto border-t border-(--blux-border) px-4 py-2" data-slot="file-preview-strip">
                    @for (var i = 0; i < Preview.Files.Count; i++)
                    {
                        var idx = i;
                        var f = Preview.Files[i];
                        var fName = f.Name ?? FilePreviewService.FileNameFromUrl(f.Src);
                        var isCurrent = idx == Preview.CurrentIndex;
                        <button type="button"
                                class="inline-flex shrink-0 items-center gap-1.5 rounded-(--blux-radius) border px-2.5 py-1 text-xs font-medium @(isCurrent ? "border-(--blux-primary-text) bg-(--blux-bg-muted) text-(--blux-text-highlighted)" : "border-(--blux-border) text-(--blux-text-muted) hover:bg-(--blux-bg-muted)")"
                                aria-current="@(isCurrent ? "true" : null)"
                                data-slot="file-preview-thumb"
                                @onclick="@(() => SelectFile(idx))">
                            <span class="font-bold uppercase">@FilePreviewService.ExtensionLabel(fName, f.Mime)</span>
                            <span class="max-w-28 truncate">@fName</span>
                        </button>
                    }
                </footer>
            }
        </div>
    </div>
}

@code {
    private bool _showDetails;
    private bool _expanded;
    private bool _wrapLines;
    private bool _markdownSource;
    private double _zoom = 1.0;
    private int _rotation;

    /// <summary>Optional child content wrapped by the provider.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional Markdown-to-HTML callback for <see cref="FilePreviewKind.Markdown"/> files.</summary>
    [Parameter] public Func<string, string>? MarkdownRenderer { get; set; }

    protected override void OnInitialized()
    {
        Preview.AttachProvider();
        Preview.Changed += OnPreviewChanged;
    }

    private void OnPreviewChanged()
    {
        ResetImageTransform();
        _ = InvokeAsync(StateHasChanged);
    }

    private string ShellClass(FilePreviewContainer container) => container switch
    {
        FilePreviewContainer.Fullscreen => "flex h-dvh w-screen flex-col bg-(--blux-bg) text-(--blux-text)",
        FilePreviewContainer.Drawer => "ms-auto flex h-dvh w-full max-w-4xl flex-col border-s border-(--blux-border) bg-(--blux-bg) text-(--blux-text) shadow-xl",
        _ => "flex max-h-[90dvh] w-full max-w-5xl flex-col overflow-hidden rounded-(--blux-radius-lg) border border-(--blux-border) bg-(--blux-bg) text-(--blux-text) shadow-xl",
    };

    private RenderFragment RenderStage(FilePreviewFile file, FilePreviewKind kind, string fileName) => kind switch
    {
        FilePreviewKind.Image => @<div class="flex items-center justify-center overflow-hidden" data-slot="renderer-image">
            <img src="@file.Src" alt="@fileName"
                 style="@($"transform:scale({_zoom.ToString("0.##", CultureInfo.InvariantCulture)}) rotate({_rotation}deg)")"
                 class="max-h-[70dvh] max-w-full object-contain transition-transform" />
        </div>,

        FilePreviewKind.Video => @<div class="w-full max-w-3xl" data-slot="renderer-video">
            <BxVideoPlayer Src="@file.Src" Poster="@file.Poster" Title="@fileName" Tracks="@file.Tracks" Keyboard="false" />
        </div>,

        FilePreviewKind.Audio => @<div class="flex w-full max-w-md flex-col items-center gap-4 rounded-(--blux-radius-md) border border-(--blux-border) bg-(--blux-bg-elevated) p-6" data-slot="renderer-audio">
            @if (!string.IsNullOrEmpty(file.Poster))
            {
                <img src="@file.Poster" alt="@fileName" class="size-32 rounded-(--blux-radius) object-cover" />
            }
            <span class="font-semibold text-(--blux-text-highlighted)">@fileName</span>
            <BxAudioPlayer Src="@file.Src" Title="@fileName" Keyboard="false" class="w-full" />
        </div>,

        FilePreviewKind.Pdf => @<div class="h-[72dvh] w-full" data-slot="renderer-pdf">
            @{
                var pdfSrc = Preview.Options.PdfPage is { } page && !file.Src.Contains('#')
                    ? $"{file.Src}#page={page}&view=FitH"
                    : file.Src;
            }
            <iframe src="@pdfSrc" title="@fileName" class="h-full w-full rounded-(--blux-radius) border border-(--blux-border)"></iframe>
        </div>,

        FilePreviewKind.Csv => RenderCsvStage(file, fileName),
        FilePreviewKind.Markdown => RenderMarkdownStage(file),
        FilePreviewKind.Text => RenderTextStage(file),

        _ => @<div class="flex max-w-sm flex-col items-center gap-3 rounded-(--blux-radius-md) border border-(--blux-border) bg-(--blux-bg-elevated) p-6 text-center" data-slot="renderer-fallback">
            <span class="inline-flex h-10 min-w-12 items-center justify-center rounded-(--blux-radius) bg-(--blux-bg-muted) px-2.5 text-xs font-bold uppercase text-(--blux-text-highlighted)">
                @FilePreviewService.ExtensionLabel(fileName, file.Mime)
            </span>
            <p class="m-0 font-semibold text-(--blux-text-highlighted)">No preview available</p>
            <p class="m-0 text-xs text-(--blux-text-muted)">Download this file to open it in another application.</p>
            <a href="@(file.DownloadUrl ?? file.Src)" download="@fileName"
               class="inline-flex items-center gap-1.5 rounded-(--blux-radius) bg-(--blux-primary) px-3 py-1.5 text-xs font-semibold text-white hover:opacity-90"
               data-slot="fallback-download">
                Download
            </a>
        </div>,
    };

    private RenderFragment RenderCsvStage(FilePreviewFile file, string fileName)
    {
        var parsed = FilePreviewService.ParseCsv(file.Content, fileName);
        return @<div class="flex h-full w-full flex-col gap-2" data-slot="renderer-csv">
            <div class="flex-1 overflow-auto rounded-(--blux-radius) border border-(--blux-border)">
                <table class="min-w-full text-xs">
                    <thead class="sticky top-0 border-b border-(--blux-border) bg-(--blux-bg-elevated) font-semibold text-(--blux-text-muted)">
                        <tr>
                            <th scope="col" class="w-10 px-2 py-1.5 text-end">#</th>
                            @for (var c = 0; c < parsed.Headers.Count; c++)
                            {
                                var isNum = c < parsed.NumericColumns.Count && parsed.NumericColumns[c];
                                <th scope="col" class="px-3 py-1.5 @(isNum ? "text-end" : "text-start")">@parsed.Headers[c]</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-(--blux-border)">
                        @for (var r = 0; r < parsed.Rows.Count; r++)
                        {
                            var row = parsed.Rows[r];
                            <tr data-slot="csv-row">
                                <td class="px-2 py-1.5 text-end tabular-nums text-(--blux-text-muted)">@(r + 1)</td>
                                @for (var c = 0; c < parsed.Headers.Count; c++)
                                {
                                    var val = c < row.Count ? row[c] : "";
                                    var isNum = c < parsed.NumericColumns.Count && parsed.NumericColumns[c];
                                    <td class="px-3 py-1.5 @(isNum ? "text-end tabular-nums" : "text-start")">@val</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex items-center justify-between text-xs text-(--blux-text-muted)" data-slot="csv-footer">
                <span>@($"{parsed.Rows.Count} rows · {parsed.Headers.Count} columns · delimiter '{(parsed.Delimiter == '\t' ? "tab" : parsed.Delimiter.ToString())}'")</span>
                @if (parsed.Truncated)
                {
                    <span>Showing first 1,000 rows</span>
                }
            </div>
        </div>;
    }

    private RenderFragment RenderMarkdownStage(FilePreviewFile file)
    {
        var raw = file.Content ?? "";
        var hasHook = MarkdownRenderer is not null;
        return @<div class="flex h-full w-full flex-col gap-2" data-slot="renderer-markdown">
            @if (hasHook)
            {
                <div class="flex items-center justify-end gap-1">
                    <button type="button" class="rounded-(--blux-radius) px-2 py-1 text-xs font-medium @(!_markdownSource ? "bg-(--blux-bg-muted) text-(--blux-text-highlighted)" : "text-(--blux-text-muted)")"
                            data-slot="markdown-preview-tab" @onclick="@(() => _markdownSource = false)">Preview</button>
                    <button type="button" class="rounded-(--blux-radius) px-2 py-1 text-xs font-medium @(_markdownSource ? "bg-(--blux-bg-muted) text-(--blux-text-highlighted)" : "text-(--blux-text-muted)")"
                            data-slot="markdown-source-tab" @onclick="@(() => _markdownSource = true)">Source</button>
                </div>
            }
            @if (hasHook && !_markdownSource)
            {
                <div class="prose max-w-none flex-1 overflow-auto rounded-(--blux-radius) border border-(--blux-border) p-4 text-sm" data-slot="markdown-html">
                    @((MarkupString)MarkdownRenderer!(raw))
                </div>
            }
            else
            {
                <pre class="m-0 flex-1 overflow-auto rounded-(--blux-radius) bg-(--blux-bg-muted) p-4 font-mono text-xs text-(--blux-text-highlighted)" data-slot="markdown-source"><code>@raw</code></pre>
            }
        </div>;
    }

    private RenderFragment RenderTextStage(FilePreviewFile file)
    {
        var raw = file.Content ?? "";
        var lines = raw.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        return @<div class="flex h-full w-full flex-col gap-2" data-slot="renderer-text">
            <div class="flex items-center justify-between gap-2 text-xs text-(--blux-text-muted)">
                <span>@($"{lines.Length} lines")</span>
                <button type="button" class="rounded-(--blux-radius) px-2 py-1 font-medium hover:bg-(--blux-bg-muted)"
                        aria-pressed="@(_wrapLines ? "true" : "false")" data-slot="text-wrap-toggle"
                        @onclick="@(() => _wrapLines = !_wrapLines)">
                    Wrap lines
                </button>
            </div>
            <pre class="m-0 flex-1 overflow-auto rounded-(--blux-radius) bg-(--blux-bg-muted) p-4 font-mono text-xs text-(--blux-text-highlighted) @(_wrapLines ? "whitespace-pre-wrap" : "whitespace-pre")" data-slot="text-content"><code>@raw</code></pre>
        </div>;
    }

    private void OnPrevious()
    {
        ResetImageTransform();
        Preview.Previous();
    }

    private void OnNext()
    {
        ResetImageTransform();
        Preview.Next();
    }

    private void SelectFile(int index)
    {
        ResetImageTransform();
        Preview.GoTo(index);
    }

    private void ZoomIn() => _zoom = Math.Min(4.0, Math.Round(_zoom * 1.5, 2));
    private void ZoomOut() => _zoom = Math.Max(0.5, Math.Round(_zoom / 1.5, 2));
    private void RotateImage()
    {
        _zoom = 1.0;
        _rotation = (_rotation + 90) % 360;
    }

    private void ResetImageTransform()
    {
        _zoom = 1.0;
        _rotation = 0;
    }

    private async Task OnCustomActionAsync(FilePreviewAction act, FilePreviewFile current)
    {
        if (act.OnSelect is not null)
        {
            await act.OnSelect(current);
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                Preview.Close();
                break;
            case "ArrowLeft":
                OnPrevious();
                break;
            case "ArrowRight":
                OnNext();
                break;
            case "Home":
                SelectFile(0);
                break;
            case "End":
                SelectFile(Preview.Files.Count - 1);
                break;
            case "+":
            case "=":
                ZoomIn();
                break;
            case "-":
                ZoomOut();
                break;
            case "0":
                ResetImageTransform();
                break;
            case "r":
            case "R":
                RotateImage();
                break;
        }
    }

    public void Dispose()
    {
        Preview.Changed -= OnPreviewChanged;
        Preview.DetachProvider();
    }
}
