@namespace Blux.UI.Tools
@using System.Globalization
@inherits BxComponentBase

<div class="@RootClass" role="region" aria-label="@(Title ?? "Audio player")" tabindex="@(Keyboard ? 0 : -1)"
     @onkeydown="OnKeyDown" data-slot="audio-player" data-locked="@(IsLocked ? "true" : null)" @attributes="AdditionalAttributes">
    <audio src="@Src" preload="@Preload" muted="@Muted" loop="@(Loop && !IsRestricted)" class="hidden" data-slot="audio-element"></audio>

    @if (IsLocked)
    {
        <div class="flex items-center justify-between gap-3 px-3 py-1.5 text-xs font-medium text-(--blux-text-muted)" data-slot="media-locked">
            <span class="inline-flex items-center gap-1.5">
                @RenderIcon("lock", "size-4 text-(--blux-warning-text)")
                <span>No plays left</span>
            </span>
            <span class="tabular-nums" data-slot="media-time">@FormatTime(ClipPosition) / @FormatTime(ClipLength)</span>
        </div>
    }
    else
    {
        <div class="flex flex-wrap items-center gap-2.5 px-3 py-1.5" data-slot="media-controls">
            <button type="button"
                    class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-(--blux-primary) text-white hover:opacity-90 disabled:opacity-40"
                    disabled="@Disabled"
                    aria-label="@(_playing ? "Pause" : "Play")"
                    data-slot="media-play"
                    @onclick="TogglePlayAsync">
                @RenderIcon(_playing ? "pause" : "play", "size-4")
            </button>

            @if (!IsHidden(MediaPlayerControl.Time))
            {
                <span class="shrink-0 font-mono text-xs tabular-nums text-(--blux-text-muted)" data-slot="media-time">
                    @FormatTime(ClipPosition) / @FormatTime(ClipLength)
                </span>
            }

            <div class="flex min-w-24 flex-1 items-center" data-slot="media-timeline">
                @if (Seekable)
                {
                    <input type="range" min="0" max="@ClipLength.ToString("0.##", CultureInfo.InvariantCulture)"
                           step="0.1" value="@ClipPosition.ToString("0.##", CultureInfo.InvariantCulture)"
                           disabled="@Disabled"
                           aria-label="Seek"
                           class="h-1.5 w-full cursor-pointer accent-(--blux-primary)"
                           data-slot="media-seek"
                           @oninput="OnSeekInputAsync" />
                }
                else
                {
                    var pct = ClipLength > 0 ? Math.Clamp(ClipPosition / ClipLength * 100.0, 0, 100) : 0;
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-(--blux-bg-muted)"
                         role="progressbar" aria-label="Playback progress"
                         aria-valuenow="@Math.Round(pct)" aria-valuemin="0" aria-valuemax="100"
                         data-slot="media-progress">
                        <div class="h-full bg-(--blux-primary)" style="@($"width:{pct.ToString("0.#", CultureInfo.InvariantCulture)}%")"></div>
                    </div>
                }
            </div>

            @if (MaxPlays > 0)
            {
                <span class="inline-flex items-center gap-1 rounded-full bg-(--blux-bg-muted) px-2 py-0.5 text-[11px] font-semibold tabular-nums text-(--blux-text-muted)"
                      title="@($"{RemainingPlays} plays left")" data-slot="media-plays-left">
                    @RemainingPlays
                </span>
            }

            @if (!IsHidden(MediaPlayerControl.Volume))
            {
                <button type="button"
                        class="inline-flex size-7 items-center justify-center rounded-full text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                        aria-label="@(Muted ? "Unmute" : "Mute")"
                        aria-pressed="@(Muted ? "true" : "false")"
                        data-slot="media-mute"
                        @onclick="ToggleMuteAsync">
                    @RenderIcon(Muted ? "volume-x" : "volume-2", "size-4")
                </button>
            }

            @if (!IsHidden(MediaPlayerControl.Rate) && Rates is { Count: > 1 })
            {
                <button type="button"
                        class="inline-flex h-7 items-center justify-center rounded-full px-2 text-xs font-semibold tabular-nums text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                        aria-label="Playback speed"
                        data-slot="media-rate"
                        @onclick="CycleRateAsync">
                    @($"{Rate.ToString("0.##", CultureInfo.InvariantCulture)}×")
                </button>
            }

            @if (!IsHidden(MediaPlayerControl.Download) && (Download || !string.IsNullOrEmpty(DownloadUrl)))
            {
                <a href="@(DownloadUrl ?? Src)" download="@(DownloadFileName ?? true.ToString())"
                   class="inline-flex size-7 items-center justify-center rounded-full text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                   aria-label="Download" data-slot="media-download"
                   @onclick="OnDownloadClickAsync">
                    @RenderIcon("download", "size-4")
                </a>
            }
        </div>
    }
</div>

@code {
    private bool _playing;
    private bool _playActive;
    private double _currentTime;

    [Parameter] public required string Src { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Preload { get; set; } = "metadata";
    [Parameter] public bool Autoplay { get; set; }
    [Parameter] public bool Loop { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Keyboard { get; set; } = true;

    /// <summary>Clip start offset in seconds.</summary>
    [Parameter] public double Start { get; set; }

    /// <summary>Optional clip end offset in seconds.</summary>
    [Parameter] public double? End { get; set; }

    /// <summary>Total duration in seconds (defaults to 60s in headless/SSR preview mode until metadata loads).</summary>
    [Parameter] public double Duration { get; set; } = 60;

    /// <summary>Whether the user can scrub the timeline.</summary>
    [Parameter] public bool Seekable { get; set; } = true;

    /// <summary>Maximum number of allowed plays (<c>0</c> = unlimited).</summary>
    [Parameter] public int MaxPlays { get; set; }

    /// <summary>Number of plays consumed so far.</summary>
    [Parameter] public int Plays { get; set; }
    [Parameter] public EventCallback<int> PlaysChanged { get; set; }

    /// <summary>Playback rate (<c>1.0</c> by default).</summary>
    [Parameter] public double Rate { get; set; } = 1.0;
    [Parameter] public EventCallback<double> RateChanged { get; set; }

    /// <summary>Available playback rates.</summary>
    [Parameter] public IReadOnlyList<double>? Rates { get; set; } = [0.5, 0.75, 1, 1.25, 1.5, 2];

    /// <summary>Audio volume between <c>0</c> and <c>1</c>.</summary>
    [Parameter] public double Volume { get; set; } = 1.0;
    [Parameter] public EventCallback<double> VolumeChanged { get; set; }

    /// <summary>Whether audio is muted.</summary>
    [Parameter] public bool Muted { get; set; }
    [Parameter] public EventCallback<bool> MutedChanged { get; set; }

    /// <summary>Enables the download button.</summary>
    [Parameter] public bool Download { get; set; }
    [Parameter] public string? DownloadUrl { get; set; }
    [Parameter] public string? DownloadFileName { get; set; }

    /// <summary>Controls to hide from the bar.</summary>
    [Parameter] public IReadOnlyList<MediaPlayerControl>? Hide { get; set; }

    [Parameter] public EventCallback OnPlay { get; set; }
    [Parameter] public EventCallback OnPause { get; set; }
    [Parameter] public EventCallback OnEnded { get; set; }
    [Parameter] public EventCallback OnLimitReached { get; set; }
    [Parameter] public EventCallback<MediaPlayerProgress> OnTimeUpdate { get; set; }
    [Parameter] public EventCallback OnDownload { get; set; }

    public int RemainingPlays => MaxPlays > 0 ? Math.Max(0, MaxPlays - Plays) : int.MaxValue;
    public bool IsLocked => MaxPlays > 0 && RemainingPlays <= 0 && !_playActive;
    private bool IsRestricted => MaxPlays > 0 || !Seekable;
    public double ClipEnd => End is { } e && e > Start ? e : Math.Max(Start, Duration);
    public double ClipLength => Math.Max(0, ClipEnd - Start);
    public double ClipPosition => Math.Clamp(_currentTime - Start, 0, ClipLength);

    private string RootClass =>
        $"rounded-full border border-(--blux-border) bg-(--blux-bg-elevated) text-(--blux-text) shadow-xs {Class}".Trim();

    protected override void OnParametersSet()
    {
        if (_currentTime < Start) _currentTime = Start;
        if (Disabled && _playing) _playing = false;
    }

    public async Task TogglePlayAsync()
    {
        if (Disabled || IsLocked) return;
        if (_playing)
        {
            _playing = false;
            await OnPause.InvokeAsync();
            StateHasChanged();
            return;
        }

        if (!_playActive)
        {
            if (MaxPlays > 0 && Plays >= MaxPlays)
            {
                await OnLimitReached.InvokeAsync();
                StateHasChanged();
                return;
            }
            _playActive = true;
            _currentTime = Start;
            Plays++;
            await PlaysChanged.InvokeAsync(Plays);
        }

        _playing = true;
        await OnPlay.InvokeAsync();
        StateHasChanged();
    }

    public async Task CompletePlayAsync()
    {
        _playing = false;
        _playActive = false;
        _currentTime = ClipEnd;
        await OnEnded.InvokeAsync();
        if (MaxPlays > 0 && Plays >= MaxPlays)
        {
            await OnLimitReached.InvokeAsync();
        }
        StateHasChanged();
    }

    public async Task SeekAsync(double clipOffsetSeconds)
    {
        if (!Seekable || Disabled || IsLocked) return;
        var clamped = Math.Clamp(clipOffsetSeconds, 0, ClipLength);
        _currentTime = Start + clamped;
        await OnTimeUpdate.InvokeAsync(new MediaPlayerProgress(ClipPosition, ClipLength, _currentTime));
        if (_currentTime >= ClipEnd - 0.05 && ClipLength > 0)
        {
            await CompletePlayAsync();
            return;
        }
        StateHasChanged();
    }

    public async Task ToggleMuteAsync()
    {
        Muted = !Muted;
        await MutedChanged.InvokeAsync(Muted);
    }

    public async Task CycleRateAsync()
    {
        if (Rates is not { Count: > 1 }) return;
        var idx = -1;
        for (var i = 0; i < Rates.Count; i++)
        {
            if (Math.Abs(Rates[i] - Rate) < 0.001) { idx = i; break; }
        }
        var next = Rates[(idx + 1) % Rates.Count];
        Rate = next;
        await RateChanged.InvokeAsync(Rate);
    }

    private async Task OnSeekInputAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var pos))
        {
            await SeekAsync(pos);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!Keyboard) return;
        if (e.Key is " " or "k" or "K")
        {
            await TogglePlayAsync();
        }
        else if (e.Key is "m" or "M")
        {
            await ToggleMuteAsync();
        }
    }

    private async Task OnDownloadClickAsync()
    {
        if (OnDownload.HasDelegate) await OnDownload.InvokeAsync();
    }

    private bool IsHidden(MediaPlayerControl control) =>
        Hide is not null && Hide.Contains(control);

    internal static string FormatTime(double seconds)
    {
        if (double.IsNaN(seconds) || double.IsInfinity(seconds) || seconds < 0) seconds = 0;
        var ts = TimeSpan.FromSeconds(Math.Round(seconds));
        return ts.TotalHours >= 1
            ? string.Create(CultureInfo.InvariantCulture, $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}")
            : string.Create(CultureInfo.InvariantCulture, $"{ts.Minutes}:{ts.Seconds:D2}");
    }

    private new static RenderFragment RenderIcon(string kind, string sizeClass) =>
        @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@sizeClass" aria-hidden="true">
            @switch (kind)
            {
                case "play":
                    <polygon points="6 3 20 12 6 21 6 3" />
                    break;
                case "pause":
                    <rect x="14" y="4" width="4" height="16" rx="1" /><rect x="6" y="4" width="4" height="16" rx="1" />
                    break;
                case "lock":
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    break;
                case "volume-2":
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                    break;
                case "volume-x":
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><line x1="22" x2="16" y1="9" y2="15" /><line x1="16" x2="22" y1="9" y2="15" />
                    break;
                case "download":
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" />
                    break;
            }
        </svg>;
}
