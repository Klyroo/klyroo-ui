@namespace Blux.UI.Tools
@using System.Globalization
@inherits BxComponentBase

<BxDashboardCard Source="@Source" Title="@Title" Subtitle="@Subtitle" Span="@Span" Card="@Card"
                 Skeleton="DashboardSkeletonKind.Gauge" Menu="@Menu" Freshness="@Freshness" Class="@Class">
    <div class="flex flex-col items-center justify-center gap-2 py-2"
         role="meter"
         aria-label="@(Title ?? "Gauge")"
         aria-valuemin="@Min.ToString("0.##", CultureInfo.InvariantCulture)"
         aria-valuemax="@Max.ToString("0.##", CultureInfo.InvariantCulture)"
         aria-valuenow="@(Value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "0")"
         aria-valuetext="@FormattedValue"
         data-slot="dashboard-gauge"
         data-variant="@Variant">
        <div class="relative flex items-center justify-center" style="width:140px;height:140px">
            <svg viewBox="0 0 100 100" class="size-full -rotate-90 overflow-visible" aria-hidden="true">
                <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="8" class="text-(--blux-bg-muted)" />
                <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="8"
                        stroke-linecap="round"
                        stroke-dasharray="263.89"
                        stroke-dashoffset="@DashOffset.ToString("0.##", CultureInfo.InvariantCulture)"
                        class="text-(--blux-primary) transition-all" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span class="text-xl font-bold tabular-nums text-(--blux-text-highlighted)" data-slot="gauge-value">@FormattedValue</span>
                @if (!string.IsNullOrEmpty(Caption))
                {
                    <span class="text-xs text-(--blux-text-muted)" data-slot="gauge-caption">@Caption</span>
                }
            </div>
        </div>
        @if (Target.HasValue)
        {
            <span class="text-xs text-(--blux-text-muted)" data-slot="gauge-target">
                Target: @DashboardFormat.Format(Target, Format, FormatCulture)
            </span>
        }
    </div>
</BxDashboardCard>

@code {
    [Parameter] public IDashboardSource? Source { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public double? Value { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double? Target { get; set; }
    [Parameter] public DashboardFormatPreset Format { get; set; } = DashboardFormatPreset.Number;
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string Variant { get; set; } = "arc";
    [Parameter] public int Span { get; set; } = 4;
    [Parameter] public bool Card { get; set; } = true;
    [Parameter] public bool? Menu { get; set; }
    [Parameter] public bool? Freshness { get; set; }

    public double Share
    {
        get
        {
            var span = Max - Min;
            if (span <= 0 || Value is null) return 0;
            return Math.Clamp((Value.Value - Min) / span, 0, 1);
        }
    }

    private double DashOffset => 263.89 * (1.0 - Share);
    private string FormattedValue => DashboardFormat.Format(Value, Format, FormatCulture);
}
