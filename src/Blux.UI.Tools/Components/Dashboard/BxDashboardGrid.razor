@namespace Blux.UI.Tools
@inherits BxComponentBase

<div class="@RootClass" data-slot="dashboard-grid" data-variant="@Variant" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public int Columns { get; set; } = 12;
    [Parameter] public string Variant { get; set; } = "cards";
    [Parameter] public bool Menu { get; set; }
    [Parameter] public bool Freshness { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string RootClass
    {
        get
        {
            var isPanels = string.Equals(Variant, "panels", StringComparison.OrdinalIgnoreCase);
            var baseCls = isPanels
                ? "grid grid-cols-12 gap-px overflow-hidden rounded-(--blux-radius-md) border border-(--blux-border) bg-(--blux-border)"
                : "grid grid-cols-12 gap-4";
            return $"{baseCls} empty:hidden {Class}".Trim();
        }
    }
}
