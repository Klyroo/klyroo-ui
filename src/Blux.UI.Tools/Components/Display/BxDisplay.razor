                <button type="button" class="inline-flex items-center gap-1 self-start text-xs font-medium text-(--blux-primary-text) hover:underline"
                        aria-expanded="@(_detailsOpen ? "true" : "false")" data-slot="breakdown-toggle"
                        @onclick="@(() => _detailsOpen = !_detailsOpen)">
                    <span>@(_detailsOpen ? "Hide details" : "Details")</span>
