                        <div class="flex min-w-0 flex-col">
                            @if (!string.IsNullOrEmpty(rec.Reference))
                            {
                                <span class="text-[11px] font-mono text-(--blux-text-muted)">@rec.Reference</span>
                            }
                            @if (!string.IsNullOrEmpty(rec.Href))
                            {
