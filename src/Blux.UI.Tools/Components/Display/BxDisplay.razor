                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        @if (rec.Chip is { } chip)
                        {
                            <BxBadge Label="@chip.Label" Color="@(chip.Color ?? BxColor.Neutral)" Variant="BxVariant.Subtle" Size="BxSize.Sm" />
                        }
                        @if (!string.IsNullOrEmpty(rec.Trailing))
                        {
                            <span class="font-semibold tabular-nums text-(--blux-text-highlighted)" data-slot="record-trailing">@rec.Trailing</span>
                        }
