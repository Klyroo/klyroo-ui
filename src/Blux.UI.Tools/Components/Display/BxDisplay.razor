            @if (remaining > 0 && Records is not null)
            {
                @RenderRevealButton(remaining, Records.Count)
            }
        </div>;
    }

    private RenderFragment RenderPerson() =>
        @<div class="flex flex-col gap-3" data-slot="display-person">
            @if (string.Equals(Variant, "group", StringComparison.OrdinalIgnoreCase) && People is { Count: > 0 })
            {
                var max = Max ?? 4;
                var shown = People.Take(max).ToList();
                var extra = People.Count - shown.Count;
                <div class="flex items-center gap-2" data-slot="person-group">
                    <div class="flex -space-x-2">
                        @foreach (var p in shown)
                        {
                            <span class="inline-flex size-8 items-center justify-center rounded-full border-2 border-(--blux-bg) bg-(--blux-bg-muted) text-xs font-semibold text-(--blux-text-highlighted)"
                                  title="@p.Name" data-slot="person-avatar">@InitialsOf(p.Name)</span>
                        }
                        @if (extra > 0)
                        {
                            <span class="inline-flex size-8 items-center justify-center rounded-full border-2 border-(--blux-bg) bg-(--blux-bg-elevated) text-xs font-semibold text-(--blux-text-muted)"
                                  data-slot="person-overflow">+@extra</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <span class="text-xs text-(--blux-text-muted)">@Title</span>
                    }
                </div>
            }
            else
            {
                var person = People is { Count: > 0 } ? People[0] : new DisplayPersonItem(Title ?? "User", Description, null, Tone, Chip);
                <div class="flex items-center justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-2.5">
                        <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-(--blux-bg-muted) text-xs font-semibold text-(--blux-text-highlighted)"
                              data-slot="person-avatar">@InitialsOf(person.Name)</span>
                        <div class="flex min-w-0 flex-col">
                            <span class="truncate font-semibold text-(--blux-text-highlighted)" data-slot="person-name">@person.Name</span>
                            @if (!string.IsNullOrEmpty(person.Description))
                            {
                                <span class="truncate text-xs text-(--blux-text-muted)">@person.Description</span>
                            }
