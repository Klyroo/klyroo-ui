    private RenderFragment RenderMeter()
    {
        var max = MeterMax > 0 ? MeterMax : (MeterParts is { Count: > 0 } ? Math.Max(1, MeterParts.Sum(p => p.Value)) : 100);
        var val = Math.Clamp(MeterValue, 0, max);
        var pct = Math.Clamp(val / max * 100.0, 0, 100);
        var effectiveTone = ErrorThreshold is { } err && pct >= err ? "bg-(--blux-error)"
            : WarningThreshold is { } warn && pct >= warn ? "bg-(--blux-warning)"
            : "bg-(--blux-primary)";

        return @<div class="flex flex-col gap-2" data-slot="display-meter" data-tone="@(ErrorThreshold is { } e && pct >= e ? "error" : WarningThreshold is { } w && pct >= w ? "warning" : "primary")">
            @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Value))
            {
                <div class="flex items-baseline justify-between gap-2">
                    <span class="text-xs font-medium text-(--blux-text-muted)" data-slot="meter-label">@Title</span>
                    <span class="text-xs font-semibold tabular-nums text-(--blux-text-highlighted)" data-slot="meter-value">@(Value ?? $"{val:0.##} / {max:0.##}")</span>
                </div>
            }
            @if (string.Equals(Variant, "scale", StringComparison.OrdinalIgnoreCase) && MeterLevels is { Count: > 0 })
            {
                <div class="grid gap-1.5" style="@($"grid-template-columns:repeat({MeterLevels.Count},minmax(0,1fr))")" data-slot="meter-scale">
                    @for (var i = 0; i < MeterLevels.Count; i++)
                    {
                        var reached = CurrentLevel is { } cur && i <= cur;
                        <div class="rounded-(--blux-radius) border px-2 py-1 text-center text-xs font-medium @(reached ? "border-(--blux-primary-text) bg-(--blux-bg-muted) text-(--blux-text-highlighted)" : "border-(--blux-border) text-(--blux-text-muted)")"
                             data-slot="meter-level" data-active="@(CurrentLevel == i ? "true" : null)">
                            @MeterLevels[i]
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex h-2.5 w-full overflow-hidden rounded-full bg-(--blux-bg-muted)"
                     role="meter" aria-label="@(Title ?? "Meter")"
                     aria-valuenow="@val.ToString("0.##", CultureInfo.InvariantCulture)"
                     aria-valuemin="0"
                     aria-valuemax="@max.ToString("0.##", CultureInfo.InvariantCulture)"
                     data-slot="meter-track">
                    @if (MeterParts is { Count: > 0 })
                    {
                        @foreach (var part in MeterParts)
                        {
                            var partPct = Math.Clamp(part.Value / max * 100.0, 0, 100).ToString("0.##", CultureInfo.InvariantCulture);
                            <div class="h-full bg-(--blux-primary) first:rounded-s-full last:rounded-e-full" style="@($"width:{partPct}%")" title="@($"{part.Label}: {part.Value}")" data-slot="meter-part"></div>
                        }
                    }
                    else
                    {
                        <div class="h-full rounded-full @effectiveTone" style="@($"width:{pct.ToString("0.##", CultureInfo.InvariantCulture)}%")" data-slot="meter-bar"></div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(Description))
            {
                <span class="text-xs text-(--blux-text-muted)" data-slot="meter-caption">@Description</span>
            }
        </div>;
    }

    private RenderFragment RenderChart() =>
        @<div class="flex flex-col gap-2.5" data-slot="display-chart">
            @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Unit))
            {
                <div class="flex items-baseline justify-between gap-2">
                    <span class="font-semibold text-(--blux-text-highlighted)" data-slot="chart-title">@Title</span>
                    @if (!string.IsNullOrEmpty(Unit))
                    {
                        <span class="text-xs text-(--blux-text-muted)">@Unit</span>
                    }
                </div>
            }
            @if (ChartData is not { Count: > 0 })
            {
                <p class="m-0 text-xs text-(--blux-text-muted)" data-slot="chart-empty">No data</p>
            }
            else if (string.Equals(Variant, "funnel", StringComparison.OrdinalIgnoreCase))
            {
                var first = Math.Max(1.0, ChartData[0].Value);
                <div class="flex flex-col gap-2" data-slot="chart-funnel">
                    @for (var i = 0; i < ChartData.Count; i++)
                    {
                        var pt = ChartData[i];
                        var widthPct = Math.Clamp(pt.Value / first * 100.0, 4, 100).ToString("0.#", CultureInfo.InvariantCulture);
                        var rate = i > 0 && ChartData[i - 1].Value > 0 ? $"{Math.Round(pt.Value / ChartData[i - 1].Value * 100)}%" : null;
                        <div class="flex flex-col gap-1" data-slot="funnel-step">
                            <div class="flex items-baseline justify-between gap-2 text-xs">
                                <span class="font-medium text-(--blux-text)">@pt.Label</span>
                                <span class="tabular-nums text-(--blux-text-muted)">@pt.Value @(rate is not null ? $"({rate})" : "")</span>
                            </div>
                            <div class="h-2 rounded-full bg-(--blux-primary)" style="@($"width:{widthPct}%")"></div>
                        </div>
                    }
                </div>
            }
            else
            {
                var max = Math.Max(1.0, ChartData.Max(d => d.Value));
                <div class="flex h-24 items-end gap-2 pt-4" data-slot="chart-bars">
                    @foreach (var pt in ChartData)
                    {
                        var hPct = Math.Clamp(pt.Value / max * 100.0, 6, 100).ToString("0.#", CultureInfo.InvariantCulture);
                        <div class="flex flex-1 flex-col items-center gap-1" title="@($"{pt.Label}: {pt.Value}")" data-slot="chart-bar">
                            <div class="w-full rounded-t-sm bg-(--blux-primary)" style="@($"height:{hPct}%")"></div>
                            <span class="max-w-full truncate text-[11px] text-(--blux-text-muted)">@pt.Label</span>
                        </div>
                    }
                </div>
            }
        </div>;

    private RenderFragment RenderTable()
    {
        var cols = TableColumns ?? [];
        var (visibleRows, remaining) = ApplyReveal(TableRows);
        return @<div class="flex flex-col gap-2" data-slot="display-table">
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="border-b border-(--blux-border) text-xs font-semibold text-(--blux-text-muted)">
                        <tr>
                            @foreach (var col in cols)
                            {
                                <th scope="col" class="px-3 py-2 @(col.Numeric || col.Align == DataListAlign.End ? "text-end" : "text-start")">@col.Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-(--blux-border)">
                        @foreach (var row in visibleRows)
                        {
                            <tr data-slot="display-table-row">
                                @foreach (var col in cols)
                                {
                                    row.TryGetValue(col.Key, out var val);
                                    <td class="px-3 py-2 @(col.Numeric || col.Align == DataListAlign.End ? "text-end tabular-nums" : "text-start") @(col.Mono ? "font-mono" : "")">@(val ?? "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    @if (TableFooter is { Count: > 0 })
                    {
                        <tfoot class="border-t border-(--blux-border-accented) font-semibold text-(--blux-text-highlighted)">
                            <tr>
                                @foreach (var col in cols)
                                {
                                    TableFooter.TryGetValue(col.Key, out var fVal);
                                    <td class="px-3 py-2 @(col.Numeric || col.Align == DataListAlign.End ? "text-end tabular-nums" : "text-start")">@fVal</td>
                                }
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
            @if (remaining > 0 && TableRows is not null)
            {
                @RenderRevealButton(remaining, TableRows.Count)
            }
        </div>;
    }

    private RenderFragment RenderDiff()
    {
        var items = (DiffItems ?? []).Where(d => ShowUnchanged || d.Changed).ToList();
        return @<div class="flex flex-col gap-2" data-slot="display-diff">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="m-0 font-semibold text-(--blux-text-highlighted)">@Title</p>
            }
            <div class="divide-y divide-(--blux-border)">
                @foreach (var item in items)
                {
                    <div class="flex flex-wrap items-center justify-between gap-2 py-2 first:pt-0 last:pb-0" data-slot="diff-item" data-changed="@(item.Changed ? "true" : "false")">
                        <span class="text-xs font-medium text-(--blux-text-muted)">@item.Label</span>
                        <div class="flex items-center gap-2 text-xs">
                            @if (item.Changed)
                            {
                                @if (!string.IsNullOrEmpty(item.Before))
                                {
                                    <span class="line-through text-(--blux-error-text)" data-slot="diff-before">@item.Before</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Before) && !string.IsNullOrEmpty(item.After))
                                {
                                    <span class="text-(--blux-text-muted)" aria-hidden="true">→</span>
                                }
                                <span class="font-semibold text-(--blux-success-text)" data-slot="diff-after">@(item.After ?? "—")</span>
                            }
                            else
                            {
                                <span class="text-(--blux-text-muted)" data-slot="diff-unchanged">@(item.After ?? item.Before ?? "—")</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>;
    }

