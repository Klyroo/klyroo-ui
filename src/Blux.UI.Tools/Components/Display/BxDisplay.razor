                            }
                            else
                            {
                                <span class="truncate font-medium text-(--blux-text-highlighted)" data-slot="record-title">@rec.Title</span>
                            }
                            @if (!string.IsNullOrEmpty(rec.Meta) || !string.IsNullOrEmpty(rec.Description))
                            {
                                <span class="truncate text-xs text-(--blux-text-muted)">@(rec.Meta ?? rec.Description)</span>
                            }
