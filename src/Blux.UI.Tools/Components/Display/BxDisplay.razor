                        {
                            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-(--blux-radius) bg-(--blux-bg-muted) text-xs font-semibold text-(--blux-text-highlighted)">
                                @if (!string.IsNullOrEmpty(rec.Icon))
                                {
                                    @RenderIcon(rec.Icon, "size-4")
                                }
                                else
