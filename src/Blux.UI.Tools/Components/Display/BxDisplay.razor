                @if (Contacts is { Count: > 0 })
                {
                    <div class="flex flex-col gap-1.5 border-t border-(--blux-border) pt-2" data-slot="person-contacts">
                        @foreach (var c in Contacts)
                        {
                            <div class="flex items-center justify-between gap-2 text-xs">
                                <span class="truncate text-(--blux-text)">@c.Value</span>
                                @if (c.Copy)
                                {
                                    <button type="button" class="inline-flex size-6 items-center justify-center rounded-(--blux-radius) text-(--blux-text-muted) hover:bg-(--blux-bg-muted)"
                                            aria-label="@($"Copy {c.Value}")" @onclick="@(() => CopyToClipboardAsync(c.Value))">
                                        @RenderIcon("copy", "size-3.5")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>;

    private static string InitialsOf(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private RenderFragment RenderList()
    {
        var (visible, remaining) = ApplyReveal(ListItems);
        var isFiles = string.Equals(Variant, "files", StringComparison.OrdinalIgnoreCase);
        var isSteps = string.Equals(Variant, "steps", StringComparison.OrdinalIgnoreCase);
        var isChecks = string.Equals(Variant, "checks", StringComparison.OrdinalIgnoreCase);
        return @<div class="flex flex-col gap-2" data-slot="display-list">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="m-0 font-semibold text-(--blux-text-highlighted)">@Title</p>
            }
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
                @for (var i = 0; i < visible.Count; i++)
                {
                    var idx = i;
                    var item = visible[i];
                    var state = item.Done ? "done" : item.Current ? "current" : "todo";
                    <li class="flex items-center justify-between gap-3" data-slot="list-item" data-state="@(isSteps ? state : null)">
                        <div class="flex min-w-0 items-center gap-2.5">
                            @if (isFiles)
                            {
                                var ext = FilePreviewService.ExtensionLabel(item.FileName ?? item.Text, item.MimeType);
                                <span class="inline-flex h-6 min-w-8 shrink-0 items-center justify-center rounded-(--blux-radius) bg-(--blux-bg-muted) px-1.5 text-[10px] font-bold uppercase text-(--blux-text-highlighted)"
                                      data-slot="file-badge">@ext</span>
                            }
                            else if (isChecks || isSteps)
                            {
                                <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full @(item.Done ? "bg-(--blux-success)/15 text-(--blux-success-text)" : item.Current ? "bg-(--blux-primary) text-white" : "bg-(--blux-bg-muted) text-(--blux-text-muted)") text-xs font-semibold">
                                    @if (item.Done)
                                    {
                                        @RenderIcon("check", "size-3")
                                    }
                                    else
                                    {
                                        @(idx + 1)
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-(--blux-text-muted)"></span>
                            }
                            <div class="flex min-w-0 flex-col">
                                @if (!string.IsNullOrEmpty(item.Href))
                                {
                                    <a href="@item.Href" class="truncate font-medium text-(--blux-text-highlighted) hover:underline"
                                       @onclick="@(e => OnFileItemClick(e, item, idx))" @onclick:preventDefault="@CanPreviewFiles()">@item.Text</a>
                                }
                                else
                                {
                                    <span class="truncate text-(--blux-text)">@item.Text</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Description) || item.FileSize is not null)
                                {
                                    <span class="text-xs text-(--blux-text-muted)">
                                        @(item.FileSize is { } sz ? FilePreviewService.FormatFileSize(sz, FormatCulture) : item.Description)
                                    </span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Meta))
                        {
                            <span class="shrink-0 text-xs text-(--blux-text-muted)">@item.Meta</span>
                        }
                    </li>
                }
            </ul>
            @if (remaining > 0 && ListItems is not null)
            {
                @RenderRevealButton(remaining, ListItems.Count)
            }
        </div>;
    }

    private bool CanPreviewFiles() =>
        RendererInfo.IsInteractive && string.Equals(Variant, "files", StringComparison.OrdinalIgnoreCase)
        && Services.GetService(typeof(FilePreviewService)) is FilePreviewService { IsMounted: true };

    private void OnFileItemClick(MouseEventArgs _, DisplayListItem clicked, int index)
    {
        if (!CanPreviewFiles() || ListItems is null) return;
        if (Services.GetService(typeof(FilePreviewService)) is not FilePreviewService preview) return;
        var files = ListItems
            .Where(x => !string.IsNullOrEmpty(x.Href))
            .Select(x => new FilePreviewFile
            {
                Src = x.Href!,
                Name = x.FileName ?? x.Text,
                Mime = x.MimeType,
                Size = x.FileSize,
            })
            .ToList();
        preview.OpenGallery(files, new FilePreviewOptions { Index = Math.Clamp(index, 0, Math.Max(0, files.Count - 1)) });
    }

    private RenderFragment RenderTimeline()
    {
        var (visible, remaining) = ApplyReveal(TimelineItems);
        var isPipeline = string.Equals(Variant, "pipeline", StringComparison.OrdinalIgnoreCase);
        return @<div class="flex flex-col gap-2" data-slot="display-timeline">
            <ol class="m-0 flex list-none @(isPipeline ? "flex-row flex-wrap items-center gap-4" : "flex-col gap-3") p-0">
                @for (var i = 0; i < visible.Count; i++)
                {
                    var item = visible[i];
                    var state = item.State ?? DisplayTimelineState.Done;
                    <li class="flex items-start gap-3" aria-current="@(state == DisplayTimelineState.Current ? "step" : null)" data-slot="timeline-item" data-state="@state.ToString().ToLowerInvariant()">
                        <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full @(state == DisplayTimelineState.Done ? "bg-(--blux-primary) text-white" : state == DisplayTimelineState.Current ? "border-2 border-(--blux-primary-text) text-(--blux-primary-text)" : "border border-(--blux-border) text-(--blux-text-muted)") text-[11px] font-semibold">
                            @(i + 1)
                        </span>
                        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                            <div class="flex items-baseline justify-between gap-2">
                                <span class="font-medium text-(--blux-text-highlighted)" data-slot="timeline-title">@item.Title</span>
                                @if (!string.IsNullOrEmpty(item.Time))
                                {
                                    <span class="text-xs text-(--blux-text-muted)" data-slot="timeline-time">@item.Time</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="m-0 text-xs text-(--blux-text-muted)">@item.Description</p>
                            }
                            @if (!string.IsNullOrEmpty(item.ActorName))
                            {
                                <span class="text-xs font-medium text-(--blux-text-muted)">@item.ActorName</span>
                            }
                        </div>
                    </li>
                }
            </ol>
            @if (remaining > 0 && TimelineItems is not null)
            {
                @RenderRevealButton(remaining, TimelineItems.Count)
            }
        </div>;
    }

    private RenderFragment RenderDate()
    {
        var date = DateValue ?? DateTimeOffset.UtcNow;
        var now = Now ?? DateTimeOffset.UtcNow;
        var days = (int)Math.Round((date.Date - now.Date).TotalDays);
        return @<div class="flex items-center gap-3" data-slot="display-date">
            <div class="flex size-12 shrink-0 flex-col items-center justify-center rounded-(--blux-radius) border border-(--blux-border) bg-(--blux-bg-muted) text-center" data-slot="date-tile">
                <span class="text-[10px] font-bold uppercase text-(--blux-primary-text)">@date.ToString("MMM", FormatCulture)</span>
                <span class="text-base font-bold leading-none tabular-nums text-(--blux-text-highlighted)">@date.Day</span>
            </div>
            <div class="flex min-w-0 flex-col gap-0.5">
                <span class="font-semibold text-(--blux-text-highlighted)" data-slot="date-title">
                    @if (string.Equals(Variant, "countdown", StringComparison.OrdinalIgnoreCase))
                    {
                        @(days == 0 ? "Today" : days == 1 ? "Tomorrow" : days > 1 ? $"In {days} days" : $"{Math.Abs(days)} days overdue")
                    }
                    else if (string.Equals(Variant, "range", StringComparison.OrdinalIgnoreCase) && EndDateValue is { } end)
                    {
                        var spanDays = Math.Max(1, (int)Math.Round((end.Date - date.Date).TotalDays) + 1);
                        @($"{date.ToString("yyyy-MM-dd", FormatCulture)} → {end.ToString("yyyy-MM-dd", FormatCulture)} ({spanDays} days)")
                    }
                    else
                    {
                        @(Title ?? date.ToString("D", FormatCulture))
                    }
                </span>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <span class="text-xs text-(--blux-text-muted)">@Description</span>
                }
            </div>
        </div>;
    }

    private RenderFragment RenderMedia() =>
        @<div class="flex flex-col gap-2" data-slot="display-media">
            @if (string.Equals(Variant, "gallery", StringComparison.OrdinalIgnoreCase) && Images is { Count: > 0 })
            {
                var max = Math.Max(1, Max ?? 3);
                var shown = Images.Take(max).ToList();
                var hiddenCount = Images.Count - shown.Count;
                <div class="grid grid-cols-3 gap-2" data-slot="media-gallery">
                    @for (var i = 0; i < shown.Count; i++)
                    {
                        var isLastWithOverflow = i == shown.Count - 1 && hiddenCount > 0;
                        <div class="relative overflow-hidden rounded-(--blux-radius) border border-(--blux-border)" data-slot="media-tile">
                            <img src="@shown[i]" alt="@(Title ?? $"Image {i + 1}")" loading="lazy" class="h-24 w-full object-cover" />
                            @if (isLastWithOverflow)
                            {
                                <span class="absolute inset-0 flex items-center justify-center bg-black/60 text-sm font-bold text-white" data-slot="media-overflow">+@hiddenCount</span>
                            }
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(Src))
            {
                <img src="@Src" alt="@(Title ?? "Media")" loading="lazy" class="max-h-64 w-full rounded-(--blux-radius) object-cover" data-slot="media-image" />
            }
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="m-0 text-xs text-(--blux-text-muted)" data-slot="media-caption">@Description</p>
            }
        </div>;

    private RenderFragment RenderCode()
    {
        var raw = Value ?? "";
        var isSecret = string.Equals(Variant, "secret", StringComparison.OrdinalIgnoreCase);
        var shown = isSecret && !_secretRevealed ? MaskSecret(raw, VisibleChars) : raw;
        return @<div class="flex flex-col gap-2" data-slot="display-code" data-variant="@(Variant ?? "block")">
            <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold uppercase text-(--blux-text-muted)" data-slot="code-label">@(Title ?? Language ?? (isSecret ? "Secret" : "Code"))</span>
                <div class="flex items-center gap-1">
                    @if (isSecret)
                    {
                        <button type="button" class="inline-flex items-center gap-1 rounded-(--blux-radius) px-2 py-1 text-xs font-medium text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                                aria-pressed="@(_secretRevealed ? "true" : "false")" data-slot="code-secret-toggle"
                                @onclick="@(() => _secretRevealed = !_secretRevealed)">
                            @RenderIcon(_secretRevealed ? "eye-off" : "eye", "size-3.5")
                            <span>@(_secretRevealed ? "Conceal" : "Reveal")</span>
                        </button>
                    }
                    @if (Copy)
                    {
                        <button type="button" class="inline-flex items-center gap-1 rounded-(--blux-radius) px-2 py-1 text-xs font-medium text-(--blux-text-muted) hover:bg-(--blux-bg-muted) hover:text-(--blux-text)"
                                aria-label="Copy code" data-slot="code-copy"
                                @onclick="@(() => CopyToClipboardAsync(raw))">
                            @RenderIcon("copy", "size-3.5")
                        </button>
                    }
                </div>
            </div>
            <pre class="m-0 overflow-x-auto rounded-(--blux-radius) bg-(--blux-bg-muted) p-3 font-mono text-xs text-(--blux-text-highlighted)" data-slot="code-value"><code>@shown</code></pre>
        </div>;
    }

    private static string MaskSecret(string raw, int visible)
    {
        if (string.IsNullOrEmpty(raw)) return "••••••••";
        if (visible <= 0 || raw.Length <= visible) return new string('•', Math.Max(8, raw.Length));
        return new string('•', 8) + raw[^visible..];
    }

    private RenderFragment RenderEmpty() =>
        @<div class="flex flex-col items-center justify-center gap-2 rounded-(--blux-radius) border border-dashed border-(--blux-border-accented) p-6 text-center" data-slot="display-empty">
            @RenderIcon(!string.IsNullOrEmpty(Icon) ? Icon : "inbox", "size-8 text-(--blux-text-muted)")
            <p class="m-0 font-semibold text-(--blux-text-highlighted)" data-slot="empty-title">@(Title ?? "Nothing to show")</p>
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="m-0 text-xs text-(--blux-text-muted)" data-slot="empty-description">@Description</p>
            }
            @if (Actions is { Count: > 0 })
            {
                <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
                    @foreach (var act in Actions)
                    {
                        @RenderAction(act)
                    }
                </div>
            }
        </div>;

    private RenderFragment RenderAccordion() =>
        @<div class="flex flex-col divide-y divide-(--blux-border) rounded-(--blux-radius) border border-(--blux-border)" data-slot="display-accordion">
            @if (AccordionItems is { Count: > 0 })
            {
                @for (var i = 0; i < AccordionItems.Count; i++)
                {
                    var idx = i;
                    var item = AccordionItems[i];
                    var open = _openAccordionIndices.Contains(idx);
                    <div class="flex flex-col" data-slot="accordion-item" data-open="@(open ? "true" : "false")">
                        <button type="button" class="flex min-h-10 w-full items-center justify-between gap-2 px-3.5 py-2 text-start font-medium text-(--blux-text-highlighted) hover:bg-(--blux-bg-muted)"
                                aria-expanded="@(open ? "true" : "false")" data-slot="accordion-trigger"
                                @onclick="@(() => ToggleAccordion(idx))">
                            <span class="flex items-center gap-2">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    @RenderIcon(item.Icon, "size-4 text-(--blux-text-muted)")
                                }
                                <span>@item.Label</span>
                            </span>
                            @RenderIcon(open ? "chevron-up" : "chevron-down", "size-4 text-(--blux-text-muted)")
                        </button>
                        @if (open)
                        {
                            <div class="px-3.5 pb-3 pt-1 text-xs text-(--blux-text-muted)" role="region" data-slot="accordion-content">
                                @if (item.Template is not null)
                                {
                                    @item.Template
                                }
                                else
                                {
                                    @item.Content
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>;

    private void ToggleAccordion(int index)
    {
        if (_openAccordionIndices.Contains(index))
        {
            _openAccordionIndices.Remove(index);
        }
        else
        {
            if (!Multiple) _openAccordionIndices.Clear();
            _openAccordionIndices.Add(index);
        }
    }

    private RenderFragment RenderAction(DisplayAction act) =>
        @<BxButton Label="@act.Label" Href="@act.Href" Color="@act.Color" Variant="@act.Variant" Size="BxSize.Sm"
                   LeadingIcon="@(string.IsNullOrEmpty(act.Icon) ? null : RenderIcon(act.Icon, "size-4"))"
                   OnClick="@(() => act.OnClick.InvokeAsync())" data-slot="display-action" />;
}
