            {
                <div class="flex items-baseline justify-between gap-2 border-t border-(--blux-border-accented) pt-2 font-semibold text-(--blux-text-highlighted)" data-slot="breakdown-total">
                    <span>@total.Label</span>
                    <span class="tabular-nums">@total.Value</span>
