<Project>
  <!--
    Blux.UI.Tools has no precompiled stylesheet: a second sheet loaded after blux.css would repeat base utilities in its own @layer utilities and
    override the responsive and dark variants of Blux.UI. It needs Tailwind compiled by the app.

    With <BluxTailwind>true</BluxTailwind> nothing else is needed: this file copies the classes the Tools components use (one @source inline(...))
    to obj/blux/blux-tools.theme.css and sets BluxToolsPresent, and the generated Tailwind entry of Blux.UI imports that theme.

    With the app's own Tailwind (Node or another pipeline), import the theme after the Blux one and say so with BluxToolsOwnTailwind=true in the project
    that references this package (BLUXTOOLS001 warns there, and in a project with Node Tailwind; a project that merely reaches the package through another one is left alone):

      @import "tailwindcss";
      @import "../obj/blux/blux.theme.css";
      @import "../obj/blux/blux-tools.theme.css";
  -->
  <PropertyGroup>
    <BluxToolsPresent>true</BluxToolsPresent>
  </PropertyGroup>

  <Target Name="BluxToolsCopyTailwindTheme" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../staticwebassets/blux-tools.theme.css"
          DestinationFolder="$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), blux))"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    The check is for the projects that need the classes of the Tools components: the ones with a PackageReference to Blux.UI.Tools, where the pages
    that use the components are, and the ones that compile Tailwind with Node (a package.json with a "tailwindcss" or "@tailwindcss/..." dependency
    key: a plugin such as prettier-plugin-tailwindcss does not count), whatever they reference. A host that only reaches the package through the
    project that references it has no components of its own and compiles no Tailwind: it has nothing to say there, so it needs no property.
    Not caught: a host that compiles Tailwind another way (not Node, not BluxTailwind) and only reaches the package through another project.
  -->
  <Target Name="BluxToolsCheckTailwind" BeforeTargets="BeforeBuild" Condition="'$(BluxTailwind)' != 'true' And '$(BluxToolsOwnTailwind)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BluxToolsReferenced Condition="'@(PackageReference->WithMetadataValue('Identity', 'Blux.UI.Tools'))' != ''">true</_BluxToolsReferenced>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/package.json')">
      <_BluxToolsNodeTailwind Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/package.json')), '&quot;(tailwindcss|@tailwindcss/[^&quot;]+)&quot;\s*:'))">true</_BluxToolsNodeTailwind>
    </PropertyGroup>
    <Warning Condition="'$(_BluxToolsReferenced)' == 'true' Or '$(_BluxToolsNodeTailwind)' == 'true'"
             Code="BLUXTOOLS001"
             Text="$(MSBuildProjectName) uses Blux.UI.Tools, which has no precompiled stylesheet and needs Tailwind compiled by the app. Set &lt;BluxTailwind&gt;true&lt;/BluxTailwind&gt; (Node-free build, nothing else to do), or, if the app compiles Tailwind itself, import obj/blux/blux-tools.theme.css after obj/blux/blux.theme.css in your stylesheet and set &lt;BluxToolsOwnTailwind&gt;true&lt;/BluxToolsOwnTailwind&gt; to silence this warning." />
  </Target>
</Project>
