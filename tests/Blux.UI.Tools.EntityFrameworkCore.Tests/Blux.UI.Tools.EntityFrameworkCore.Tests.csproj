<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Proves the Entity Framework Core adapter against EF Core and SQLite in memory: the async executor is the one that runs, and a list with a Queryable source answers like
       one with Items. A project of its own so EF Core and the native SQLite library stay out of the other unit tests. net10.0 only: it pairs with EF Core 10. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blux.UI.Tools.EntityFrameworkCore\Blux.UI.Tools.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Blux.UI.Tools\Blux.UI.Tools.csproj" />
    <ProjectReference Include="..\..\src\Blux.UI.Tools.Query\Blux.UI.Tools.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
