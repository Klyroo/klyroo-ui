<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <!-- Built first so the fixture can start it without rebuilding. -->
  <ItemGroup>
    <ProjectReference Include="..\..\playground\Blux.Playground\Blux.Playground\Blux.Playground.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The live demos of the templates are run by the docs host from their build output: built first, never referenced by it or by the tests. -->
  <ItemGroup>
    <ProjectReference Include="..\..\templates\starter\src\Starter.Web\Starter.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\dashboard\src\Dashboard.Web\Dashboard.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\landing\src\Landing.Web\Landing.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\docs\src\Docs.Web\Docs.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\saas\src\SaaS.Web\SaaS.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\portfolio\src\Portfolio.Web\Portfolio.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\changelog\src\Changelog.Web\Changelog.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\chat\src\Chat.Web\Chat.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\templates\editor\src\Editor.Web\Editor.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The canned chat replies, so chat tests compare with the whole answer instead of guessing a length. -->
  <ItemGroup>
    <Compile Include="..\..\playground\Blux.Playground\Blux.Playground.Client\Examples\ChatDemo.cs" Link="ChatDemo.cs" />
    <!-- The list of templates of the gallery, for the screenshot generator. -->
    <Compile Include="..\..\playground\Blux.Playground\Blux.Playground.Client\Templates\TemplateRegistry.cs" Link="TemplateRegistry.cs" />
  </ItemGroup>

  <!-- One browser page per test class at a time: by default xUnit uses one thread per core, and that many pages
       booting WebAssembly at once time out (Firefox first). -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
