@using Microsoft.AspNetCore.Components.Web
@using Blux.UI.Tools.Query

@* A list with @bind-State and a provider that counts its calls: the parent feeds the reported state back. *@
<button type="button" data-testid="reset" @onclick="Reset">reset</button>
<button type="button" data-testid="page3" @onclick="Page3">page 3</button>
<span data-testid="bound-page">@_state?.Page</span>
<BxDataList TItem="Person" Schema="DataListControllerTests.Schema" Provider="Load" @bind-State="_state" UrlSync="UrlSync" Label="People">
    <BxDataListResultCount data-testid="count" />
    <BxDataListTable>
        <BxDataListColumn Field="name" />
        <BxDataListColumn Field="age" />
    </BxDataListTable>
    <BxDataListPagination />
</BxDataList>

@code {
    private DataListState? _state;
    private readonly DataListProvider<Person> _inner = DataListControllerTests.Schema.InMemoryProvider(DataListControllerTests.People);

    [Parameter] public bool UrlSync { get; set; }
    [Parameter] public DataListState? Initial { get; set; }

    public int Calls { get; private set; }

    protected override void OnInitialized() => _state = Initial;

    private ValueTask<DataListResult<Person>> Load(DataListRequest request, CancellationToken cancellationToken)
    {
        Calls++;
        return _inner(request, cancellationToken);
    }

    private void Reset() => _state = DataListControllerTests.Schema.DefaultState;

    private void Page3() => _state = DataListControllerTests.Schema.DefaultState with { Page = 3 };
}
