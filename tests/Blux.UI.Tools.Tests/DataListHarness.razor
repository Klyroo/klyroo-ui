@using Blux.UI.Tools.Query

@* A list with explicit columns, the way an app writes it. The tests set the source, the URL options and the state. *@
<BxDataList TItem="Person" Schema="Schema" Items="Items" Provider="Provider" UrlKey="@UrlKey" UrlSync="UrlSync" State="State" StateChanged="StateChanged"
            Density="Density" data-testid="list">
    <div data-testid="toolbar" class="flex">
        <BxDataListResultCount data-testid="count" />
        <BxDataListRefresh data-testid="refresh" />
    </div>
    <BxDataListErrorState data-testid="error" />
    <BxDataListTable Caption="People" data-testid="table" Empty="EmptyContent">
        <BxDataListColumn Field="name" />
        <BxDataListColumn Field="age" Align="DataListAlign.End" Format="N1" />
        <BxDataListColumn Key="city" Title="Town" Class="city-col">
            <Template Context="person"><strong>@person.City</strong></Template>
        </BxDataListColumn>
    </BxDataListTable>
    <BxDataListPagination data-testid="pagination" />
</BxDataList>

@code {
    [Parameter] public DataListSchema<Person>? Schema { get; set; } = DataListControllerTests.Schema;
    [Parameter] public IEnumerable<Person>? Items { get; set; }
    [Parameter] public DataListProvider<Person>? Provider { get; set; }
    [Parameter] public string? UrlKey { get; set; }
    [Parameter] public bool UrlSync { get; set; } = true;
    [Parameter] public DataListState? State { get; set; }
    [Parameter] public EventCallback<DataListState> StateChanged { get; set; }
    [Parameter] public DataListDensity Density { get; set; }
    [Parameter] public RenderFragment<DataListContext<Person>>? EmptyContent { get; set; }
}
