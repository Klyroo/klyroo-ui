@* Columns with a header template: a part that reads the list it sits in, and a header that is only an accessible name. *@
<BxDataList TItem="Person" Schema="DataListControllerTests.Schema" Items="Items">
    <BxDataListTable Caption="People">
        <BxDataListColumn Key="select" Sortable="false">
            <HeaderTemplate><DataListHeaderCount /></HeaderTemplate>
            <Template Context="person"><input type="checkbox" aria-label="@person.Name" /></Template>
        </BxDataListColumn>
        <BxDataListColumn Field="name" HeaderTemplate="NamedHeader" />
        <BxDataListColumn Field="age" />
    </BxDataListTable>
</BxDataList>

@code {
    [Parameter] public IEnumerable<Person>? Items { get; set; }

    private static readonly RenderFragment NamedHeader = b =>
    {
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", "sr-only");
        b.AddContent(2, "Full name");
        b.CloseElement();
    };
}
