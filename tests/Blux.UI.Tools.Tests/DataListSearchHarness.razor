@using Blux.UI.Tools.Query

@* A list with a schema that searches name and city, with the search part, a count, the table and the pagination. *@
<BxDataList TItem="Person" Schema="Schema" Items="Items" Provider="Provider" UrlKey="@UrlKey" UrlSync="UrlSync" Label="@Label" data-testid="list">
    <div data-testid="toolbar" class="flex">
        <BxDataListSearch TItem="Person" MinLength="MinLength" Debounce="Debounce" data-testid="search" />
        <BxDataListResultCount data-testid="count" />
    </div>
    <BxDataListTable Caption="People" data-testid="table">
        <BxDataListColumn Field="name" />
        <BxDataListColumn Field="city" />
    </BxDataListTable>
    <BxDataListPagination data-testid="pagination" />
</BxDataList>

@code {
    public static readonly DataListSchema<Person> Schema = DataListSchema.For<Person>(s => s
        .RowKey(p => p.Id)
        .Search(p => p.Name, p => p.City)
        .Field(p => p.Name, f => f.Sortable())
        .Field(p => p.City)
        .DefaultSort(p => p.Name)
        .DefaultPageSize(10));

    [Parameter] public IEnumerable<Person>? Items { get; set; }
    [Parameter] public DataListProvider<Person>? Provider { get; set; }
    [Parameter] public string? UrlKey { get; set; }
    [Parameter] public bool UrlSync { get; set; } = true;
    [Parameter] public string? Label { get; set; }
    [Parameter] public int MinLength { get; set; }
    [Parameter] public int? Debounce { get; set; }
}
