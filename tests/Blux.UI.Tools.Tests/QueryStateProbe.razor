@using Blux.UI.Tools
@using Microsoft.AspNetCore.Components.Web
@using Blux.UI.Tools.Query
@implements IDisposable
@inject QueryState Query

@* A component bound to the query keys "q" and "p": renders again when the URL changes, and writes from buttons. *@
@{ Renders++; }
<span data-testid="q">@_q.Value</span>
<span data-testid="page">@_page.Value</span>
<button data-testid="replace" @onclick="() => _q.Set(Next(), QueryHistory.Replace)">replace</button>
<button data-testid="push" @onclick="() => _q.Set(Next(), QueryHistory.Push)">push</button>
<button data-testid="both" @onclick="Both">both</button>

@code {
    private QueryValue<string> _q = default!;
    private QueryValue<int> _page = default!;
    private int _counter;

    public int Renders { get; private set; }

    private string Next() => "v" + (++_counter);

    protected override void OnInitialized()
    {
        Query.UseRenderer(RendererInfo);
        _q = Query.Bind("q", QueryCodecs.String, "");
        _page = Query.Bind("p", QueryCodecs.Int32, 1);
        _q.Changed += OnChanged;
        _page.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Both()
    {
        _q.Set("both", QueryHistory.Replace);
        _page.Set(3, QueryHistory.Push);
    }

    public void Dispose()
    {
        _q.Dispose();
        _page.Dispose();
    }
}
