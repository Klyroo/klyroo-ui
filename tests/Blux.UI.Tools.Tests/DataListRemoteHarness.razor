@using Blux.UI.Tools.Query

@* A ticket list with a provider, the filter tags and the table; it persists its prerendered result (and the labels of remote options) under the key "f". *@
<BxDataList TItem="Ticket" Schema="Schema" Items="@(Provider is null ? FilterData.All : null)" Provider="Provider" UrlSync="false" State="State" UrlKey="f" ResultJson="TicketJson.Default.DataListResultTicket">
    <BxDataListFilterTags TItem="Ticket" data-testid="tags" />
    <BxDataListTable TItem="Ticket" Caption="Tickets">
        <BxDataListColumn TItem="Ticket" Field="title" Title="Title" />
    </BxDataListTable>
</BxDataList>

@code {
    [Parameter] public DataListSchema<Ticket> Schema { get; set; } = FilterData.Schema;
    [Parameter] public DataListProvider<Ticket>? Provider { get; set; }
    [Parameter] public DataListState? State { get; set; }
}
