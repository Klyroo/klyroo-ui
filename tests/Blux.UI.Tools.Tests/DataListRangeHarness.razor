@using Blux.UI.Tools.Query

@* A list of orders with number and date filters: the tags (optionally the add and clear buttons), a count and the table. *@
<BxDataList TItem="Order" Schema="Schema" Items="Items" UrlKey="@UrlKey" UrlSync="UrlSync" State="State" StateChanged="StateChanged" Label="Orders" data-testid="list">
    <BxDataListFilterTags TItem="Order" ShowAdd="ShowAdd" ShowClear="ShowClear" ApplyMode="ApplyMode" data-testid="tags" />
    <BxDataListResultCount TItem="Order" data-testid="count" />
    <BxDataListTable TItem="Order" Caption="Orders" data-testid="table">
        <BxDataListColumn TItem="Order" Field="id" Title="No." />
        <BxDataListColumn TItem="Order" Field="name" />
        <BxDataListColumn TItem="Order" Field="amount" />
        <BxDataListColumn TItem="Order" Field="day" />
    </BxDataListTable>
    <BxDataListPagination TItem="Order" data-testid="pagination" />
</BxDataList>

@code {
    [Parameter] public DataListSchema<Order> Schema { get; set; } = RangeData.Schema;
    [Parameter] public IEnumerable<Order>? Items { get; set; } = RangeData.All;
    [Parameter] public string? UrlKey { get; set; }
    [Parameter] public bool UrlSync { get; set; } = true;
    [Parameter] public DataListState? State { get; set; }
    [Parameter] public EventCallback<DataListState> StateChanged { get; set; }
    [Parameter] public bool ShowAdd { get; set; }
    [Parameter] public bool ShowClear { get; set; }
    [Parameter] public DataListApplyMode ApplyMode { get; set; }
}
