@using Blux.UI.Tools.Query

@* A list of tickets with the filter panel (and optionally the tags beside it): a text filter, two option filters and a boolean one. *@
<BxDataList TItem="Ticket" Schema="Schema" Items="Items" UrlKey="@UrlKey" UrlSync="UrlSync" Label="Tickets" data-testid="list">
    <BxDataListFilterPanel TItem="Ticket" ApplyMode="ApplyMode" Description="@Description" CloseOnApply="CloseOnApply" data-testid="panel" />
    @if (ShowTags)
    {
        <BxDataListFilterTags TItem="Ticket" data-testid="tags" />
    }
    <BxDataListResultCount TItem="Ticket" data-testid="count" />
    <BxDataListTable TItem="Ticket" Caption="Tickets" data-testid="table">
        <BxDataListColumn TItem="Ticket" Field="title" Title="Title" />
        <BxDataListColumn TItem="Ticket" Field="status" />
    </BxDataListTable>
</BxDataList>

@code {
    [Parameter] public DataListSchema<Ticket> Schema { get; set; } = FilterData.Schema;
    [Parameter] public IEnumerable<Ticket>? Items { get; set; } = FilterData.All;
    [Parameter] public string? UrlKey { get; set; }
    [Parameter] public bool UrlSync { get; set; } = true;
    [Parameter] public bool ShowTags { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool CloseOnApply { get; set; }
    [Parameter] public DataListApplyMode ApplyMode { get; set; }
}
