@using Blux.UI.Tools.Query

@* A list with a schema that has a text, two option and a boolean filter, with the filter tags (optionally the add and clear buttons), a count and the table. *@
<BxDataList TItem="Ticket" Schema="Schema" Items="Items" UrlKey="@UrlKey" UrlSync="UrlSync" Label="@Label" data-testid="list">
    <BxDataListFilterTags TItem="Ticket" ShowAdd="ShowAdd" ShowClear="ShowClear" ApplyMode="ApplyMode" data-testid="tags" />
    <BxDataListResultCount TItem="Ticket" data-testid="count" />
    <BxDataListTable TItem="Ticket" Caption="Tickets" data-testid="table">
        <BxDataListColumn TItem="Ticket" Field="title" Title="Title" />
        <BxDataListColumn TItem="Ticket" Field="status" />
        <BxDataListColumn TItem="Ticket" Field="active" />
        <BxDataListColumn TItem="Ticket" Field="owner" />
    </BxDataListTable>
    <BxDataListPagination TItem="Ticket" data-testid="pagination" />
</BxDataList>

@code {
    [Parameter] public DataListSchema<Ticket> Schema { get; set; } = FilterData.Schema;
    [Parameter] public IEnumerable<Ticket>? Items { get; set; } = FilterData.All;
    [Parameter] public string? UrlKey { get; set; }
    [Parameter] public bool UrlSync { get; set; } = true;
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowAdd { get; set; }
    [Parameter] public bool ShowClear { get; set; }
    [Parameter] public DataListApplyMode ApplyMode { get; set; }
}
