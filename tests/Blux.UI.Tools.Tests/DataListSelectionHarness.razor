@using Blux.UI.Tools.Query

@* A list with a selection column and the bar of its actions, and a toolbar menu. The tests set the source, the scope, the keys and the actions. *@
<BxDataList TItem="Person" Schema="Schema" Items="Provider is null ? Items : null" Provider="Provider" UrlSync="false" State="State" StateChanged="StateChanged" Selectable="Selectable"
            SelectionScope="SelectionScope" SelectedKeys="SelectedKeys" SelectedKeysChanged="SelectedKeysChanged" data-testid="list">
    <div data-testid="toolbar" class="flex">
        <BxDataListResultCount data-testid="count" />
        <BxDataListActionsDropdown TItem="Person" Actions="ToolbarActions" OnError="OnError" />
    </div>
    <BxDataListTable Caption="People" data-testid="table">
        <BxDataListColumn Field="name" />
        <BxDataListColumn Field="age" Align="DataListAlign.End" />
    </BxDataListTable>
    @if (ShowBar)
    {
        <BxDataListSelectionActions TItem="Person" Actions="Actions" OnError="OnError" MaxVisible="MaxVisible" />
    }
    <BxDataListPagination data-testid="pagination" />
</BxDataList>

@code {
    [Parameter] public DataListSchema<Person>? Schema { get; set; } = DataListControllerTests.Schema;
    [Parameter] public IEnumerable<Person>? Items { get; set; } = DataListControllerTests.People;
    [Parameter] public DataListProvider<Person>? Provider { get; set; }
    [Parameter] public DataListState? State { get; set; }
    [Parameter] public EventCallback<DataListState> StateChanged { get; set; }
    [Parameter] public bool? Selectable { get; set; }
    [Parameter] public DataListSelectionScope SelectionScope { get; set; }
    [Parameter] public IReadOnlySet<string>? SelectedKeys { get; set; }
    [Parameter] public EventCallback<IReadOnlySet<string>> SelectedKeysChanged { get; set; }
    [Parameter] public bool ShowBar { get; set; } = true;
    [Parameter] public int MaxVisible { get; set; } = 3;
    [Parameter] public IReadOnlyList<DataListAction<Person>> Actions { get; set; } = [new() { Key = "delete", Label = "Delete", OnExecute = _ => Task.CompletedTask }];
    [Parameter] public IReadOnlyList<DataListAction<Person>> ToolbarActions { get; set; } = [];
    [Parameter] public EventCallback<DataListActionFailure<Person>> OnError { get; set; }
}
