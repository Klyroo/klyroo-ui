<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blux.UI\Blux.UI.csproj" />
    <ProjectReference Include="..\..\src\Blux.UI.Build.Tasks\Blux.UI.Build.Tasks.csproj" />
    <ProjectReference Include="..\..\build\Blux.UI.ClassExtractor\Blux.UI.ClassExtractor.csproj" />
  </ItemGroup>

  <!-- The pure parts of the docs host's supervisor of the template demos and the registry of the gallery: dependency free, compiled here as they are. -->
  <ItemGroup>
    <Compile Include="..\..\playground\Blux.Playground\Blux.Playground\Templates\TemplateLaunch.cs" Link="Templates\TemplateLaunch.cs" />
    <Compile Include="..\..\playground\Blux.Playground\Blux.Playground.Client\Templates\TemplateRegistry.cs" Link="Templates\TemplateRegistry.cs" />
    <Compile Include="..\..\playground\Blux.Playground\Blux.Playground.Client\Templates\TemplateSettings.cs" Link="Templates\TemplateSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fonts\Fixtures\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fonts\Fixtures" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
