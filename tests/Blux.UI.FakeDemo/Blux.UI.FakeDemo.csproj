<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A stand-in for a template demo, for the tests of the supervisor in the docs host: it serves a home page that writes its <base href>,
       and answers badly while a file named "unhealthy" sits next to its assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>FakeDemo</AssemblyName>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

</Project>
