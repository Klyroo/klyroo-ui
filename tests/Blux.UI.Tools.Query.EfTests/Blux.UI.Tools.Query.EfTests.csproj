<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proves that the IQueryable applier of Blux.UI.Tools.Query translates to SQL, against EF Core and SQLite in memory, and answers like the in-memory executor.
       A project of its own, not part of Blux.UI.Tools.Query.Tests: EF Core and the native SQLite library stay out of the unit tests (which run on net10.0 and net11.0
       without any database), and a failure here points at translation, not at the semantics. net10.0 only because it pairs with EF Core 10. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blux.UI.Tools.Query\Blux.UI.Tools.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
