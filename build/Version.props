<Project>
  <!-- The version of Lux.UI, in one place: imported by the library (src/Lux.UI) and by the dotnet tool (src/Lux.UI.Mcp),
       so they cannot drift. A release changes it here (an empty suffix is a stable release). -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
  </PropertyGroup>
</Project>
