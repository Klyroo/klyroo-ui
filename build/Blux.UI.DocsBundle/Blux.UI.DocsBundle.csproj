<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the docs bundle (docs-bundle.json) from the docs catalog and the library. Built and run by
       src/Blux.UI.Mcp.Core on every build whose inputs changed; it also writes the generated skill reference. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.BundleGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\playground\Blux.Playground\Blux.Playground.Client\Blux.Playground.Client.csproj" />
    <ProjectReference Include="..\..\src\Blux.UI.Mcp.Model\Blux.UI.Mcp.Model.csproj" />
  </ItemGroup>

</Project>
