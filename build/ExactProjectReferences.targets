<Project>
  <!--
    Version lockstep: the sister packages (Blux.UI.Tools today) are released with Blux.UI and only work with the same version of it.
    A ProjectReference is packed as a dependency with a minimum version ([1.2.3, )); this makes it exact ([1.2.3]) for every project
    reference of the project that imports this file. build/verify-package.mjs checks the nuspec.
  -->
  <Target Name="BluxExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>
</Project>
