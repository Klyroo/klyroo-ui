<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>$(KlyrooSampleTfm)-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);$(KlyrooSampleTfm)-ios;$(KlyrooSampleTfm)-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(KlyrooSampleTfm)-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Klyroo.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- Disable MAUI CSS handling so Blazor can handle it -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Klyroo on MAUI</ApplicationTitle>
    <ApplicationId>dev.klyroo.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>

    <!--
      Platform minimums. Klyroo needs the native popover API in the web view: iOS 17 and Mac Catalyst 17 (Safari 17), Android with a current
      System WebView (Chrome 114 or later; the app itself runs from Android 7.0, API 24).
    -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- -p:KlyrooTv=true forces the TV form factor (remote control navigation) on any Android device, to try TV mode without a TV. -->
  <PropertyGroup Condition="'$(KlyrooTv)' == 'true'">
    <DefineConstants>$(DefineConstants);KLYROO_TV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1d4ed8" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1d4ed8" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <_KlyrooLoggingVersion>10.0.0</_KlyrooLoggingVersion>
    <_KlyrooLoggingVersion Condition="'$(KlyrooSampleTfm)' == 'net11.0'">11.0.0</_KlyrooLoggingVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="$(_KlyrooLoggingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klyroo.Maui.Shared\Klyroo.Maui.Shared.csproj" />
  </ItemGroup>

  <!--
    The Klyroo build features. An app gets all of this from the Klyroo.UI package (buildTransitive); here Klyroo.UI is a project reference,
    so the task assembly is built first and the targets are imported by hand. The fonts are generated into obj/ and added to the static
    web assets at _klyroo/fonts/, which MAUI copies into the app as assets served from wwwroot (see index.html).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Klyroo.UI.Build.Tasks\Klyroo.UI.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <KlyrooBuildTasksAssembly>$(MSBuildThisFileDirectory)..\..\..\src\Klyroo.UI.Build.Tasks\bin\$(Configuration)\netstandard2.0\Klyroo.UI.Build.Tasks.dll</KlyrooBuildTasksAssembly>
  </PropertyGroup>
  <Import Project="..\..\..\src\Klyroo.UI\buildTransitive\Klyroo.UI.Tasks.targets" />
  <Import Project="..\..\..\src\Klyroo.UI\buildTransitive\Klyroo.UI.Fonts.targets" />
  <Import Project="..\..\..\src\Klyroo.UI\buildTransitive\Klyroo.UI.Icons.targets" />

  <ItemGroup>
    <KlyrooFont Include="Geist" Role="sans" Weights="400..700" Subsets="latin" />
    <!-- The icon scan also reads the pages of the shared project. -->
    <KlyrooIconScanDirectory Include="..\Klyroo.Maui.Shared" />
  </ItemGroup>

</Project>
