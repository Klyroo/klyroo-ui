@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

<h1 class="text-2xl font-semibold text-(--klyroo-text-highlighted)">Dashboard</h1>

@* The sizes of the panels and the collapsed state of the sidebar are remembered in localStorage in a web view (cookies on the web). *@
<div class="h-[28rem] w-full overflow-hidden rounded-xl border border-(--klyroo-border)" data-testid="dashboard">
    <KlyDashboardGroup StorageKey="maui-dashboard">
        <KlyDashboardSidebar As="div" Resizable>
            <Header><span class="font-semibold text-(--klyroo-text-highlighted)">Acme</span></Header>
            <ChildContent>
                <KlyNavigationMenu Items="_nav" Orientation="KlyOrientation.Vertical" AriaLabel="Workspace" />
            </ChildContent>
        </KlyDashboardSidebar>

        <KlyDashboardPanel Resizable Size="40" MinSize="25" MaxSize="70" ResizeLabel="Resize list">
            <Header>
                <KlyDashboardNavbar Title="Team">
                    <Leading><KlyDashboardSidebarCollapse /></Leading>
                </KlyDashboardNavbar>
            </Header>
            <Body>
                <KlyTable Items="People" Caption="Team members">
                    <KlyColumn Title="Name" Field="p => p.Name" Sortable />
                    <KlyColumn Title="Role" Field="p => p.Role" Sortable />
                </KlyTable>
            </Body>
        </KlyDashboardPanel>

        <KlyDashboardPanel>
            <Header><KlyDashboardNavbar Title="Details" Toggle="false" /></Header>
            <Body>
                <KlyTabs Items="_tabs" AriaLabel="Details" />
                <KlyAccordion Items="_faq" />
            </Body>
        </KlyDashboardPanel>
    </KlyDashboardGroup>
</div>

@code {
    private sealed record Person(string Name, string Role);

    private static readonly Person[] People =
    [
        new("Lindsay Walton", "Front-end developer"),
        new("Courtney Henry", "Designer"),
        new("Tom Cook", "Director of product"),
        new("Whitney Francis", "Copywriter"),
    ];

    private static readonly KlyNavigationItem[] _nav =
    [
        new("Home") { Href = "/", Exact = true },
        new("Forms") { Href = "/forms" },
        new("Overlays") { Href = "/overlays" },
    ];

    private static readonly KlyTabItem[] _tabs =
    [
        new("Account") { Value = "account", Content = @<p class="p-4 text-sm">Make changes to your account.</p> },
        new("Password") { Value = "password", Content = @<p class="p-4 text-sm">Change your password.</p> },
    ];

    private static readonly KlyAccordionItem[] _faq =
    [
        new("Does it work offline?") { Value = "offline", Content = @<p>Yes: the pages, the styles and the fonts are in the app.</p> },
        new("Where is my layout kept?") { Value = "layout", Content = @<p>In localStorage, under the id of the dashboard.</p> },
    ];
}
