@page "/forms"
@using System.ComponentModel.DataAnnotations

<PageTitle>Forms</PageTitle>

<h1 class="text-2xl font-semibold text-(--klyroo-text-highlighted)">Forms</h1>

@* FormName is how the form posts in a Blazor Web App without interactivity. In a web view the page is always interactive, so the same form just submits. *@
<KlyForm Model="Model" FormName="profile" OnValidSubmit="SaveAsync" ShowSummary class="flex w-full max-w-md flex-col gap-4">
    <KlyFormField Label="Name" Required Field="FieldIdentifier.Create(() => Model!.Name)">
        <KlyInput @bind-Value="Model!.Name" data-testid="name" />
    </KlyFormField>
    <KlyFormField Label="Country" Field="FieldIdentifier.Create(() => Model!.Country)">
        <KlySelect @bind-Value="Model!.Country" Items="_countries" Placeholder="Choose a country" data-testid="country" />
    </KlyFormField>
    <KlyFormField Label="Bio">
        <KlyTextarea @bind-Value="Model!.Bio" Rows="3" />
    </KlyFormField>
    <KlySwitch @bind-Value="Model!.Notify" Label="Email notifications" />
    <KlyCheckbox @bind-Value="Model!.Terms" Label="I accept the terms" />
    <KlyButton Type="ButtonType.Submit" Label="Save profile" data-testid="save" />
    @if (_saved)
    {
        <p role="status" class="text-sm text-(--klyroo-success-text)" data-testid="saved">Saved @Model!.Name.</p>
    }
</KlyForm>

@code {
    [SupplyParameterFromForm(FormName = "profile")]
    private Profile? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new();

    private static readonly KlySelectItem[] _countries =
    [
        new("fr", "France"),
        new("de", "Germany"),
        new("it", "Italy"),
        new("es", "Spain"),
    ];

    private async Task SaveAsync()
    {
        await Task.Delay(200);
        _saved = true;
    }

    private sealed class Profile
    {
        [Required(ErrorMessage = "The name is required.")]
        public string? Name { get; set; }

        public string? Country { get; set; }

        public string? Bio { get; set; }

        public bool Notify { get; set; } = true;

        [Range(typeof(bool), "true", "true", ErrorMessage = "Accept the terms to continue.")]
        public bool Terms { get; set; }
    }
}
