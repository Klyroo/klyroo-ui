<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>$(KlyrooSampleTfm)</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klyroo.Maui.Shared\Klyroo.Maui.Shared.csproj" />
  </ItemGroup>

  <!--
    The Klyroo build features (self-hosted fonts, bundled icons). An app gets all of this from the Klyroo.UI package (buildTransitive);
    here Klyroo.UI is a project reference, so the task assembly is built first and the targets are imported by hand.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Klyroo.UI.Build.Tasks\Klyroo.UI.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <KlyrooBuildTasksAssembly>$(MSBuildThisFileDirectory)..\..\..\src\Klyroo.UI.Build.Tasks\bin\$(Configuration)\netstandard2.0\Klyroo.UI.Build.Tasks.dll</KlyrooBuildTasksAssembly>
  </PropertyGroup>
  <Import Project="..\..\..\src\Klyroo.UI\buildTransitive\Klyroo.UI.Tasks.targets" />
  <Import Project="..\..\..\src\Klyroo.UI\buildTransitive\Klyroo.UI.Fonts.targets" />
  <Import Project="..\..\..\src\Klyroo.UI\buildTransitive\Klyroo.UI.Icons.targets" />

  <ItemGroup>
    <KlyrooFont Include="Geist" Role="sans" Weights="400..700" Subsets="latin" />
    <!-- The icon scan also reads the pages of the shared project. -->
    <KlyrooIconScanDirectory Include="..\Klyroo.Maui.Shared" />
  </ItemGroup>

</Project>
