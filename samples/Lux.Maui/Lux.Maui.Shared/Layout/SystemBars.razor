@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISystemBars Bars

@code {
    private DotNetObjectReference<SystemBars>? _self;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watch;

    // Follows the color mode of Lux (class "dark" on html) and passes it to the host, which colors the system bars.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Lux.Maui.Shared/host.js");
        _self = DotNetObjectReference.Create(this);
        _watch = await _module.InvokeAsync<IJSObjectReference>("watchDark", _self);
    }

    [JSInvokable]
    public void OnMode(bool dark) => Bars.Apply(dark);

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Removes the lx-color-mode listener: left in place it would keep calling into a disposed reference.
            if (_watch is not null) await _watch.InvokeVoidAsync("dispose");
            if (_watch is not null) await _watch.DisposeAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _self?.Dispose(); }
    }
}
