@page "/overlays"
@inject IToastService Toasts

<PageTitle>Overlays</PageTitle>

<h1 class="text-2xl font-semibold text-(--lux-text-highlighted)">Overlays</h1>
<p class="text-(--lux-text-muted)">Native dialogs and popovers (iOS 17 or later), driven by the browser in the web view.</p>

<div class="flex flex-wrap items-center gap-3">
    <LxModal @bind-Open="_modal" Title="Edit profile" Description="Changes are saved when you close the dialog.">
        <ChildContent><LxButton Label="Modal" Variant="ButtonVariant.Outline" data-testid="modal-trigger" /></ChildContent>
        <Body>
            <div class="flex flex-col gap-4">
                <LxFormField Label="Name"><LxInput Value="Ada Lovelace" /></LxFormField>
            </div>
        </Body>
        <Footer>
            <LxButton Label="Cancel" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" data-lx-close />
            <LxButton Label="Save" data-lx-close data-testid="modal-save" />
        </Footer>
    </LxModal>

    <LxModal Title="Delete project?" Description="Back and Escape do nothing here: choose a button." Dismissible="false" Close="false" Size="LxSize.Sm">
        <ChildContent><LxButton Label="Confirm modal" Variant="ButtonVariant.Outline" data-testid="confirm-trigger" /></ChildContent>
        <Footer>
            <LxButton Label="Cancel" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" data-lx-close />
            <LxButton Label="Delete" Color="LxColor.Error" data-lx-close />
        </Footer>
    </LxModal>

    <LxModal Title="Shipping" Description="Back closes the open list first, then the modal.">
        <ChildContent><LxButton Label="Modal with select" Variant="ButtonVariant.Outline" data-testid="modal-select-trigger" /></ChildContent>
        <Body>
            <LxFormField Label="Country">
                <LxSelect @bind-Value="_country" Items="_countries" Placeholder="Choose a country" />
            </LxFormField>
        </Body>
        <Footer><LxButton Label="Close" Color="LxColor.Neutral" Variant="ButtonVariant.Ghost" data-lx-close /></Footer>
    </LxModal>

    <LxSlideover Title="Settings" Description="A panel docked to an edge.">
        <ChildContent><LxButton Label="Slideover" Variant="ButtonVariant.Outline" data-testid="slideover-trigger" /></ChildContent>
        <Body><p class="text-sm text-(--lux-text-muted)">The panel keeps clear of the notch and the gesture bar.</p></Body>
    </LxSlideover>

    <LxDropdownMenu Items="_items" OnSelect="item => _last = item.Label">
        <LxButton Label="Menu" Color="LxColor.Neutral" Variant="ButtonVariant.Outline" data-testid="menu-trigger" />
    </LxDropdownMenu>

    <LxPopover Placement="bottom-start">
        <ChildContent><LxButton Label="Popover" Variant="ButtonVariant.Outline" data-testid="popover-trigger" /></ChildContent>
        <Content>
            <p class="w-56 p-4 text-sm" data-testid="popover-panel">Escape or a tap outside closes me.</p>
        </Content>
    </LxPopover>

    <LxButton Label="Toast" OnClick="ShowToast" data-testid="toast-trigger" />
</div>

<p class="text-sm text-(--lux-text-muted)" data-testid="modal-state">Modal: @(_modal ? "open" : "closed")</p>
<p class="text-sm text-(--lux-text-muted)" data-testid="menu-state">Last menu action: @(_last ?? "none")</p>

@code {
    private bool _modal;
    private string? _last;
    private string? _country;

    private static readonly LxSelectItem[] _countries = [new("fr", "France"), new("de", "Germany"), new("it", "Italy")];

    private static readonly LxMenuItem[] _items =
    [
        LxMenuItem.Heading("My account"),
        new() { Label = "Profile" },
        new() { Label = "Billing" },
        LxMenuItem.Separator(),
        new() { Label = "Delete account", Color = LxColor.Error },
    ];

    private async Task ShowToast() => await Toasts.Add(new LxToast
    {
        Title = "Changes saved",
        Description = "Your profile is up to date.",
        Color = LxColor.Success,
    });
}
