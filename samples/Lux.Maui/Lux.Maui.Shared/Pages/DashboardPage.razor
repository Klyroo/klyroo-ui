@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

<h1 class="text-2xl font-semibold text-(--lux-text-highlighted)">Dashboard</h1>

@* The sizes of the panels and the collapsed state of the sidebar are remembered in localStorage in a web view (cookies on the web). *@
<div class="h-[28rem] w-full overflow-hidden rounded-xl border border-(--lux-border)" data-testid="dashboard">
    <LxDashboardGroup StorageKey="maui-dashboard">
        <LxDashboardSidebar As="div" Resizable>
            <Header><span class="font-semibold text-(--lux-text-highlighted)">Acme</span></Header>
            <ChildContent>
                <LxNavigationMenu Items="_nav" Orientation="LxOrientation.Vertical" AriaLabel="Workspace" />
            </ChildContent>
        </LxDashboardSidebar>

        <LxDashboardPanel Resizable Size="40" MinSize="25" MaxSize="70" ResizeLabel="Resize list">
            <Header>
                <LxDashboardNavbar Title="Team">
                    <Leading><LxDashboardSidebarCollapse /></Leading>
                </LxDashboardNavbar>
            </Header>
            <Body>
                <LxTable Items="People" Caption="Team members">
                    <LxColumn TItem="Person" Title="Name" Field="p => p.Name" Sortable />
                    <LxColumn TItem="Person" Title="Role" Field="p => p.Role" Sortable />
                </LxTable>
            </Body>
        </LxDashboardPanel>

        <LxDashboardPanel>
            <Header><LxDashboardNavbar Title="Details" Toggle="false" /></Header>
            <Body>
                <LxTabs Items="_tabs" AriaLabel="Details" />
                <LxAccordion Items="_faq" />
            </Body>
        </LxDashboardPanel>
    </LxDashboardGroup>
</div>

@code {
    private sealed record Person(string Name, string Role);

    private static readonly Person[] People =
    [
        new("Lindsay Walton", "Front-end developer"),
        new("Courtney Henry", "Designer"),
        new("Tom Cook", "Director of product"),
        new("Whitney Francis", "Copywriter"),
    ];

    private static readonly LxNavigationItem[] _nav =
    [
        new("Home") { Href = "/", Exact = true },
        new("Forms") { Href = "/forms" },
        new("Overlays") { Href = "/overlays" },
    ];

    private static readonly LxTabItem[] _tabs =
    [
        new("Account") { Value = "account", Content = @<p class="p-4 text-sm">Make changes to your account.</p> },
        new("Password") { Value = "password", Content = @<p class="p-4 text-sm">Change your password.</p> },
    ];

    private static readonly LxAccordionItem[] _faq =
    [
        new("Does it work offline?") { Value = "offline", Content = @<p>Yes: the pages, the styles and the fonts are in the app.</p> },
        new("Where is my layout kept?") { Value = "layout", Content = @<p>In localStorage, under the id of the dashboard.</p> },
    ];
}
