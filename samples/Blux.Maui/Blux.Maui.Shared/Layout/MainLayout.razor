@inherits LayoutComponentBase
@inject IFormFactor FormFactor

@* BxHead sends the theme variables and the self-hosted fonts to <head> through the HeadOutlet root component of the MAUI app.
   It renders nothing on the web, where App.razor places them. *@
<BxHead />

<BxApp SpatialNavigation="@FormFactor.IsTv">
    <BxHeader Title="Blux on MAUI" Items="_items" AriaLabel="Main" MenuTitle="Menu">
        <Right>
            <BxLocaleSelect Size="BxSize.Sm" />
            <BxColorModeButton Size="BxSize.Sm" />
        </Right>
    </BxHeader>
    <BxMain>
        <div class="mx-auto flex w-full max-w-5xl flex-col gap-8 p-4 sm:p-6">
            @Body
        </div>
    </BxMain>
</BxApp>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private static readonly BxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true },
        new("Forms") { Href = "/forms" },
        new("Overlays") { Href = "/overlays" },
        new("Dashboard") { Href = "/dashboard" },
    ];
}
