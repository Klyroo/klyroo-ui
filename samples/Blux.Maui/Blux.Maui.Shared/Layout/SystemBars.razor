@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISystemBars Bars

@code {
    private DotNetObjectReference<SystemBars>? _self;
    private IJSObjectReference? _module;

    // Follows the color mode of Blux (class "dark" on html) and passes it to the host, which colors the system bars.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Blux.Maui.Shared/host.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("watchDark", _self);
    }

    [JSInvokable]
    public void OnMode(bool dark) => Bars.Apply(dark);

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
