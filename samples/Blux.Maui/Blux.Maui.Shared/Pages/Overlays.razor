@page "/overlays"
@inject IToastService Toasts

<PageTitle>Overlays</PageTitle>

<h1 class="text-2xl font-semibold text-(--blux-text-highlighted)">Overlays</h1>
<p class="text-(--blux-text-muted)">Native dialogs and popovers (iOS 17 or later), driven by the browser in the web view.</p>

<div class="flex flex-wrap items-center gap-3">
    <BxModal @bind-Open="_modal" Title="Edit profile" Description="Changes are saved when you close the dialog.">
        <ChildContent><BxButton Label="Modal" Variant="ButtonVariant.Outline" data-testid="modal-trigger" /></ChildContent>
        <Body>
            <div class="flex flex-col gap-4">
                <BxFormField Label="Name"><BxInput Value="Ada Lovelace" /></BxFormField>
            </div>
        </Body>
        <Footer>
            <BxButton Label="Cancel" Color="BxColor.Neutral" Variant="ButtonVariant.Ghost" data-bx-close />
            <BxButton Label="Save" data-bx-close data-testid="modal-save" />
        </Footer>
    </BxModal>

    <BxModal Title="Delete project?" Description="Back and Escape do nothing here: choose a button." Dismissible="false" Close="false" Size="BxSize.Sm">
        <ChildContent><BxButton Label="Confirm modal" Variant="ButtonVariant.Outline" data-testid="confirm-trigger" /></ChildContent>
        <Footer>
            <BxButton Label="Cancel" Color="BxColor.Neutral" Variant="ButtonVariant.Outline" data-bx-close />
            <BxButton Label="Delete" Color="BxColor.Error" data-bx-close />
        </Footer>
    </BxModal>

    <BxModal Title="Shipping" Description="Back closes the open list first, then the modal.">
        <ChildContent><BxButton Label="Modal with select" Variant="ButtonVariant.Outline" data-testid="modal-select-trigger" /></ChildContent>
        <Body>
            <BxFormField Label="Country">
                <BxSelect @bind-Value="_country" Items="_countries" Placeholder="Choose a country" />
            </BxFormField>
        </Body>
        <Footer><BxButton Label="Close" Color="BxColor.Neutral" Variant="ButtonVariant.Ghost" data-bx-close /></Footer>
    </BxModal>

    <BxSlideover Title="Settings" Description="A panel docked to an edge.">
        <ChildContent><BxButton Label="Slideover" Variant="ButtonVariant.Outline" data-testid="slideover-trigger" /></ChildContent>
        <Body><p class="text-sm text-(--blux-text-muted)">The panel keeps clear of the notch and the gesture bar.</p></Body>
    </BxSlideover>

    <BxDropdownMenu Items="_items" OnSelect="item => _last = item.Label">
        <BxButton Label="Menu" Color="BxColor.Neutral" Variant="ButtonVariant.Outline" data-testid="menu-trigger" />
    </BxDropdownMenu>

    <BxPopover Placement="bottom-start">
        <ChildContent><BxButton Label="Popover" Variant="ButtonVariant.Outline" data-testid="popover-trigger" /></ChildContent>
        <Content>
            <p class="w-56 p-4 text-sm" data-testid="popover-panel">Escape or a tap outside closes me.</p>
        </Content>
    </BxPopover>

    <BxButton Label="Toast" OnClick="ShowToast" data-testid="toast-trigger" />
</div>

<p class="text-sm text-(--blux-text-muted)" data-testid="modal-state">Modal: @(_modal ? "open" : "closed")</p>
<p class="text-sm text-(--blux-text-muted)" data-testid="menu-state">Last menu action: @(_last ?? "none")</p>

@code {
    private bool _modal;
    private string? _last;
    private string? _country;

    private static readonly BxSelectItem[] _countries = [new("fr", "France"), new("de", "Germany"), new("it", "Italy")];

    private static readonly BxMenuItem[] _items =
    [
        BxMenuItem.Heading("My account"),
        new() { Label = "Profile" },
        new() { Label = "Billing" },
        BxMenuItem.Separator(),
        new() { Label = "Delete account", Color = BxColor.Error },
    ];

    private async Task ShowToast() => await Toasts.Add(new BxToast
    {
        Title = "Changes saved",
        Description = "Your profile is up to date.",
        Color = BxColor.Success,
    });
}
