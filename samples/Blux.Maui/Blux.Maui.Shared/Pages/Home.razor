@page "/"
@inject IFormFactor FormFactor

<PageTitle>Blux on MAUI</PageTitle>

<div class="flex flex-col gap-2">
    <h1 class="text-2xl font-semibold text-(--blux-text-highlighted)">Blux UI in a Blazor Hybrid app</h1>
    <p class="text-(--blux-text-muted)">
        The same pages run in the MAUI app (a BlazorWebView) and in the web app. Blux detects the host and adapts what needs a server.
    </p>
</div>

<BxCard>
    <Header><h2 class="font-semibold">This host</h2></Header>
    <ChildContent>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-(--blux-text-muted)">Renderer</dt>
            <dd data-testid="renderer">@RendererInfo.Name (interactive: @RendererInfo.IsInteractive)</dd>
            <dt class="text-(--blux-text-muted)">Form factor</dt>
            <dd data-testid="form-factor">@FormFactor.GetFormFactor()</dd>
            <dt class="text-(--blux-text-muted)">Platform</dt>
            <dd data-testid="platform">@FormFactor.GetPlatform()</dd>
            <dt class="text-(--blux-text-muted)">Culture</dt>
            <dd data-testid="culture">@System.Globalization.CultureInfo.CurrentUICulture.Name</dd>
        </dl>
    </ChildContent>
</BxCard>

<BxAlert Title="Touch and remote friendly" Description="Tooltips open on a long press, targets are at least 44 pixels, and TV mode moves focus with the arrow keys."
         Color="BxColor.Info" Variant="BxVariant.Subtle" />

<div class="flex flex-wrap items-center gap-3">
    <BxButton Label="Counter" OnClick="() => _count++" data-testid="counter" />
    <BxBadge Label="@($"Clicked {_count} times")" Variant="BxVariant.Subtle" />
    <BxTooltip Text="Press and hold on a touch screen">
        <BxButton Label="Long press me" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" data-testid="tooltip-trigger" />
    </BxTooltip>
    <BxAvatar Alt="Ada Lovelace" />
</div>

@code {
    private int _count;
}
