{
  "name": "klyroo-ui-build",
  "private": true,
  "description": "Builds the generated assets of Klyroo.UI. Only needed to work on the library, never by apps using it.",
  "type": "module",
  "scripts": {
    "classes": "dotnet run --project build/Klyroo.UI.ClassExtractor -- src/Klyroo.UI",
    "css": "tailwindcss -i src/Klyroo.UI/styles/klyroo.css -o src/Klyroo.UI/wwwroot/klyroo.css --minify && tailwindcss -i src/Klyroo.UI/styles/klyroo.preflight.css -o src/Klyroo.UI/wwwroot/klyroo.preflight.css --minify",
    "js": "esbuild src/Klyroo.UI/js/index.js --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=src/Klyroo.UI/wwwroot/Klyroo.UI.lib.module.js",
    "editor": "esbuild src/Klyroo.UI/js/editor-engine.js --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=src/Klyroo.UI/wwwroot/klyroo-editor.js",
    "icons": "node build/gen-icons.mjs",
    "test:js": "node --test tests/js/*.test.mjs",
    "build": "npm run icons && npm run classes && npm run css && npm run js && npm run editor"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "@iconify-json/lucide": "1.2.157",
    "@iconify/collections": "1.0.767",
    "@tailwindcss/cli": "4.3.5",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-mention": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5"
  }
}
