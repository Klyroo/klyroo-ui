<Project Sdk="Microsoft.NET.Sdk">

  <!-- A startup hook (DOTNET_STARTUP_HOOKS) the docs host injects into the template demos it runs, so the demos need no code of their own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
