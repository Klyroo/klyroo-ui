<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blux.Playground.Client\Blux.Playground.Client.csproj" />
    <!-- The image optimizer behind /_blux/img: the docs show real resized images. -->
    <ProjectReference Include="..\..\..\src\Blux.UI.Images.Local\Blux.UI.Images.Local.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- The MCP server at /mcp and the llms.txt files, generated from the docs bundle. -->
    <ProjectReference Include="..\..\..\src\Blux.UI.Mcp.Core\Blux.UI.Mcp.Core.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!--
    Dogfooding of the self-hosted fonts. An app gets all of this from the Blux.UI package (buildTransitive); here Blux.UI is a
    project reference, so the task assembly is built first and the targets are imported by hand.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Blux.UI.Build.Tasks\Blux.UI.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <BluxBuildTasksAssembly>$(MSBuildThisFileDirectory)..\..\..\src\Blux.UI.Build.Tasks\bin\$(Configuration)\netstandard2.0\Blux.UI.Build.Tasks.dll</BluxBuildTasksAssembly>
    <BluxFontsCacheDir Condition="'$(BluxFontsCacheDir)' == ''">$(MSBuildThisFileDirectory)obj\blux\fonts-cache\</BluxFontsCacheDir>
  </PropertyGroup>
  <Import Project="..\..\..\src\Blux.UI\buildTransitive\Blux.UI.Tasks.targets" />
  <Import Project="..\..\..\src\Blux.UI\buildTransitive\Blux.UI.Fonts.targets" />
  <Import Project="..\..\..\src\Blux.UI\buildTransitive\Blux.UI.Icons.targets" />

  <!-- Fonts of the site: downloaded from the providers at build time and served from the site's own origin. -->
  <ItemGroup>
    <BluxFont Include="Geist" Role="sans" Weights="400..700" Subsets="latin;latin-ext" />
    <BluxFont Include="Geist Mono" Role="mono" Weights="400..600" Subsets="latin;latin-ext" />
    <!-- The pixel face of the headings (font-pixel in site.css): not preloaded, it is only used by a few large titles. -->
    <BluxFont Include="Doto" Weights="700;900" Subsets="latin" Preload="false" Category="mono" />
  </ItemGroup>

</Project>
