<!DOCTYPE html>
<html lang="@_locale.Code" dir="@_locale.DirAttribute">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Accessible, themable Blazor components for every render mode." />
    @* The site can be served below a path base (see Program.cs): every relative URL, the stylesheets, the framework and the image endpoint included, follows this. *@
    <base href="@(HttpContext.Request.PathBase.Value?.TrimEnd('/') + "/")" />
    <BxColorModeScript />
    <BxCultureMeta />
    <BxThemeStyle />
    @* Self-hosted at build time from the BluxFont items of the project (Geist, Geist Mono, Doto): no third-party request. *@
    <BxFonts />
    <ResourcePreloader />
    @* The site compiles Tailwind itself (Blux "Tailwind in the app" mode): one stylesheet, no blux.css. *@
    <link rel="stylesheet" href="@Assets["site.css"]" />
    <link rel="stylesheet" href="@Assets["Blux.Playground.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="_mode" />
</head>

<body>
    <Routes @rendermode="_mode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["site.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? _mode;
    private BxLocale _locale = BxLocales.En;

    // /ssr, /server, /wasm and /auto prefixes pick a mode, to test components in each; everything else runs in Auto.
    protected override void OnParametersSet()
    {
        // lang and dir of the page follow the culture of the request, like the components do.
        _locale = BxLocales.Resolve(System.Globalization.CultureInfo.CurrentUICulture);
        _mode = PlaygroundServices.ModeFromPath(HttpContext.Request.Path) switch
        {
            "ssr" => null,
            "server" => InteractiveServer,
            "wasm" => InteractiveWebAssembly,
            _ => InteractiveAuto,
        };
    }
}
