@page "/stack"
@using Blux.Playground.Client.Docs

<PageTitle>LuxStack · High-velocity headless C# &amp; multiplatform Blazor/MAUI UI suite</PageTitle>

@* Product Switcher Strip (TanStack style) *@
<div class="border-b border-(--blux-border) bg-(--blux-bg-muted)/70 backdrop-blur">
    <div class="mx-auto flex max-w-(--breakpoint-2xl) items-center gap-2 overflow-x-auto px-4 py-2.5 sm:px-6 lg:px-8">
        <a href="/stack" class="inline-flex shrink-0 items-center gap-2 rounded-full border border-(--blux-primary-text) bg-(--blux-bg) px-3 py-1 font-mono text-xs font-semibold text-(--blux-text-highlighted)">
            <span class="size-2 rounded-full bg-(--blux-primary)"></span>
            <span>LuxStack</span>
            <span class="text-[10px] text-(--blux-text-muted)">HUB</span>
        </a>
        <span class="text-(--blux-border-accented)" aria-hidden="true">/</span>
        @foreach (var p in LuxStackProducts.All)
        {
            <a href="@($"/stack/{p.Slug}")"
               class="inline-flex shrink-0 items-center gap-2 rounded-full border border-(--blux-border) bg-(--blux-bg) px-3 py-1 font-mono text-xs text-(--blux-text-muted) transition-colors hover:border-(--blux-border-accented) hover:text-(--blux-text-highlighted)">
                <span class="size-2 rounded-full" style="@($"background:{p.AccentHex}")"></span>
                <span>@p.Name</span>
            </a>
        }
    </div>
</div>

@* Hero *@
<section class="relative isolate overflow-hidden border-b border-(--blux-border)">
    <div class="pg-dots absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]" aria-hidden="true"></div>
    <div class="pg-glow absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="mx-auto grid max-w-(--breakpoint-2xl) gap-10 px-4 pt-16 pb-16 sm:px-6 sm:pt-24 lg:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)] lg:items-end lg:px-8 lg:pb-20">
        <div>
            <p class="pg-eyebrow-mono">lux.stack <span aria-hidden="true">·</span> <span class="text-(--blux-primary-text)">8 headless + UI libraries</span> <span aria-hidden="true">·</span> Blazor &amp; .NET MAUI</p>
            <h1 class="mt-5 text-5xl font-semibold leading-[0.95] tracking-[-0.055em] text-(--blux-text-highlighted) sm:text-7xl xl:text-[4.75rem]">
                The TanStack architecture,<br />
                <span class="pg-accent">engineered for .NET.</span>
            </h1>
        </div>
        <div class="lg:pb-2">
            <p class="text-lg leading-relaxed text-(--blux-text-muted) text-pretty">
                Eight focused repositories with a strict two-layer contract: <code class="font-mono text-sm text-(--blux-text-highlighted)">Lux.&lt;Product&gt;.Core</code>
                is 100% headless C# &amp; NativeAOT-ready, and <code class="font-mono text-sm text-(--blux-text-highlighted)">Lux.&lt;Product&gt;</code>
                delivers zero-roundtrip Blazor Web &amp; .NET MAUI Blazor Hybrid components.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <BxButton Label="Explore Lux.Query" Href="/stack/query" Size="BxSize.Lg" Class="rounded-lg px-5">
                    <TrailingIcon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
                </BxButton>
                <button type="button" data-copy-text="dotnet add package Lux.Stack"
                        class="group inline-flex items-center gap-3 rounded-lg border border-(--blux-border-accented) bg-(--blux-bg) px-4 py-2.5 font-mono text-sm text-(--blux-text-highlighted) hover:border-(--blux-primary-text)">
                    <span><span class="text-(--blux-text-muted)">$</span> dotnet add package Lux.Stack</span>
                    <span class="text-[11px] uppercase tracking-wider text-(--blux-text-muted) group-hover:text-(--blux-primary-text)" data-copy-label>Copy</span>
                </button>
            </div>
        </div>
    </div>
</section>

@* 8 Product Cards (TanStack Grid) *@
<section aria-labelledby="products-heading" class="border-b border-(--blux-border)">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <h2 id="products-heading" class="text-4xl font-semibold leading-none tracking-[-0.045em] text-(--blux-text-highlighted) sm:text-6xl">
                Eight libraries.<br /><span class="pg-accent">Pick one or the stack.</span>
            </h2>
            <p class="text-lg text-(--blux-text-muted) lg:max-w-xl lg:justify-self-end">
                Each product has its own dedicated repository, headless C# core, Blazor/MAUI Razor components, test suite, and landing page.
            </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
            @foreach (var product in LuxStackProducts.All)
            {
                <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-(--blux-border) bg-(--blux-bg) transition-all hover:border-(--blux-border-accented)"
                         style="@($"border-top: 3px solid {product.AccentHex}")">
                    <div class="flex flex-1 flex-col p-6">
                        <div class="flex items-center justify-between gap-2">
                            <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-(--blux-text-muted)">
                                <span class="size-2.5 rounded-full" style="@($"background:{product.AccentHex}")"></span>
                                @product.RepoName
                            </span>
                            <BxBadge Label="Core + UI" Color="@product.BadgeColor" Variant="BxVariant.Subtle" Size="BxSize.Sm" />
                        </div>

                        <h3 class="mt-3 text-2xl font-semibold tracking-tight text-(--blux-text-highlighted)">
                            <a href="@($"/stack/{product.Slug}")" class="hover:underline" style="@($"text-decoration-color:{product.AccentHex}")">
                                Lux.<span style="@($"color:{product.AccentHex}")">@product.ShortName</span>
                            </a>
                        </h3>

                        <p class="mt-1 font-mono text-xs text-(--blux-text-highlighted)">@product.Tagline</p>
                        <p class="mt-3 flex-1 text-sm leading-relaxed text-(--blux-text-muted)">@product.Description</p>

                        <div class="mt-5 rounded-xl border border-(--blux-border) bg-(--blux-bg-muted)/60 p-3 font-mono text-xs">
                            <div class="flex items-center justify-between text-(--blux-text-muted)">
                                <span>Headless:</span>
                                <span class="text-(--blux-text-highlighted)">@product.CorePackage</span>
                            </div>
                            <div class="mt-1 flex items-center justify-between text-(--blux-text-muted)">
                                <span>Blazor/MAUI:</span>
                                <span class="text-(--blux-text-highlighted)">@product.UiPackage</span>
                            </div>
                        </div>

                        <div class="mt-4 flex flex-wrap gap-1.5">
                            @foreach (var comp in product.Components.Take(3))
                            {
                                <span class="rounded-md border border-(--blux-border) bg-(--blux-bg-muted) px-2 py-0.5 font-mono text-[11px] text-(--blux-text)">@comp.Name</span>
                            }
                        </div>

                        <div class="mt-6 pt-2">
                            <BxButton Label="@($"Open {product.Name} page")"
                                      Href="@($"/stack/{product.Slug}")"
                                      Color="BxColor.Neutral"
                                      Variant="ButtonVariant.Outline"
                                      Size="BxSize.Sm"
                                      Class="w-full justify-between rounded-lg">
                                <TrailingIcon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></TrailingIcon>
                            </BxButton>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@* Interactive Component Redirection Directory *@
<section aria-labelledby="redirections-heading">
    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
            <div>
                <p class="pg-eyebrow-mono">LuxStackCatalog.ResolveComponent</p>
                <h2 id="redirections-heading" class="mt-2 text-3xl font-semibold tracking-tight text-(--blux-text-highlighted) sm:text-5xl">
                    Component redirections.
                </h2>
            </div>
            <div class="lg:max-w-md lg:justify-self-end">
                <BxInput @bind-Value="_filter"
                         Placeholder="Filter by component, package or product (e.g. BxDataList, Form, Agent)..."
                         aria-label="Filter components" />
            </div>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-(--blux-border) bg-(--blux-bg)">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="border-b border-(--blux-border) bg-(--blux-bg-muted) font-mono text-xs uppercase text-(--blux-text-muted)">
                        <tr>
                            <th class="px-4 py-3">Component / Service</th>
                            <th class="px-4 py-3">Layer</th>
                            <th class="px-4 py-3">Product Landing Page</th>
                            <th class="px-4 py-3">NuGet Package</th>
                            <th class="px-4 py-3">Repository</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-(--blux-border)">
                        @foreach (var (product, comp) in FilteredComponents)
                        {
                            <tr class="hover:bg-(--blux-bg-muted)/40">
                                <td class="px-4 py-3 font-mono font-medium text-(--blux-text-highlighted)">
                                    <a href="@comp.Href" class="hover:underline">@comp.Name</a>
                                    <p class="mt-0.5 font-sans text-xs font-normal text-(--blux-text-muted)">@comp.Description</p>
                                </td>
                                <td class="px-4 py-3">
                                    <BxBadge Label="@comp.Layer"
                                             Color="@(comp.Layer == "Core" ? BxColor.Info : BxColor.Success)"
                                             Variant="BxVariant.Subtle"
                                             Size="BxSize.Sm" />
                                </td>
                                <td class="px-4 py-3 font-mono text-xs">
                                    <a href="@($"/stack/{product.Slug}")" class="inline-flex items-center gap-2 font-semibold text-(--blux-text-highlighted) hover:underline">
                                        <span class="size-2 rounded-full" style="@($"background:{product.AccentHex}")"></span>
                                        @product.Name →
                                    </a>
                                </td>
                                <td class="px-4 py-3 font-mono text-xs text-(--blux-text)">
                                    @(comp.Layer == "Core" ? product.CorePackage : product.UiPackage)
                                </td>
                                <td class="px-4 py-3 font-mono text-xs text-(--blux-text-muted)">
                                    @product.RepoPath
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@code {
    private string _filter = "";

    private IEnumerable<(LuxProductInfo Product, LuxProductComponentLink Component)> FilteredComponents =>
        from p in LuxStackProducts.All
        from c in p.Components
        where string.IsNullOrWhiteSpace(_filter)
              || c.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || c.Description.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
              || p.CorePackage.Contains(_filter, StringComparison.OrdinalIgnoreCase)
        select (p, c);
}
