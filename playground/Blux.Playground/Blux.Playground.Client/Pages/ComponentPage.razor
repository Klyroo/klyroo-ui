@page "/components/{Slug}"
@page "/{Mode}/components/{Slug}"
@layout Layout.DocsLayout
@using Blux.Playground.Client.Docs

@if (_doc is null)
{
    <PageTitle>Not found · blux-ui</PageTitle>
    <h1 class="text-3xl font-bold tracking-tight">Component not found</h1>
}
else
{
    <PageTitle>@_doc.Name · blux-ui</PageTitle>
    <p class="pg-eyebrow">@_doc.Group</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-[-0.04em] text-(--blux-text-highlighted)">@_doc.Name</h1>
    <p class="mt-3 text-lg text-(--blux-text-muted)">@_doc.Description</p>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-(--blux-border) bg-(--blux-bg-muted) px-4 py-3">
        <RendererBadge />
        <nav aria-label="Render mode" class="flex gap-1 rounded-lg border border-(--blux-border) bg-(--blux-bg) p-1 font-mono text-xs">
            @foreach (var mode in PlaygroundServices.Modes)
            {
                var active = mode == (CurrentMode ?? "auto");
                @* A full page load: the server picks the render mode per request. *@
                <a href="@($"/{mode}/components/{Slug}")" target="_top" data-enhance-nav="false" aria-current="@(active ? "page" : null)"
                   class="@(active ? "rounded-md bg-(--blux-primary) px-2.5 py-1 font-medium text-(--blux-primary-contrast)" : "rounded-md px-2.5 py-1 text-(--blux-text-muted) hover:text-(--blux-text-highlighted)")">@mode</a>
            }
        </nav>
    </div>

    <div class="mt-10 flex flex-col gap-12">
        @foreach (var example in _doc.Examples)
        {
            <Example Of="example.Type" Title="@example.Title" Description="@example.Description" />
        }
    </div>

    <h2 id="api" class="mt-16 scroll-mt-24 text-xl font-semibold tracking-tight text-(--blux-text-highlighted)">API</h2>
    @foreach (var type in _doc.Api)
    {
        <h3 class="mt-6 mb-3 font-mono text-sm font-semibold">@ApiName(type)</h3>
        <ApiTable Of="type" />
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Mode { get; set; }

    private ComponentDoc? _doc;

    private string? CurrentMode => Mode is null ? null : PlaygroundServices.ModeFromPath("/" + Mode);

    protected override void OnParametersSet() => _doc = Catalog.Find(Slug);

    private static string ApiName(Type type) => ApiReader.TypeName(type).Replace("<object>", "<TItem>").Replace("<string>", "<TValue>");
}
