@page "/docs/lux-query"
@layout Layout.DocsLayout
@using Blux.UI.Tools.Query

<PageTitle>Lux.Query · LuxStack Documentation</PageTitle>

<div class="pg-prose">
    <p class="pg-eyebrow">LuxStack Libraries · <a href="/stack/query">Product Landing Page</a></p>
    <h1>Lux.Query</h1>
    <p class="pg-lead">
        Strongly typed, NativeAOT-compatible query AST, reversible URL search parameter codecs, InMemory &amp; IQueryable evaluators,
        Entity Framework Core async SQL execution, and reactive Blazor / .NET MAUI <code>QueryState</code>.
    </p>

    <h2>Packages &amp; Two-Layer Architecture</h2>
    <ul>
        <li><strong><code>Lux.Query.Core</code></strong> — 100% headless C#, zero UI dependency, <code>&lt;IsAotCompatible&gt;true&lt;/IsAotCompatible&gt;</code>. Houses <code>DataListSchema</code>, <code>DataListRequest</code>, <code>DataListFilterGroup</code>, <code>QueryCodecs</code>, <code>InMemoryDataList</code>, and <code>QueryableDataList</code>.</li>
        <li><strong><code>Lux.Query</code></strong> — Razor Class Library supporting <code>browser</code>, <code>ios</code>, <code>android</code>, <code>maccatalyst</code>, and <code>windows</code>. Provides <code>QueryState</code>, <code>QueryGroup</code>, <code>QueryValue&lt;T&gt;</code>, and <code>AddLuxQuery()</code>.</li>
        <li><strong><code>Lux.Query.EntityFrameworkCore</code></strong> — Optional adapter translating <code>DataListRequest</code> into async SQL via <code>EfAsyncQueryExecutor</code>.</li>
    </ul>

    <h2>Installation</h2>
    <CodeBlock Title="Terminal" Code="@InstallCmd" />
    <p>Register <code>QueryState</code> in <code>Program.cs</code> (Blazor Web App) or <code>MauiProgram.cs</code> (.NET MAUI Blazor Hybrid):</p>
    <CodeBlock Title="Program.cs / MauiProgram.cs" Code="@RegisterCs" />

    <h2>Defining a Typed Schema</h2>
    <p>
        Use <code>DataListSchema.For&lt;T&gt;()</code> to declare the row key, full-text search columns, sortable fields,
        and filterable predicates with compile-time type safety. The same schema drives InMemory evaluation, IQueryable SQL translation,
        and URL state encoding.
    </p>
    <CodeBlock Title="ProductSchema.cs" Code="@SchemaCs" />

    <h2>Building &amp; Executing a DataListRequest</h2>
    <p>
        <code>DataListRequest</code> is an immutable query AST supporting offset paging (<code>DataListPaging.Offset</code>),
        cursor paging (<code>DataListPaging.Cursor</code>), multi-column sorting (<code>DataListSort</code>), nested AND/OR filter groups
        (<code>DataListFilterGroup</code>), and search terms (<code>DataListSearch</code>).
    </p>
    <CodeBlock Title="InMemory &amp; IQueryable Execution" Code="@ExecuteCs" />

    <h2>Entity Framework Core Async SQL</h2>
    <p>
        Add <code>Lux.Query.EntityFrameworkCore</code> on your server project so <code>QueryableDataList</code> translates filters,
        sorting, and counts to SQL asynchronously via <code>EfAsyncQueryExecutor</code> without loading rows into memory.
    </p>
    <CodeBlock Title="Program.cs (Server)" Code="@EfCs" />

    <h2>Reactive URL State (Blazor &amp; .NET MAUI Hybrid)</h2>
    <p>
        Inject <code>QueryState</code> to read and write typed query parameters synchronized with the browser URL or MAUI
        <code>BlazorWebView</code> navigation stack. Supports <code>QueryHistory.Replace</code> (default for filters/search) and
        <code>QueryHistory.Push</code> (for pagination). See also the dedicated <a href="/docs/url-state">URL state guide</a>.
    </p>
    <CodeBlock Title="CatalogPage.razor" Code="@QueryStateRazor" />

    <h2>NativeAOT &amp; Headless MAUI Usage</h2>
    <p>
        Reference only <code>Lux.Query.Core</code> in Minimal APIs, background workers, CLI apps, or native C# .NET MAUI ViewModels.
        All JSON serialization uses source-generated <code>DataListJsonContext</code> with zero reflection fallback.
    </p>

    <h2>API Reference</h2>
    <h3>DataListRequest</h3>
    <ApiTable Of="typeof(DataListRequest)" />
    <h3 class="mt-8">DataListResult&lt;TItem&gt;</h3>
    <ApiTable Of="typeof(DataListResult<object>)" />
    <h3 class="mt-8">QueryState</h3>
    <ApiTable Of="typeof(QueryState)" />
</div>

@code {
    private const string InstallCmd = """
        dotnet add package Lux.Query.Core               # Headless C# / NativeAOT / MAUI C#
        dotnet add package Lux.Query                    # Blazor Web & .NET MAUI Blazor Hybrid
        dotnet add package Lux.Query.EntityFrameworkCore # Optional EF Core async SQL executor
        """;

    private const string RegisterCs = """
        builder.Services.AddLuxQuery();
        """;

    private const string SchemaCs = """
        using Blux.UI.Tools.Query;

        public sealed record Product(int Id, string Name, string Category, decimal Price, bool Active);

        var schema = DataListSchema.For<Product>(s => s
            .RowKey(p => p.Id)
            .Search(p => p.Name, p => p.Category)
            .Field(p => p.Price, f => f.Key("price").Sortable().Filterable())
            .Field(p => p.Category, f => f.Key("category").Sortable().Filterable())
            .Field(p => p.Active, f => f.Key("active").Filterable()));
        """;

    private const string ExecuteCs = """
        var request = new DataListRequest(
            Paging: new DataListPaging.Offset(Skip: 0, Take: 25),
            Sorts: [new DataListSort("price", Descending: true)],
            Filter: DataListFilterGroup.Empty,
            Search: new DataListSearch("Monitor"));

        // 1. In-memory evaluation (zero allocations beyond the page)
        DataListResult<Product> memoryPage = schema.ExecuteInMemory(products, request);

        // 2. IQueryable evaluation (LINQ / EF Core)
        IQueryable<Product> filtered = schema.Apply(db.Products.AsNoTracking(), request);
        """;

    private const string EfCs = """
        builder.Services.AddLuxQuery();
        builder.Services.AddSingleton<IDataListQueryExecutor, EfAsyncQueryExecutor>();
        """;

    private const string QueryStateRazor = """
        @inject QueryState Query

        <BxInput Value="@(Query.Get("q") ?? "")"
                 ValueChanged="@(v => Query.Set("q", string.IsNullOrWhiteSpace(v) ? null : v))"
                 Placeholder="Search catalog..." />

        @code {
            private void NextPage()
            {
                var current = int.TryParse(Query.Get("page"), out var p) ? p : 1;
                Query.Set("page", (current + 1).ToString(), QueryHistory.Push);
            }
        }
        """;
}
