@page "/form/docs"
@page "/docs/lux-form"
@layout Layout.DocsLayout

<PageTitle>Lux.Form · LuxStack Documentation</PageTitle>

<div class="pg-prose">
    <p class="pg-eyebrow">LuxStack Libraries · <a href="/form">Product Landing Page</a></p>
    <h1>Lux.Form</h1>
    <p class="pg-lead">
        Schema-driven, NativeAOT form engine with 31 declarative field kinds, reactive visibility conditions,
        dirty path diffing, output transforms, multi-step wizards with <code>SkipWhen</code>, sectioned <code>FormPage</code>,
        and programmatic overlay dialogs via <code>FormService</code>.
    </p>

    <h2>Packages &amp; Two-Layer Architecture</h2>
    <ul>
        <li><strong><code>Lux.Form.Core</code></strong> — 100% headless C#, zero UI dependency, <code>&lt;IsAotCompatible&gt;true&lt;/IsAotCompatible&gt;</code>. Houses <code>FormSchema</code>, <code>FormFieldSchema</code>, <code>FormStepSchema</code>, <code>FormController</code>, and <code>FormService</code>.</li>
        <li><strong><code>Lux.Form</code></strong> — Multiplatform Razor Class Library for Blazor Web &amp; .NET MAUI Blazor Hybrid. Provides <code>BxFormEngine</code>, <code>BxFormPage</code>, <code>BxFormProvider</code>, and <code>AddLuxForm()</code>.</li>
    </ul>

    <h2>Installation</h2>
    <CodeBlock Title="Terminal" Code="@InstallCmd" />
    <CodeBlock Title="Program.cs / MauiProgram.cs" Code="@RegisterCs" />

    <h2>Schema Definition &amp; Reactive Conditions</h2>
    <p>
        Every field declares its key, kind, validation constraints, conditional visibility (<code>Condition</code>),
        and optional output normalization (<code>TransformOutput</code>). When a field's <code>Condition</code> evaluates to
        <code>false</code>, it is automatically hidden, skipped during validation, and omitted from <code>BuildOutput()</code>.
    </p>
    <CodeBlock Title="ProfileForm.cs" Code="@SchemaCs" />

    <h2>Supported Field Kinds (31)</h2>
    <p>
        <code>FormFieldKind</code> covers text, email, password (with live <code>FormPasswordRequirement</code> checks),
        number, textarea, select, multi-select, autocomplete, checkbox, switch, radio, slider, date, time, datetime,
        color, tags, file, rating, one-time code, repeatable arrays, tabs, headings, dividers, and alerts.
    </p>

    <h2>Multi-Step Wizards with SkipWhen</h2>
    <p>
        Define <code>Steps</code> on <code>FormSchema</code> to turn <code>BxFormEngine</code> into a stepped wizard.
        Each <code>FormStepSchema</code> supports <code>SkipWhen = controller =&gt; ...</code> to bypass irrelevant steps dynamically
        (for example, skipping Billing when the selected plan is Free).
    </p>
    <CodeBlock Title="OnboardingWizard.cs" Code="@WizardCs" />

    <h2>Rendering with BxFormEngine, BxFormPage &amp; FormService</h2>
    <p>
        Mount <code>&lt;BxFormProvider /&gt;</code> once in your root layout to open schema-driven forms programmatically
        from C# via <code>FormService.OpenAsync(schema, initialValues)</code> in modals or slide-over drawers.
    </p>
    <CodeBlock Title="ProfilePage.razor" Code="@UiRazor" />

    <h2>Dirty Tracking &amp; Output Diffing</h2>
    <p>
        <code>FormController</code> maintains a baseline snapshot of initial values. Inspect <code>IsDirty</code> and
        <code>DirtyPaths</code> to warn users before navigation or send minimal PATCH payloads. After a successful
        <code>SubmitAsync()</code>, the baseline automatically resets so <code>IsDirty</code> returns to <code>false</code>.
    </p>

    <h2>API Reference</h2>
    <h3>BxFormEngine</h3>
    <ApiTable Of="typeof(BxFormEngine)" />
    <h3 class="mt-8">BxFormPage</h3>
    <ApiTable Of="typeof(BxFormPage)" />
    <h3 class="mt-8">FormController</h3>
    <ApiTable Of="typeof(FormController)" />
    <h3 class="mt-8">FormSchema</h3>
    <ApiTable Of="typeof(FormSchema)" />
</div>

@code {
    private const string InstallCmd = """
        dotnet add package Lux.Form.Core   # Headless NativeAOT schema & FormController
        dotnet add package Lux.Form        # Blazor Web & .NET MAUI Blazor Hybrid components
        """;

    private const string RegisterCs = """
        builder.Services.AddLuxForm();
        """;

    private const string SchemaCs = """
        using Blux.UI.Tools;

        var schema = new FormSchema
        {
            FormKey = "profile",
            Title = "User Profile",
            Fields =
            [
                new FormFieldSchema
                {
                    Key = "name",
                    Label = "Full Name",
                    Required = true,
                    DirtyCheck = true,
                    TransformOutput = v => v?.ToString()?.Trim()
                },
                new FormFieldSchema
                {
                    Key = "age",
                    Label = "Age",
                    Kind = FormFieldKind.Number,
                    Min = 18,
                    Max = 120,
                    DefaultValue = 25.0
                },
                new FormFieldSchema
                {
                    Key = "company",
                    Label = "Company",
                    Required = true,
                    Condition = f => f.GetValue<double>("age") >= 21
                },
                new FormFieldSchema
                {
                    Key = "password",
                    Label = "Password",
                    Kind = FormFieldKind.Password,
                    PasswordRequirements =
                    [
                        new FormPasswordRequirement("len", "At least 8 characters", s => s.Length >= 8)
                    ]
                }
            ]
        };

        var controller = new FormController(schema, new Dictionary<string, object?> { ["name"] = "Alice" });
        """;

    private const string WizardCs = """
        var wizardSchema = new FormSchema
        {
            FormKey = "onboarding",
            Title = "Workspace Onboarding",
            Steps =
            [
                new FormStepSchema
                {
                    Key = "account",
                    Title = "Account",
                    Fields = [new FormFieldSchema { Key = "plan", Label = "Plan", Required = true, DefaultValue = "free" }]
                },
                new FormStepSchema
                {
                    Key = "billing",
                    Title = "Billing",
                    SkipWhen = f => f.GetValue<string>("plan") == "free",
                    Fields = [new FormFieldSchema { Key = "vat", Label = "VAT Number", Required = true }]
                }
            ]
        };
        """;

    private const string UiRazor = """
        <BxFormEngine Form="@_controller"
                      SubmitLabel="Save profile"
                      ShowReset="true"
                      OnSubmit="@HandleSubmit" />

        @* Programmatic overlay host in MainLayout.razor *@
        <BxFormProvider />
        """;
}
