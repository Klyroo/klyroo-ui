@page "/docs/lux-spreadsheet"
@layout Layout.DocsLayout

<PageTitle>Lux.Spreadsheet · LuxStack Documentation</PageTitle>

<div class="pg-prose">
    <p class="pg-eyebrow">LuxStack Libraries · <a href="/stack/spreadsheet">Product Landing Page</a></p>
    <h1>Lux.Spreadsheet</h1>
    <p class="pg-lead">
        Headless, NativeAOT spreadsheet import engine with 20-row header layout detection, NFD accent-insensitive normalization,
        ≥80% pass-rate column suggestions, unknown value resolution questions, duplicate/upsert handling, inline cell editing,
        and batched submission with rejected-row retry.
    </p>

    <h2>Packages &amp; Two-Layer Architecture</h2>
    <ul>
        <li><strong><code>Lux.Spreadsheet.Core</code></strong> — 100% headless C#, zero UI dependency, <code>&lt;IsAotCompatible&gt;true&lt;/IsAotCompatible&gt;</code>. Houses <code>SpreadsheetSchema</code>, <code>SpreadsheetColumnSchema</code>, <code>SpreadsheetRule</code>, and <code>SpreadsheetImporter</code>.</li>
        <li><strong><code>Lux.Spreadsheet</code></strong> — Multiplatform Razor Class Library for Blazor Web &amp; .NET MAUI Blazor Hybrid. Provides <code>BxSpreadsheetImport</code> and <code>AddLuxSpreadsheet()</code>.</li>
    </ul>

    <h2>Installation</h2>
    <CodeBlock Title="Terminal" Code="@InstallCmd" />
    <CodeBlock Title="Program.cs / MauiProgram.cs" Code="@RegisterCs" />

    <h2>5-Step Intelligent Import Pipeline</h2>
    <ol>
        <li><strong>Source &amp; Layout Detection</strong> — Accepts CSV, TSV, or direct Excel/Google Sheets clipboard paste (<code>LoadText</code> / <code>Paste</code>). Scans up to 20 rows to skip report banners and automatically detect the delimiter and true header row.</li>
        <li><strong>NFD Normalization &amp; ≥80% Column Suggestions</strong> — Strips diacritics, asterisks, and markers (e.g. <code>"Prénom * (required)" → "prenom"</code>). For unmapped required fields, scores candidate columns against sample rows and suggests a match only when ≥80% of values pass type parsing and rules (without auto-applying silently).</li>
        <li><strong>Unknown Value Questions</strong> — For <code>Select</code> columns with <code>UnknownPolicy = SpreadsheetUnknownValuePolicy.Ask</code>, collects unrecognized values and lets users map, keep, or discard them globally.</li>
        <li><strong>Reconciliation &amp; Inline Review Grid</strong> — Flags intra-file duplicates (<code>Duplicates = Error | KeepFirst | KeepLast</code>), detects updates against <code>ExistingRecords</code> (<code>ExistingAction = Update | Skip | Error</code>), and supports live <code>EditCell(rowIndex, fieldKey, value)</code>.</li>
        <li><strong>Batched Submit &amp; Retry Rejected Rows</strong> — Sends importable rows in configurable batches and isolates server-rejected rows (<code>SpreadsheetRejectedRow</code>) so users can edit and retry only failed rows.</li>
    </ol>

    <h2>Headless Usage (Lux.Spreadsheet.Core · NativeAOT)</h2>
    <CodeBlock Title="RateImporter.cs" Code="@CoreCs" />

    <h2>Wizard UI (Blazor Web &amp; .NET MAUI Hybrid)</h2>
    <CodeBlock Title="ImportPage.razor" Code="@UiRazor" />

    <h2>API Reference</h2>
    <h3>BxSpreadsheetImport</h3>
    <ApiTable Of="typeof(BxSpreadsheetImport)" />
    <h3 class="mt-8">SpreadsheetImporter</h3>
    <ApiTable Of="typeof(SpreadsheetImporter)" />
    <h3 class="mt-8">SpreadsheetSchema</h3>
    <ApiTable Of="typeof(SpreadsheetSchema)" />
</div>

@code {
    private const string InstallCmd = """
        dotnet add package Lux.Spreadsheet.Core   # Headless NativeAOT importer & validation engine
        dotnet add package Lux.Spreadsheet        # 5-step Blazor Web & .NET MAUI Blazor Hybrid wizard
        """;

    private const string RegisterCs = """
        builder.Services.AddLuxSpreadsheet();
        """;

    private const string CoreCs = """
        using Blux.UI.Tools;

        var schema = new SpreadsheetSchema
        {
            Key = "rates",
            RowKeyField = "code",
            Duplicates = SpreadsheetDuplicatesPolicy.Error,
            ExistingAction = SpreadsheetExistingAction.Update,
            Columns =
            [
                new SpreadsheetColumnSchema { Key = "code", Label = "Code", Required = true },
                new SpreadsheetColumnSchema
                {
                    Key = "price",
                    Label = "Unit Price",
                    Kind = SpreadsheetColumnKind.Number,
                    DecimalSeparator = ',',
                    Required = true,
                    Rules = [SpreadsheetRule.Min(0)]
                },
                new SpreadsheetColumnSchema
                {
                    Key = "currency",
                    Label = "Currency",
                    Kind = SpreadsheetColumnKind.Select,
                    Required = true,
                    UnknownPolicy = SpreadsheetUnknownValuePolicy.Ask,
                    Options =
                    [
                        new SpreadsheetOption("EUR", "Euro", ["€", "EUR"]),
                        new SpreadsheetOption("USD", "US Dollar", ["$", "USD"])
                    ]
                }
            ]
        };

        var importer = new SpreadsheetImporter(schema);
        importer.LoadText("Export Report 2026;;\nCode;Amount;Currency\nA1;12,50;€\nA2;45,00;USD", "rates.csv");
        // importer.HeaderRowNumber == 2, importer.MissingFields[0].Suggestion.HeaderText == "Amount"
        """;

    private const string UiRazor = """
        <BxSpreadsheetImport Importer="@_importer"
                             Title="Import Product Rates"
                             Wizard="true" />
        """;
}
