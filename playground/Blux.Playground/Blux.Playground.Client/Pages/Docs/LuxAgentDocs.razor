@page "/docs/lux-agent"
@layout Layout.DocsLayout

<PageTitle>Lux.Agent · LuxStack Documentation</PageTitle>

<div class="pg-prose">
    <p class="pg-eyebrow">LuxStack Libraries · <a href="/stack/agent">Product Landing Page</a></p>
    <h1>Lux.Agent</h1>
    <p class="pg-lead">
        Semantic AI Agent Bridge (<code>snapshot</code>, <code>query</code>, <code>act</code>, <code>observe</code>),
        composable headless browser behaviors (<code>lux-behaviors.js</code>), WebMCP tool registration (<code>navigator.modelContext</code>),
        automatic <code>[redacted]</code> secret masking, permission policies, and bounded <code>UndoStack&lt;T&gt;</code> — inspired by <code>ui-sdk.dev</code>.
    </p>

    <h2>Packages &amp; Two-Layer Architecture</h2>
    <ul>
        <li><strong><code>Lux.Agent.Core</code></strong> — 100% headless C#, zero dependencies, <code>&lt;IsAotCompatible&gt;true&lt;/IsAotCompatible&gt;</code>. Houses <code>AgentComponentSnapshot</code>, <code>AgentQueryRequest</code>, <code>AgentQueryMatch</code>, <code>AgentActStep</code>, <code>AgentActResult</code>, <code>ObservedChange</code>, <code>AgentToolDefinition</code>, and <code>UndoStack&lt;T&gt;</code>.</li>
        <li><strong><code>Lux.Agent</code></strong> — Multiplatform Razor Class Library (<code>browser</code>, <code>ios</code>, <code>android</code>, <code>maccatalyst</code>, <code>windows</code>). Provides <code>AgentBridgeService</code>, <code>AddLuxAgent()</code>, and static web assets <code>_content/Lux.Agent/lux-agent.js</code> &amp; <code>_content/Lux.Agent/lux-behaviors.js</code>.</li>
    </ul>

    <h2>Installation</h2>
    <CodeBlock Title="Terminal" Code="@InstallCmd" />
    <CodeBlock Title="Program.cs / MauiProgram.cs" Code="@RegisterCs" />

    <h2>Why Semantic Agent Bridges Instead of CSS Selectors?</h2>
    <p>
        Traditional browser automation breaks whenever markup changes, cannot inspect closed dropdown options without clicking popups,
        and risks leaking sensitive inputs in DOM scrapes. <code>AgentBridgeService</code> exposes three concise, deterministic tools
        (returned by <code>AgentBridgeService.GetToolDefinitions()</code>):
    </p>
    <ul>
        <li><strong><code>snapshot</code></strong> — Lists up to 100 registered components with stable refs (<code>c1</code>, <code>c2</code>…), current value, disabled/off-page flags, and supported semantic actions. Password and one-time-code fields are always returned as <code>[redacted]</code>.</li>
        <li><strong><code>query</code></strong> — Finds controls by accent-insensitive label or kind, and inspects choices inside selects or dashboard filters without opening popups.</li>
        <li><strong><code>act</code></strong> — Executes a sequence of semantic steps (<code>setValue</code>, <code>toggle</code>, <code>clear</code>, <code>reset</code>, <code>submit</code>, <code>setView</code>, <code>editCell</code>) guarded by <code>AllowPolicy</code> and <code>ConfirmRequired</code>.</li>
    </ul>

    <h2>Bridging Forms, Dashboards &amp; Spreadsheets</h2>
    <CodeBlock Title="AgentIntegration.cs" Code="@BridgeCs" />

    <h2>Unified Observe Stream &amp; Secret Redaction</h2>
    <p>
        Subscribe via <code>agent.Observe(change =&gt; ...)</code> to capture every state mutation with <code>Previous</code>,
        <code>Value</code>, <code>Reason</code>, and <code>AgentChangeSource</code>. Sensitive fields never expose plaintext in snapshots or observed change events.
    </p>

    <h2>Bounded UndoStack&lt;T&gt; (NativeAOT)</h2>
    <p>
        <code>UndoStack&lt;T&gt;</code> provides an immutable-friendly undo/redo history stack with configurable depth limit,
        <code>Record(next)</code>, <code>Undo()</code>, <code>Redo()</code>, <code>CanUndo</code>, and <code>CanRedo</code>.
    </p>
    <CodeBlock Title="UndoHistory.cs" Code="@UndoCs" />

    <h2>Browser WebMCP &amp; Composable Behaviors</h2>
    <p>
        Include <code>_content/Lux.Agent/lux-agent.js</code> (already bundled in <code>Blux.UI</code>) to automatically expose
        <code>window.Blux.agent</code> and register <code>snapshot</code>, <code>query</code>, and <code>act</code> with
        <code>navigator.modelContext</code> (WebMCP) whenever supported by the browser.
    </p>
    <CodeBlock Title="Browser WebMCP" Code="@BrowserJs" />

    <h2>API Reference</h2>
    <h3>AgentBridgeService</h3>
    <ApiTable Of="typeof(AgentBridgeService)" />
    <h3 class="mt-8">AgentComponentSnapshot</h3>
    <ApiTable Of="typeof(AgentComponentSnapshot)" />
    <h3 class="mt-8">ObservedChange</h3>
    <ApiTable Of="typeof(ObservedChange)" />
    <h3 class="mt-8">UndoStack&lt;T&gt;</h3>
    <ApiTable Of="typeof(UndoStack<object>)" />
</div>

@code {
    private const string InstallCmd = """
        dotnet add package Lux.Agent.Core   # Zero-dependency NativeAOT models & UndoStack<T>
        dotnet add package Lux.Agent        # AgentBridgeService + WebMCP & Behaviors JS assets
        """;

    private const string RegisterCs = """
        builder.Services.AddLuxAgent();
        """;

    private const string BridgeCs = """
        using Blux.UI.Tools;

        agent.RegisterForm(form, confirmSubmit: true);
        agent.RegisterDashboard(dashboard);
        agent.RegisterSpreadsheet(importer);

        // Optional global permission policy for consequential actions
        agent.AllowPolicy = (step, confirmRequired) =>
            Task.FromResult(!confirmRequired || userApproved);

        // 1. Inspect page state (passwords are automatically "[redacted]")
        var snapshot = agent.Snapshot();

        // 2. Query select options accent-insensitively without opening popups
        var regions = agent.Query(new AgentQueryRequest { Within = "region", Text = "Europe" });

        // 3. Execute semantic actions in sequence
        var result = await agent.ActAsync([
            new AgentActStep("project name", "setValue", ["Atlas"]),
            new AgentActStep("region", "setValue", ["eu-west"])
        ]);
        """;

    private const string UndoCs = """
        var history = new UndoStack<string>("Initial", limit: 50);
        history.Record("Draft v2");
        history.Record("Published v3");

        history.Undo(); // Current == "Draft v2"
        history.Redo(); // Current == "Published v3"
        """;

    private const string BrowserJs = """
        const snap = window.Blux.agent.snapshot();
        const res  = await window.Blux.agent.act([
          { ref: 'Project name', action: 'setValue', args: ['Atlas'] }
        ]);
        const unsubscribe = window.Blux.agent.observe(evt => console.log(evt));
        """;
}
