@page "/display/docs"
@page "/docs/lux-display"
@layout Layout.DocsLayout

<PageTitle>Lux.Display · LuxStack Documentation</PageTitle>

<div class="pg-prose">
    <p class="pg-eyebrow">LuxStack Libraries · <a href="/display">Product Landing Page</a></p>
    <h1>Lux.Display</h1>
    <p class="pg-lead">
        19 read-only display blocks (<code>BxDisplay</code>), constrained Audio/Video media players with clip bounds and play quotas
        (<code>BxAudioPlayer</code>, <code>BxVideoPlayer</code>), and a multi-format modal file previewer (<code>FilePreviewService</code> &amp; <code>BxFilePreviewProvider</code>).
    </p>

    <h2>Packages &amp; Two-Layer Architecture</h2>
    <ul>
        <li><strong><code>Lux.Display.Core</code></strong> — 100% headless C#, zero UI dependency, <code>&lt;IsAotCompatible&gt;true&lt;/IsAotCompatible&gt;</code>. Houses <code>FilePreviewService</code>, MIME/extension kind detection, RFC 4180 CSV parser, and media progress/track models.</li>
        <li><strong><code>Lux.Display</code></strong> — Multiplatform Razor Class Library for Blazor Web &amp; .NET MAUI Blazor Hybrid. Provides <code>BxDisplay</code>, <code>BxAudioPlayer</code>, <code>BxVideoPlayer</code>, <code>BxFilePreviewProvider</code>, and <code>AddLuxDisplay()</code>.</li>
    </ul>

    <h2>Installation</h2>
    <CodeBlock Title="Terminal" Code="@InstallCmd" />
    <CodeBlock Title="Program.cs / MauiProgram.cs" Code="@RegisterCs" />

    <h2>19 Read-Only Display Blocks (BxDisplay)</h2>
    <p>
        <code>DisplayKind</code> covers 19 semantic read-only presentation patterns sharing a unified surface, tone, loading skeleton, and action API:
        <code>Heading</code>, <code>Text</code>, <code>Alert</code> (with expandable details), <code>Callout</code>, <code>Facts</code> (with copy buttons &amp; empty placeholders),
        <code>Stat</code> (with delta &amp; SVG sparkline), <code>Stats</code>, <code>Breakdown</code>, <code>Meter</code> (with warning/error thresholds),
        <code>Chart</code>, <code>Table</code>, <code>Diff</code> (before/after highlighting), <code>Records</code>, <code>People</code>, <code>Contacts</code>,
        <code>List</code> (with incremental Reveal More), <code>Timeline</code>, <code>Date</code>, <code>Code</code> (with <code>Variant="secret"</code> masking), and <code>Accordion</code>.
    </p>
    <CodeBlock Title="DisplayExamples.razor" Code="@DisplayRazor" />

    <h2>Constrained Audio &amp; Video Players</h2>
    <p>
        <code>BxAudioPlayer</code> and <code>BxVideoPlayer</code> go beyond standard HTML5 players with assessment and business constraints:
    </p>
    <ul>
        <li><strong>Clip Bounds (<code>Start</code> / <code>End</code>)</strong> — Play only a specific time window of a larger media asset.</li>
        <li><strong>Play Quotas (<code>MaxPlays</code> / <code>Plays</code>)</strong> — Limit how many times a user can listen or watch (e.g., language exams), firing <code>OnLimitReached</code> and locking playback automatically.</li>
        <li><strong>Seek Guard (<code>Seekable="false"</code>)</strong> — Prevents scrubbing forward or backward when strict linear playback is required.</li>
    </ul>
    <CodeBlock Title="ExamMedia.razor" Code="@MediaRazor" />

    <h2>Multi-Format FilePreviewService &amp; Lightbox</h2>
    <p>
        Mount <code>&lt;BxFilePreviewProvider /&gt;</code> once in your layout and call <code>FilePreviewService.Open(...)</code> from any component or service.
        Supports images (with zoom), PDFs, audio, video, code/text, and RFC 4180 CSV files parsed directly in <code>Lux.Display.Core</code>.
    </p>
    <CodeBlock Title="OpenPreview.cs" Code="@PreviewCs" />

    <h2>API Reference</h2>
    <h3>BxDisplay</h3>
    <ApiTable Of="typeof(BxDisplay)" />
    <h3 class="mt-8">BxAudioPlayer</h3>
    <ApiTable Of="typeof(BxAudioPlayer)" />
    <h3 class="mt-8">BxVideoPlayer</h3>
    <ApiTable Of="typeof(BxVideoPlayer)" />
    <h3 class="mt-8">FilePreviewService</h3>
    <ApiTable Of="typeof(FilePreviewService)" />
</div>

@code {
    private const string InstallCmd = """
        dotnet add package Lux.Display.Core   # Headless NativeAOT MIME detector, CSV parser & media models
        dotnet add package Lux.Display        # BxDisplay, BxAudioPlayer, BxVideoPlayer & BxFilePreviewProvider
        """;

    private const string RegisterCs = """
        builder.Services.AddLuxDisplay();
        """;

    private const string DisplayRazor = """
        <BxDisplay Kind="DisplayKind.Stat"
                   Title="MRR"
                   Value="€148,900"
                   Delta="+14.2%"
                   Trend="@([102.0, 118.0, 134.0, 148.9])" />

        <BxDisplay Kind="DisplayKind.Code"
                   Variant="secret"
                   Title="API Secret"
                   Value="sk_live_9876543210"
                   VisibleChars="4"
                   Copy="true" />

        <BxDisplay Kind="DisplayKind.Meter"
                   Title="Storage"
                   MeterValue="92" MeterMax="100"
                   WarningThreshold="75" ErrorThreshold="90" />
        """;

    private const string MediaRazor = """
        <BxAudioPlayer Src="/media/listening-test.mp3"
                       Title="Listening Comprehension · Extract 1"
                       Start="15" End="45"
                       MaxPlays="2"
                       Seekable="false"
                       OnLimitReached="@HandleQuotaReached" />
        """;

    private const string PreviewCs = """
        @inject FilePreviewService Preview

        @code {
            private void OpenDocs() => Preview.Open(
                new FilePreviewItem("architecture.png", "/img/sample-grid.png"),
                new FilePreviewItem("rates.csv", "/files/rates.csv"));
        }
        """;
}
