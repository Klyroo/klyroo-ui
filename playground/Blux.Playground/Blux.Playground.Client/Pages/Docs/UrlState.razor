@page "/docs/url-state"
@page "/{Mode}/docs/url-state"
@layout Layout.DocsLayout

<PageTitle>URL state · blux-ui</PageTitle>
<div class="pg-prose">
    <p class="pg-eyebrow">Data</p>
    <h1>URL state</h1>
    <p class="pg-lead">
        Keep the state of a page (a search, a filter, a sort, a page number) in the query string, so that a link shares it, Back undoes it and a
        reload keeps it. This is the equivalent of <code>useQueryState</code> and <code>useQueryStates</code> in the Nuxt UI tools, and it ships in
        <code>Blux.UI.Tools</code>; its codecs are in <code>Blux.UI.Tools.Query</code>, which an API server can reference to parse the same URLs.
    </p>

    <div class="not-prose my-6">
        <RendererBadge />
        <Example Of="typeof(Examples.UrlStateExample)" Title="Live example" Description="Type in the search box, click a filter, change the sort, then use Back and Forward. The address bar is the state." />
    </div>

    <h2>The URL is the source of truth</h2>
    <p>
        <code>QueryState</code> is a scoped service that <code>AddBluxUiTools</code> registers. It reads the query of the current URL and writes it back through
        <code>NavigationManager</code>. A component never keeps its own copy of what the URL holds: a link, the Back button and an address typed by
        the user all end up in <code>LocationChanged</code>, and every value bound to the URL follows. A change that leaves the state as it is notifies nobody,
        which is why a write of your own does not render the page twice.
    </p>

    <h2>One value</h2>
    <p>
        <code>Bind</code> ties a key to a typed value with a codec and a default. A key that is absent, or whose text the codec cannot read, gives the default;
        a value equal to the default is written as no key at all, so an untouched page keeps a clean URL.
    </p>
    <CodeBlock Title="Search.razor" Code="@OneValue" />

    <h2>A group of values</h2>
    <p>
        <code>Group</code> binds a record. Each property has a key and a codec, and one write is one navigation and one history entry. An optional prefix
        (<code>users</code> gives <code>users.q</code>, <code>users.page</code>) lets two lists share a page. The keys of a group are claimed: a second group of the page that uses the same key throws when it adds it,
        naming both owners, instead of silently writing over the first. Two groups with different keys can both have no prefix.
    </p>
    <CodeBlock Title="Users.razor" Code="@Group" />

    <h2>Push or replace</h2>
    <p>
        Typing in a search box should <strong>replace</strong> the current history entry, or Back would step through every letter. A page, a sort or an applied
        filter should <strong>push</strong>, so Back returns to the previous one. <code>QueryHistory.Replace</code> is the default; ask for <code>QueryHistory.Push</code> where
        a change is a place the user may want to return to. Writes made in the same event handler merge into one navigation after the handler yields, and if
        any of them pushes, the whole batch pushes. Parameters this service never wrote (<code>utm_source</code>, the keys of another component) stay in the URL untouched.
    </p>

    <h2>Static server rendering</h2>
    <p>
        Nothing is written without interactivity, because there is nothing to navigate with, and nothing is written while a page is prerendered. A page
        reads the URL as usual, and every change it offers is a link: <code>HrefWith</code> (on the service, on a bound value and on a group) builds the URL of the
        current page with a change applied. In the live example above, the filters, the pages and the clear button are links, and the search is a GET form that
        carries the other keys as hidden fields. Switch the render mode of the
        <a href="ssr/docs/url-state">static version</a>, the <a href="server/docs/url-state">server</a>, the <a href="wasm/docs/url-state">WebAssembly</a> or the
        <a href="auto/docs/url-state">auto</a> one: the URLs are the same in all of them. Give the service the renderer of a component with
        the <code>RendererInfo</code> of the component to <code>Bind</code> and <code>Group</code>: a write from a renderer that is not interactive changes nothing, and the
        navigation manager is never called (with <code>BlazorDisableThrowNavigationException</code> it would turn the call into a real redirect of the request). The raw
        <code>Set</code> needs <code>Query.UseRenderer(RendererInfo)</code> first and throws on the server without it.
    </p>
    <CodeBlock Title="StaticLinks.razor" Code="@Links" />

    <h2>Codecs</h2>
    <p>
        A codec is an <code>IQueryCodec&lt;T&gt;</code>: <code>TryParse(raw, out value)</code> and <code>Format(value)</code>, where a null result leaves the key out of the URL. A
        parse failure never throws; the caller gets its default. Numbers and dates use the invariant culture, so a URL means the same on every machine.
    </p>
    <ul data-testid="codec-list">
        <li><code>QueryCodecs.String</code>: as is.</li>
        <li><code>QueryCodecs.Int32</code> and <code>QueryCodecs.Int64</code>: an optional sign and digits.</li>
        <li><code>QueryCodecs.Decimal</code> and <code>QueryCodecs.Double</code>: invariant culture with a dot; a double is finite.</li>
        <li><code>QueryCodecs.Boolean</code>: <code>true</code> or <code>false</code>, in any case.</li>
        <li><code>QueryCodecs.DateOnly</code>: <code>yyyy-MM-dd</code>.</li>
        <li><code>QueryCodecs.DateTimeOffset</code>: the round-trip format, <code>2026-01-02T03:04:05.0000000+01:00</code>.</li>
        <li><code>QueryCodecs.Enum&lt;T&gt;()</code>: the member name, case-insensitive; <code>lowercase: true</code> writes it in lower case.</li>
        <li><code>QueryCodecs.Array(item)</code>: the items joined by a comma, escaped; an empty list leaves the key out.</li>
        <li><code>QueryCodecs.Range(item)</code>: <code>from..to</code>, either end optional.</li>
    </ul>
    <p>
        A list escapes its separator, <code>~</code> and <code>%</code> inside an item (<code>%2C</code>, <code>%7E</code>, <code>%25</code>) so any value round-trips, and an empty item is a lone <code>~</code>.
        <code>QueryCodecs.Optional</code> turns the codec of a struct into the codec of its nullable.
    </p>

    <h2>Subscriptions and claims</h2>
    <p>
        <code>Subscribe(prefix, handler)</code> calls the handler with the changed keys that match the prefix, whether the change came from a write or from the URL; a key
        matches when it equals the prefix or starts with the prefix and a dot, and the empty prefix matches all. <code>Claim(prefix, owner)</code> reserves a prefix, the
        empty one included, and throws when the page already holds the same one. A claim that meets one made before the last change of page (a layout, or a page reused for
        another route parameter) is judged once the render under way is over, because the router creates the next page before it disposes the previous one: if the old claim is
        still alive then, <code>QueryClaim.ThrowIfConflicted()</code> throws, and a group calls it every time it is used.
    </p>

    <h2>What the framework does</h2>
    <p>
        These notes come from running the live example above in the four render modes. A programmatic <code>NavigateTo</code> with <code>ReplaceHistoryEntry</code> rewrites the
        entry and raises <code>LocationChanged</code> in Interactive Server, WebAssembly and Auto, and so do Back and Forward and a click on a link the router handles. The
        value of <code>[SupplyParameterFromQuery]</code> follows the same URL, so the two never disagree; use it for a read-only parameter of a routable page, and
        <code>QueryState</code> wherever you also write. In static server rendering a link is handled by enhanced navigation, which patches the page and pushes an entry, and Back restores the previous one. BlazorWebView has not been run with this service yet: its navigation manager is expected to behave like the interactive ones.
    </p>
</div>

@code {
    [Parameter] public string? Mode { get; set; }

    private const string OneValue = """
        @inject QueryState Query
        @implements IDisposable

        <BxInput Value="@_search.Value" ValueChanged="v => _search.Value = v ?? string.Empty Debounce="300" />
        <p>Page @_page.Value</p>
        <BxButton Label="Next" OnClick="() => _page.Set(_page.Value + 1, QueryHistory.Push)" />

        @code {
            private QueryValue<string> _search = default!;
            private QueryValue<int> _page = default!;

            protected override void OnInitialized()
            {
                _search = Query.Bind("q", QueryCodecs.String, "", RendererInfo);   // typing replaces the entry
                _page = Query.Bind("page", QueryCodecs.Int32, 1, RendererInfo);    // page 1 is not written
                _search.Changed += () => _ = InvokeAsync(StateHasChanged);
                _page.Changed += () => _ = InvokeAsync(StateHasChanged);
            }

            public void Dispose() { _search.Dispose(); _page.Dispose(); }
        }
        """;

    private const string Group = """
        public sealed record Filters(string Q = "", Status Status = Status.All, int Page = 1);

        protected override void OnInitialized()
        {
            _filters = Query.Group(new Filters(), nameof(Users), RendererInfo, prefix: "users", history: QueryHistory.Push)
                .Add("q", f => f.Q, (f, v) => f with { Q = v }, QueryCodecs.String)
                .Add("status", f => f.Status, (f, v) => f with { Status = v }, QueryCodecs.Enum<Status>(lowercase: true))
                .Add("page", f => f.Page, (f, v) => f with { Page = v }, QueryCodecs.Int32);
            _filters.Changed += () => _ = InvokeAsync(StateHasChanged);
        }

        // One navigation, one history entry; users.page=1 and users.status=all are left out.
        private void Apply(Status status) => _filters.Update(f => f with { Status = status, Page = 1 });
        """;

    private const string Links = """
        @* Works in static server rendering, in a prerender and in every interactive mode. *@
        <a href="@_filters.HrefWith(_filters.Value with { Page = 2 })">Page 2</a>

        <form method="get">
            <input name="users.q" value="@_filters.Value.Q" />
            <button>Search</button>
        </form>
        """;
}
