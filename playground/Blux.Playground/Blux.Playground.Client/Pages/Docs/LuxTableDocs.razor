@page "/table/docs"
@page "/docs/lux-table"
@layout Layout.DocsLayout
@using Blux.UI.Tools.Query

<PageTitle>Lux.Table · LuxStack Documentation</PageTitle>

<div class="pg-prose">
    <p class="pg-eyebrow">LuxStack Libraries · <a href="/table">Product Landing Page</a></p>
    <h1>Lux.Table</h1>
    <p class="pg-lead">
        Enterprise-grade DataList and headless tree/grouping engine for Blazor Web and .NET MAUI Blazor Hybrid.
        Combines TanStack Table architecture with Nuxt UI Tools UX polish.
    </p>

    <h2>Packages &amp; Two-Layer Architecture</h2>
    <ul>
        <li><strong><code>Lux.Table.Core</code></strong> — 100% headless C#, zero UI dependency, <code>&lt;IsAotCompatible&gt;true&lt;/IsAotCompatible&gt;</code>. Contains <code>DataListTree&lt;TItem&gt;</code>, <code>DataListTreeNode&lt;TItem&gt;</code>, and <code>DataListTreeSelectionMode</code>.</li>
        <li><strong><code>Lux.Table</code></strong> — Multiplatform Razor Class Library (<code>browser</code>, <code>ios</code>, <code>android</code>, <code>maccatalyst</code>, <code>windows</code>). Ships <code>BxDataList</code>, <code>BxDataListTable</code>, <code>BxDataListGrid</code>, <code>BxDataListColumn</code>, <code>BxDataListToolbar</code>, <code>BxDataListFilterBar</code>, <code>BxDataListPagination</code>, <code>DataListGroupBy</code>, <code>DataListSummaries</code>, <code>DataListRowSummary</code>, and <code>Lux.Table.lib.module.js</code>.</li>
    </ul>

    <h2>Installation</h2>
    <CodeBlock Title="Terminal" Code="@InstallCmd" />
    <CodeBlock Title="Program.cs / MauiProgram.cs" Code="@RegisterCs" />

    <h2>Headless Tree Hierarchy (Lux.Table.Core · NativeAOT)</h2>
    <p>
        Build flattened tree models with nesting depth, parent pointers, sibling termination flags (<code>IsLast</code>),
        and vertical continuation rail metadata (<code>AncestorContinuations</code>) directly in headless C# or NativeAOT services.
    </p>
    <CodeBlock Title="TreeHierarchy.cs" Code="@TreeCs" />

    <h2>Full-Featured Table with HeaderMenu, Summaries &amp; Polish</h2>
    <p>
        <code>BxDataListTable</code> includes Nuxt UI Tools polish out of the box:
    </p>
    <ul>
        <li><strong><code>HeaderMenu="true"</code></strong> — Clicking a column header opens an accessible Sort Asc / Sort Desc / Clear Sort / Hide Column menu.</li>
        <li><strong><code>ShowProgressLine="true"</code></strong> — Displays a subtle 2px indeterminate progress bar during background reloads without hiding existing rows.</li>
        <li><strong><code>SkeletonKind</code></strong> — Adaptive loading skeletons (<code>DataListSkeletonKind.Table</code>, <code>Cards</code>, <code>Matrix</code>).</li>
        <li><strong><code>EmptyState</code></strong> — Distinguishes first-use empty lists (with primary onboarding CTA) from filtered-empty states (with reset filters button).</li>
        <li><strong><code>Summaries</code></strong> — Footer aggregations (<code>Sum</code>, <code>Average</code>, <code>Min</code>, <code>Max</code>, <code>Count</code>).</li>
    </ul>
    <CodeBlock Title="EmployeesTable.razor" Code="@TableRazor" />

    <h2>Responsive Mobile Summary Rows (iOS &amp; Android)</h2>
    <p>
        Provide <code>RowSummary</code> (<code>DataListRowSummary&lt;TItem&gt;</code>) so the table automatically switches into a compact,
        thumb-friendly summary list below <code>768px</code> (<code>AutoPhone = true</code>) while preserving selection checkboxes and row actions.
    </p>
    <CodeBlock Title="MobileSummary.razor" Code="@MobileRazor" />

    <h2>Related Deep-Dive Guides</h2>
    <ul>
        <li><a href="/components/data-list">Interactive BxDataList Component Reference &amp; Live Examples</a></li>
        <li><a href="/docs/data-list">Data List Sources, Remote APIs, Infinite Scroll &amp; Counts</a></li>
        <li><a href="/docs/url-state">URL State &amp; Saved Views</a></li>
    </ul>

    <h2>API Reference</h2>
    <h3>BxDataList&lt;TItem&gt;</h3>
    <ApiTable Of="typeof(BxDataList<object>)" />
    <h3 class="mt-8">BxDataListTable&lt;TItem&gt;</h3>
    <ApiTable Of="typeof(BxDataListTable<object>)" />
    <h3 class="mt-8">DataListTree&lt;TItem&gt;</h3>
    <ApiTable Of="typeof(DataListTree<object>)" />
</div>

@code {
    private const string InstallCmd = """
        dotnet add package Lux.Table.Core   # Headless NativeAOT tree hierarchy models
        dotnet add package Lux.Table        # Full Blazor Web & .NET MAUI Blazor Hybrid DataList
        """;

    private const string RegisterCs = """
        builder.Services.AddLuxTable(options =>
        {
            options.DefaultPageSize = 25;
        });
        """;

    private const string TreeCs = """
        using Blux.UI.Tools;

        var tree = new DataListTree<Employee>
        {
            Children = e => e.Reports,
            DefaultExpandedDepth = 1,
            Selectable = DataListTreeSelectionMode.All
        };

        var (roots, allNodes) = tree.BuildTree(employees, schema);
        """;

    private const string TableRazor = """
        <BxDataList TItem="Employee" Schema="@_schema" Items="@_employees" UrlSync="true">
            <BxDataListToolbar TItem="Employee" />
            <BxDataListTable TItem="Employee"
                             HeaderMenu="true"
                             ShowProgressLine="true"
                             Summaries="@(new DataListSummaries<Employee>())">
                <BxDataListColumn TItem="Employee" Field="name" Title="Employee" />
                <BxDataListColumn TItem="Employee" Field="department" Title="Department" />
                <BxDataListColumn TItem="Employee" Field="salary" Title="Salary"
                                  Summary="DataListSummaryKind.Sum" />
            </BxDataListTable>
            <BxDataListPagination TItem="Employee" />
        </BxDataList>
        """;

    private const string MobileRazor = """
        private static readonly DataListRowSummary<Employee> PhoneSummary = new()
        {
            Title = e => e.Name,
            Details = e => [e.Department, $"€{e.Salary:N0}"],
            AutoPhone = true
        };
        """;
}
