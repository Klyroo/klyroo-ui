@page "/docs/internationalization"
@layout Layout.DocsLayout

<PageTitle>Internationalization · blux-ui</PageTitle>
<div class="pg-prose">
    <p class="pg-eyebrow">Getting started</p>
    <h1>Internationalization</h1>
    <p class="pg-lead">
        Every text a component renders comes from a locale: a code, a name, a writing direction and a set of messages.
        Twelve are built in, and components follow the culture of the user without any code.
    </p>

    <h2>Built-in locales</h2>
    <p>
        <code>BxLocales.All</code> holds them. Each one is a <code>BxLocale(Code, Name, Dir, Messages)</code>;
        the messages are a <code>BxMessages</code> record with one property per text, in English by default.
    </p>
    <div class="not-prose my-4 overflow-x-auto rounded-lg border border-(--blux-border)">
        <table class="w-full text-start text-sm" data-testid="locale-list">
            <caption class="sr-only">Built-in locales</caption>
            <thead><tr class="border-b border-(--blux-border) text-(--blux-text-muted)"><th scope="col" class="px-3 py-2 text-start font-medium">Property</th><th scope="col" class="px-3 py-2 text-start font-medium">Code</th><th scope="col" class="px-3 py-2 text-start font-medium">Name</th><th scope="col" class="px-3 py-2 text-start font-medium">Direction</th></tr></thead>
            <tbody>
                @foreach (var (property, locale) in Locales)
                {
                    <tr class="border-b border-(--blux-border) last:border-0">
                        <td class="px-3 py-2 font-mono text-xs">BxLocales.@property</td>
                        <td class="px-3 py-2 font-mono text-xs">@locale.Code</td>
                        <td class="px-3 py-2" lang="@locale.Code" dir="@locale.DirAttribute">@locale.Name</td>
                        <td class="px-3 py-2 font-mono text-xs">@locale.Dir</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2>Automatic: follow the culture</h2>
    <p>
        This is the equivalent of the <code>@@nuxtjs/i18n</code> integration of Nuxt UI, and it needs no component code.
        A component picks its locale from <code>CultureInfo.CurrentUICulture</code>: the exact code (<code>pt-BR</code>),
        then its parent cultures (<code>pt-PT</code> gets <code>pt</code>, <code>zh-Hans-CN</code> tries <code>zh-Hans</code> then
        <code>zh</code>), then English. That is exactly what <code>UseRequestLocalization</code> does with the supported cultures, on purpose:
        there is no "same language" step, so <code>zh-TW</code> gets English unless you offer a <code>zh-TW</code> or a <code>zh</code> locale,
        and a server and a client that follow the same culture never pick different locales.
        The choice is cached per culture.
    </p>
    <p>
        On the server, ASP.NET Core request localization sets the culture of each request, in static rendering and in
        Interactive Server alike. A WebAssembly client has no request, and its runtime starts from the language of the browser,
        which can differ from what the server chose (a visitor with <code>Accept-Language: ca,es;q=0.9</code> gets Spanish from the server but Catalan from the browser).
        <code>ApplyServerCultureAsync</code> gives the client the culture the server rendered with. It reads, in this order:
        the <code>blux-culture</code> meta element that <code>&lt;BxCultureMeta /&gt;</code> renders in <code>&lt;head&gt;</code>
        (the exact culture and UI culture of the request, whichever provider chose them), then the culture cookie,
        then the <code>lang</code> attribute of the <code>html</code> element. Pass the supported cultures so that a cookie or an attribute
        outside the list is ignored, as the server ignores it.
    </p>
    <CodeBlock Title="Program.cs (server)" Code="@ServerSetup" />
    <CodeBlock Title="Program.cs (client)" Code="@ClientSetup" />

    <h2>Setting the locale</h2>
    <p>
        <code>BxApp</code> takes a <code>Locale</code> and cascades it to everything below. Components read, in this order:
        the cascaded locale, <code>BluxOptions.Locale</code>, then the locale matching the UI culture among <code>BluxOptions.Locales</code>
        (all built-in ones by default).
    </p>
    <CodeBlock Code="@AppLocale" />
    <CodeBlock Title="Program.cs" Code="@Options" />
    <Example Of="typeof(Examples.LocalePanelsExample)" Title="One locale per subtree" Description="The panels are all in this page, and each one has its own language, direction and date format." />
    <div class="mt-12"></div>
    <Example Of="typeof(Examples.LocaleSwitchExample)" Title="Switching at runtime" Description="Changing the Locale parameter re-renders the components below it. The buttons need interactivity." />

    <h2>Changing a few messages</h2>
    <p>
        <code>BxLocales.Extend</code> is the equivalent of <code>extendLocale</code>: it copies a locale and overrides what you list.
        Messages are an immutable record, so a plain <code>with</code> expression works too. A message with placeholders
        (<code>{0}</code>, <code>{1}</code>) keeps them in a translation.
    </p>
    <CodeBlock Code="@Extend" />
    <Example Of="typeof(Examples.LocaleExtendExample)" Title="Extending a locale" />

    <h2>A locale of your own</h2>
    <p>Equivalent of <code>defineLocale</code>. Start from <code>new BxMessages()</code> (English) or from <code>with</code> on another locale, and add it to <code>BluxOptions.Locales</code> so the automatic choice and the locale select find it.</p>
    <CodeBlock Code="@Custom" />

    <h2>Right to left</h2>
    <p>
        A locale carries its direction (<code>BxLocales.Ar</code> is <code>BxDirection.Rtl</code>). <code>BxApp</code> writes <code>lang</code> and
        <code>dir</code> from it unless you set <code>Lang</code> or <code>Dir</code>. To flip the whole page, put them on the
        <code>html</code> element too, with the same resolution:
    </p>
    <CodeBlock Title="App.razor" Code="@HtmlLangDir" />
    <p>
        Components use logical utilities (<code>ms-</code>, <code>pe-</code>, <code>start-</code>, <code>rounded-s</code>) and mirror their arrows
        and chevrons with <code>rtl:</code> variants, so they follow the direction on their own. Use the same utilities in your own markup.
    </p>

    <h2>Dates, numbers and sizes</h2>
    <p>
        Components with a <code>Culture</code> parameter (Calendar, InputDate, InputTime, InputNumber, InputRating, BlogPost, ChangelogVersion, Chart,
        PricingTable), the file size of FileUpload and the numbers inside messages format with the regional culture of the user when it speaks the
        language of the locale: an <code>en-GB</code> user with the English locale keeps <code>20/11/2026</code>, Monday as first day and a 24 hour clock,
        and <code>fr-CA</code> keeps its formats with the French locale. When the locale is another language than the culture of the user
        (a French <code>BxApp</code> on an <code>en-GB</code> page), the culture of the locale is used, so the page shows French dates.
        An explicit <code>Culture</code> parameter still wins. File sizes use the units of the locale (<code>1,5 Ko</code> in French).
        To keep a regional culture on the server, list it in <code>AddSupportedCultures</code>; the WebAssembly client receives it through <code>BxCultureMeta</code>.
    </p>

    <h2>Language select</h2>
    <p><code>BxLocaleSelect</code> lists <code>BluxOptions.Locales</code> by default, writes the culture cookie and reloads, so the next request is rendered in that language. See the <a href="/components/locale-select">LocaleSelect</a> page.</p>

    <h2>Migrating from Options.Strings</h2>
    <p><code>BluxOptions.Strings</code> and <code>BluxStrings</code> are gone: texts are an immutable <code>BxMessages</code> carried by a locale.</p>
    <CodeBlock Code="@Migration" />
</div>

@code {
    private static readonly (string Property, BxLocale Locale)[] Locales =
    [
        ("En", BxLocales.En), ("Fr", BxLocales.Fr), ("De", BxLocales.De), ("Es", BxLocales.Es), ("It", BxLocales.It), ("Pt", BxLocales.Pt),
        ("PtBr", BxLocales.PtBr), ("Nl", BxLocales.Nl), ("Ja", BxLocales.Ja), ("ZhCn", BxLocales.ZhCn), ("Ar", BxLocales.Ar), ("Ru", BxLocales.Ru),
    ];

    private const string ServerSetup = """
        // The supported UI cultures are the codes of the locales you offer. Add regional cultures
        // to the supported cultures to format dates and numbers for them (en-GB: 20/11/2026, 24 hour clock).
        var uiCultures = BxLocales.All.Select(locale => locale.Code).ToArray();
        app.UseRequestLocalization(new RequestLocalizationOptions()
            .SetDefaultCulture("en")
            .AddSupportedCultures([.. uiCultures, "en-GB", "fr-CA"])
            .AddSupportedUICultures(uiCultures));
        """;

    private const string ClientSetup = """
        var host = builder.Build();
        // Takes the culture the server rendered with (meta element, culture cookie, then the lang attribute of <html>)
        // instead of the language of the browser, so the client picks the same locale as the server.
        await host.Services.ApplyServerCultureAsync(BxLocales.All.Select(locale => locale.Code));
        await host.RunAsync();
        """;

    private const string AppLocale = """
        <BxApp Locale="BxLocales.Fr">
            @Body
        </BxApp>
        """;

    private const string Options = """
        builder.Services.AddBluxUi(o =>
        {
            // A fixed locale for the whole app, whatever the culture of the user:
            // o.Locale = BxLocales.De;

            // Or limit and extend what the automatic choice picks from. The list is copied here, and
            // Locale and Locales become read-only when the first component resolves a locale:
            o.Locales = [BxLocales.En, BxLocales.Fr, BxLocales.Ar];
        });
        """;

    private const string Extend = """
        var australian = BxLocales.Extend(BxLocales.En,
            code: "en-AU",
            name: "English (Australia)",
            messages: m => m with { SearchCommands = "Find a command..." });

        builder.Services.AddBluxUi(o => o.Locales = [.. BxLocales.All, australian]);
        """;

    private const string Custom = """
        var esperanto = new BxLocale("eo", "Esperanto", BxDirection.Ltr, new BxMessages
        {
            Close = "Fermi",
            Notifications = "Sciigoj",
            // ... every message you do not set stays in English
        });
        """;

    private const string HtmlLangDir = """
        @using System.Globalization
        @{ var locale = BxLocales.Resolve(CultureInfo.CurrentUICulture); }
        <html lang="@locale.Code" dir="@locale.DirAttribute">
        """;

    private const string Migration = """
        // Before
        builder.Services.AddBluxUi(o => o.Strings.Close = "Fermer");

        // After
        builder.Services.AddBluxUi(o => o.Locale = BxLocales.Extend(BxLocales.En, messages: m => m with { Close = "Fermer" }));
        // or, to translate everything, pick a built-in locale: o.Locale = BxLocales.Fr
        """;
}
