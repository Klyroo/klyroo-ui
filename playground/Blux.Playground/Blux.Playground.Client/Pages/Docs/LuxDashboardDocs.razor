@page "/dashboard/docs"
@page "/docs/lux-dashboard"
@layout Layout.DocsLayout

<PageTitle>Lux.Dashboard · LuxStack Documentation</PageTitle>

<div class="pg-prose">
    <p class="pg-eyebrow">LuxStack Libraries · <a href="/dashboard">Product Landing Page</a></p>
    <h1>Lux.Dashboard</h1>
    <p class="pg-lead">
        Analytical dashboard engine with 3-wave staged query orchestration (<code>Essential</code> → <code>Background</code> → <code>Deferred</code>),
        global reactive filters, leap-year-safe comparison ranges, RFC 4180 UTF-8 BOM CSV export, and 13 visualization blocks.
    </p>

    <h2>Packages &amp; Two-Layer Architecture</h2>
    <ul>
        <li><strong><code>Lux.Dashboard.Core</code></strong> — 100% headless C#, zero UI dependency, <code>&lt;IsAotCompatible&gt;true&lt;/IsAotCompatible&gt;</code>. Contains <code>DashboardController</code>, <code>DashboardResource&lt;T&gt;</code>, <code>DashboardFilterControl</code>, <code>DashboardFormat</code>, and all data models.</li>
        <li><strong><code>Lux.Dashboard</code></strong> — Multiplatform Razor Class Library for Blazor Web &amp; .NET MAUI Blazor Hybrid. Ships all 13 analytical components and <code>AddLuxDashboard()</code>.</li>
    </ul>

    <h2>Installation</h2>
    <CodeBlock Title="Terminal" Code="@InstallCmd" />
    <CodeBlock Title="Program.cs / MauiProgram.cs" Code="@RegisterCs" />

    <h2>3-Wave Staged Query Orchestration</h2>
    <p>
        Register each data source with a <code>DashboardQueryStage</code>:
    </p>
    <ul>
        <li><strong><code>Essential</code></strong> — Runs first when <code>RefreshAsync()</code> is invoked (top-line KPIs and executive stats).</li>
        <li><strong><code>Background</code></strong> — Runs immediately after Essential completes (charts, breakdowns, ranked lists).</li>
        <li><strong><code>Deferred</code></strong> — Stays <code>Idle</code> during initial load until explicitly triggered (heavy audit logs or secondary tabs).</li>
    </ul>
    <CodeBlock Title="AnalyticsDashboard.cs" Code="@ControllerCs" />

    <h2>13 Built-In Analytical Components</h2>
    <ul>
        <li><code>BxDashboardPage</code> — Top-level shell with title, view tabs with badges, filter toolbar, and global Reset/Refresh controls.</li>
        <li><code>BxDashboardGrid</code> &amp; <code>BxDashboardCard</code> — Responsive 12-column analytical layout grid and card container with freshness badges and action menus.</li>
        <li><code>BxDashboardStat</code> &amp; <code>BxDashboardStats</code> — Single KPI card (with sparkline, comparison delta, and goal bar) and multi-metric KPI strip.</li>
        <li><code>BxDashboardGauge</code> — Circular SVG gauge with target tick and formatted center value.</li>
        <li><code>BxDashboardBars</code>, <code>BxDashboardList</code>, <code>BxDashboardDetails</code> — Horizontal bar distributions, ranked lists, and key/value detail grids.</li>
        <li><code>BxDashboardTable</code> — Sortable analytical table with inline bar/delta columns and one-click CSV export.</li>
        <li><code>BxDashboardAlerts</code>, <code>BxDashboardFeed</code>, <code>BxDashboardChart</code> — Severity-coded alerts, activity feeds, and chart containers.</li>
    </ul>
    <CodeBlock Title="RevenueDashboard.razor" Code="@UiRazor" />

    <h2>Formatting, Comparison Ranges &amp; CSV Export</h2>
    <p>
        <code>DashboardFormat</code> handles null/NaN safe formatting (<code>Compact</code>, <code>Delta</code>, <code>Points</code>, <code>Ratio</code>, <code>Percent</code>),
        leap-year-accurate comparison windows (<code>Feb 29, 2024 → Feb 28, 2023</code>), slugified filenames, and locale-aware UTF-8 BOM CSV export.
    </p>
    <CodeBlock Title="FormatAndExport.cs" Code="@FormatCs" />

    <h2>API Reference</h2>
    <h3>BxDashboardPage</h3>
    <ApiTable Of="typeof(BxDashboardPage)" />
    <h3 class="mt-8">BxDashboardStats</h3>
    <ApiTable Of="typeof(BxDashboardStats)" />
    <h3 class="mt-8">BxDashboardGauge</h3>
    <ApiTable Of="typeof(BxDashboardGauge)" />
    <h3 class="mt-8">BxDashboardTable</h3>
    <ApiTable Of="typeof(BxDashboardTable)" />
    <h3 class="mt-8">DashboardController</h3>
    <ApiTable Of="typeof(DashboardController)" />
</div>

@code {
    private const string InstallCmd = """
        dotnet add package Lux.Dashboard.Core   # Headless NativeAOT controller, filters & formatters
        dotnet add package Lux.Dashboard        # 13 Blazor Web & .NET MAUI Blazor Hybrid blocks
        """;

    private const string RegisterCs = """
        builder.Services.AddLuxDashboard();
        """;

    private const string ControllerCs = """
        using Blux.UI.Tools;

        var dashboard = new DashboardController("analytics");
        dashboard.AddView("overview", "Overview", badge: "3");
        dashboard.AddView("details", "Details");

        var yearFilter = dashboard.AddFilter(new DashboardFilterControl(
            "year", "Year",
            items: [new DashboardOption("2025", "2025"), new DashboardOption("2026", "2026")],
            defaultValues: ["2026"]));

        var summary = dashboard.RegisterResource(new DashboardResource<int>(
            "summary", LoadSummaryAsync, DashboardQueryStage.Essential));
        var trend = dashboard.RegisterResource(new DashboardResource<double[]>(
            "trend", LoadTrendAsync, DashboardQueryStage.Background));
        var audit = dashboard.RegisterResource(new DashboardResource<string>(
            "audit", LoadAuditAsync, DashboardQueryStage.Deferred));

        await dashboard.RefreshAsync(); // Runs Essential -> Background; audit remains Idle
        """;

    private const string UiRazor = """
        <BxDashboardPage Dashboard="@_dashboard" Title="Revenue Analytics">
            <BxDashboardGrid Menu="true" Freshness="true">
                <BxDashboardStats Title="Executive KPIs" Items="@_stats" />
                <BxDashboardGauge Title="Q4 ARR Target" Value="86" Max="100" Target="90"
                                  Format="DashboardFormatPreset.Percent" />
                <BxDashboardBars Title="Channels" Items="@_bars"
                                 Format="DashboardFormatPreset.Compact" />
            </BxDashboardGrid>
        </BxDashboardPage>
        """;

    private const string FormatCs = """
        DashboardFormat.Format(12600, DashboardFormatPreset.Compact, CultureInfo.InvariantCulture); // "12.6K"
        DashboardFormat.Format(14.2, DashboardFormatPreset.Delta, CultureInfo.InvariantCulture);    // "+14.2%"
        DashboardFormat.Format(0.57, DashboardFormatPreset.Ratio, CultureInfo.InvariantCulture);    // "57%"

        var csv = DashboardFormat.ExportCsv(table, CultureInfo.GetCultureInfo("fr-FR"));
        """;
}
