@* Decorative falling pixel rain. Positions are fixed so server and client render the same markup. *@
<div class="pg-rain" aria-hidden="true">
    @foreach (var (left, height, duration, delay) in Drops)
    {
        <i style="@($"left:{left}%;--h:{height}px;--d:{duration}s;--delay:{delay}s")"></i>
    }
</div>

@code {
    private static readonly (int Left, int Height, double Duration, double Delay)[] Drops =
    [
        (3, 40, 9.5, 0), (8, 64, 12, 2.5), (14, 32, 8, 5), (19, 56, 11, 1), (26, 40, 10, 6.5), (31, 72, 13, 3),
        (38, 36, 9, 8), (44, 52, 12.5, 0.5), (51, 44, 10.5, 4.5), (57, 68, 14, 7), (63, 32, 8.5, 2), (69, 56, 11.5, 9),
        (74, 40, 9.5, 3.5), (80, 64, 13, 0.8), (86, 36, 10, 5.5), (91, 52, 12, 1.8), (96, 44, 9, 7.5), (47, 28, 7.5, 10),
    ];
}
