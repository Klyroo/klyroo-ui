@using Blux.Playground.Client.Docs

@*
    Live demonstration of the library's point: use a component and watch two logs. The left one is filled by site.js
    from browser events (no .NET involved); the right one by the .NET callbacks the demo binds.
*@
<div data-pg-showcase>
    <BxTabs Items="Demos()" AriaLabel="Pick a component" @bind-Value="_demo"
            Ui="@(new TabsUi { List = "w-fit flex-wrap gap-1.5 bg-transparent p-0", Trigger = "flex-none rounded-md border border-(--blux-border) bg-(--blux-bg) px-3 py-1.5 font-mono text-xs text-(--blux-text-muted) aria-selected:border-(--blux-primary) aria-selected:bg-(--blux-primary) aria-selected:text-(--blux-primary-contrast) aria-selected:shadow-none", Root = "gap-5" })" />
</div>

@code {
    private string? _demo = "modal";
    private bool _modalOpen;
    private string? _name = "Apollo";
    private string? _country;
    private string? _tab = "overview";
    private bool _notify = true;
    private readonly Dictionary<string, List<string>> _dotnet = [];

    private sealed record Demo(string Key, string Label, string File, string[] Code, int Highlight, RenderFragment Live);

    private static readonly BxSelectItem[] Countries = [new("fr", "France"), new("de", "Germany"), new("jp", "Japan"), new("br", "Brazil")];

    private static readonly BxMenuItem[] Menu =
    [
        new() { Label = "Rename", Shortcut = "R" },
        new() { Label = "Duplicate", Shortcut = "D" },
        BxMenuItem.Separator(),
        new() { Label = "Delete", Color = BxColor.Error },
    ];

    private void OnModal(bool open) { _modalOpen = open; Log("modal", $"OpenChanged({Bool(open)})"); }
    private void OnName(string? name) { _name = name; Log("modal", $"ValueChanged(\"{name}\")"); }
    private void OnCountry(string? country) { _country = country; Log("select", $"ValueChanged(\"{country}\")"); }
    private void OnTab(string? tab) { _tab = tab; Log("tabs", $"ValueChanged(\"{tab}\")"); }
    private void OnMenu(BxMenuItem item) => Log("menu", $"OnSelect(\"{item.Label}\")");
    private void OnNotify(bool on) { _notify = on; Log("switch", $"ValueChanged({Bool(on)})"); }
    private static string Bool(bool value) => value ? "true" : "false";

    private void Log(string demo, string line)
    {
        if (!_dotnet.TryGetValue(demo, out var lines)) _dotnet[demo] = lines = [];
        lines.Insert(0, $"{DateTime.Now:HH:mm:ss.f}  {line}");
        if (lines.Count > 6) lines.RemoveAt(6);
    }

    private IReadOnlyList<BxTabItem> Demos() =>
    [
        Item(new("modal", "Modal", "RenameDialog.razor",
        [
            "<BxModal @bind-Open=\"open\" Title=\"Rename project\">",
            "    <ChildContent><BxButton Label=\"Rename\" /></ChildContent>",
            "    <Body><BxInput @bind-Value=\"name\" /></Body>",
            "    <Footer>",
            "        <BxButton Label=\"Save\" data-bx-close />",
            "    </Footer>",
            "</BxModal>",
        ], 0, @<BxModal Open="_modalOpen" OpenChanged="OnModal" Title="Rename project" Size="BxSize.Sm">
                <ChildContent><BxButton Label="Rename" /></ChildContent>
                <Body><BxFormField Label="Project name"><BxInput Value="@_name" ValueChanged="OnName" /></BxFormField></Body>
                <Footer><BxButton Label="Save" data-bx-close /></Footer>
            </BxModal>)),

        Item(new("select", "Select", "CountryPicker.razor",
        [
            "<BxFormField Label=\"Country\">",
            "    <BxSelect @bind-Value=\"country\"",
            "              Items=\"Countries\"",
            "              Placeholder=\"Choose…\" />",
            "</BxFormField>",
        ], 1, @<div class="w-56"><BxFormField Label="Country"><BxSelect Value="@_country" ValueChanged="OnCountry" Items="Countries" Placeholder="Choose…" /></BxFormField></div>)),

        Item(new("tabs", "Tabs", "ProjectTabs.razor",
        [
            "<BxTabs Items=\"tabs\"",
            "        @bind-Value=\"tab\"",
            "        Variant=\"TabsVariant.Link\" />",
        ], 1, @<div class="w-64"><BxTabs Variant="TabsVariant.Link" AriaLabel="Project" Value="@_tab" ValueChanged="OnTab"
                    Items="@([new("Overview") { Value = "overview", Content = TabText("Overview") }, new("Activity") { Value = "activity", Content = TabText("Activity") }, new("Settings") { Value = "settings", Content = TabText("Settings") }])" /></div>)),

        Item(new("menu", "DropdownMenu", "RowActions.razor",
        [
            "<BxDropdownMenu Items=\"actions\"",
            "                OnSelect=\"Run\">",
            "    <BxButton Label=\"Actions\" />",
            "</BxDropdownMenu>",
        ], 1, @<BxDropdownMenu Items="Menu" OnSelect="OnMenu"><BxButton Label="Actions" Color="BxColor.Neutral" Variant="ButtonVariant.Outline" TrailingIcon='BxIcons.Named("chevron-down")' /></BxDropdownMenu>)),

        Item(new("switch", "Switch", "Preferences.razor",
        [
            "<BxSwitch @bind-Value=\"notify\"",
            "          Label=\"Email me\"",
            "          Description=\"Weekly digest\" />",
        ], 0, @<BxSwitch Value="_notify" ValueChanged="OnNotify" Label="Email me" Description="Weekly digest" />)),
    ];

    private static RenderFragment TabText(string text) => @<p class="pt-3 text-sm text-(--blux-text-muted)">@text panel</p>;

    private BxTabItem Item(Demo demo) => new(demo.Label) { Value = demo.Key, Content = Panel(demo) };

    private RenderFragment Panel(Demo demo) =>
        @<div class="relative grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-12" data-pg-demo="@demo.Key">
            @* Code panel *@
            <div class="relative self-start overflow-hidden rounded-xl border border-(--blux-border) bg-(--pg-code-bg) shadow-[0_28px_60px_-30px_#000c]">
                <div class="flex items-center justify-between border-b border-white/10 bg-(--pg-code-head) px-4 py-2.5">
                    <span class="font-mono text-xs text-[#d7dcde]">@demo.File</span>
                    <span class="font-mono text-[11px] uppercase tracking-widest text-[#a3a9ac]"><span class="font-pixel text-lg text-[#ffd23f]">@demo.Code.Length</span> lines</span>
                </div>
                <div class="py-3 font-mono text-[13px]/6">
                    @for (var i = 0; i < demo.Code.Length; i++)
                    {
                        var hit = i == demo.Highlight;
                        <div class="@(hit ? "flex border-s-2 border-[#ffd23f] bg-(--pg-code-line)" : "flex border-s-2 border-transparent")">
                            <span class="w-10 shrink-0 select-none pe-3 text-end text-[#7d858a]" aria-hidden="true">@(i + 1)</span>
                            <code class="whitespace-pre text-[#d7dcde]">@((MarkupString)Highlighter.ToHtml(demo.Code[i]))</code>
                        </div>
                    }
                </div>
                <p class="border-t border-white/10 px-4 py-2.5 font-mono text-[11px] text-[#9aa1a6]">// highlighted: the only line that talks to .NET</p>
            </div>

            @* Right column: live component and the two logs, wired to the code panel. *@
            <div class="relative flex flex-col gap-4">
                <span class="pg-wire hidden border-t lg:block before:-start-1 before:-top-[3.5px] after:-end-1 after:-top-[3.5px]" style="left:-3rem;width:3rem;top:4.5rem" aria-hidden="true"></span>
                <span class="pg-wire hidden border-s lg:block before:-start-[3.5px] before:-top-1 after:-start-[3.5px] after:-bottom-1" style="left:-1.5rem;top:4.5rem;bottom:11.25rem" aria-hidden="true"></span>

                <div class="rounded-xl border border-(--blux-border) bg-(--blux-bg)">
                    <PanelHead Title="Live component" Note="try it" />
                    <div class="pg-dots flex min-h-36 items-center justify-center p-6">@demo.Live</div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="relative rounded-xl border border-(--blux-border) bg-(--blux-bg)">
                        <span class="pg-wire hidden border-t lg:block before:-start-1 before:-top-[3.5px] after:hidden" style="left:-1.5rem;width:1.5rem;top:1.15rem" aria-hidden="true"></span>
                        <PanelHead Title="In the browser" Note="no .NET" />
                        @* Filled by site.js; Blazor never renders children here. *@
                        <ol class="h-40 overflow-hidden px-3 py-2 font-mono text-[11px]/5 text-(--blux-text-muted)" data-pg-log="browser" aria-label="Events handled in the browser"></ol>
                    </div>
                    <div class="rounded-xl border border-(--blux-border) bg-(--blux-bg)">
                        <PanelHead Title="Sent to .NET" Note="@(RendererInfo.IsInteractive ? RendererInfo.Name : "static page")" />
                        <ol class="h-40 overflow-hidden px-3 py-2 font-mono text-[11px]/5 text-(--blux-text)" aria-label="Events received by .NET">
                            @if (!RendererInfo.IsInteractive)
                            {
                                <li class="text-(--blux-text-muted)">Nothing reaches .NET on a static page. The component still works.</li>
                            }
                            else if (!_dotnet.TryGetValue(demo.Key, out var lines) || lines.Count == 0)
                            {
                                <li class="text-(--blux-text-muted)">Waiting for a bound change…</li>
                            }
                            else
                            {
                                @foreach (var line in lines)
                                {
                                    <li @key="line" class="pg-log-line rounded-sm px-1"><span class="text-(--blux-primary-text)">→</span> @line</li>
                                }
                            }
                        </ol>
                    </div>
                </div>
            </div>
        </div>;
}
