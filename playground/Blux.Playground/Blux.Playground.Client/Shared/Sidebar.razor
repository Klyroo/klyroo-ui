@implements IDisposable
@using Blux.Playground.Client.Docs
@inject NavigationManager Navigation

@* Keyed by active library slug so switching between independent library docs always mounts a fresh navigation tree. *@
<BxContentNavigation @key="@(_activeSlug ?? "ui")" Items="_items" AriaLabel="Documentation" Ui="_ui" data-testid="docs-sidebar" />

@code {
    private static readonly ContentNavigationUi _ui = new() { List = "gap-6" };

    private string? _activeSlug;
    private IReadOnlyList<BxContentNavigationItem> _items = [];

    protected override void OnInitialized()
    {
        UpdateSidebar();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateSidebar();
        StateHasChanged();
    }

    private void UpdateSidebar()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var mode = PlaygroundServices.ModeFromPath(path);
        _activeSlug = LuxStackProducts.ResolveFromPath(path)?.Slug;
        _items = DocsNavigation.Sidebar(mode is null ? "" : "/" + mode, _activeSlug);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
