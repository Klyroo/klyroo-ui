@implements IDisposable
@using Blux.Playground.Client.Docs
@inject NavigationManager Navigation

@* The documentation sidebar is scoped to the active LuxStack library (Lux.UI vs Query/Table/Form/Dashboard/Display/Spreadsheet/Agent). *@
<BxContentNavigation Items="_items" AriaLabel="Documentation" Ui="_ui" data-testid="docs-sidebar" />

@code {
    private static readonly ContentNavigationUi _ui = new() { List = "gap-6" };

    private IReadOnlyList<BxContentNavigationItem> _items = [];

    protected override void OnInitialized()
    {
        UpdateSidebar();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateSidebar();
        StateHasChanged();
    }

    private void UpdateSidebar()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var mode = PlaygroundServices.ModeFromPath(path);
        var activeSlug = LuxStackProducts.ResolveFromPath(path)?.Slug;
        _items = DocsNavigation.Sidebar(mode is null ? "" : "/" + mode, activeSlug);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
