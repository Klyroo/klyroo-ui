    private async Task RunAgentStep()
    {
        _step++;
        var next = _step % 2 == 1 ? "Atlas" : "Orion";
        await _agent.ActAsync([new AgentActStep("Project", "setValue", [next])]);
    }
    private void RunAgentQueryDemo()
    {
        var q = _agent.Query(new AgentQueryRequest { Within = "region", Text = "Europe" });
        _agentQueryNote = q.Count > 0 && q[0].Items.Count > 0
            ? $"Matched {q[0].Label} -> {q[0].Items[0].Value} ({q[0].Items[0].Label}) without opening popup!"
            : "No match";
    }
    private async Task RunPolicySubmitDemo()
    {
        var res = await _agent.ActAsync(
            [new AgentActStep("Project Settings", "submit")],
            allow: (_, confirmRequired) => Task.FromResult(!confirmRequired || _allowConfirm));
        _policyResultText = res.Ok ? "OK: Policy approved submit!" : $"REFUSED: {res.Error}";
    }
    private void RecordUndoStep()
    {
        _step++;
        _undo.Record($"Snapshot #{_step}: Project = {(_step % 2 == 1 ? "Atlas" : "Orion")}");
    }

