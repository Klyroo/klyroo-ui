@using System.Diagnostics.CodeAnalysis

<section class="scroll-mt-24" id="@Anchor" aria-labelledby="@($"{Anchor}-title")">
    <h2 id="@($"{Anchor}-title")" class="text-lg font-semibold tracking-tight text-(--blux-text-highlighted)">
        <a href="@($"#{Anchor}")" class="hover:underline hover:decoration-(--blux-primary) hover:decoration-2 hover:underline-offset-4">@Title</a>
    </h2>
    @if (Description is not null)
    {
        <p class="mt-1 text-sm text-(--blux-text-muted)">@Description</p>
    }
    <div class="mt-3 overflow-hidden rounded-xl border border-(--blux-border) bg-(--blux-bg)">
        <div class="flex items-center justify-between border-b border-(--blux-border) px-4 py-2">
            <span class="pg-eyebrow-mono flex items-center gap-2"><span class="size-1.5 bg-(--blux-primary)" aria-hidden="true"></span>Preview</span>
        </div>
        <div class="pg-dots flex min-h-36 flex-wrap items-center justify-center gap-3 p-6 sm:p-10">
            <DynamicComponent Type="Of" />
        </div>
        <CodeBlock Code="@Source" Class="border-t border-(--blux-border)" />
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    [DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.All)]
    public Type Of { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }

    private string Anchor => Title.ToLowerInvariant().Replace(' ', '-');

    private string Source
    {
        get
        {
            using var stream = typeof(Example).Assembly.GetManifestResourceStream($"example:{Of.Name}");
            return stream is null ? "" : new StreamReader(stream).ReadToEnd();
        }
    }
}
