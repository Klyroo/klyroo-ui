@inherits LayoutComponentBase
@layout SiteLayout

@* The sidebar sits beside the main landmark, not in it: the skip link of the site lands on the article and jumps over the menu. *@
<div class="mx-auto flex max-w-(--breakpoint-2xl) gap-10 px-4 sm:px-6 lg:px-8">
    <aside aria-label="Documentation sidebar" class="sticky top-16 hidden h-[calc(100dvh_-_4rem)] w-56 shrink-0 overflow-y-auto py-8 lg:block">
        <Sidebar />
    </aside>
    <div class="min-w-0 flex-1 py-8 lg:py-10">
        <aside aria-label="Documentation menu" class="mb-6 lg:hidden">
            <details class="rounded-lg border border-(--blux-border)">
                <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium">Menu</summary>
                <div class="border-t border-(--blux-border) p-4"><Sidebar /></div>
            </details>
        </aside>
        <main id="main" tabindex="-1" class="focus:outline-none">
            <article class="max-w-4xl">
                @Body
            </article>
        </main>
    </div>
</div>
