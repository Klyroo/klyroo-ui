@inherits LayoutComponentBase
@implements IDisposable
@using Blux.Playground.Client.Docs
@inject NavigationManager Navigation

<BxSkipLink />

<header class="sticky top-0 z-40 bg-(--blux-bg)/95 backdrop-blur">
    <div class="border-b border-(--blux-border)">
        <div class="mx-auto flex h-16 max-w-(--breakpoint-2xl) items-center gap-4 px-4 sm:px-6 lg:px-8">
            <a href="/" class="flex items-center gap-2.5 font-mono text-[15px] font-semibold text-(--blux-text-highlighted)">
                <Logo Class="size-7" />
                <span>lux<span class="text-(--blux-text-dimmed)">/</span>stack</span>
            </a>
            @if (_activeProduct is not null)
            {
                <span class="hidden text-(--blux-border-accented) sm:inline" aria-hidden="true">/</span>
                <a href="@($"/{_activeProduct.Slug}")" class="hidden items-center gap-1.5 font-mono text-sm font-semibold text-(--blux-text-highlighted) sm:inline-flex">
                    <span class="size-2 rounded-full" style="@($"background:{_activeProduct.AccentHex}")" aria-hidden="true"></span>
                    <span>@_activeProduct.Name</span>
                </a>
            }
            else
            {
                <span class="hidden rounded-md border border-(--blux-border) px-1.5 py-0.5 font-mono text-[11px] text-(--blux-text-muted) sm:inline">v0.1-alpha</span>
            }

            <nav aria-label="Main" class="ms-6 hidden items-center gap-6 text-sm md:flex">
                @if (_activeProduct is null)
                {
                    @* LuxStack Hub navigation: ecosystem-level only *@
                    <a href="/#libraries" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Libraries</a>
                    <a href="/#redirections" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Catalog</a>
                }
                else if (_activeProduct.Slug == "ui")
                {
                    @* Lux.UI independent navigation *@
                    <a href="/ui" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Overview</a>
                    <a href="/ui/docs" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Docs</a>
                    <a href="@($"{_prefix}/components/button")" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Components</a>
                    <a href="/docs/theming" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Theming</a>
                    <a href="templates" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Templates</a>
                }
                else
                {
                    @* Independent navigation strictly for the active library *@
                    <a href="@($"/{_activeProduct.Slug}")" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Overview</a>
                    <a href="@($"/{_activeProduct.Slug}/docs")" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Docs</a>
                    <a href="@($"/{_activeProduct.Slug}/docs/examples")" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Examples</a>
                    <a href="@($"/{_activeProduct.Slug}/docs/api")" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">API</a>
                }
            </nav>

            <div class="ms-auto flex items-center gap-1">
                <BxContentSearchButton Collapsed="false" Class="me-1 min-w-0 sm:w-56" />
                <ColorModeButton />
            </div>
        </div>
    </div>
    <LuxStackBar />
</header>

@* Search is scoped strictly to the active library when browsing a library, or global on the LuxStack Hub. *@
<BxContentSearch @key="@(_activeProduct?.Slug ?? "hub")" Pages="Blux.Playground.Client.Docs.DocsNavigation.SearchPages(_prefix, _activeProduct?.Slug)" />

@Body

<footer class="border-t border-(--blux-border)">
    <div class="mx-auto flex max-w-(--breakpoint-2xl) flex-col gap-2 px-4 py-8 text-sm text-(--blux-text-muted) sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <p class="font-mono text-xs uppercase tracking-widest">@(_activeProduct is null ? "LuxStack · 8 Headless & UI Libraries · MIT" : $"{_activeProduct.Name} · LuxStack · MIT")</p>
        <p>Built for .NET 10, Blazor Web, .NET MAUI Blazor Hybrid &amp; NativeAOT.</p>
    </div>
</footer>

<BxToaster />

<div id="blazor-error-ui" data-nosnippet class="fixed inset-x-0 bottom-0 z-50 hidden bg-amber-100 px-4 py-3 text-sm text-zinc-900">
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss ms-4 cursor-pointer">🗙</span>
</div>

@code {
    private string _prefix = "";
    private LuxProductInfo? _activeProduct;

    protected override void OnInitialized()
    {
        UpdateContext();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateContext();
        StateHasChanged();
    }

    private void UpdateContext()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var mode = PlaygroundServices.ModeFromPath(path);
        _prefix = mode is null ? "" : "/" + mode;
        _activeProduct = LuxStackProducts.ResolveFromPath(path);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
