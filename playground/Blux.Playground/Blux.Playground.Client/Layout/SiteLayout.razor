@inherits LayoutComponentBase
@inject NavigationManager Navigation

<BxSkipLink />

<header class="sticky top-0 z-40 bg-(--blux-bg)/95 backdrop-blur">
    <div class="border-b border-(--blux-border)">
        <div class="mx-auto flex h-16 max-w-(--breakpoint-2xl) items-center gap-4 px-4 sm:px-6 lg:px-8">
            <a href="/" class="flex items-center gap-2.5 font-mono text-[15px] font-semibold text-(--blux-text-highlighted)">
                <Logo Class="size-7" />
                <span>lux<span class="text-(--blux-text-dimmed)">/</span>stack</span>
            </a>
            <span class="hidden rounded-md border border-(--blux-border) px-1.5 py-0.5 font-mono text-[11px] text-(--blux-text-muted) sm:inline">v0.1-alpha</span>
            <nav aria-label="Main" class="ms-6 hidden items-center gap-6 text-sm md:flex">
                <a href="/" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Libraries</a>
                <a href="/docs" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Docs</a>
                <a href="@($"{_prefix}/components/button")" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Components</a>
                <a href="/docs/theming" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Theming</a>
                <a href="templates" class="text-(--blux-text-muted) hover:text-(--blux-text-highlighted)">Templates</a>
            </nav>
            <div class="ms-auto flex items-center gap-1">
                <BxContentSearchButton Collapsed="false" Class="me-1 min-w-0 sm:w-56" />
                <ColorModeButton />
            </div>
        </div>
    </div>
    <LuxStackBar />
</header>

@* The search of the whole site, over the catalog and all LuxStack libraries: Ctrl+K (Cmd+K on a Mac). *@
<BxContentSearch Pages="Blux.Playground.Client.Docs.DocsNavigation.SearchPages(_prefix)" />

@* The page puts its own main landmark in Body (MainLayout, DocsLayout), so the skip link can jump over what comes before it. *@
@Body

<footer class="border-t border-(--blux-border)">
    <div class="mx-auto flex max-w-(--breakpoint-2xl) flex-col gap-2 px-4 py-8 text-sm text-(--blux-text-muted) sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <p class="font-mono text-xs uppercase tracking-widest">LuxStack · 8 Headless &amp; UI Libraries · MIT</p>
        <p>Built for .NET 10, Blazor Web, .NET MAUI Blazor Hybrid &amp; NativeAOT.</p>
    </div>
</footer>

<BxToaster />

<div id="blazor-error-ui" data-nosnippet class="fixed inset-x-0 bottom-0 z-50 hidden bg-amber-100 px-4 py-3 text-sm text-zinc-900">
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss ms-4 cursor-pointer">🗙</span>
</div>

@code {
    private string _prefix = "";

    protected override void OnInitialized()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var mode = PlaygroundServices.ModeFromPath(path);
        _prefix = mode is null ? "" : "/" + mode;
    }
}
