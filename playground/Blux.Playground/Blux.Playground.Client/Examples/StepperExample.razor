<div class="w-full max-w-2xl">
    <BxStepper Items="Items" @bind-Current="_step" AriaLabel="Checkout" />
    <p class="mt-4 text-sm text-(--blux-text-muted)" data-testid="step-state">Step: @(_step + 1) of @Items.Length</p>
</div>

@code {
    private int _step = 1;

    private static readonly BxStepperItem[] Items =
    [
        new("Address") { Description = "Where to ship", Content = @<p class="text-sm">Enter your shipping address.</p> },
        new("Payment") { Description = "How to pay", Content = @<p class="text-sm">Choose a payment method.</p> },
        new("Review") { Description = "Check the order", Content = @<p class="text-sm">Review your order.</p> },
        new("Done") { Disabled = true },
    ];
}
