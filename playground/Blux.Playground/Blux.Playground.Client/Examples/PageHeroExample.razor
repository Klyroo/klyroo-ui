<div class="w-full overflow-hidden rounded-lg border border-(--blux-border) bg-(--blux-bg)">
    <BxPageHero Headline="Open source" Title="Ship forms faster" HeadingLevel="3"
                Description="Accessible form controls that validate in the browser and on the server, in every render mode."
                Links="_links" Ui="_ui">
        <Media>
            <div class="rounded-xl border border-(--blux-border) bg-(--blux-bg-elevated) p-5 font-mono text-sm text-(--blux-text)">
                <p><span class="text-(--blux-text-muted)">$</span> dotnet add package Blux.UI</p>
                <p><span class="text-(--blux-text-muted)">$</span> dotnet run</p>
            </div>
        </Media>
    </BxPageHero>
</div>

@code {
    private readonly PageHeroUi _ui = new()
    {
        Container = "py-12 sm:py-12 lg:py-12",
        Title = "text-4xl sm:text-4xl lg:text-5xl",
    };

    private readonly PageLinkItem[] _links =
    [
        new("Get started", "/docs/installation") { TrailingIcon = "arrow-right" },
        new("View the source", "https://github.com/") { Target = "_blank", Color = BxColor.Neutral, Variant = ButtonVariant.Outline },
    ];
}
