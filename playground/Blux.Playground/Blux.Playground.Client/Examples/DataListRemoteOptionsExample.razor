@using Blux.UI.Tools.Query
@implements IDisposable
@inject QueryState Query
@inject NavigationManager Navigation

@* The options of the Customer filter come from a directory that answers after 400 ms, five per page, with a search: add a Customer filter, type "co" to search, scroll or press Load more for the next page.
   A value in the address (rem.f.customer=Globex) is labelled by the resolver ("Globex (Cypress Creek)"). The counts next to the options come from the facet of the filter. Statically rendered the editor lists
   the selected customers (labelled on the server) and the counted ones; searching the rest needs JavaScript. "Break the directory" makes every call fail: the editor shows an error with a retry button. *@
<div class="w-full space-y-3" data-testid="list-remote">
    <p class="flex flex-wrap items-center gap-3 text-sm text-(--blux-text-muted)">
        <BxButton Label="Break the directory" Href="@Query.HrefWith(("fail", "1"))" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="BxSize.Sm" data-testid="rem-break" />
        <BxButton Label="Repair the directory" Href="@Query.HrefWith(("fail", (string?)null))" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="BxSize.Sm" data-testid="rem-repair" />
    </p>
    <BxDataList TItem="Invoice" Label="Invoices with remote options" Schema="_schema" Items="InvoiceData.All" UrlKey="rem" />
</div>

@code {
    private DataListSchema<Invoice> _schema = default!;

    protected override void OnInitialized()
    {
        // Read when each call starts, so the buttons above take effect without building the list again.
        _schema = InvoiceRemoteData.CreateSchema(() => new Uri(Navigation.Uri).Query.Contains("fail=1", StringComparison.Ordinal));
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
