@* The ErrorContent of an ErrorBoundary hands over the exception: <BxError Exception="exception" />.
   Its message stays hidden unless ShowDetails is set, because exception messages can leak internals. *@
<div class="w-full overflow-hidden rounded-xl border border-(--blux-border)">
    <BxError Exception="_exception" ShowDetails HeadingAs="h3" Clear="false" data-testid="error-boundary">
        <Actions>
            <BxButton Label="Try again" Href="/components/error" />
            <BxButton Label="Contact support" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Href="/docs" />
        </Actions>
    </BxError>
</div>

@code {
    private readonly Exception _exception = new InvalidOperationException("The report could not be generated.");
}
