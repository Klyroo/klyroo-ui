@* While Streaming the block opens by itself, its label shimmers, and when the stream ends it closes after a moment and tells how
   long it took, unless you opened or closed it in between. Simulating the stream needs interactivity. *@
<div class="flex w-full max-w-xl flex-col gap-6" data-testid="chat-reasoning-example">
    <BxChatReasoning Duration="12" data-testid="chat-reasoning-done">
        The question is about streaming, so an <code>IAsyncEnumerable</code> fits. I will describe appending tokens, then rendering again.
    </BxChatReasoning>
    <div class="flex flex-col items-start gap-2">
        <BxButton Label="Think out loud" Size="BxSize.Sm" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Loading="_thinking" OnClick="Think" data-testid="chat-reasoning-run" />
        <BxChatReasoning Streaming="_thinking" AutoCloseDelay="800" data-testid="chat-reasoning-live">
            @_thought
        </BxChatReasoning>
    </div>
    <div class="flex flex-col items-start gap-2">
        <BxChatReasoning @bind-Open="_open" Duration="5" data-testid="chat-reasoning-bound">
            Bound with @@bind-Open: .NET hears about every toggle.
        </BxChatReasoning>
        <p class="text-sm text-(--blux-text-muted)" data-testid="chat-reasoning-bound-state">Open: @(_open ? "true" : "false")</p>
    </div>
</div>

@code {
    private bool _open;
    private bool _thinking;
    private string _thought = "Nothing yet.";

    private async Task Think()
    {
        _thinking = true;
        _thought = "";
        StateHasChanged();
        await foreach (var token in ChatDemo.Tokens("First I look at what was asked. Then I pick the simplest approach and check it against the constraints.", 80))
        {
            _thought += token;
            StateHasChanged();
        }
        _thinking = false;
    }
}
