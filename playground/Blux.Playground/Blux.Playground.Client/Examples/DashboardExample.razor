@* A complete dashboard in a frame of fixed height, so it does not replace the layout of the site. In an app the group
   fills the page: give it the whole viewport. As="div": the docs page already has a main landmark.
   The group-data-[state=collapsed]/sidebar variants keep labels for screen readers while the sidebar shows icons only. *@
<div class="h-[30rem] w-full overflow-hidden rounded-xl border border-(--blux-border)" data-testid="dashboard">
    <BxDashboardGroup StorageKey="playground-dashboard">
        <BxDashboardSidebar As="div" Resizable data-testid="dashboard-sidebar">
            <Header>
                <span class="font-semibold text-(--blux-text-highlighted)">Acme</span>
            </Header>
            <ChildContent>
                <BxDashboardSearchButton data-testid="dashboard-search-button" />
                <BxNavigationMenu Items="_items" Orientation="BxOrientation.Vertical" AriaLabel="Workspace" Ui="_navUi" />
            </ChildContent>
            <Footer>
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-(--blux-bg-elevated) text-xs font-medium" aria-hidden="true">AL</span>
                <span class="min-w-0 truncate text-sm group-data-[state=collapsed]/sidebar:sr-only">Ada Lovelace</span>
            </Footer>
        </BxDashboardSidebar>

        <BxDashboardPanel Resizable Size="35" MinSize="20" MaxSize="60" ResizeLabel="Resize inbox" data-testid="dashboard-inbox">
            <Header>
                <BxDashboardNavbar Title="Inbox">
                    <Leading><BxDashboardSidebarCollapse data-testid="dashboard-collapse" /></Leading>
                </BxDashboardNavbar>
                <BxDashboardToolbar>
                    <Left>
                        <BxButton Label="All" Size="BxSize.Sm" Variant="ButtonVariant.Soft" Color="BxColor.Neutral" />
                        <BxButton Label="Unread" Size="BxSize.Sm" Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" />
                    </Left>
                </BxDashboardToolbar>
            </Header>
            <Body>
                <ul class="flex flex-col gap-3 text-sm">
                    @foreach (var subject in _subjects)
                    {
                        <li class="truncate text-(--blux-text)">@subject</li>
                    }
                </ul>
            </Body>
        </BxDashboardPanel>

        <BxDashboardPanel data-testid="dashboard-detail">
            <Header>
                <BxDashboardNavbar Title="Message" Toggle="false">
                    <Right>
                        <BxButton Label="Reply" Size="BxSize.Sm" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" />
                    </Right>
                </BxDashboardNavbar>
            </Header>
            <Body>
                <p class="text-sm text-(--blux-text-muted)">
                    Press Ctrl+K, or use the search button, to jump to a page or run a command.
                </p>
                <p class="text-sm text-(--blux-text-muted)" data-testid="dashboard-last">Last command: @(_last ?? "none")</p>
            </Body>
        </BxDashboardPanel>

        <BxDashboardSearch Groups="_groups" OnSelect="item => _last = item.Label" />
    </BxDashboardGroup>
</div>

@code {
    private string? _last;

    private static readonly NavigationMenuUi _navUi = new() { Label = "group-data-[state=collapsed]/sidebar:sr-only" };

    private static readonly string[] _subjects = ["Welcome to Acme", "Your invoice is ready", "Design review notes", "Weekly summary", "Password changed"];

    private static readonly BxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true, Icon = BxIcons.Named("home", "size-5") },
        new("Inbox") { Href = "/components/dashboard-group", Icon = BxIcons.Named("inbox", "size-5") },
        new("Calendar") { Href = "/components/header", Icon = BxIcons.Named("calendar", "size-5") },
        new("Settings") { Href = "/docs/theming", Icon = BxIcons.Named("user", "size-5") },
    ];

    private static readonly BxCommandGroup[] _groups =
    [
        new("Go to",
        [
            new() { Label = "Inbox", Href = "?view=inbox", Keywords = "mail messages" },
            new() { Label = "Settings", Href = "?view=settings", Keywords = "preferences account" },
        ]),
        new("Actions",
        [
            new() { Label = "Compose message", Keywords = "new write" },
            new() { Label = "Sign out", Keywords = "logout" },
        ]),
    ];
}
