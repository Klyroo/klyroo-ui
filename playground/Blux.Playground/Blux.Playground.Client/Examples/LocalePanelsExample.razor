@* One BxApp per locale: its texts, its writing direction and the culture of its dates and numbers apply to everything inside.
   Nothing here needs interactivity, so it renders the same in every mode. *@
<div class="grid w-full gap-4 md:grid-cols-3">
    @foreach (var locale in _locales)
    {
        <BxApp Locale="locale" Toaster="false" Class="flex flex-col gap-3 rounded-lg border border-(--blux-border) p-4" data-testid="@($"locale-panel-{locale.Code}")">
            <p class="font-medium">@locale.Name <span class="text-xs text-(--blux-text-muted)">(@locale.Code, @locale.DirAttribute)</span></p>
            <BxFileUpload MaxSize="1536" />
            <BxCalendar Value="@_date" Size="BxSize.Sm" />
        </BxApp>
    }
</div>

@code {
    private static readonly BxLocale[] _locales = [BxLocales.Fr, BxLocales.Ar, BxLocales.Ja];
    private readonly DateOnly _date = new(2026, 3, 5);
}
