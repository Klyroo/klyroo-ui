<div class="flex w-full flex-col gap-6">
    <BxBlogPost Title="Introducing the marketing components" Description="Pricing, changelog and blog components that read well on every screen."
                Date="@(new DateTimeOffset(2026, 11, 18, 0, 0, 0, TimeSpan.Zero))" Badge="Release" Orientation="BxOrientation.Horizontal"
                Href="/docs" Image="@Cover" ImageAlt="Abstract yellow and teal gradient"
                Authors="@(new[] { new BxPostAuthor("Ada Lovelace") { Description = "Maintainer" } })" />
    <BxBlogPost Title="Why a card has one link" Description="The title carries the link and stretches over the card, so there is a single tab stop."
                Date="@(new DateTimeOffset(2026, 11, 2, 0, 0, 0, TimeSpan.Zero))" Variant="BlogPostVariant.Soft" DateFormat="d MMM yyyy">
        <div class="flex gap-2 text-sm">
            <a href="/docs" class="text-(--blux-primary-text) underline underline-offset-4">Read the article</a>
            <a href="/docs" class="text-(--blux-primary-text) underline underline-offset-4">Share</a>
        </div>
    </BxBlogPost>
</div>

@code {
    private static readonly string Cover = "data:image/svg+xml," + Uri.EscapeDataString(
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 9'><defs><linearGradient id='g'><stop offset='0' stop-color='#ffd23f'/><stop offset='1' stop-color='#1f6f7a'/></linearGradient></defs><rect width='16' height='9' fill='url(#g)'/></svg>");
}
