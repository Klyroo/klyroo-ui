<div class="flex flex-wrap items-start justify-center gap-8">
    <div class="flex flex-col items-center gap-2">
        <BxCalendar Mode="BxCalendarMode.Range" @bind-Range="_range" WeekStart="DayOfWeek.Monday" AriaLabel="Stay" data-testid="range" />
        <p class="text-sm text-(--blux-text-muted)" data-testid="range-state">Range: @Text(_range)</p>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BxCalendar Mode="BxCalendarMode.Multiple" @bind-Values="_dates" AriaLabel="Days off" data-testid="multiple" />
        <p class="text-sm text-(--blux-text-muted)" data-testid="multiple-state">Days: @(_dates.Count == 0 ? "none" : string.Join(", ", _dates.Select(d => d.ToString("MM-dd"))))</p>
    </div>
</div>

@code {
    private BxDateRange? _range = new(new DateOnly(2026, 11, 9), new DateOnly(2026, 11, 13));
    private IReadOnlyList<DateOnly> _dates = [new DateOnly(2026, 11, 2), new DateOnly(2026, 11, 20)];

    private static string Text(BxDateRange? range) =>
        range?.Start is null ? "none" : $"{range.Start:yyyy-MM-dd} to {(range.End is { } end ? end.ToString("yyyy-MM-dd") : "...")}";
}
