<div class="flex flex-wrap items-center gap-2">
    @foreach (var size in Enum.GetValues<BxSize>())
    {
        <BxButton Size="size" Label="@size.ToString()" />
    }
    <BxButton Label="Download" Variant="ButtonVariant.Outline">
        <LeadingIcon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg></LeadingIcon>
    </BxButton>
    <BxButton Square aria-label="Add" Color="BxColor.Neutral">
        <LeadingIcon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg></LeadingIcon>
    </BxButton>
</div>
