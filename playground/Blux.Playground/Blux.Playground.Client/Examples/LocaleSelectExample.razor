@using System.Globalization
@inject BluxOptions Options
@* Needs app.UseRequestLocalization with the same cultures on the server: the select only writes the culture cookie.
   Without Locales it offers BluxOptions.Locales, the twelve built-in ones. *@
<div class="flex flex-col items-center gap-3">
    <BxLocaleSelect data-testid="locale-select" />
    <p class="text-sm text-(--blux-text-muted)">Current UI culture: <code data-testid="locale-current">@CultureInfo.CurrentUICulture.Name</code></p>
    <p class="text-sm text-(--blux-text-muted)">Locale of the components: <code data-testid="locale-resolved">@Options.ResolveLocale(CultureInfo.CurrentUICulture).Code</code></p>
</div>
