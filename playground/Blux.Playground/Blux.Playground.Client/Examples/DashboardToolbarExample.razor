<div class="h-64 w-full overflow-hidden rounded-xl border border-(--blux-border)">
    <BxDashboardGroup>
        <BxDashboardPanel>
            <Header>
                <BxDashboardNavbar Title="Orders" Toggle="false" />
                <BxDashboardToolbar data-testid="dashboard-toolbar">
                    <Left>
                        <BxButton Label="Filter" Size="BxSize.Sm" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" LeadingIcon="@(BxIcons.Named("list", "size-4"))" />
                        <BxButton Label="Export" Size="BxSize.Sm" Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" />
                    </Left>
                    <Right>
                        <span class="text-sm text-(--blux-text-muted)">24 orders</span>
                    </Right>
                </BxDashboardToolbar>
            </Header>
            <Body><p class="text-sm text-(--blux-text-muted)">A secondary bar under the navbar.</p></Body>
        </BxDashboardPanel>
    </BxDashboardGroup>
</div>
