<BxPageGrid Columns="3" Class="w-full gap-4">
    @foreach (var (icon, title, text) in _items)
    {
        <BxPageCard Icon="@icon" Title="@title" Description="@text" />
    }
</BxPageGrid>

@code {
    private readonly (string Icon, string Title, string Text)[] _items =
    [
        ("zap", "Instant", "Pages render on the server and stay light."),
        ("lock", "Private", "Nothing leaves your servers unless you send it."),
        ("globe", "Global", "Static output caches well on any CDN."),
        ("code", "Typed", "Strongly typed parameters everywhere."),
        ("eye", "Readable", "Contrast is checked in light and dark."),
        ("bell", "Aware", "Toasts and banners say what changed."),
    ];
}
