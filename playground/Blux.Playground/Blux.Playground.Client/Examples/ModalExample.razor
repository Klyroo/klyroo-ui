<BxModal @bind-Open="_open" Title="Edit profile" Description="Changes are saved when you close the dialog.">
    <ChildContent><BxButton Label="Edit profile" Variant="ButtonVariant.Outline" data-testid="modal-trigger" /></ChildContent>
    <Body>
        <div class="flex flex-col gap-4">
            <BxFormField Label="Name"><BxInput Value="Ada Lovelace" /></BxFormField>
            <BxFormField Label="Bio"><BxTextarea Rows="3" /></BxFormField>
        </div>
    </Body>
    <Footer>
        <BxButton Label="Cancel" Color="BxColor.Neutral" Variant="ButtonVariant.Ghost" data-bx-close />
        <BxButton Label="Save" data-bx-close data-testid="modal-save" />
    </Footer>
</BxModal>
<p class="text-sm text-(--blux-text-muted)" data-testid="modal-state">Dialog: @(_open ? "open" : "closed")</p>

@code {
    private bool _open;
}
