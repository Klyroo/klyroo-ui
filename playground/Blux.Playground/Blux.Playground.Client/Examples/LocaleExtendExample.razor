@* BxLocales.Extend derives a locale and overrides only the messages you list; the others are kept. *@
<BxApp Locale="_canadian" Toaster="false" Class="flex w-full flex-col gap-3" data-testid="locale-extend">
    <p>Locale: <code data-testid="locale-extend-code">@_canadian.Code</code></p>
    <BxFileUpload MaxSize="1536" />
</BxApp>

@code {
    private static readonly BxLocale _canadian = BxLocales.Extend(BxLocales.Fr, code: "fr-CA", name: "Français (Canada)",
        messages: m => m with { DropFiles = "Glissez-déposez vos fichiers ici ou cliquez pour parcourir" });
}
