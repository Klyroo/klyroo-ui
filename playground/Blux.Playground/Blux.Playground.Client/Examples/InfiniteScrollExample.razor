@inject NavigationManager Navigation

<div class="flex w-full max-w-md flex-col gap-3">
    <div role="region" aria-label="Activity feed" tabindex="0" data-testid="infinite-feed"
         class="h-64 overflow-y-auto rounded-lg border border-(--blux-border) bg-(--blux-bg)">
        <ul>
            @for (var i = 1; i <= Shown; i++)
            {
                <li class="border-b border-(--blux-border) px-3 py-2 text-sm">Event @i</li>
            }
        </ul>
        <BxInfiniteScroll HasMore="HasMore" OnLoadMore="LoadAsync" Href="@NextHref" ShowEnd data-testid="infinite-more" />
    </div>
    <p class="text-sm text-(--blux-text-muted)" data-testid="infinite-count">Showing @Shown of @Total</p>
    <p class="text-sm text-(--blux-text-muted)" data-testid="infinite-requests">Load requests: @_requests</p>
</div>

@code {
    private const int PageSize = 20;
    private const int Total = 60;

    private int _pages = 1;
    private int _requests;

    // The document has a <base href>, so a bare "?feed=" would resolve against the site root: keep the current path.
    private string _path = "";

    private int Shown => Math.Min(_pages * PageSize, Total);
    private bool HasMore => Shown < Total;
    private string NextHref => $"{_path}?feed={_pages + 1}";

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        _path = uri.AbsolutePath;
        // Without .NET the link of the button reloads the page with one more page of events.
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _pages = int.TryParse(query["feed"], out var pages) ? Math.Clamp(pages, 1, Total / PageSize) : 1;
    }

    // The component counts the load as running until this returns: no Loading flag is needed for an async handler.
    private async Task LoadAsync()
    {
        _requests++;
        await Task.Delay(600);
        _pages++;
    }
}
