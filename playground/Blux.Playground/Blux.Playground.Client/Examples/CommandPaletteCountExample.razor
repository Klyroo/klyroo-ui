<div class="flex w-full max-w-lg flex-col items-center gap-3">
    <div class="w-full overflow-hidden rounded-[calc(var(--blux-radius)*2)] border border-(--blux-border) bg-(--blux-bg-overlay)">
        <BxCommandPalette Groups="Groups" Label="Go to a mailbox" Placeholder="Go to a mailbox..." data-testid="count-palette" />
    </div>
</div>

@code {
    // Count sits at the end of the row, before the shortcut; the search does not read it.
    private static readonly BxCommandGroup[] Groups =
    [
        new("Mailboxes",
        [
            new() { Label = "Inbox", Count = 12, Shortcut = "G I" },
            new() { Label = "Starred", Count = 3 },
            new() { Label = "Archive", Count = 1840 },
        ]),
    ];
}
