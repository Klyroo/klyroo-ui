@* Sticky below the header and shown from the lg breakpoint. Rendered here with As="div" because the example sits inside a landmark. *@
<div class="w-full max-w-xs rounded-lg border border-(--blux-border) bg-(--blux-bg) px-4">
    <BxPageAside As="div" Class="static block py-4">
        <Top><p class="text-sm font-semibold text-(--blux-text-highlighted)">Docs</p></Top>
        <ChildContent><BxPageLinks aria-label="Docs navigation" Links="_links" /></ChildContent>
        <Bottom><p class="text-xs text-(--blux-text-muted)">Version 0.1</p></Bottom>
    </BxPageAside>
</div>

@code {
    private readonly PageLinkItem[] _links =
    [
        new("Installation", "/docs/installation") { Active = false },
        new("Theming", "/docs/theming") { Active = false },
    ];
}
