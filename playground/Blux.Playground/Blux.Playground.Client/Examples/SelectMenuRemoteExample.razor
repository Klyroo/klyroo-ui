<div class="flex w-full max-w-xs flex-col gap-3">
    <BxFormField Label="Country">
        <BxSelectMenu OptionsProvider="_source.ByPage" ResolveSelected="_source.Resolve" PageSize="20" Placeholder="Search a country"
                      Value="_values" ValueChanged="@(v => _values = v ?? [])" data-testid="remote-select" />
    </BxFormField>
    <p class="text-sm text-(--blux-text-muted)" data-testid="remote-state">Selected: @(_values.Count > 0 ? string.Join(", ", _values) : "none")</p>
    <p class="text-sm text-(--blux-text-muted)" data-testid="remote-requests">Source calls: @_source.Requests</p>
    <p class="text-sm text-(--blux-text-muted)" data-testid="remote-last">Last call: @_source.Last</p>
</div>

@code {
    private RemoteDirectory _source = default!;
    private IReadOnlyList<string> _values = [];

    protected override void OnInitialized() => _source = new RemoteDirectory { Changed = () => _ = InvokeAsync(StateHasChanged) };
}
