<form method="post" @formname="documents" @onsubmit="Save" enctype="multipart/form-data" class="flex w-full max-w-md flex-col items-start gap-3">
    <AntiforgeryToken />
    <BxFormField Label="Documents" class="w-full">
        <BxFileUpload Name="Files" Multiple Accept=".txt,.pdf,image/*" MaxSize="1048576" MaxFiles="3" Hint="Text, PDF or images" OnChange="OnChange" data-testid="documents" />
    </BxFormField>
    <BxButton Type="submit" Label="Upload" />
    @if (_saved)
    {
        <p role="status" class="text-sm text-(--blux-success-text)" data-testid="documents-saved">Received: @(_received.Count == 0 ? "nothing" : string.Join(", ", _received))</p>
    }
</form>

@code {
    // Static rendering: the browser posts the files and Blazor binds them to this property by the name of the input.
    [SupplyParameterFromForm(FormName = "documents")]
    private IReadOnlyList<IBrowserFile>? Files { get; set; }

    // Interactive rendering: InputFile raises OnChange as soon as files are chosen.
    private IReadOnlyList<IBrowserFile> _chosen = [];
    private IReadOnlyList<string> _received = [];
    private bool _saved;

    private void OnChange(InputFileChangeEventArgs e) => _chosen = e.GetMultipleFiles(3);

    private void Save()
    {
        _received = (Files ?? _chosen).Select(f => f.Name).ToList();
        _saved = true;
    }
}
