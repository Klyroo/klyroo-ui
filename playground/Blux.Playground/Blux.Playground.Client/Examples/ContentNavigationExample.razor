@* The sidebar of this site is a ContentNavigation too. The current page is compared with each Href (aria-current="page");
   here Active is forced so the example does not depend on the address of the docs page that hosts it. *@
<div class="w-72 rounded-xl border border-(--blux-border) p-3" data-testid="content-navigation-example">
    <BxContentNavigation Items="_items" AriaLabel="Example documentation" />
</div>

@code {
    private static readonly BxContentNavigationItem[] _items =
    [
        new("Getting started")
        {
            Icon = "book-open",
            Open = true,
            Children =
            [
                new("Introduction") { Href = "#introduction", Active = true },
                new("Installation") { Href = "#installation", Active = false },
                new("Theming") { Href = "#theming", Active = false, Badge = "New", BadgeColor = BxColor.Success },
            ],
        },
        new("Components")
        {
            Icon = "folder",
            Open = false,
            Children =
            [
                new("Elements")
                {
                    Open = true,
                    Children =
                    [
                        new("Button") { Href = "#button", Active = false },
                        new("Badge") { Href = "#badge", Active = false },
                    ],
                },
                new("Form")
                {
                    Children =
                    [
                        new("Input") { Href = "#input", Active = false },
                        new("Select") { Href = "#select", Active = false },
                    ],
                },
                new("Archived") { Href = "#archived", Disabled = true },
            ],
        },
        new("Changelog") { Icon = "file", Href = "#changelog", Active = false },
    ];
}
