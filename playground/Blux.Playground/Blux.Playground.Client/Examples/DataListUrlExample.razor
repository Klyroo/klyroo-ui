@using Blux.UI.Tools.Query
@implements IDisposable
@inject ProviderCallLog Calls
@inject NavigationManager Navigation

@* No UrlKey: the state uses the plain keys q, s, p and ps. Sort or page, then use Back and Forward, or share the address. The footer is a test hook that counts the provider calls
   of this render: a list that shows the result of its prerender loads nothing a second time. *@
<div class="w-full space-y-3" data-testid="list-url">
    <BxDataList TItem="Invoice" Label="Invoices in the URL" Schema="InvoiceData.Schema" Provider="LoadAsync" ResultJson="DemoJson.Default.DataListResultInvoice">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <BxDataListSearch data-testid="url-search" />
            <BxDataListResultCount data-testid="url-count" />
            <BxDataListRefresh data-testid="url-refresh" />
        </div>
        <BxDataListErrorState />
        <BxDataListTable Caption="Invoices in the URL" data-testid="url-table">
            <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <BxDataListColumn Field="customer" />
            <BxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
            <BxDataListColumn Field="issued" Format="d" />
        </BxDataListTable>
        <BxDataListPagination data-testid="url-pagination" />
    </BxDataList>
    <p class="font-mono text-xs text-(--blux-text-muted)">
        Provider calls: <span data-testid="url-calls">@Calls.Count</span>
        · Time zone: <span data-testid="url-zone">@(Calls.LastTimeZone ?? "none")</span>
        · Query: <span data-testid="url-query">@(new Uri(Navigation.Uri).Query)</span>
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        Calls.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private ValueTask<DataListResult<Invoice>> LoadAsync(DataListRequest request, CancellationToken cancellationToken)
    {
        Calls.Add(request);
        return ValueTask.FromResult(InvoiceData.Schema.ExecuteInMemory(InvoiceData.All, request));
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Calls.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
