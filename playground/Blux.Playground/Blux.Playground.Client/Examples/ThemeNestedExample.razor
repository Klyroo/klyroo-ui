@using Blux.UI.Theming
@* One BxTheme can carry several component types, and themes nest: the innermost wins. *@
<BxTheme Overrides="_outer">
    <div class="flex flex-wrap items-center gap-3" data-testid="theme-outer">
        <BxButton Label="Outer" />
        <BxBadge Label="Outer" />
        <BxTheme For="typeof(BxButton)" Ui='new ButtonUi { Base = "rounded-none" }'>
            <BxButton Label="Inner" data-testid="theme-inner" />
        </BxTheme>
    </div>
</BxTheme>

@code {
    private readonly Dictionary<Type, ISlotOverrides> _outer = new()
    {
        [typeof(BxButton)] = new ButtonUi { Base = "rounded-full" },
        [typeof(BxBadge)] = new BadgeUi { Base = "rounded-full" },
    };
}
