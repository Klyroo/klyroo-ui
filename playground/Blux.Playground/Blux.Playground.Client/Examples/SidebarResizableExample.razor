<div class="flex h-72 w-full flex-col overflow-hidden rounded-xl border border-(--blux-border) lg:flex-row">
    <BxSidebar Id="playground-sidebar-resizable" Resizable Collapsible="false" Width="224" As="div" data-testid="sidebar-resizable">
        <Header>
            <span class="font-semibold text-(--blux-text-highlighted)">Acme</span>
        </Header>
        <ChildContent>
            <BxNavigationMenu Items="_items" Orientation="BxOrientation.Vertical" AriaLabel="Workspace, resizable" />
        </ChildContent>
    </BxSidebar>
    <div class="min-w-0 flex-1 p-6 text-sm text-(--blux-text-muted)">
        Drag the edge of the sidebar, or focus it and use the arrow keys, Home and End.
    </div>
</div>

@code {
    private static readonly BxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true },
        new("Inbox") { Href = "/components/sidebar" },
        new("Settings") { Href = "/docs/theming" },
    ];
}
