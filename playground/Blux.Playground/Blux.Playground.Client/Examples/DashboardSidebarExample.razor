@* The collapse button and the mobile toggle sit in the navbar, not in the sidebar: they find the sidebar through the
   group. Below the lg breakpoint the sidebar is replaced by the toggle, which opens it as an off-canvas panel. *@
<div class="h-72 w-full overflow-hidden rounded-xl border border-(--blux-border)" data-testid="dashboard-sidebar-frame">
    <BxDashboardGroup StorageKey="playground-dashboard-sidebar">
        <BxDashboardSidebar As="div" Width="224" Resizable data-testid="dashboard-sidebar-only" MobileTitle="Workspace">
            <Header><span class="font-semibold text-(--blux-text-highlighted)">Acme</span></Header>
            <ChildContent>
                <BxNavigationMenu Items="_items" Orientation="BxOrientation.Vertical" AriaLabel="Sections" Ui="_navUi" />
            </ChildContent>
        </BxDashboardSidebar>
        <BxDashboardPanel>
            <Header>
                <BxDashboardNavbar Title="Settings">
                    <Leading><BxDashboardSidebarCollapse data-testid="dashboard-sidebar-collapse" /></Leading>
                </BxDashboardNavbar>
            </Header>
            <Body>
                <p class="text-sm text-(--blux-text-muted)">Collapse the sidebar with the button next to the title, or drag its edge. Both are remembered in the browser.</p>
            </Body>
        </BxDashboardPanel>
    </BxDashboardGroup>
</div>

@code {
    private static readonly NavigationMenuUi _navUi = new() { Label = "group-data-[state=collapsed]/sidebar:sr-only" };

    private static readonly BxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true, Icon = BxIcons.Named("home", "size-5") },
        new("Messages") { Href = "/components/dashboard-sidebar", Icon = BxIcons.Named("mail", "size-5") },
        new("Settings") { Href = "/docs/theming", Icon = BxIcons.Named("user", "size-5") },
    ];
}
