@using Blux.UI.Tools.Query
@implements IDisposable
@inject QueryState Query
@inject NavigationManager Navigation

@* The provider fails while the address says ?broken=1. The error state keeps the rows on screen and offers a retry; "Repair" removes the flag, and the retry then succeeds. *@
<div class="w-full space-y-3" data-testid="list-error">
    <p class="flex flex-wrap items-center gap-3 text-sm text-(--blux-text-muted)">
        <BxButton Label="Break the backend" Href="@Query.HrefWith(("broken", "1"))" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="BxSize.Sm" data-testid="err-break" />
        <BxButton Label="Repair the backend" Href="@Query.HrefWith(("broken", (string?)null))" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Size="BxSize.Sm" data-testid="err-repair" />
    </p>
    <BxDataList TItem="Invoice" Schema="InvoiceData.Schema" Provider="LoadAsync" UrlKey="err">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <BxDataListResultCount />
            <BxDataListRefresh />
        </div>
        <BxDataListErrorState data-testid="err-state" />
        <BxDataListTable Caption="Invoices from a flaky backend">
            <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <BxDataListColumn Field="customer" />
            <BxDataListColumn Field="status" />
        </BxDataListTable>
        <BxDataListPagination AriaLabel="Flaky backend pagination" />
    </BxDataList>
</div>

@code {
    // The links carry the current address with one change: they follow it.
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private ValueTask<DataListResult<Invoice>> LoadAsync(DataListRequest request, CancellationToken cancellationToken)
    {
        if (new Uri(Navigation.Uri).Query.Contains("broken=1", StringComparison.Ordinal))
        {
            throw new InvalidOperationException("The invoice service is down.");
        }
        return ValueTask.FromResult(InvoiceData.Schema.ExecuteInMemory(InvoiceData.All, request));
    }
}
