<div class="h-72 w-full overflow-hidden rounded-xl border border-(--blux-border)" data-testid="dashboard-panels">
    <BxDashboardGroup StorageKey="playground-dashboard-panels">
        <BxDashboardPanel Resizable Size="25" MinSize="15" MaxSize="40" ResizeLabel="Resize list" data-testid="dashboard-panel-list">
            <Header><BxDashboardNavbar Title="List" Toggle="false" /></Header>
            <Body><p class="text-sm text-(--blux-text-muted)">Between 15% and 40%.</p></Body>
        </BxDashboardPanel>
        <BxDashboardPanel Resizable Size="50" MinSize="30" ResizeLabel="Resize detail" data-testid="dashboard-panel-detail">
            <Header><BxDashboardNavbar Title="Detail" Toggle="false" /></Header>
            <Body><p class="text-sm text-(--blux-text-muted)">At least 30%. Focus a handle and use the arrow keys, Home and End.</p></Body>
            <Footer><p class="px-4 py-2 text-xs text-(--blux-text-muted)">Footer</p></Footer>
        </BxDashboardPanel>
        <BxDashboardPanel data-testid="dashboard-panel-aside">
            <Header><BxDashboardNavbar Title="Aside" Toggle="false" /></Header>
            <Body><p class="text-sm text-(--blux-text-muted)">Takes what is left.</p></Body>
        </BxDashboardPanel>
    </BxDashboardGroup>
</div>
