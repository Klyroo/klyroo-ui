<div class="flex w-full flex-col items-center gap-4">
    <BxAuthForm FormName="auth-sign-up" Title="Create your account" Description="Start your 14-day trial, no credit card needed."
                Fields="Fields" SubmitLabel="Create account" OnValidSubmit="SignUpAsync" Color="BxColor.Secondary"
                Separator="@null" HeadingLevel="2" />
    @if (_created is not null)
    {
        <p role="status" class="text-sm text-(--blux-success-text)" data-testid="auth-created">Account created for @_created.</p>
    }
</div>

@code {
    private string? _created;

    private static readonly BxAuthField[] Fields =
    [
        new("name", "text") { Label = "Full name", Required = true, Autocomplete = "name" },
        new("email", "email") { Label = "Work email", Placeholder = "you@company.com", Required = true, Autocomplete = "email" },
        new("password", "password") { Label = "Password", Required = true, Autocomplete = "new-password", Help = "At least 8 characters." },
        new("role", "select")
        {
            Label = "Your role",
            Placeholder = "Pick a role",
            Items = [new("dev", "Developer"), new("design", "Designer"), new("pm", "Product manager")],
        },
        new("terms", "checkbox") { Label = "I agree to the terms of service", Required = true },
    ];

    private Task SignUpAsync(IReadOnlyDictionary<string, string?> values)
    {
        _created = values["email"];
        return Task.CompletedTask;
    }
}
