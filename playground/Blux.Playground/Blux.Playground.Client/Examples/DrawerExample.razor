<div class="flex flex-col items-center gap-3">
    <BxDrawer @bind-Open="_open" Title="Quick actions" Description="Pick something to do next.">
        <ChildContent><BxButton Label="Open drawer" Variant="ButtonVariant.Outline" data-testid="drawer-trigger" /></ChildContent>
        <Body>
            <p class="text-sm text-(--blux-text-muted)">The drawer is a native modal dialog: the page behind it is inert and Escape closes it.</p>
        </Body>
        <Footer>
            <BxButton Label="Cancel" Color="BxColor.Neutral" Variant="ButtonVariant.Ghost" data-bx-close />
            <BxButton Label="Done" data-bx-close data-testid="drawer-done" />
        </Footer>
    </BxDrawer>
    <p class="text-sm text-(--blux-text-muted)" data-testid="drawer-state">Drawer: @(_open ? "open" : "closed")</p>
</div>

@code {
    private bool _open;
}
