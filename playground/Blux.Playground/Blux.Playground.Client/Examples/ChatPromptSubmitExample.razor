@* Inside a BxChatPrompt the button follows its Status. Standalone, give it one. Stop and retry need interactivity. *@
<div class="flex flex-wrap items-center gap-6" data-testid="chat-prompt-submit-example">
    @foreach (var status in Enum.GetValues<ChatStatus>())
    {
        <div class="flex flex-col items-center gap-2 text-xs text-(--blux-text-muted)">
            <BxChatPromptSubmit Status="status" OnStop="Stop" OnReload="Retry"
                                data-testid="@($"chat-submit-{status.ToString().ToLowerInvariant()}")" />
            @status
        </div>
    }
    <p class="text-sm" role="status" data-testid="chat-submit-event">@(_event is null ? "No click yet" : $"Clicked: {_event}")</p>
</div>

@code {
    private string? _event;

    private void Stop() => _event = "stop";

    private void Retry() => _event = "retry";
}
