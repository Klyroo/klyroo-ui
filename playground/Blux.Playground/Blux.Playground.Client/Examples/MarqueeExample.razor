<div class="flex w-full flex-col gap-4">
    <BxMarquee Duration="25" data-testid="marquee">
        @foreach (var name in Names)
        {
            <BxBadge Label="@name" Variant="BxVariant.Subtle" />
        }
    </BxMarquee>
    <BxMarquee Reverse="true" Duration="40" Overlay="false">
        @foreach (var name in Names)
        {
            <span class="text-sm text-(--blux-text-muted)">@name</span>
        }
    </BxMarquee>
</div>

@code {
    private static readonly string[] Names = ["Blazor", "Tailwind", "Accessible", "Themeable", "Server", "WebAssembly", "Auto", "Static SSR"];
}
