<div class="flex w-full max-w-xs flex-col gap-3">
    <BxFormField Label="Countries visited">
        <BxSelectMenu OptionsProvider="_source.ByPage" Multiple Create PageSize="20" Debounce="150" Placeholder="Search or add a country"
                      Value="_values" ValueChanged="@(v => _values = v ?? [])" data-testid="remote-create" />
    </BxFormField>
    <p class="text-sm text-(--blux-text-muted)" data-testid="remote-create-state">Selected: @string.Join(", ", _values)</p>
</div>

@code {
    private readonly RemoteDirectory _source = new() { LatencyMs = 250 };
    private IReadOnlyList<string> _values = [];
}
