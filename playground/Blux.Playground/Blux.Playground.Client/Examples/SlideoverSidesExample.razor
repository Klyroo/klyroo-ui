<BxSlideover Side="SlideoverSide.Left" Title="Navigation">
    <ChildContent><BxButton Label="Left" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--blux-text-muted)">Slides in from the left.</p></Body>
</BxSlideover>
<BxSlideover Side="SlideoverSide.Right" Title="Details">
    <ChildContent><BxButton Label="Right" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--blux-text-muted)">Slides in from the right.</p></Body>
</BxSlideover>
<BxSlideover Side="SlideoverSide.Bottom" Title="Activity" Close="false">
    <ChildContent><BxButton Label="Bottom" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--blux-text-muted)">Slides up from the bottom. Escape closes it.</p></Body>
</BxSlideover>
