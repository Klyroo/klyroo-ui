@using System.ComponentModel.DataAnnotations

<BxForm Model="Model" FormName="enhanced-form" Enhance OnValidSubmit="Save" class="flex w-full max-w-sm flex-col">
    <BxFormField Label="Stack" For="() => Model!.Stack">
        <BxSelectMenu Items="Stack" Multiple @bind-Value="Model!.Stack" Placeholder="Pick technologies" />
    </BxFormField>
    <BxFormField Label="Marks" For="() => Model!.Marks">
        <BxToggleGroup Items="Marks" AriaLabel="Marks" Multiple @bind-Value="Model!.Marks" />
    </BxFormField>
    <BxFormField Label="Seats" For="() => Model!.Seats">
        <BxInputNumber @bind-Value="Model!.Seats" Min="0" Max="50" />
    </BxFormField>
    <BxFormField Label="Code" For="() => Model!.Code">
        <BxPinInput Length="4" @bind-Value="Model!.Code" />
    </BxFormField>
    <BxFormField Label="Visit" For="() => Model!.Visit">
        <BxCalendar @bind-Value="Model!.Visit" AriaLabel="Visit date" />
    </BxFormField>
    <BxButton Type="submit" Label="Save enhanced" />
    @if (_posted is not null)
    {
        <p role="status" class="text-sm text-(--blux-success-text)" data-testid="enhanced-saved">Posted: @_posted</p>
    }
</BxForm>

@code {
    [SupplyParameterFromForm(FormName = "enhanced-form")]
    private Profile? Model { get; set; }

    private string? _posted;

    private static readonly BxSelectItem[] Stack = [new("dotnet", ".NET"), new("node", "Node.js"), new("go", "Go")];
    private static readonly BxToggleItem[] Marks = [new("bold", "Bold"), new("italic", "Italic")];

    protected override void OnInitialized() => Model ??= new();

    // The server resets the model after saving: the page it sends back must win over what the browser showed.
    private void Save()
    {
        _posted = $"{string.Join(",", Model!.Stack)} / {string.Join(",", Model.Marks)} / {Model.Seats} / {Model.Code} / {Model.Visit:yyyy-MM-dd}";
        Model = new();
    }

    private sealed class Profile
    {
        public IReadOnlyList<string> Stack { get; set; } = ["dotnet"];

        public IReadOnlyList<string> Marks { get; set; } = ["bold"];

        public decimal? Seats { get; set; } = 2;

        public string? Code { get; set; }

        public DateOnly? Visit { get; set; } = new(2026, 11, 10);
    }
}
