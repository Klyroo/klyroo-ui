<div class="flex w-full max-w-lg flex-col items-center gap-3">
    <div class="w-full overflow-hidden rounded-[calc(var(--blux-radius)*2)] border border-(--blux-border) bg-(--blux-bg-overlay)">
        <BxCommandPalette Groups="Groups" OnSelect="item => _last = item.Label" Placeholder="Type a command or search..." data-testid="palette" />
    </div>
    <p class="text-sm text-(--blux-text-muted)" data-testid="palette-state">Last command: @(_last ?? "none")</p>
</div>

@code {
    private string? _last;

    private static readonly BxCommandGroup[] Groups =
    [
        new("Suggestions",
        [
            new() { Label = "New file", Description = "Create an empty file", Shortcut = "N", Keywords = "create add" },
            new() { Label = "New folder", Description = "Create a folder", Keywords = "create directory" },
            new() { Label = "Open settings", Keywords = "preferences configuration" },
        ]),
        new("Account",
        [
            new() { Label = "Profile" },
            new() { Label = "Billing", Description = "Invoices and payment methods" },
            new() { Label = "Documentation", Href = "/docs", Keywords = "help guide" },
            new() { Label = "Delete account", Disabled = true },
        ]),
    ];
}
