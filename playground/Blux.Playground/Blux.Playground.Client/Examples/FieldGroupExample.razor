        <BxButton Label="Left" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" />
        <BxButton Label="Center" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" />
        <BxButton Label="Right" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" />
