<BxPageColumns Columns="3" Class="w-full gap-4 *:mb-4">
    @foreach (var (title, text) in _items)
    {
        <BxPageCard Variant="PageCardVariant.Subtle" Title="@title" Description="@text" />
    }
</BxPageColumns>

@code {
    private readonly (string Title, string Text)[] _items =
    [
        ("Short", "One line."),
        ("Longer", "Cards of different heights pack without gaps, in reading order down each column, so a testimonial wall needs no JavaScript."),
        ("Medium", "Two lines of text, enough to show the packing."),
        ("Tall", "A taller card with more words: the quick brown fox jumps over the lazy dog, then does it again for good measure."),
        ("Tiny", "Hi."),
        ("Regular", "A regular card with a regular amount of text."),
    ];
}
