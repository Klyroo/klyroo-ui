<div class="flex flex-col items-start gap-4">
    <BxToggleGroup Items="Alignments" AriaLabel="Text alignment" @bind-Value="_alignment" />
    <BxToggleGroup Items="Styles" AriaLabel="Text style" Multiple Variant="ToggleVariant.Soft" Value="@(["bold"])" />
    <p class="text-sm text-(--blux-text-muted)" data-testid="toggle-group-state">Alignment: @(_alignment.Count > 0 ? _alignment[0] : "none")</p>
</div>

@code {
    private IReadOnlyList<string> _alignment = ["left"];

    private static readonly BxToggleItem[] Alignments = [new("left", "Left"), new("center", "Center"), new("right", "Right")];
    private static readonly BxToggleItem[] Styles = [new("bold", "Bold"), new("italic", "Italic"), new("underline", "Underline")];
}
