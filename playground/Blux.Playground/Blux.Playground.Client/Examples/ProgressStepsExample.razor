<div class="w-full max-w-md">
    <BxProgress Value="@_step" Steps="Steps" AriaLabel="Checkout" />
    <div class="mt-4 flex justify-center gap-2">
        <BxButton Label="Back" Variant="ButtonVariant.Outline" Disabled="@(_step == 0)" OnClick="() => _step--" />
        <BxButton Label="Next" Disabled="@(_step == Steps.Length - 1)" OnClick="() => _step++" />
    </div>
</div>

@code {
    private static readonly string[] Steps = ["Cart", "Shipping", "Payment", "Done"];
    private int _step = 1;
}
