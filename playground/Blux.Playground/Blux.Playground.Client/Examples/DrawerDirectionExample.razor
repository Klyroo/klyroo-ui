<BxDrawer Direction="DrawerDirection.Top" Title="From the top" Close>
    <ChildContent><BxButton Label="Top" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--blux-text-muted)">Handle at the bottom edge.</p></Body>
</BxDrawer>
<BxDrawer Direction="DrawerDirection.Left" Title="From the left" Close>
    <ChildContent><BxButton Label="Left" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--blux-text-muted)">Side drawers have no handle.</p></Body>
</BxDrawer>
<BxDrawer Direction="DrawerDirection.Right" Inset Title="Inset, from the right" Close>
    <ChildContent><BxButton Label="Right, inset" Variant="ButtonVariant.Outline" /></ChildContent>
    <Body><p class="text-sm text-(--blux-text-muted)">Inset floats the drawer away from the edges.</p></Body>
</BxDrawer>
