<div class="flex w-full max-w-2xl flex-col gap-3">
    <BxFormField Label="Summary" Help="Select some text to format it.">
        <BxEditor Value="@("<p>Select a few of these words, then use the floating toolbar or press Ctrl+B.</p>")" Name="summary" data-testid="editor-bubble">
            <BxEditorToolbar Layout="EditorToolbarLayout.Bubble" />
        </BxEditor>
    </BxFormField>
    <BxFormField Label="Read only">
        <BxEditor Value="@("<p>This text can be selected and copied, not edited.</p>")" ReadOnly="true" data-testid="editor-readonly" />
    </BxFormField>
</div>
