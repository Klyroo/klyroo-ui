<div class="flex w-full max-w-xs flex-col gap-4">
    <BxFormField Label="Quantity">
        <BxInputNumber @bind-Value="_quantity" Min="0" Max="20" />
    </BxFormField>
    <BxFormField Label="Price (French format)">
        <BxInputNumber @bind-Value="_price" Min="0" Step="0.5m" Locale="fr-FR" Orientation="BxOrientation.Vertical" />
    </BxFormField>
    <p class="text-sm text-(--blux-text-muted)" data-testid="number-state">Quantity: @(_quantity?.ToString() ?? "none"), price: @(_price?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "none")</p>
</div>

@code {
    private decimal? _quantity = 2;
    private decimal? _price = 1234.5m;
}
