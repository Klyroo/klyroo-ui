<div class="flex w-full flex-col items-center gap-4">
    <BxAuthForm FormName="auth-verify" Title="Check your email" Description="We sent a 6-digit code to you@example.com."
                Fields="Fields" SubmitLabel="Verify" OnValidSubmit="VerifyAsync" FieldErrors="_fieldErrors" Enhance />
    @if (_verified)
    {
        <p role="status" class="text-sm text-(--blux-success-text)" data-testid="auth-verified">Email verified.</p>
    }
</div>

@code {
    private bool _verified;
    private IReadOnlyDictionary<string, string>? _fieldErrors;

    private static readonly BxAuthField[] Fields =
    [
        new("code", "otp") { Label = "Verification code", Length = 6, Required = true, Help = "The code expires in 10 minutes." },
    ];

    private Task VerifyAsync(IReadOnlyDictionary<string, string?> values)
    {
        // 123456 stands for the code the server sent.
        if (values["code"] == "123456")
        {
            _fieldErrors = null;
            _verified = true;
        }
        else
        {
            _fieldErrors = new Dictionary<string, string> { ["code"] = "That code is not right. Try again." };
        }
        return Task.CompletedTask;
    }
}
