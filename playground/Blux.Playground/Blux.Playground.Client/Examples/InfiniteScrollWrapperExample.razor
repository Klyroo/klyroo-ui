<div class="flex w-full max-w-md flex-col gap-3">
    @* overflow-x-hidden makes the computed overflow-y "auto" too, though nothing scrolls here: the page does. *@
    <div class="overflow-x-hidden rounded-lg border border-(--blux-border) bg-(--blux-bg)" data-testid="wrap-feed">
        <ul>
            @for (var i = 1; i <= _shown; i++)
            {
                <li class="border-b border-(--blux-border) px-3 py-2 text-sm">Row @i</li>
            }
        </ul>
        <BxInfiniteScroll HasMore="_shown < 60" OnLoadMore="LoadAsync" data-testid="wrap-more" />
    </div>
    <p class="text-sm text-(--blux-text-muted)" data-testid="wrap-count">Showing @_shown of 60</p>
    <p class="text-sm text-(--blux-text-muted)" data-testid="wrap-requests">Load requests: @_requests</p>
</div>

@code {
    private int _shown = 20;
    private int _requests;

    private async Task LoadAsync()
    {
        _requests++;
        await Task.Delay(400);
        _shown += 20;
    }
}
