<div class="w-full overflow-hidden rounded-lg border border-(--blux-border) bg-(--blux-bg)">
    <BxPageCta Variant="BxVariant.Solid" Title="Start building today" HeadingLevel="3"
               Description="Add the package, import the stylesheet and render your first component in a minute."
               Links="_solid" Class="py-6" />
    <BxPageCta Variant="BxVariant.Soft" Title="Questions before you start?" HeadingLevel="3"
               Description="Browse the guides or open a discussion."
               Links="_soft" Class="py-6" />
</div>

@code {
    private readonly PageLinkItem[] _solid =
    [
        new("Get started", "/docs/installation") { Color = BxColor.Neutral },
    ];

    private readonly PageLinkItem[] _soft =
    [
        new("Read the guides", "/docs/installation"),
        new("Ask a question", "https://github.com/") { Target = "_blank", Color = BxColor.Neutral, Variant = ButtonVariant.Outline },
    ];
}
