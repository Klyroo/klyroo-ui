<div class="flex w-full max-w-md flex-col gap-2">
    <BxFileUpload Accept="image/*" Label="Choose an avatar" Hint="PNG or JPG" MaxSize="2097152" OnChange="OnChange" data-testid="avatar" />
    <p class="text-sm text-(--blux-text-muted)" data-testid="avatar-state">@_state</p>
</div>

@code {
    private string _state = "No file read yet.";

    private async Task OnChange(InputFileChangeEventArgs e)
    {
        await using var stream = e.File.OpenReadStream(2 * 1024 * 1024);
        var buffer = new byte[stream.Length];
        await stream.ReadExactlyAsync(buffer);
        _state = $"Read {buffer.Length} bytes of {e.File.Name}.";
    }
}
