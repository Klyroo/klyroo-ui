<div class="flex flex-col gap-3">
    <div class="h-72 w-full overflow-hidden rounded-xl border border-(--blux-border)" data-testid="dashboard-bound">
        <BxDashboardGroup StorageKey="playground-dashboard-bound" @bind-Sizes="_sizes">
            <BxDashboardSidebar As="div" @bind-Collapsed="_collapsed" data-testid="dashboard-bound-sidebar">
                <Header><span class="font-semibold text-(--blux-text-highlighted)">Acme</span></Header>
                <ChildContent>
                    <BxNavigationMenu Items="_items" Orientation="BxOrientation.Vertical" AriaLabel="Workspace, bound" Ui="_navUi" />
                </ChildContent>
            </BxDashboardSidebar>
            <BxDashboardPanel Resizable Size="40" MinSize="15" MaxSize="85" ResizeLabel="Resize list">
                <Header>
                    <BxDashboardNavbar Title="List">
                        <Leading><BxDashboardSidebarCollapse data-testid="dashboard-bound-collapse" /></Leading>
                    </BxDashboardNavbar>
                </Header>
            </BxDashboardPanel>
            <BxDashboardPanel>
                <Header><BxDashboardNavbar Title="Detail" Toggle="false" /></Header>
            </BxDashboardPanel>
        </BxDashboardGroup>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm text-(--blux-text-muted)">
        <p data-testid="dashboard-bound-sizes">Sizes: @string.Join(",", _sizes.Select(s => Math.Round(s)))</p>
        <p data-testid="dashboard-bound-collapsed">Collapsed: @(_collapsed ? "true" : "false")</p>
        <BxButton Label="Set 25 / 75" Size="BxSize.Sm" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" OnClick="() => _sizes = [25, 75]" data-testid="dashboard-bound-set" />
    </div>
</div>

@code {
    private IReadOnlyList<double> _sizes = [40, 60];
    private bool _collapsed;

    private static readonly NavigationMenuUi _navUi = new() { Label = "group-data-[state=collapsed]/sidebar:sr-only" };

    private static readonly BxNavigationItem[] _items =
    [
        new("Home") { Href = "/", Exact = true, Icon = BxIcons.Named("home", "size-5") },
        new("Inbox") { Href = "/components/dashboard-group", Icon = BxIcons.Named("inbox", "size-5") },
    ];
}
