<div class="flex flex-col items-start gap-4">
    <BxFormField Label="Verification code" Help="Paste a code into any box to fill them all.">
        <BxPinInput Length="6" @bind-Value="_code" />
    </BxFormField>
    <BxFormField Label="Secret PIN">
        <BxPinInput Length="4" Mask Type="PinInputType.Alphanumeric" Size="BxSize.Lg" />
    </BxFormField>
    <p class="text-sm text-(--blux-text-muted)" data-testid="pin-state">Code: @(string.IsNullOrEmpty(_code) ? "none" : _code)</p>
</div>

@code {
    private string? _code;
}
