<div class="flex w-full max-w-sm flex-col gap-3">
    <BxFormField Label="Topics" Help="Press Enter or comma to add, Backspace to remove. Three at most.">
        <BxInputTags @bind-Value="_tags" Max="3" Placeholder="Add a topic" />
    </BxFormField>
    <p class="text-sm text-(--blux-text-muted)" data-testid="tags-state">Tags: @(_tags.Count > 0 ? string.Join(" | ", _tags) : "none")</p>
</div>

@code {
    private IReadOnlyList<string> _tags = ["blazor", "tailwind"];
}
