<div class="flex flex-wrap items-center gap-3">
    @foreach (var size in Enum.GetValues<BxSize>())
    {
        <BxAvatar Size="size" Alt="Grace Hopper" />
    }
    <BxAvatar Size="BxSize.Lg" Src="https://i.pravatar.cc/80?img=47" Alt="Profile photo" />
    @* A broken image falls back to the initials. *@
    <BxAvatar Size="BxSize.Lg" Src="/missing.png" Alt="Ada Lovelace" />
</div>
