<BxPopover Placement="right">
    <ChildContent><BxButton Label="Open unbound" Color="BxColor.Neutral" Variant="ButtonVariant.Subtle" data-testid="unbound-trigger" /></ChildContent>
    <Content>
        <div class="flex w-64 flex-col gap-2 p-4" data-testid="unbound-panel">
            <BxFormField Label="Name" Id="pg-name">
                <BxInput data-testid="unbound-input" />
            </BxFormField>
        </div>
    </Content>
</BxPopover>
