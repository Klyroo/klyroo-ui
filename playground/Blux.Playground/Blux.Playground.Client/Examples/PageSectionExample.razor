<div class="w-full overflow-hidden rounded-lg border border-(--blux-border) bg-(--blux-bg)">
    <BxPageSection Icon="zap" Headline="Features" Title="Built for the way Blazor renders" HeadingLevel="3"
                   Description="Components that work before the runtime starts and keep working after it does."
                   Features="_features" Links="_links" Ui="_ui">
        <Media>
            <div class="rounded-xl border border-(--blux-border) bg-(--blux-bg-elevated) p-6 text-sm text-(--blux-text-muted)">
                <p class="font-mono text-(--blux-text)">Render mode: static</p>
                <p class="mt-2">This panel is plain server-rendered HTML.</p>
            </div>
        </Media>
    </BxPageSection>
</div>

@code {
    private readonly PageSectionUi _ui = new() { Container = "py-12 sm:py-12 lg:py-12" };

    private readonly PageFeatureItem[] _features =
    [
        new("Browser-first state", "Menus, dialogs and tabs answer in the browser, with no round trip.") { Icon = "globe" },
        new("Accessible by default", "ARIA patterns, keyboard support and contrast checked in light and dark.") { Icon = "eye" },
        new("Themeable", "A handful of CSS variables restyle every component.") { Icon = "pencil", Href = "/docs/theming" },
    ];

    private readonly PageLinkItem[] _links =
    [
        new("Read the docs", "/docs/installation") { Color = BxColor.Neutral, Variant = ButtonVariant.Outline },
    ];
}
