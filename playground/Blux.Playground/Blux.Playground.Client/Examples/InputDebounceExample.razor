@using System.ComponentModel.DataAnnotations
<div class="flex w-full max-w-sm flex-col gap-3">
    <BxInput @ref="_input" Value="@_query" ValueChanged="OnQuery" Debounce="400" ClearOnEscape Type="search" Placeholder="Type, then pause" aria-label="Debounced search" data-testid="debounced" />
    <p class="text-sm text-(--blux-text-muted)" data-testid="debounced-state">Value: @_query</p>
    <p class="text-sm text-(--blux-text-muted)" data-testid="debounced-count">Reports: @_reports</p>
    <div class="flex gap-2">
        @* Keeps the focus in the field: the button replaces the text, even text still waiting for its pause. *@
        <button type="button" class="rounded-md border px-3 py-1 text-sm" data-testid="reset" @onmousedown:preventDefault="true" @onclick="Reset">Reset</button>
    </div>
    <BxInput Value="@_plain" ValueChanged="OnPlain" aria-label="Plain input" Placeholder="No debounce: reported on change" data-testid="plain" />
    <p class="text-sm text-(--blux-text-muted)" data-testid="plain-state">Plain: @_plain</p>
    <BxInput Value="@_escOnly" ValueChanged="OnEscOnly" ClearOnEscape aria-label="Escape only" Placeholder="ClearOnEscape, no Debounce" data-testid="escape-only" />
    <p class="text-sm text-(--blux-text-muted)" data-testid="escape-only-state">Escape only: @_escOnly</p>
    <button type="button" class="rounded-md border px-3 py-1 text-sm" data-testid="escape-only-set" @onclick="@(() => _escOnly = "from parent")">Set from parent</button>
    <EditForm Model="_account" class="flex flex-col gap-2">
        <DataAnnotationsValidator />
        <BxInput @bind-Value="_account.Email" Debounce="300" Type="text" aria-label="Email" Placeholder="Validated after each pause" data-testid="email" />
        <ValidationMessage For="() => _account.Email" />
    </EditForm>
</div>

@code {
    private BxInput? _input;
    private string? _query;
    private string? _plain;
    private string? _escOnly;
    private int _reports;
    private readonly Account _account = new();

    private void OnQuery(string? value)
    {
        _query = value;
        _reports++;
    }

    private void OnEscOnly(string? value) => _escOnly = value;

    private void OnPlain(string? value) => _plain = value;

    private async Task Reset()
    {
        if (_input is not null) await _input.SetValueAsync("");
    }

    private sealed class Account
    {
        [EmailAddress(ErrorMessage = "Not an email address.")]
        public string? Email { get; set; }
    }
}
