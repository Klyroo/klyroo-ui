@using Blux.UI.Tools.Query

@* Virtualized table with PagingMode.None: 200 rows loaded at once, only the rows around the scroll viewport are mounted in the DOM (with tr spacers, sticky header, aria-rowcount and aria-rowindex).
   Statically rendered, virtualization stays off and the regular table rows are drawn. *@
<div class="w-full" data-testid="list-virtualized">
    <BxDataList TItem="Invoice" Label="Virtualized invoices" Schema="InvoiceData.Schema" Items="_items" PagingMode="DataListPagingMode.None" UrlKey="virt">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <BxDataListSearch />
            <BxDataListResultCount />
        </div>
        <BxDataListTable Caption="Virtualized invoices" Virtualize="true">
            <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <BxDataListColumn Field="customer" />
            <BxDataListColumn Field="status" />
            <BxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </BxDataListTable>
    </BxDataList>
</div>

@code {
    private static readonly Invoice[] _items = InvoiceLargeData.All[..200];
}
