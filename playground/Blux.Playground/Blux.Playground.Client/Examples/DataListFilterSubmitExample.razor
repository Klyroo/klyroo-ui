@* The same filters in the Submit apply mode: the editors keep their changes until Apply, Cancel or Escape drops them, and each Apply is one history entry (sub.f.*). The parts are placed by hand,
   so the filter row is the tags with the add filter button. *@
<div class="w-full space-y-3" data-testid="list-filters-submit">
    <BxDataList TItem="Invoice" Label="Invoices with Submit filters" Schema="InvoiceFilterData.Schema" Items="InvoiceData.All" UrlKey="sub">
        <BxDataListFilterTags ShowAdd="true" ShowClear="true" ApplyMode="DataListApplyMode.Submit" />
        <BxDataListResultCount />
        <BxDataListTable Caption="Invoices with Submit filters">
            <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <BxDataListColumn Field="customer" />
            <BxDataListColumn Field="status" />
            <BxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </BxDataListTable>
        <BxDataListPagination />
    </BxDataList>
</div>
