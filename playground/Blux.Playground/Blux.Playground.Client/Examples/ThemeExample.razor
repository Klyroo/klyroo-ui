@using Blux.UI.Theming
<div class="flex flex-wrap items-center gap-3">
    <BxButton Label="Default" data-testid="theme-default" />
    <BxTheme For="typeof(BxButton)" Ui="_bold">
        <BxButton Label="Themed" data-testid="theme-button" />
        <BxButton Label="Instance wins" Ui='new ButtonUi { Base = "font-normal normal-case tracking-normal" }' data-testid="theme-instance" />
    </BxTheme>
</div>

@code {
    private readonly ButtonUi _bold = new() { Base = "font-extrabold uppercase tracking-wider" };
}
