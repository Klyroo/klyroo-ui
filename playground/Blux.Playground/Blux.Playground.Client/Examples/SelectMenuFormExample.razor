@using System.ComponentModel.DataAnnotations

<EditForm Model="Model" FormName="select-menu-form" OnValidSubmit="Save" class="flex w-full max-w-sm flex-col items-start gap-4" novalidate>
    <DataAnnotationsValidator />
    <BxFormField Label="Stack" For="() => Model!.Stack" class="w-full">
        <BxSelectMenu Items="Stack" Multiple @bind-Value="Model!.Stack" Placeholder="Pick technologies" />
    </BxFormField>
    <BxFormField Label="Keywords" For="() => Model!.Keywords" class="w-full">
        <BxInputTags @bind-Value="Model!.Keywords" Placeholder="Type, then Enter" />
    </BxFormField>
    <BxButton Type="submit" Label="Save profile" />
    @if (_saved)
    {
        <p role="status" class="text-sm text-(--blux-success-text)" data-testid="saved">Saved: @string.Join(", ", Model!.Stack) / @string.Join(", ", Model!.Keywords)</p>
    }
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "select-menu-form")]
    private Profile? Model { get; set; }

    private bool _saved;

    private static readonly BxSelectItem[] Stack = [new("dotnet", ".NET"), new("node", "Node.js"), new("python", "Python"), new("go", "Go")];

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = true;

    private sealed class Profile
    {
        public IReadOnlyList<string> Stack { get; set; } = [];

        public IReadOnlyList<string> Keywords { get; set; } = [];
    }
}
