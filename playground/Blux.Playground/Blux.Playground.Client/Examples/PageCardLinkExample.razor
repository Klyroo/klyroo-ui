@* The title is the only link; it stretches over the card, so a click anywhere follows it. *@
<div class="grid w-full gap-4 sm:grid-cols-2">
    <BxPageCard Variant="PageCardVariant.Spotlight" Icon="file" Title="Documentation" Href="/docs/installation"
                Description="Install the package and render your first component." data-testid="card-link" />
    <BxPageCard Variant="PageCardVariant.Outline" Icon="external-link" Title="Source code" Href="https://github.com/" Target="_blank"
                Description="Read the code and open an issue." Color="BxColor.Neutral" data-testid="card-external" />
</div>
