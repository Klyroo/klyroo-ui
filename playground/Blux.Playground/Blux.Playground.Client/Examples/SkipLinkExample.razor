@* Put the link first in the page, before the header, and give the main landmark the id it names. Here a small block stands in for the main content. *@
<div class="flex w-full flex-col gap-3 text-sm">
    <BxSkipLink Target="skip-link-example-main" data-testid="skip-link-example" />
    <p class="text-(--blux-text-muted)">
        Click in this block and press Tab: the link appears in the top corner of the screen. Pressing Enter moves the focus to the content below,
        on this page, and leaves the address alone.
    </p>
    <div id="skip-link-example-main" class="rounded-md border border-(--blux-border) p-3 focus:outline-2 focus:outline-(--blux-primary-text)" data-testid="skip-link-example-target">
        Main content
    </div>
</div>
