<div class="flex w-full max-w-2xl flex-col gap-3">
    <BxFormField Label="Changing buttons" Help="Items can change while the editor is open: the buttons show the state of the action they now stand for.">
        <BxEditor Value="@("<p><strong><em>Bold and italic</em></strong></p>")" Name="changing" data-testid="editor-changing">
            <BxEditorToolbar Items="Current" />
        </BxEditor>
    </BxFormField>
    <div>
        <BxButton Variant="ButtonVariant.Outline" OnClick="Next" data-testid="editor-changing-next">Use other buttons</BxButton>
    </div>
</div>

@code {
    private static readonly EditorToolbarItem[][] Sets =
    [
        [new(EditorAction.Bold), new(EditorAction.Italic)],
        [new(EditorAction.Bold), new(EditorAction.Code)],
        [new(EditorAction.Bold), new(EditorAction.Redo)],
    ];

    private int _set;

    private EditorToolbarItem[] Current => Sets[_set];

    private void Next() => _set = (_set + 1) % Sets.Length;
}
