<div class="w-full max-w-lg">
    <BxAccordion Items="Items" Value="@(["render-modes"])" />
</div>

@code {
    private static readonly BxAccordionItem[] Items =
    [
        new("Which render modes are supported?") { Value = "render-modes", Content = @<p>Interactive Server, WebAssembly and Auto, plus static server rendering.</p> },
        new("Do I need Tailwind?") { Value = "tailwind", Content = @<p>No. Without it, load blux.css and theme with CSS variables.</p> },
        new("Is it accessible?") { Value = "a11y", Content = @<p>Components follow the WAI-ARIA authoring practices and are tested with axe.</p> },
    ];
}
