@using System.ComponentModel.DataAnnotations

<EditForm Model="Model" FormName="calendar-form" OnValidSubmit="Save" class="flex flex-col items-start gap-4" novalidate>
    <div class="flex flex-wrap items-start gap-8">
        <BxCalendar Mode="BxCalendarMode.Multiple" @bind-Values="Model!.Days" AriaLabel="Days to book" data-testid="form-days" />
        <BxCalendar Mode="BxCalendarMode.Range" @bind-Range="Model!.Stay" AriaLabel="Stay dates" data-testid="form-stay" />
    </div>
    <BxButton Type="submit" Label="Book dates" />
    @if (_saved)
    {
        <p role="status" class="text-sm text-(--blux-success-text)" data-testid="calendar-saved">Booked: @Text()</p>
    }
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "calendar-form")]
    private Booking? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = true;

    private string Text() =>
        $"{string.Join(",", Model!.Days.Select(d => d.ToString("MM-dd")))} / {Model.Stay?.Start:yyyy-MM-dd} to {Model.Stay?.End:yyyy-MM-dd}";

    private sealed class Booking
    {
        public IReadOnlyList<DateOnly> Days { get; set; } = [new(2026, 11, 2)];

        public BxDateRange? Stay { get; set; } = new(new DateOnly(2026, 11, 9), new DateOnly(2026, 11, 13));
    }
}
