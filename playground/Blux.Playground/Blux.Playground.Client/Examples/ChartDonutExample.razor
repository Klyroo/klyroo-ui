@* A donut has one slice per row, sized by the first category. The Center fragment sits over the hole. *@
<div class="w-full">
    <BxChart TItem="Browser" Data="_data" Index="@(b => b.Name)" Categories="_categories" Type="BxChartType.Donut"
             Height="260" Thickness="36" data-testid="chart-donut">
        <Center>
            <span class="text-2xl font-semibold text-(--blux-text-highlighted)">@_data.Sum(b => b.Share)%</span>
            <span class="text-xs text-(--blux-text-muted)">of visits</span>
        </Center>
    </BxChart>
</div>

@code {
    private sealed record Browser(string Name, double Share);

    private static readonly Browser[] _data =
    [
        new("Chrome", 54), new("Safari", 24), new("Firefox", 9), new("Edge", 8), new("Other", 5),
    ];

    private static readonly BxChartCategory<Browser>[] _categories = [new("share", b => b.Share) { Label = "Share of visits" }];
}
