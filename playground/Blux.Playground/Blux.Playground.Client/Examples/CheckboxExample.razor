<div class="flex flex-col gap-3">
    <BxCheckbox @bind-Value="_updates" Label="Product updates" Description="A short email when something ships." />
    <BxCheckbox Value="true" Label="Success color" Color="BxColor.Success" />
    <BxCheckbox Disabled Label="Disabled" />
    <p class="text-sm text-(--blux-text-muted)">Updates: @(_updates ? "yes" : "no")</p>
</div>

@code {
    private bool _updates;
}
