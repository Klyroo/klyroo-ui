<div class="flex w-full max-w-2xl flex-col gap-3">
    <BxFormField Label="Slash menu" Help="Type / and keep typing to filter, then press Enter.">
        <BxEditor Value="@("")" Name="slash" Placeholder="Type / for commands" data-testid="editor-slash">
            <BxEditorSuggestionMenu Items="Items" />
        </BxEditor>
    </BxFormField>
</div>

@code {
    private static readonly EditorSuggestionItem[] Items =
    [
        new(EditorAction.Heading, "Big title") { Level = 1, Description = "Heading 1", Keywords = "h1 heading" },
        new(EditorAction.Heading, "Section") { Level = 2, Description = "Heading 2", Keywords = "h2 heading" },
        new(EditorAction.BulletList, "Bullets") { Description = "A list of points" },
        new(EditorAction.Blockquote, "Quote") { Description = "Quote a passage" },
        new(EditorAction.HorizontalRule, "Divider") { Description = "A horizontal line" },
    ];
}
