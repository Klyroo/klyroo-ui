<div class="flex flex-col items-center gap-4">
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var variant in Enum.GetValues<BxVariant>())
        {
            <BxKbd Variant="variant" Value="K" />
        }
    </div>
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var size in Enum.GetValues<BxSize>())
        {
            <BxKbd Size="size" Value="Esc" />
        }
    </div>
    <p class="flex items-center gap-1 text-sm">
        Open the search with <BxKbd Value="Ctrl" /> <BxKbd Value="K" />
    </p>
</div>
