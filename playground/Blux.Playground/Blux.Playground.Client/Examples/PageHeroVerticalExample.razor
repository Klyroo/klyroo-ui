<div class="w-full overflow-hidden rounded-lg border border-(--blux-border) bg-(--blux-bg)">
    <BxPageHero Orientation="BxOrientation.Vertical" Title="One stylesheet, every render mode" HeadingLevel="3"
                Description="Server, WebAssembly, Auto and static pages share the same markup and the same theme."
                Links="_links" Ui="_ui" />
</div>

@code {
    private readonly PageHeroUi _ui = new()
    {
        Container = "py-12 sm:py-12 lg:py-12",
        Title = "text-4xl sm:text-4xl lg:text-5xl",
    };

    private readonly PageLinkItem[] _links =
    [
        new("Get started", "/docs/installation"),
        new("Browse components", "/components/button") { Color = BxColor.Neutral, Variant = ButtonVariant.Subtle },
    ];
}
