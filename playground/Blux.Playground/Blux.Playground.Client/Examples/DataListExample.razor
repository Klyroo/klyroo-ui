@* Rows in memory, described by a schema: the list sorts and pages them itself. The state lives in the URL under the prefix "mem" (mem.q, mem.s, mem.p, mem.ps). *@
<div class="w-full" data-testid="list-memory">
    <BxDataList TItem="Invoice" Label="Invoices in memory" Schema="InvoiceData.Schema" Items="InvoiceData.All" UrlKey="mem" ResultJson="DemoJson.Default.DataListResultInvoice">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <BxDataListSearch data-testid="mem-search" />
            <BxDataListResultCount />
            <BxDataListRefresh />
        </div>
        <BxDataListErrorState />
        <BxDataListTable Caption="Invoices">
            <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <BxDataListColumn Field="customer" />
            <BxDataListColumn Field="status" />
            <BxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
            <BxDataListColumn Field="issued" Format="d" />
        </BxDataListTable>
        <BxDataListPagination />
    </BxDataList>
</div>
