<div class="flex flex-col items-center gap-3">
    @foreach (var variant in Enum.GetValues<BxVariant>())
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var color in new[] { BxColor.Primary, BxColor.Success, BxColor.Warning, BxColor.Error, BxColor.Neutral })
            {
                <BxBadge Color="color" Variant="variant" Label="@color.Value" />
            }
        </div>
    }
    <div class="flex flex-wrap items-center gap-2">
        @foreach (var size in Enum.GetValues<BxSize>())
        {
            <BxBadge Size="size" Label="@size.ToString()" Variant="BxVariant.Subtle" />
        }
    </div>
</div>
