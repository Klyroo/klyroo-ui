<EditForm Model="Model" FormName="appointment" OnValidSubmit="Save" class="flex w-full max-w-xs flex-col items-start gap-3">
    <BxFormField Label="Appointment date" Description="Posted as yyyy-MM-dd." For="() => Model!.Date" class="w-full">
        <BxInputDate @bind-Value="Model!.Date" data-testid="appointment" />
    </BxFormField>
    <BxButton Type="submit" Label="Book" />
    @if (_saved)
    {
        <p role="status" class="text-sm text-(--blux-success-text)" data-testid="appointment-saved">Booked: @Model!.Date?.ToString("yyyy-MM-dd")</p>
    }
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "appointment")]
    private Booking? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new() { Date = new DateOnly(2026, 11, 10) };

    private void Save() => _saved = true;

    private sealed class Booking
    {
        public DateOnly? Date { get; set; }
    }
}
