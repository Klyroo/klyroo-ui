@* Attachments are yours to manage: show a chip per file and take it out of the list when it is removed. A message with
   attachments may be sent with no text. Removing needs interactivity. *@
<div class="w-full max-w-xl" data-testid="chat-prompt-attachments-example">
    <BxChatPrompt OnSubmit="Send" Placeholder="Add a note..." Variant="FieldVariant.Subtle" data-testid="chat-prompt-attachments">
        <Attachments>
            @foreach (var file in _files)
            {
                var f = file;
                <BxChatAttachment @key="f.Name" Name="@f.Name" Type="@f.Type" FileSize="f.Size" Size="BxSize.Sm" Removable OnRemove="() => Remove(f)" />
            }
        </Attachments>
        <Footer>
            <span class="text-xs text-(--blux-text-muted)" data-testid="chat-prompt-attachments-last">@(_last ?? "Nothing sent yet")</span>
        </Footer>
    </BxChatPrompt>
</div>

@code {
    private sealed record Attached(string Name, string Type, long Size);

    private readonly List<Attached> _files = [new("report.pdf", "application/pdf", 248000), new("budget.xlsx", "application/vnd.ms-excel", 31800)];
    private string? _last;

    private void Remove(Attached file) => _files.Remove(file);

    private void Send(string text)
    {
        _last = $"Sent \"{text}\" with {_files.Count} file(s)";
        _files.Clear();
    }
}
