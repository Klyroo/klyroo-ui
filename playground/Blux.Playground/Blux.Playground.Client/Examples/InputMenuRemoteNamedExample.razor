<div class="flex w-full max-w-xs flex-col gap-3">
    <BxFormField Label="Home country, named">
        <BxInputMenu OptionsProvider="_source.ByPage" Items="Known" Strict PageSize="20" Value="@_country" ValueChanged="@(v => _country = v)" data-testid="remote-named-strict" />
    </BxFormField>
    <p class="text-sm text-(--blux-text-muted)" data-testid="remote-named-strict-state">Selected: @(_country ?? "none")</p>
</div>

@code {
    private readonly RemoteDirectory _source = new();
    private string? _country = "fr";

    // Items name a value without listing it: France shows as France in every render mode, without a call to the source.
    private static readonly BxSelectItem[] Known = [new("fr", "France")];
}
