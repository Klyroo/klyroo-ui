<div class="flex w-full max-w-xs flex-col gap-3">
    <BxSwitch @bind-Value="_failing" Label="The source is down" data-testid="remote-input-fail" />
    <BxFormField Label="Look up a country">
        <BxInputMenu OptionsProvider="_source.ByPage" PageSize="20" MinLength="2" Placeholder="Type two letters" @bind-Value="_text" data-testid="remote-input-error" />
    </BxFormField>
    <p class="text-sm text-(--blux-text-muted)" data-testid="remote-input-error-state">Text: @(_text ?? "none")</p>
    <p class="text-sm text-(--blux-text-muted)" data-testid="remote-input-error-requests">Source calls: @_source.Requests</p>
</div>

@code {
    private RemoteDirectory _source = default!;
    private string? _text;

    // The switch flips what the simulated source does: with it on, every call throws and the list shows its error and Retry button.
    private bool _failing
    {
        get => _source.Fail;
        set => _source.Fail = value;
    }

    protected override void OnInitialized() => _source = new RemoteDirectory { Changed = () => _ = InvokeAsync(StateHasChanged), LatencyMs = 200 };
}
