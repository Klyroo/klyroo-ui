@using Blux.UI.Tools.Query

@* Table and Grid views with BxDataListLayoutSwitch, BxDataListSortMenu and BxDataListGrid:
   - The first list has both BxDataListTable and BxDataListGrid, a layout switch, a sort menu, search, selection and row actions.
   - The second list is a standalone grid (DefaultLayout = Grid) with custom sort options and a card removal action. *@
<div class="flex w-full flex-col gap-8">
    <div class="w-full" data-testid="list-grid-switch">
        <BxDataList TItem="Invoice" Label="Invoices with table and grid views" Schema="InvoiceData.Schema" Items="_items" UrlKey="grid" PreferencesKey="demo-grid" Selectable="true">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <BxDataListSearch />
                <div class="flex flex-wrap items-center gap-2">
                    <BxDataListResultCount />
                    <BxDataListSortMenu />
                    <BxDataListViewToggle />
                    <BxDataListLayoutSwitch />
                    <BxDataListRefresh />
                </div>
            </div>
            <BxDataListSelectionActions Actions="_bulkActions" />
            <BxDataListTable Caption="Invoices with table and grid views" RowActions="_rowActions" RowSummary="_summary">
                <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
                <BxDataListColumn Field="customer" />
                <BxDataListColumn Field="status" />
                <BxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
            </BxDataListTable>
            <BxDataListGrid Columns="3" RowActions="_rowActions">
                <ItemTemplate Context="invoice">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-baseline justify-between gap-2">
                            <span class="font-semibold text-(--blux-text-highlighted)" data-slot="card-customer">@invoice.Customer</span>
                            <span class="text-xs tabular-nums text-(--blux-text-muted)">#@invoice.Id</span>
                        </div>
                        <div class="flex items-center justify-between gap-2 text-xs text-(--blux-text-muted)">
                            <span>@invoice.Status</span>
                            <span class="font-medium tabular-nums text-(--blux-text)">@invoice.Amount.ToString("C2")</span>
                        </div>
                    </div>
                </ItemTemplate>
            </BxDataListGrid>
            <BxDataListPagination />
        </BxDataList>
    </div>

    <div class="w-full" data-testid="list-grid-only">
        <BxDataList TItem="Invoice" Label="Removable invoice cards" Schema="_gridOnlySchema" Items="_removable" UrlKey="cards" UrlSync="false">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <BxDataListResultCount />
                <BxDataListSortMenu Items="_sortOptions" />
            </div>
            <BxDataListGrid Columns="3" RowActions="_removeActions" RowActionsMaxVisible="1" />
        </BxDataList>
    </div>

    <div class="w-full" data-testid="list-grouped">
        <BxDataList TItem="Invoice" Label="Invoices grouped by status" Schema="InvoiceData.Schema" Items="_groupedItems" PagingMode="DataListPagingMode.None" UrlKey="grp" PreferencesKey="demo-groups" Selectable="true">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <BxDataListResultCount />
                <div class="flex flex-wrap items-center gap-2">
                    <BxDataListSortMenu />
                    <BxDataListLayoutSwitch />
                </div>
            </div>
            <BxDataListSelectionActions Actions="_bulkActions" />
            <BxDataListTable Caption="Invoices grouped by status" GroupBy="_groupBy">
                <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
                <BxDataListColumn Field="customer" />
                <BxDataListColumn Field="status" />
                <BxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
            </BxDataListTable>
            <BxDataListGrid Columns="3" GroupBy="_groupBy" />
        </BxDataList>
    </div>

    <div class="w-full" data-testid="list-tree">
        <BxDataList @ref="_treeList" TItem="DepartmentNode" Label="Departments tree" Schema="_treeSchema" Items="_treeItems" PagingMode="DataListPagingMode.None" UrlSync="false" Selectable="true">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <BxDataListResultCount />
                <div class="flex flex-wrap items-center gap-2">
                    <BxButton Label="Expand all" Size="BxSize.Sm" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" data-slot="tree-expand-all" OnClick="@(() => _treeList?.ExpandAll())" />
                    <BxButton Label="Collapse all" Size="BxSize.Sm" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" data-slot="tree-collapse-all" OnClick="@(() => _treeList?.CollapseAll())" />
                </div>
            </div>
            <BxDataListSelectionActions Actions="_treeActions" />
            <BxDataListTable Caption="Departments tree" Tree="_tree">
                <BxDataListColumn Field="name" Title="Department" />
                <BxDataListColumn Field="head" Title="Lead" />
                <BxDataListColumn Field="headcount" Title="Headcount" Align="DataListAlign.End" />
            </BxDataListTable>
        </BxDataList>
    </div>
</div>

@code {
    private BxDataList<DepartmentNode>? _treeList;
    private static readonly Invoice[] _items = InvoiceData.All[..25];
    private List<Invoice> _removable = [.. InvoiceData.All[..6]];
    private static readonly Invoice[] _groupedItems =
    [
        .. InvoiceData.All[..6],
        InvoiceData.All[6] with { Status = "" },
    ];

    private static readonly DataListGroupBy<Invoice> _groupBy = new()
    {
        Field = "status",
        Order = ["Paid", "Pending", "Overdue"],
    };

    private sealed record DepartmentNode(string Id, string Name, string Head, int Headcount, IReadOnlyList<DepartmentNode>? Subteams = null);

    private static readonly DataListSchema<DepartmentNode> _treeSchema = DataListSchema.For<DepartmentNode>(s => s
        .RowKey(d => d.Id)
        .RowLabel(d => d.Name)
        .Field(d => d.Name, f => f.Sortable())
        .Field(d => d.Head, f => f.Sortable())
        .Field(d => d.Headcount, f => f.Sortable()));

    private static readonly DepartmentNode[] _treeItems =
    [
        new("eng", "Engineering", "Ada Lovelace", 42,
        [
            new("eng-platform", "Platform", "Grace Hopper", 18,
            [
                new("eng-runtime", "Runtime", "Alan Turing", 8),
                new("eng-infra", "Infrastructure", "Margaret Hamilton", 10),
            ]),
            new("eng-ui", "Design Systems", "Håkon Wium Lie", 24),
        ]),
        new("ops", "Operations", "Katherine Johnson", 15,
        [
            new("ops-sec", "Security", "Whitfield Diffie", 7),
        ]),
        new("legal", "Legal", "Ruth Bader", 5),
    ];

    private static readonly DataListTree<DepartmentNode> _tree = new()
    {
        Children = d => d.Subteams,
        DefaultExpandedDepth = 1,
    };

    private static readonly DataListAction<DepartmentNode>[] _treeActions =
    [
        new() { Key = "export-teams", Label = "Export teams", Icon = "download", OnExecute = _ => Task.CompletedTask },
    ];

    private static readonly DataListSchema<Invoice> _gridOnlySchema = DataListSchema.For<Invoice>(s => s
        .RowKey(i => i.Id)
        .RowLabel(i => $"Invoice #{i.Id}")
        .Field(i => i.Id, f => f.Sortable())
        .Field(i => i.Customer, f => f.Sortable())
        .Field(i => i.Amount, f => f.Sortable())
        .DefaultSort(i => i.Id)
        .DefaultPageSize(6)
        .DefaultLayout(DataListLayout.Grid));

    private static readonly DataListSortOption[] _sortOptions =
    [
        new("id", "Invoice number"),
        new("customer", "Customer name"),
        new("amount", "Total amount"),
    ];

    private static readonly DataListAction<Invoice>[] _bulkActions =
    [
        new() { Key = "export", Label = "Export", Icon = "download", OnExecute = _ => Task.CompletedTask },
    ];

    private static readonly DataListRowAction<Invoice>[] _rowActions =
    [
        new() { Key = "open", Label = "Open", Icon = "download", Href = c => $"#invoice-{c.Item.Id}" },
    ];

    private static readonly DataListRowSummary<Invoice> _summary = new()
    {
        Title = i => i.Customer,
        Leading = i => @<span>#@i.Id</span>,
        Status = i => @<span class="rounded-full border border-(--blux-border-accented) px-2 py-0.5 text-xs">@i.Status</span>,
        Details = i => [i.Amount.ToString("C2"), i.Issued.ToString("yyyy-MM-dd")],
        Href = i => $"#invoice-{i.Id}",
    };

    private DataListRowAction<Invoice>[] _removeActions =>
    [
        new()
        {
            Key = "remove",
            Label = "Remove",
            Icon = "trash",
            Color = BxColor.Error,
            OnExecute = ctx =>
            {
                _removable = [.. _removable.Where(i => i.Id != ctx.Item.Id)];
                StateHasChanged();
                return Task.CompletedTask;
            },
        },
    ];
}
