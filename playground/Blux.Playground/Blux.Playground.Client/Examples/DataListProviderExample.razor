@using Blux.UI.Tools.Query

@* A provider loads the rows: here after a delay, as a database or an API would. While the first rows load the table shows placeholders; later requests keep the previous rows on screen. *@
<div class="w-full" data-testid="list-provider">
    <BxDataList TItem="Invoice" Label="Invoices from a provider" Schema="InvoiceData.Schema" Provider="LoadAsync" UrlKey="prov" ResultJson="DemoJson.Default.DataListResultInvoice" Density="DataListDensity.Compact">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <BxDataListResultCount />
            <BxDataListRefresh />
        </div>
        <BxDataListErrorState />
        <BxDataListTable Caption="Invoices from a provider">
            <BxDataListColumn Field="id" Title="No." Align="DataListAlign.End" />
            <BxDataListColumn Field="customer" />
            <BxDataListColumn Field="status">
                <Template Context="invoice">
                    <BxBadge Label="@invoice.Status" Variant="BxVariant.Soft" Color="@StatusColor(invoice.Status)" />
                </Template>
            </BxDataListColumn>
            <BxDataListColumn Field="amount" Align="DataListAlign.End" Format="C2" />
        </BxDataListTable>
        <BxDataListPagination />
    </BxDataList>
</div>

@code {
    private async ValueTask<DataListResult<Invoice>> LoadAsync(DataListRequest request, CancellationToken cancellationToken)
    {
        // The token is cancelled when a newer request replaces this one.
        await Task.Delay(600, cancellationToken);
        return InvoiceData.Schema.ExecuteInMemory(InvoiceData.All, request);
    }

    private static BxColor StatusColor(string status) => status switch
    {
        "Paid" => BxColor.Success,
        "Pending" => BxColor.Warning,
        "Overdue" => BxColor.Error,
        _ => BxColor.Neutral,
    };
}
