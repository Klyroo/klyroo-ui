@* The list follows new messages while you are at the bottom. Scroll up and it stops; "Jump to latest" brings you back.
   The buttons need interactivity, since they change the list from .NET. *@
<div class="flex w-full max-w-xl flex-col gap-3">
    <div class="flex h-72 flex-col overflow-hidden rounded-xl border border-(--blux-border)">
        <BxChatMessages Status="_status" data-testid="chat-messages-demo">
            @foreach (var message in _messages)
            {
                <BxChatMessage @key="message.Id" Role="message.Role" Text="@message.Text" />
            }
        </BxChatMessages>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <BxButton Label="Add a message" Size="BxSize.Sm" OnClick="AddUser" data-testid="chat-messages-add" />
        <BxButton Label="Add a reply" Size="BxSize.Sm" Variant="ButtonVariant.Outline" OnClick="AddAssistant" data-testid="chat-messages-reply" />
        @foreach (var status in Enum.GetValues<ChatStatus>())
        {
            var s = status;
            <BxButton Label="@s.ToString()" Size="BxSize.Sm" Variant="ButtonVariant.Soft" Color="BxColor.Neutral" OnClick="() => _status = s"
                      data-testid="@($"chat-messages-status-{s.ToString().ToLowerInvariant()}")" />
        }
    </div>
</div>

@code {
    private sealed record Item(int Id, ChatRole Role, string Text);

    private readonly List<Item> _messages = [.. Enumerable.Range(1, 12).Select(i => new Item(i, i % 2 == 1 ? ChatRole.User : ChatRole.Assistant, i % 2 == 1 ? $"Question {i / 2 + 1}: how does the list behave?" : $"Answer {i / 2}: it keeps the latest message in view while you are at the bottom."))];
    private ChatStatus _status;
    private int _next = 13;

    private void AddUser() => _messages.Add(new Item(_next++, ChatRole.User, $"New question {_next}"));

    private void AddAssistant() => _messages.Add(new Item(_next++, ChatRole.Assistant, $"New answer {_next}"));
}
