<div class="grid w-full gap-4 md:grid-cols-3">
    @foreach (var variant in Enum.GetValues<CardVariant>())
    {
        <BxCard Variant="variant">
            <Header><h3 class="font-semibold">@variant card</h3></Header>
            <ChildContent><p class="text-sm text-(--blux-text-muted)">Header, body and footer are each optional.</p></ChildContent>
            <Footer><BxButton Label="Action" Size="BxSize.Sm" Variant="ButtonVariant.Outline" /></Footer>
        </BxCard>
    }
</div>
