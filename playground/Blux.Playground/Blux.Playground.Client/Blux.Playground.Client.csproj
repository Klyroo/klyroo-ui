<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Dates and numbers in every language of the locale picker (Arabic, Japanese, Russian...), not only the default subset. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!-- Example sources, shown next to their live preview. -->
  <ItemGroup>
    <EmbeddedResource Include="Examples\**\*.razor" LogicalName="example:%(Filename)" />
  </ItemGroup>

  <!-- Parameter descriptions for the API tables, from the library's XML documentation (built before this project). -->
  <Target Name="EmbedBluxDocumentation" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../src/Blux.UI/bin/$(Configuration)/net10.0/Blux.UI.xml" LogicalName="Blux.UI.xml" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../src/Blux.UI.Tools/bin/$(Configuration)/net10.0/Blux.UI.Tools.xml" LogicalName="Blux.UI.Tools.xml" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <ProjectReference Include="..\..\..\src\Blux.UI\Blux.UI.csproj" />
    <!-- Data-heavy components (the data list and its parts), documented in the same catalog. -->
    <ProjectReference Include="..\..\..\src\Blux.UI.Tools\Blux.UI.Tools.csproj" />
    <!-- Only the URL builder of the local image optimizer: the endpoint itself runs on the server. -->
    <ProjectReference Include="..\..\..\src\Blux.UI.Images\Blux.UI.Images.csproj" />
  </ItemGroup>

  <!--
    Dogfooding of the bundled icons. An app gets all of this from the Blux.UI package (buildTransitive); here Blux.UI is a project
    reference, so the task assembly is built first and the targets are imported by hand. The examples of this project name their
    icons (ph:house, i-mdi-home, simple-icons:github, book-open...): the build finds them in the .razor files and bundles them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Blux.UI.Build.Tasks\Blux.UI.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <BluxBuildTasksAssembly>$(MSBuildThisFileDirectory)..\..\..\src\Blux.UI.Build.Tasks\bin\$(Configuration)\netstandard2.0\Blux.UI.Build.Tasks.dll</BluxBuildTasksAssembly>
  </PropertyGroup>
  <Import Project="..\..\..\src\Blux.UI\buildTransitive\Blux.UI.Tasks.targets" />
  <Import Project="..\..\..\src\Blux.UI\buildTransitive\Blux.UI.Icons.targets" />

  <!-- A folder of SVG files, used as custom:blux (see the Icons guide). The files are not served: they are compiled into the assembly. -->
  <ItemGroup>
    <BluxIconCollection Include="Assets\icons" Prefix="custom" />
    <!-- Names the scan cannot see: the Icons guide builds one at runtime. -->
    <BluxIcon Include="ph:cube;ph:cube-fill;ph:cube-bold" />
  </ItemGroup>

</Project>
