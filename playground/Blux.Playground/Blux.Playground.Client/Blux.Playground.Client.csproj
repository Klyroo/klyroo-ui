<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Dates and numbers in every language of the locale picker (Arabic, Japanese, Russian...), not only the default subset. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!-- Example sources, shown next to their live preview. -->
  <ItemGroup>
    <EmbeddedResource Include="Examples\**\*.razor" LogicalName="example:%(Filename)" />
  </ItemGroup>

  <!-- Parameter descriptions for the API tables, from the library's XML documentation (built before this project). -->
  <Target Name="EmbedBluxDocumentation" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../src/Blux.UI/bin/$(Configuration)/net10.0/Blux.UI.xml" LogicalName="Blux.UI.xml" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <ProjectReference Include="..\..\..\src\Blux.UI\Blux.UI.csproj" />
  </ItemGroup>

</Project>
