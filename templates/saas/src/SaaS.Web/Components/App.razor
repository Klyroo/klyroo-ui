<!DOCTYPE html>
<html lang="@_locale.Code" dir="@_locale.DirAttribute">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The site can be served below a path base (see Program.cs): every relative URL, the stylesheet and the framework included, follows this. *@
    <base href="@_baseHref" />
    <LxColorModeScript />
    <LxCultureMeta />
    <LxThemeStyle />
    @* Self-hosted at build time from the LuxFont items of SaaS.Web.csproj: no third-party request. *@
    <LxFonts />
    <ResourcePreloader />
    @* Compiled by the build from Styles/app.css (Tailwind, with the Lux theme). *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @* No render mode: every page is rendered once by the server and sent as HTML. The menu, the search, the table of contents, the navigation groups,
       the color mode, the language select, the accordion and the billing switch run in the browser (Lux's own script, or plain CSS), and the copy
       buttons of the code blocks run on the small script below. The login and sign-up forms are posted to the server, which renders the answer. So
       there is no circuit and no WebAssembly to download. *@
    <Routes />
    @* Copies the code of a block when its button is pressed (Content/CodeCopy.cs). A site with a Content-Security-Policy serves it as a file instead. *@
    <script>@((MarkupString)CodeCopy.Script)</script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    // The PathBase setting as configured, normalized to "/x/": the root when there is none.
    private string _baseHref => Configuration["PathBase"] is { Length: > 0 } pathBase ? "/" + pathBase.Trim('/') + "/" : "/";

    private LxLocale _locale = LxLocales.En;

    // lang and dir of the page follow the culture of the request, like the components do.
    protected override void OnParametersSet() =>
        _locale = LxLocales.Resolve(System.Globalization.CultureInfo.CurrentUICulture);
}
