@inject MarkdownStore Store

@* The three most recent posts of the blog, from the same files as the blog page. *@
<KlyPageSection id="blog"
               Headline="@SiteInfo.PostsHeadline"
               Title="@SiteInfo.PostsTitle"
               Orientation="KlyOrientation.Vertical"
               Links="_links">
    <KlyBlogPosts Class="mt-10">
        @foreach (var post in _posts)
        {
            <KlyBlogPost Title="@post.Title" Description="@post.Description" Date="@post.Date" Image="@post.Image" ImageAlt="@post.ImageAlt"
                        Href="@post.Href" Authors="post.Authors" data-testid="latest-post" />
        }
    </KlyBlogPosts>
</KlyPageSection>

@code {
    private static readonly PageLinkItem[] _links = [new("All posts", SiteInfo.BlogHref) { Color = KlyColor.Neutral, Variant = ButtonVariant.Outline, TrailingIcon = "ph:arrow-right" }];

    private IReadOnlyList<Post> _posts = [];

    protected override void OnInitialized() => _posts = [.. Store.Site.Posts().Take(3)];
}
