@page "/blog/{Slug}"
@inject MarkdownStore Store
@inject NavigationManager Navigation

@if (_post is not null)
{
    <PageTitle>@_post.Title - @SiteInfo.Name</PageTitle>
    <HeadContent>
        <meta name="description" content="@(_post.Description ?? SiteInfo.Description)" />
    </HeadContent>

    <KlyContainer Class="py-10 sm:py-14">
        <div class="mx-auto max-w-3xl">
            <KlyBreadcrumb Items="_crumbs" />

            <article data-testid="article" class="mt-8">
                <header class="flex flex-col gap-4">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-(--klyroo-text-muted)">
                        <time datetime="@KlyDates.Iso(_post.Date)">@KlyDates.Format(_post.Date)</time>
                        <span aria-hidden="true">&middot;</span>
                        <span>@_post.ReadingMinutes min read</span>
                        @foreach (var tag in _post.Tags)
                        {
                            <KlyBadge Label="@tag" Color="KlyColor.Neutral" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
                        }
                    </div>
                    <h1 class="text-3xl font-semibold tracking-tight text-balance text-(--klyroo-text-highlighted) sm:text-4xl">@_post.Title</h1>
                    @if (_post.Description is not null)
                    {
                        <p class="text-lg text-pretty text-(--klyroo-text-muted)">@_post.Description</p>
                    }
                    @if (_post.Author is not null)
                    {
                        <KlyUser Name="@_post.Author" Description="@_post.AuthorRole" Class="mt-2" />
                    }
                </header>

                @if (_post.Image is not null)
                {
                    <KlyImage Src="@_post.Image" Alt="@(_post.ImageAlt ?? "")" Class="mt-8 aspect-video w-full rounded-[calc(var(--klyroo-radius)*2)] object-cover ring ring-(--klyroo-border)" />
                }

                @* The prose styles of the Klyroo PageBody, plus the ones in Styles/app.css for what Markdown adds (code blocks, callouts, tables). *@
                <KlyPageBody Class="markdown-body mt-10 pb-10">@((MarkupString)_post.Page.Html)</KlyPageBody>
            </article>

            @if (_more.Count > 0)
            {
                <section aria-labelledby="more-posts" class="mt-6 border-t border-(--klyroo-border) pt-10">
                    <h2 id="more-posts" class="text-xl font-semibold text-(--klyroo-text-highlighted)">Keep reading</h2>
                    <KlyBlogPosts Class="mt-6 md:grid-cols-2 lg:grid-cols-2">
                        @foreach (var post in _more)
                        {
                            <KlyBlogPost Title="@post.Title" Description="@post.Description" Date="@post.Date" Image="@post.Image" ImageAlt="@post.ImageAlt"
                                        Href="@post.Href" Authors="post.Authors" HeadingLevel="3" data-testid="more-post" />
                        }
                    </KlyBlogPosts>
                </section>
            }
        </div>
    </KlyContainer>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private Post? _post;
    private IReadOnlyList<Post> _more = [];
    private IReadOnlyList<KlyBreadcrumbItem> _crumbs = [];

    protected override void OnParametersSet()
    {
        var posts = Store.Site.Posts();
        _post = posts.FirstOrDefault(p => string.Equals(p.Name, Slug, StringComparison.OrdinalIgnoreCase));
        if (_post is null)
        {
            // Answers 404 with the page of Pages/NotFound.razor.
            Navigation.NotFound();
            return;
        }
        // The two posts after this one in time, wrapping to the newest: always the other posts when there are only a few.
        var index = posts.ToList().IndexOf(_post);
        _more = [.. Enumerable.Range(1, Math.Min(2, posts.Count - 1)).Select(offset => posts[(index + offset) % posts.Count])];
        _crumbs = [new("Blog") { Href = SiteInfo.BlogHref }, new(_post.Title)];
    }
}
