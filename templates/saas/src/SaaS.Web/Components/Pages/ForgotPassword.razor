@page "/forgot-password"

<PageTitle>Reset your password - @SiteInfo.Name</PageTitle>

@* UI only, like the sign-in and sign-up pages: the form checks the email and calls ResetAsync, which sends nothing. To make it real, look the account
   up in ResetAsync and send the link by email. Answer the same thing whether the address has an account or not, so that the page cannot be used to
   find out who is registered. *@
<LxContainer Class="flex justify-center py-12 sm:py-20">
    <div class="flex w-full max-w-sm flex-col gap-6">
        <LxAuthForm FormName="forgot-password" Title="Reset your password" Description="Enter your email and we will send you a link to choose a new one." HeadingLevel="1"
                    Fields="_fields" SubmitLabel="Send the link" OnValidSubmit="ResetAsync">
            <Icon>
                <LxIcon Name="ph:lock-key" Class="size-8" />
            </Icon>
            <Footer>
                Remembered it? <a href="@SiteInfo.LoginHref" class="font-medium text-(--lux-primary-text) underline underline-offset-4">Back to sign in</a>
            </Footer>
        </LxAuthForm>

        @if (_email is not null)
        {
            <LxAlert Color="LxColor.Info" Variant="LxVariant.Soft" Title="The form is valid" role="status" data-testid="auth-result"
                     Description="@($"A link would be sent to {_email} now. This template has no authentication: nothing was sent and nothing was stored.")" />
        }
    </div>
</LxContainer>

@code {
    private string? _email;

    private static readonly LxAuthField[] _fields =
    [
        new("email", "email") { Label = "Email", Placeholder = "you@company.com", Required = true, Autocomplete = "email" },
    ];

    private Task ResetAsync(IReadOnlyDictionary<string, string?> values)
    {
        _email = values["email"]?.Trim();
        return Task.CompletedTask;
    }
}
