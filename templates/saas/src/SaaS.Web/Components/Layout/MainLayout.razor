@inherits LayoutComponentBase

<BxApp>
    <BxSkipLink />

    @* Links are relative: they resolve against <base href>, so the site works at the root of a domain and below a path. *@
    <BxHeader Items="SiteInfo.Navigation" AriaLabel="@SiteInfo.HeaderLabel" MenuTitle="@SiteInfo.HeaderMenuTitle">
        <Left>
            <a href="@SiteInfo.HomeHref" class="flex items-center gap-2 rounded-sm font-semibold text-(--blux-text-highlighted)">
                <BxIcon Name="ph:wave-sine" Class="size-6" />
                <span>@SiteInfo.Name</span>
            </a>
        </Left>
        <Right>
            @* Two buttons for one search, so that only one shows: the label and the shortcut where there is room, the icon alone on a phone. *@
            <BxContentSearchButton Collapsed="false" Size="BxSize.Sm" Class="hidden xl:inline-flex xl:w-48" />
            <BxContentSearchButton Size="BxSize.Sm" Class="xl:hidden" />
            <BxLocaleSelect Size="BxSize.Sm" Class="hidden sm:inline-flex" />
            <BxColorModeButton Size="BxSize.Sm" />
            <BxButton Label="Sign in" Href="@SiteInfo.LoginHref" Size="BxSize.Sm" Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" Class="ms-1 hidden sm:inline-flex" />
            <BxButton Label="Get started" Href="@SiteInfo.SignUpHref" Size="BxSize.Sm" Class="hidden sm:inline-flex" />
        </Right>
        <Body>
            @* The mobile menu: the links, then the two buttons that the header only shows from the sm breakpoint up. *@
            <BxNavigationMenu Items="SiteInfo.Navigation" Orientation="BxOrientation.Vertical" AriaLabel="@SiteInfo.HeaderMenuTitle" />
            <div class="mt-6 flex flex-col gap-3">
                <BxButton Label="Sign in" Href="@SiteInfo.LoginHref" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" Block />
                <BxButton Label="Get started" Href="@SiteInfo.SignUpHref" Block />
                <BxLocaleSelect />
            </div>
        </Body>
    </BxHeader>

    @* The search of the whole site: the documentation, the blog and the changelog. Ctrl+K (Cmd+K on a Mac) or one of the buttons above. The list is
       not in the page: the browser fetches search-index.json (Program.cs) the first time the search opens. *@
    <BxContentSearch IndexUrl="search-index.json" />

    <BxMain id="main" tabindex="-1" class="focus:outline-none">
        @Body
    </BxMain>

    <BxFooter>
        <Top>
            @* Level 2: a page can end in its only h1 (the sign-in page), and a level 3 heading would skip one. *@
            <BxFooterColumns Columns="SiteInfo.FooterColumns" AriaLabel="@SiteInfo.FooterLabel" HeadingLevel="2">
                <Left>
                    <a href="@SiteInfo.HomeHref" class="flex items-center gap-2 rounded-sm font-semibold text-(--blux-text-highlighted)">
                        <BxIcon Name="ph:wave-sine" Class="size-6" />
                        <span>@SiteInfo.Name</span>
                    </a>
                    <p class="mt-3 max-w-xs text-sm text-(--blux-text-muted)">@SiteInfo.Tagline</p>
                </Left>
            </BxFooterColumns>
        </Top>
        <Left>
            <p class="text-sm text-(--blux-text-muted)">@SiteInfo.Copyright</p>
        </Left>
    </BxFooter>
</BxApp>
