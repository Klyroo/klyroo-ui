<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tailwind compiled by the build (no Node): Styles/app.css becomes _content/Chat.Shared/app.css, for the web host and the MAUI app. -->
    <BluxTailwind>true</BluxTailwind>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Icons the build cannot see because the page picks the name at run time (a variable, a condition). The ones written as literals are found by the build. -->
  <ItemGroup>
    <BluxIcon Include="lucide:copy;lucide:check;lucide:refresh-cw;lucide:sparkles;lucide:code-xml;lucide:mail;lucide:database;lucide:cpu" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blux.UI" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

</Project>
