@implements IDisposable
@inject ConversationState Conversations
@inject IToastService Toasts

@* The rename and delete dialogs, one of each for the whole list. The rows of the list ask for them through ConversationState. They are outside the sidebar
   on purpose: on a phone the sidebar is a panel that closes before a dialog outside it opens. *@
<BxModal @bind-Open="_renameOpen" Title="Rename conversation" Description="The title is shown in the list and at the top of the conversation." data-testid="rename-dialog">
    <Body>
        <form id="rename-form" @onsubmit="RenameAsync" class="flex flex-col gap-2">
            <BxFormField Label="Title">
                <BxInput @bind-Value="_title" Immediate Placeholder="Title" data-testid="rename-input" />
            </BxFormField>
        </form>
    </Body>
    <Footer>
        <BxButton Label="Cancel" Color="BxColor.Neutral" Variant="ButtonVariant.Ghost" data-bx-close />
        <BxButton Label="Save" Type="submit" form="rename-form" Disabled="@(ConversationState.CleanTitle(_title).Length == 0)" data-testid="rename-save" />
    </Footer>
</BxModal>

<BxModal @bind-Open="_deleteOpen" Title="Delete conversation?" Description="@(_target is null ? null : $"\"{_target.Title}\" is removed from this browser. This cannot be undone.")" data-testid="delete-dialog">
    <Footer>
        <BxButton Label="Cancel" Color="BxColor.Neutral" Variant="ButtonVariant.Ghost" data-bx-close />
        <BxButton Label="Delete" Color="BxColor.Error" OnClick="DeleteAsync" data-testid="delete-confirm" />
    </Footer>
</BxModal>

@code {
    private bool _renameOpen;
    private bool _deleteOpen;
    private string? _title;
    private Conversation? _target;

    protected override void OnInitialized()
    {
        Conversations.RenameRequested += OnRename;
        Conversations.DeleteRequested += OnDelete;
    }

    private void OnRename(Conversation conversation) => _ = InvokeAsync(() =>
    {
        _target = conversation;
        _title = conversation.Title;
        _renameOpen = true;
        StateHasChanged();
    });

    private void OnDelete(Conversation conversation) => _ = InvokeAsync(() =>
    {
        _target = conversation;
        _deleteOpen = true;
        StateHasChanged();
    });

    private async Task RenameAsync()
    {
        if (_target is null || ConversationState.CleanTitle(_title).Length == 0) return;
        var saved = await Conversations.RenameAsync(_target, _title);
        _renameOpen = false;
        if (!saved) await Toasts.Add(new BxToast { Title = "Not saved", Description = "This browser did not keep the change: it applies to this visit only.", Color = BxColor.Warning });
    }

    private async Task DeleteAsync()
    {
        if (_target is null) return;
        await Conversations.DeleteAsync(_target);
        _deleteOpen = false;
        _target = null;
    }

    public void Dispose()
    {
        Conversations.RenameRequested -= OnRename;
        Conversations.DeleteRequested -= OnDelete;
    }
}
