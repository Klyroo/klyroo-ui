@page "/error"

<PageTitle>Error</PageTitle>

<LxDashboardPanel>
    <ChildContent>
        <LxDashboardNavbar Title="Something went wrong">
            <Leading>
                <LxDashboardSidebarCollapse />
            </Leading>
            <Right>
                <LxColorModeButton />
            </Right>
        </LxDashboardNavbar>
        <div class="flex flex-col items-start gap-4 p-6">
            <p class="text-(--lux-text-muted)">The request could not be completed. Try again, and if the problem stays, check the logs of the server.</p>
            <LxButton Label="Back home" Href="./" />
        </div>
    </ChildContent>
</LxDashboardPanel>
