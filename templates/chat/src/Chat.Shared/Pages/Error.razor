@page "/error"

<PageTitle>Error</PageTitle>

<KlyDashboardPanel>
    <ChildContent>
        <KlyDashboardNavbar Title="Something went wrong">
            <Leading>
                <KlyDashboardSidebarCollapse />
            </Leading>
            <Right>
                <KlyColorModeButton />
            </Right>
        </KlyDashboardNavbar>
        <div class="flex flex-col items-start gap-4 p-6">
            <p class="text-(--klyroo-text-muted)">The request could not be completed. Try again, and if the problem stays, check the logs of the server.</p>
            <KlyButton Label="Back home" Href="./" />
        </div>
    </ChildContent>
</KlyDashboardPanel>
