@inherits LayoutComponentBase

<KlyApp>
    <KlySkipLink />

    @* Links are relative: they resolve against <base href>, so the site works at the root of a domain and below a path. *@
    <KlyHeader Items="SiteInfo.Navigation" AriaLabel="@SiteInfo.HeaderLabel" MenuTitle="@SiteInfo.HeaderMenuTitle">
        <Left>
            <a href="@SiteInfo.HomeHref" class="flex items-center gap-3 rounded-sm font-semibold text-(--klyroo-text-highlighted)">
                @* The name next to it says the same, so the initials are hidden from assistive technology. *@
                <KlyAvatar Alt="@SiteInfo.Name" Size="KlySize.Sm" aria-hidden="true" />
                <span>@SiteInfo.Name</span>
            </a>
        </Left>
        <Right>
            @* Two buttons for one search, so that only one shows: the label and the shortcut where there is room, the icon alone on a phone. *@
            <KlyContentSearchButton Collapsed="false" Size="KlySize.Sm" Class="hidden xl:inline-flex xl:w-48" />
            <KlyContentSearchButton Size="KlySize.Sm" Class="xl:hidden" />
            <KlyLocaleSelect Size="KlySize.Sm" Class="hidden sm:inline-flex" />
            <KlyColorModeButton Size="KlySize.Sm" />
            <KlyButton Label="Get in touch" Href="@SiteInfo.ContactHref" Size="KlySize.Sm" Class="ms-1 hidden sm:inline-flex" />
        </Right>
        <Body>
            @* The mobile menu: the links, then the button and the language select that the header only shows from the sm breakpoint up. *@
            <KlyNavigationMenu Items="SiteInfo.Navigation" Orientation="KlyOrientation.Vertical" AriaLabel="@SiteInfo.HeaderMenuTitle" />
            <div class="mt-6 flex flex-col gap-3">
                <KlyButton Label="Get in touch" Href="@SiteInfo.ContactHref" Block />
                <KlyLocaleSelect />
            </div>
        </Body>
    </KlyHeader>

    @* The search of the whole site: the projects, the articles and the text pages. Ctrl+K (Cmd+K on a Mac) or one of the buttons above. The list is
       not in the page: the browser fetches search-index.json (Program.cs) the first time the search opens. *@
    <KlyContentSearch IndexUrl="search-index.json" />

    <KlyMain id="main" tabindex="-1" class="focus:outline-none">
        @Body
    </KlyMain>

    <KlyFooter>
        <Top>
            @* Level 2: a page can end in its only h1, and a level 3 heading would skip one. *@
            <KlyFooterColumns Columns="SiteInfo.FooterColumns" AriaLabel="@SiteInfo.FooterLabel" HeadingLevel="2">
                <Left>
                    <a href="@SiteInfo.HomeHref" class="flex items-center gap-3 rounded-sm font-semibold text-(--klyroo-text-highlighted)">
                        <KlyAvatar Alt="@SiteInfo.Name" Size="KlySize.Sm" aria-hidden="true" />
                        <span>@SiteInfo.Name</span>
                    </a>
                    <p class="mt-3 max-w-xs text-sm text-(--klyroo-text-muted)">@SiteInfo.Role in @SiteInfo.Location.</p>
                </Left>
            </KlyFooterColumns>
        </Top>
        <Left>
            <p class="text-sm text-(--klyroo-text-muted)">@SiteInfo.Copyright</p>
        </Left>
        <Right>
            <ul class="m-0 flex list-none gap-1 p-0" aria-label="Social links">
                @foreach (var link in SiteInfo.Social)
                {
                    <li>
                        <KlyButton Href="@link.Href" Square Size="KlySize.Sm" Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" aria-label="@link.Label">
                            <LeadingIcon><KlyIcon Name="@link.Icon" Class="size-5" /></LeadingIcon>
                        </KlyButton>
                    </li>
                }
            </ul>
        </Right>
    </KlyFooter>
</KlyApp>
