@inherits LayoutComponentBase

<LxApp>
    <LxSkipLink />

    @* Links are relative: they resolve against <base href>, so the site works at the root of a domain and below a path. *@
    <LxHeader Items="SiteInfo.Navigation" AriaLabel="@SiteInfo.HeaderLabel" MenuTitle="@SiteInfo.HeaderMenuTitle">
        <Left>
            <a href="@SiteInfo.HomeHref" class="flex items-center gap-3 rounded-sm font-semibold text-(--lux-text-highlighted)">
                @* The name next to it says the same, so the initials are hidden from assistive technology. *@
                <LxAvatar Alt="@SiteInfo.Name" Size="LxSize.Sm" aria-hidden="true" />
                <span>@SiteInfo.Name</span>
            </a>
        </Left>
        <Right>
            @* Two buttons for one search, so that only one shows: the label and the shortcut where there is room, the icon alone on a phone. *@
            <LxContentSearchButton Collapsed="false" Size="LxSize.Sm" Class="hidden xl:inline-flex xl:w-48" />
            <LxContentSearchButton Size="LxSize.Sm" Class="xl:hidden" />
            <LxLocaleSelect Size="LxSize.Sm" Class="hidden sm:inline-flex" />
            <LxColorModeButton Size="LxSize.Sm" />
            <LxButton Label="Get in touch" Href="@SiteInfo.ContactHref" Size="LxSize.Sm" Class="ms-1 hidden sm:inline-flex" />
        </Right>
        <Body>
            @* The mobile menu: the links, then the button and the language select that the header only shows from the sm breakpoint up. *@
            <LxNavigationMenu Items="SiteInfo.Navigation" Orientation="LxOrientation.Vertical" AriaLabel="@SiteInfo.HeaderMenuTitle" />
            <div class="mt-6 flex flex-col gap-3">
                <LxButton Label="Get in touch" Href="@SiteInfo.ContactHref" Block />
                <LxLocaleSelect />
            </div>
        </Body>
    </LxHeader>

    @* The search of the whole site: the projects, the articles and the text pages. Ctrl+K (Cmd+K on a Mac) or one of the buttons above. The list is
       not in the page: the browser fetches search-index.json (Program.cs) the first time the search opens. *@
    <LxContentSearch IndexUrl="search-index.json" />

    <LxMain id="main" tabindex="-1" class="focus:outline-none">
        @Body
    </LxMain>

    <LxFooter>
        <Top>
            @* Level 2: a page can end in its only h1, and a level 3 heading would skip one. *@
            <LxFooterColumns Columns="SiteInfo.FooterColumns" AriaLabel="@SiteInfo.FooterLabel" HeadingLevel="2">
                <Left>
                    <a href="@SiteInfo.HomeHref" class="flex items-center gap-3 rounded-sm font-semibold text-(--lux-text-highlighted)">
                        <LxAvatar Alt="@SiteInfo.Name" Size="LxSize.Sm" aria-hidden="true" />
                        <span>@SiteInfo.Name</span>
                    </a>
                    <p class="mt-3 max-w-xs text-sm text-(--lux-text-muted)">@SiteInfo.Role in @SiteInfo.Location.</p>
                </Left>
            </LxFooterColumns>
        </Top>
        <Left>
            <p class="text-sm text-(--lux-text-muted)">@SiteInfo.Copyright</p>
        </Left>
        <Right>
            <ul class="m-0 flex list-none gap-1 p-0" aria-label="Social links">
                @foreach (var link in SiteInfo.Social)
                {
                    <li>
                        <LxButton Href="@link.Href" Square Size="LxSize.Sm" Variant="ButtonVariant.Ghost" Color="LxColor.Neutral" aria-label="@link.Label">
                            <LeadingIcon><LxIcon Name="@link.Icon" Class="size-5" /></LeadingIcon>
                        </LxButton>
                    </li>
                }
            </ul>
        </Right>
    </LxFooter>
</LxApp>
