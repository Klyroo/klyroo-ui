<!DOCTYPE html>
<html lang="@_locale.Code" dir="@_locale.DirAttribute">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The site can be served below a path base (see Program.cs): every relative URL, the stylesheet and the framework included, follows this. *@
    <base href="@_baseHref" />
    <BxColorModeScript />
    <BxCultureMeta />
    <BxThemeStyle />
    @* Self-hosted at build time from the LuxFont items of Portfolio.Web.csproj: no third-party request. *@
    <BxFonts />
    <ResourcePreloader />
    @* Compiled by the build from Styles/app.css (Tailwind, with the Blux theme). *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @* No render mode: every page is rendered once by the server and sent as HTML. The menu, the search, the color mode and the language select run in
       the browser (Blux's own script), and the copy buttons of the code blocks run on the small script below. The contact form is posted to the server,
       which renders the answer. So there is no circuit and no WebAssembly to download. *@
    <Routes />
    @* Copies the code of a block when its button is pressed (Content/CodeCopy.cs). A site with a Content-Security-Policy serves it as a file instead. *@
    <script>@((MarkupString)CodeCopy.Script)</script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    // The PathBase setting as configured, normalized to "/x/": the root when there is none.
    private string _baseHref => Configuration["PathBase"] is { Length: > 0 } pathBase ? "/" + pathBase.Trim('/') + "/" : "/";

    private BxLocale _locale = BxLocales.En;

    // lang and dir of the page follow the culture of the request, like the components do.
    protected override void OnParametersSet() =>
        _locale = BxLocales.Resolve(System.Globalization.CultureInfo.CurrentUICulture);
}
