@* A project as a card: the cover, the title as the only link, the description, and the year and the stack. Used by the home page and by the work page. *@
<KlyPageCard Title="@Project.Title" Description="@Project.Description" Href="@Project.Href" HeadingLevel="HeadingLevel" Color="KlyColor.Neutral" Class="h-full" data-testid="project">
    <Header>
        @if (Project.Image is not null)
        {
            <KlyImage Src="@Project.Image" Alt="@(Project.ImageAlt ?? "")" Class="aspect-[16/10] w-full object-cover" />
        }
    </Header>
    <Footer>
        <div class="flex flex-wrap items-center gap-2">
            <KlyBadge Label="@Project.Year.ToString()" Color="KlyColor.Neutral" Variant="KlyVariant.Outline" Size="KlySize.Sm" />
            @foreach (var item in Project.Stack.Take(3))
            {
                <KlyBadge Label="@item" Color="KlyColor.Neutral" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
            }
        </div>
    </Footer>
</KlyPageCard>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;

    /// <summary>The level of the title: 2 on the work page, where the h1 is the title of the page, and 3 in a section of the home page.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;
}
