@* LxPageSection renders each item of Features as a LxPageFeature. *@
<LxPageSection id="skills"
               Headline="@SiteInfo.SkillsHeadline"
               Title="@SiteInfo.SkillsTitle"
               Orientation="LxOrientation.Vertical"
               Features="SiteInfo.Skills"
               Links="_links" />

@code {
    private static readonly PageLinkItem[] _links = [new("More about me", SiteInfo.AboutHref) { Color = LxColor.Neutral, Variant = ButtonVariant.Outline, TrailingIcon = "ph:arrow-right" }];
}
