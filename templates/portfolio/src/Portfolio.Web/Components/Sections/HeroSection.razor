@* The introduction. The card on the right is plain markup: who you are, where, and whether you are taking work. Swap the avatar's initials for a
   photo by giving BxUser an AvatarSrc (a file in wwwroot), and keep the Now list short and true: it is the first thing a visitor reads after the title. *@
<BxPageHero Headline="@SiteInfo.HeroHeadline"
            Title="@SiteInfo.HeroTitle"
            Description="@SiteInfo.HeroDescription"
            Links="SiteInfo.HeroLinks"
            Ui="_ui">
    <Media>
        <div data-testid="hero-card" class="mx-auto flex w-full max-w-[26rem] flex-col gap-6 rounded-2xl bg-(--blux-bg) p-6 shadow-xl ring ring-(--blux-border)">
            <BxUser Name="@SiteInfo.Name" Description="@($"{SiteInfo.Role}, {SiteInfo.Location}")" Size="BxSize.Xl" />
            <dl class="m-0 flex flex-col divide-y divide-(--blux-border) text-sm">
                @foreach (var (label, value) in SiteInfo.Now)
                {
                    <div class="flex flex-col gap-0.5 py-3 first:pt-0 last:pb-0 sm:flex-row sm:gap-4">
                        <dt class="shrink-0 font-mono text-xs uppercase tracking-wider text-(--blux-text-muted) sm:w-24 sm:pt-0.5">@label</dt>
                        <dd class="m-0 text-(--blux-text-highlighted)">@value</dd>
                    </div>
                }
            </dl>
            <ul class="m-0 flex list-none gap-1 p-0" aria-label="Find me elsewhere">
                @foreach (var link in SiteInfo.Social)
                {
                    <li>
                        <BxButton Href="@link.Href" Square Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" aria-label="@link.Label">
                            <LeadingIcon><BxIcon Name="@link.Icon" Class="size-5" /></LeadingIcon>
                        </BxButton>
                    </li>
                }
            </ul>
        </div>
    </Media>
</BxPageHero>

@code {
    private static readonly PageHeroUi _ui = new()
    {
        Container = "gap-12 py-16 sm:py-20 lg:py-24",
        Title = "text-4xl sm:text-5xl lg:text-6xl",
    };
}
