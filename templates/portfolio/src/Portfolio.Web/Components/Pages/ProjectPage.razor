@page "/work/{Slug}"
@inject MarkdownStore Store
@inject NavigationManager Navigation

@if (_project is not null)
{
    <PageTitle>@_project.Title - @SiteInfo.Name</PageTitle>
    <HeadContent>
        <meta name="description" content="@(_project.Description ?? SiteInfo.Description)" />
    </HeadContent>

    <KlyContainer Class="py-10 sm:py-14">
        <div class="mx-auto max-w-3xl">
            <KlyBreadcrumb Items="_crumbs" />

            <article data-testid="project-page" class="mt-8">
                <header class="flex flex-col gap-6">
                    <h1 class="text-3xl font-semibold tracking-tight text-balance text-(--klyroo-text-highlighted) sm:text-4xl">@_project.Title</h1>
                    @if (_project.Description is not null)
                    {
                        <p class="text-lg text-pretty text-(--klyroo-text-muted)">@_project.Description</p>
                    }

                    <dl class="m-0 grid grid-cols-1 gap-x-8 gap-y-4 border-y border-(--klyroo-border) py-6 text-sm sm:grid-cols-2" data-testid="project-facts">
                        <div>
                            <dt class="font-mono text-xs uppercase tracking-wider text-(--klyroo-text-muted)">Year</dt>
                            <dd class="m-0 mt-1 text-(--klyroo-text-highlighted)">@_project.Year</dd>
                        </div>
                        @if (_project.Role is not null)
                        {
                            <div>
                                <dt class="font-mono text-xs uppercase tracking-wider text-(--klyroo-text-muted)">Role</dt>
                                <dd class="m-0 mt-1 text-(--klyroo-text-highlighted)">@_project.Role</dd>
                            </div>
                        }
                        @if (_project.Client is not null)
                        {
                            <div>
                                <dt class="font-mono text-xs uppercase tracking-wider text-(--klyroo-text-muted)">Client</dt>
                                <dd class="m-0 mt-1 text-(--klyroo-text-highlighted)">@_project.Client</dd>
                            </div>
                        }
                        @if (_project.Stack.Count > 0)
                        {
                            <div>
                                <dt class="font-mono text-xs uppercase tracking-wider text-(--klyroo-text-muted)">Built with</dt>
                                <dd class="m-0 mt-1 flex flex-wrap gap-2">
                                    @foreach (var item in _project.Stack)
                                    {
                                        <KlyBadge Label="@item" Color="KlyColor.Neutral" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
                                    }
                                </dd>
                            </div>
                        }
                    </dl>

                    @if (_project.Links.Count > 0)
                    {
                        <ul class="m-0 flex list-none flex-wrap gap-3 p-0" aria-label="Links of the project">
                            @foreach (var link in _project.Links)
                            {
                                <li>
                                    <KlyButton Label="@link.Label" Href="@link.Url" Color="KlyColor.Neutral" Variant="ButtonVariant.Outline" Size="KlySize.Sm">
                                        <TrailingIcon><KlyIcon Name="ph:arrow-up-right" Class="size-4" /></TrailingIcon>
                                    </KlyButton>
                                </li>
                            }
                        </ul>
                    }
                </header>

                @if (_project.Image is not null)
                {
                    <KlyImage Src="@_project.Image" Alt="@(_project.ImageAlt ?? "")" Class="mt-8 aspect-video w-full rounded-[calc(var(--klyroo-radius)*2)] object-cover ring ring-(--klyroo-border)" />
                }

                @* The prose styles of the Klyroo PageBody, plus the ones in Styles/app.css for what Markdown adds (code blocks, callouts, tables). *@
                <KlyPageBody Class="markdown-body mt-10 pb-10">@((MarkupString)_project.Page.Html)</KlyPageBody>
            </article>

            @if (_more.Count > 0)
            {
                <section aria-labelledby="more-work" class="mt-6 border-t border-(--klyroo-border) pt-10">
                    <h2 id="more-work" class="text-xl font-semibold text-(--klyroo-text-highlighted)">More work</h2>
                    <KlyPageGrid Columns="2" Class="mt-6 gap-6">
                        @foreach (var project in _more)
                        {
                            <ProjectCard Project="project" HeadingLevel="3" />
                        }
                    </KlyPageGrid>
                </section>
            }
        </div>
    </KlyContainer>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private Project? _project;
    private IReadOnlyList<Project> _more = [];
    private IReadOnlyList<KlyBreadcrumbItem> _crumbs = [];

    protected override void OnParametersSet()
    {
        var projects = Store.Site.Projects();
        _project = projects.FirstOrDefault(p => string.Equals(p.Name, Slug, StringComparison.OrdinalIgnoreCase));
        if (_project is null)
        {
            // Answers 404 with the page of Pages/NotFound.razor.
            Navigation.NotFound();
            return;
        }
        // The two projects after this one, wrapping to the first: always the other projects when there are only a few.
        var index = projects.ToList().IndexOf(_project);
        _more = [.. Enumerable.Range(1, Math.Min(2, projects.Count - 1)).Select(offset => projects[(index + offset) % projects.Count])];
        _crumbs = [new("Work") { Href = SiteInfo.WorkHref }, new(_project.Title)];
    }
}
