@page "/contact"

<PageTitle>@SiteInfo.ContactTitle - @SiteInfo.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@SiteInfo.ContactDescription" />
</HeadContent>

@* UI only. The form is Blux's BxForm, posted to the server with FormName (no circuit): the server checks the fields with the rules of ContactMessage and,
   when they are valid, calls SendAsync below, which sends nothing. There is no mail service, no database and no queue: the message is not stored, not
   logged and not forwarded, and it is not echoed back, only the name. To make it real, send the message in SendAsync (an SMTP client, an email API or a
   form service), return a message in _error when that fails, and add a way to stop bots (a hidden field, a rate limit, or a check such as Turnstile). *@
<BxContainer Class="py-10 sm:py-14">
    <BxPageHeader Title="@SiteInfo.ContactTitle" Description="@SiteInfo.ContactDescription" />

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="flex flex-col gap-6">
            @if (_sentTo is not null)
            {
                <BxAlert Color="BxColor.Info" Variant="BxVariant.Soft" Title="The form is valid" role="status" data-testid="contact-result"
                         Description="@($"Thank you, {_sentTo}. This template has no mail service: nothing was sent and nothing was stored. Write to {SiteInfo.Email} to reach me.")" />
            }
            @if (_error is not null)
            {
                <BxAlert Color="BxColor.Error" Variant="BxVariant.Soft" Title="@_error" role="alert" />
            }

            <BxForm Model="Model" FormName="contact" OnValidSubmit="SendAsync" class="flex flex-col gap-5" data-testid="contact-form">
                <div class="grid gap-5 sm:grid-cols-2">
                    <BxFormField Label="Name" Required For="() => Model!.Name">
                        <BxInput @bind-Value="Model!.Name" autocomplete="name" />
                    </BxFormField>
                    <BxFormField Label="Email" Required For="() => Model!.Email">
                        <BxInput @bind-Value="Model!.Email" Type="email" autocomplete="email" Placeholder="you@company.com" />
                    </BxFormField>
                </div>
                <BxFormField Label="What is this about?" Required For="() => Model!.Topic">
                    <BxSelect @bind-Value="Model!.Topic" Items="SiteInfo.Topics" Placeholder="Pick one" />
                </BxFormField>
                <BxFormField Label="Message" Required For="() => Model!.Message" Help="@($"Up to {ContactMessage.MaxMessageLength} characters.")">
                    <BxTextarea @bind-Value="Model!.Message" Rows="7" />
                </BxFormField>
                <div>
                    <BxButton Type="submit" Label="Send the message" Size="BxSize.Lg" />
                </div>
            </BxForm>
        </div>

        <aside aria-label="Other ways to reach me" class="flex flex-col gap-6 text-sm">
            <div>
                <h2 class="text-sm font-semibold text-(--blux-text-highlighted)">Email</h2>
                <p class="mt-1 text-(--blux-text-muted)"><a href="mailto:@SiteInfo.Email" class="font-medium text-(--blux-primary-text) underline underline-offset-4">@SiteInfo.Email</a></p>
            </div>
            <div>
                <h2 class="text-sm font-semibold text-(--blux-text-highlighted)">Based in</h2>
                <p class="mt-1 text-(--blux-text-muted)">@SiteInfo.Location</p>
            </div>
            <div>
                <h2 class="text-sm font-semibold text-(--blux-text-highlighted)">Elsewhere</h2>
                <ul class="m-0 mt-2 flex list-none flex-col gap-2 p-0">
                    @foreach (var link in SiteInfo.Social.Where(l => l.Label != "Email"))
                    {
                        <li>
                            <a href="@link.Href" class="inline-flex items-center gap-2 text-(--blux-text-muted) underline-offset-4 hover:text-(--blux-text-highlighted) hover:underline">
                                <BxIcon Name="@link.Icon" Class="size-4" />
                                <span>@link.Label</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </aside>
    </div>
</BxContainer>

@code {
    // Bound to the posted form: a static post is validated by the server like an interactive one, and the page that answers it carries the errors.
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactMessage? Model { get; set; }

    private string? _sentTo;
    private string? _error;

    protected override void OnInitialized() => Model ??= new();

    // Called with a valid form. It only remembers who wrote: nothing is sent, stored or logged. Replace its body to deliver the message (see the note above).
    private Task SendAsync()
    {
        _error = null;
        _sentTo = Model!.Name?.Trim();
        Model = new();
        return Task.CompletedTask;
    }
}
