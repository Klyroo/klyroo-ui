@page "/contact"
@inject NavigationManager Navigation

<PageTitle>@SiteInfo.ContactTitle - @SiteInfo.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@SiteInfo.ContactDescription" />
</HeadContent>

@* UI only. The form is Klyroo's KlyForm, posted to the server with FormName (no circuit): the server checks the fields with the rules of ContactMessage and,
   when they are valid, calls SendAsync below, which sends nothing. There is no mail service, no database and no queue: the message is not stored, not
   logged and not forwarded, and it is not echoed back. A valid post redirects to /contact?sent=1 (Post/Redirect/Get). To make it real, send the message in SendAsync (an SMTP client, an email API or a
   form service), return a message in _error when that fails, and add a way to stop bots (a hidden field, a rate limit, or a check such as Turnstile). *@
<KlyContainer Class="py-10 sm:py-14">
    <KlyPageHeader Title="@SiteInfo.ContactTitle" Description="@SiteInfo.ContactDescription" />

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="flex flex-col gap-6">
            @if (Sent == "1")
            {
                <KlyAlert Color="KlyColor.Info" Variant="KlyVariant.Soft" Title="The form is valid" role="status" data-testid="contact-result"
                         Description="@($"Thank you. This template has no mail service: nothing was sent and nothing was stored. Write to {SiteInfo.Email} to reach me.")" />
            }
            @if (_error is not null)
            {
                <KlyAlert Color="KlyColor.Error" Variant="KlyVariant.Soft" Title="@_error" role="alert" />
            }

            <KlyForm Model="Model" FormName="contact" OnValidSubmit="SendAsync" class="flex flex-col gap-5" data-testid="contact-form">
                <div class="grid gap-5 sm:grid-cols-2">
                    <KlyFormField Label="Name" Required Field="FieldIdentifier.Create(() => Model!.Name)">
                        <KlyInput @bind-Value="Model!.Name" autocomplete="name" />
                    </KlyFormField>
                    <KlyFormField Label="Email" Required Field="FieldIdentifier.Create(() => Model!.Email)">
                        <KlyInput @bind-Value="Model!.Email" Type="InputType.Email" autocomplete="email" Placeholder="you@company.com" />
                    </KlyFormField>
                </div>
                <KlyFormField Label="What is this about?" Required Field="FieldIdentifier.Create(() => Model!.Topic)">
                    @* Radio buttons post natively: the form works with JavaScript off. *@
                    <KlyRadioGroup TValue="string" @bind-Value="Model!.Topic" Items="SiteInfo.Topics" />
                </KlyFormField>
                <KlyFormField Label="Message" Required Field="FieldIdentifier.Create(() => Model!.Message)" Help="@($"Up to {ContactMessage.MaxMessageLength} characters.")">
                    <KlyTextarea @bind-Value="Model!.Message" Rows="7" />
                </KlyFormField>
                <div>
                    <KlyButton Type="ButtonType.Submit" Label="Send the message" Size="KlySize.Lg" />
                </div>
            </KlyForm>
        </div>

        <aside aria-label="Other ways to reach me" class="flex flex-col gap-6 text-sm">
            <div>
                <h2 class="text-sm font-semibold text-(--klyroo-text-highlighted)">Email</h2>
                <p class="mt-1 text-(--klyroo-text-muted)"><a href="mailto:@SiteInfo.Email" class="font-medium text-(--klyroo-primary-text) underline underline-offset-4">@SiteInfo.Email</a></p>
            </div>
            <div>
                <h2 class="text-sm font-semibold text-(--klyroo-text-highlighted)">Based in</h2>
                <p class="mt-1 text-(--klyroo-text-muted)">@SiteInfo.Location</p>
            </div>
            <div>
                <h2 class="text-sm font-semibold text-(--klyroo-text-highlighted)">Elsewhere</h2>
                <ul class="m-0 mt-2 flex list-none flex-col gap-2 p-0">
                    @foreach (var link in SiteInfo.Social.Where(l => l.Label != "Email"))
                    {
                        <li>
                            <a href="@link.Href" class="inline-flex items-center gap-2 text-(--klyroo-text-muted) underline-offset-4 hover:text-(--klyroo-text-highlighted) hover:underline">
                                <KlyIcon Name="@link.Icon" Class="size-4" />
                                <span>@link.Label</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </aside>
    </div>
</KlyContainer>

@code {
    // Bound to the posted form: a static post is validated by the server like an interactive one, and the page that answers it carries the errors.
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactMessage? Model { get; set; }

    // "1" on the page a successful post redirects to (Post/Redirect/Get), so that reloading it does not post the form again.
    [SupplyParameterFromQuery(Name = "sent")]
    public string? Sent { get; set; }

    private string? _error;

    protected override void OnInitialized() => Model ??= new();

    // Called with a valid form. It sends nothing, stores nothing and logs nothing: it only redirects to the confirmation. Replace its body to deliver the
    // message (see the note above), and keep the redirect, which is what stops a reload from sending the form twice.
    private Task SendAsync()
    {
        _error = null;
        Navigation.NavigateTo("contact?sent=1");
        return Task.CompletedTask;
    }
}
