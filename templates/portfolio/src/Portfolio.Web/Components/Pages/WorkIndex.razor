@page "/work"
@inject MarkdownStore Store

<PageTitle>@SiteInfo.WorkPageTitle - @SiteInfo.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@SiteInfo.WorkPageDescription" />
</HeadContent>

<KlyContainer Class="py-10 sm:py-14">
    <KlyPageHeader Title="@SiteInfo.WorkPageTitle" Description="@SiteInfo.WorkPageDescription" />

    <KlyPageGrid Columns="2" Class="mt-10 gap-6">
        @foreach (var project in _projects)
        {
            <ProjectCard Project="project" HeadingLevel="2" />
        }
    </KlyPageGrid>
</KlyContainer>

@code {
    private IReadOnlyList<Project> _projects = [];

    protected override void OnParametersSet() => _projects = Store.Site.Projects();
}
