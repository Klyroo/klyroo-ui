@page "/about"
@inject MarkdownStore Store

<PageTitle>@_title - @SiteInfo.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@_description" />
</HeadContent>

<KlyContainer Class="py-10 sm:py-14">
    <div class="mx-auto max-w-3xl">
        <KlyPageHeader Title="@_title" Description="@_description" />

        @* The text is content/about.md: write it in Markdown, start at ##. The experience and the skills below are typed data (Site/Resume.cs). *@
        @if (_about is not null)
        {
            <KlyPageBody Class="markdown-body mt-8" data-testid="about-text">@((MarkupString)_about.Html)</KlyPageBody>
        }

        <section aria-labelledby="experience" class="mt-12">
            <h2 id="experience" class="text-2xl font-semibold tracking-tight text-(--klyroo-text-highlighted)">Experience</h2>
            <KlyTimeline Items="_timeline" Color="KlyColor.Neutral" AriaLabel="Experience" Class="mt-6" data-testid="experience" />
        </section>

        <section aria-labelledby="skills" class="mt-12">
            <h2 id="skills" class="text-2xl font-semibold tracking-tight text-(--klyroo-text-highlighted)">Skills and tools</h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-3">
                @foreach (var group in Resume.Skills)
                {
                    <div data-testid="skill-group">
                        <h3 class="text-sm font-semibold text-(--klyroo-text-highlighted)">@group.Name</h3>
                        <ul class="m-0 mt-3 flex list-none flex-col gap-2 p-0 text-sm text-(--klyroo-text-muted)">
                            @foreach (var item in group.Items)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </section>

        <section aria-labelledby="elsewhere" class="mt-12 border-t border-(--klyroo-border) pt-10">
            <h2 id="elsewhere" class="text-2xl font-semibold tracking-tight text-(--klyroo-text-highlighted)">Elsewhere</h2>
            <p class="mt-3 text-(--klyroo-text-muted)">The tools I work with every day are on the <a href="@SiteInfo.UsesHref" class="font-medium text-(--klyroo-primary-text) underline underline-offset-4">uses page</a>, and the best way to reach me is the <a href="@SiteInfo.ContactHref" class="font-medium text-(--klyroo-primary-text) underline underline-offset-4">contact form</a>.</p>
        </section>
    </div>
</KlyContainer>

@code {
    private MarkdownPage? _about;
    private string _title = SiteInfo.AboutTitle;
    private string _description = SiteInfo.AboutDescription;
    private IReadOnlyList<KlyTimelineItem> _timeline = [];

    protected override void OnParametersSet()
    {
        _about = Store.Site.About();
        // The title and the description of the page can be set in the front matter of content/about.md.
        _title = _about is { Title: { Length: > 0 } title } ? title : SiteInfo.AboutTitle;
        _description = _about?.Description ?? SiteInfo.AboutDescription;
        _timeline = Resume.Timeline();
    }
}
