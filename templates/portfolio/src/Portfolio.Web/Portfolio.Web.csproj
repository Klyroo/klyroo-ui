<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Tailwind compiled by the build (no Node): Styles/app.css becomes app.css, which App.razor links. -->
    <KlyrooTailwind>true</KlyrooTailwind>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Klyroo.UI" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- The projects, the articles and the other pages. They are read from the folder at run time, so they travel with the build and with the publish output. -->
  <ItemGroup>
    <None Update="content/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fonts are downloaded at build time and served from the site's own origin (KlyFonts in App.razor links them). -->
  <ItemGroup>
    <KlyrooFont Include="Geist" Role="sans" Weights="400..700" Subsets="latin" />
    <KlyrooFont Include="Geist Mono" Role="mono" Weights="400..600" Subsets="latin" />
  </ItemGroup>

</Project>
