<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tailwind compiled by the build (no Node): Styles/app.css becomes _content/Starter.Shared/app.css, for the web host and the MAUI app. -->
    <KlyrooTailwind>true</KlyrooTailwind>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Klyroo.UI" />
  </ItemGroup>

</Project>
