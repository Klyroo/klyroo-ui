@inherits LayoutComponentBase

@* LxHead sends the theme variables and the self-hosted fonts to <head> through the HeadOutlet root component of the MAUI app.
   It renders nothing on the web, where App.razor places them. *@
<LxHead />
<SystemBars />

<LxApp>
    <LxSkipLink />

    @* Links are relative: they resolve against <base href>, so the app works at the root of a site and below a path. *@
    <LxHeader Items="_items" AriaLabel="Main" MenuTitle="Menu">
        <Left>
            <a href="./" class="flex items-center gap-2 font-semibold text-(--lux-text-highlighted)">
                <LxIcon Name="ph:stack" Class="size-6" />
                <span>Starter</span>
            </a>
        </Left>
        <Right>
            <LxLocaleSelect Size="LxSize.Sm" />
            <LxColorModeButton Size="LxSize.Sm" />
        </Right>
    </LxHeader>

    <LxMain id="main" tabindex="-1" class="focus:outline-none">
        @Body
    </LxMain>

    <LxFooter>
        <Left>
            <p class="text-sm text-(--lux-text-muted)">&copy; @DateTime.UtcNow.Year Starter. Built with Lux.UI.</p>
        </Left>
        <Right>
            <nav aria-label="Footer" class="flex gap-4 text-sm">
                <a href="./" class="text-(--lux-text-muted) hover:text-(--lux-text-highlighted)">Home</a>
                <a href="about" class="text-(--lux-text-muted) hover:text-(--lux-text-highlighted)">About</a>
            </nav>
        </Right>
    </LxFooter>
</LxApp>

<div id="blazor-error-ui" data-nosnippet class="fixed inset-x-0 bottom-0 z-50 hidden bg-amber-100 px-4 py-3 text-sm text-zinc-900">
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss ms-4 cursor-pointer">x</span>
</div>

@code {
    private static readonly LxNavigationItem[] _items =
    [
        new("Home") { Href = "./", Exact = true },
        new("Features") { Href = "./#features", Active = false },
        new("About") { Href = "about" },
    ];
}
