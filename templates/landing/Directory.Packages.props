<Project>
  <!-- Central package management: the versions of every package of the solution, in one place. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Blux.UI" Version="0.1.0-alpha" />
  </ItemGroup>
</Project>
