@* The hero. The invoice on the right is plain markup, there to show what the product makes: it is hidden from assistive technology
   because it repeats nothing the text next to it does not say. Swap it for a screenshot (LxImage) when you have one. *@
<LxPageHero Headline="@SiteContent.HeroHeadline"
            Title="@SiteContent.HeroTitle"
            Description="@SiteContent.HeroDescription"
            Links="SiteContent.HeroLinks"
            Ui="_ui">
    <Media>
        <div aria-hidden="true" data-testid="hero-invoice"
             class="mx-auto flex w-full max-w-[27rem] flex-col gap-5 rounded-2xl bg-(--lux-bg) p-6 shadow-xl ring ring-(--lux-border)">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="font-mono text-xs uppercase tracking-wider text-(--lux-text-muted)">Invoice 1042</p>
                    <p class="mt-1 text-lg font-semibold text-(--lux-text-highlighted)">Alder Studio</p>
                </div>
                <LxBadge Label="Paid" Color="LxColor.Success" Variant="LxVariant.Subtle" />
            </div>
            <dl class="flex flex-col divide-y divide-(--lux-border) text-sm">
                @foreach (var (label, amount) in _lines)
                {
                    <div class="flex items-center justify-between gap-4 py-3">
                        <dt class="text-(--lux-text-muted)">@label</dt>
                        <dd class="font-mono text-(--lux-text)">@amount</dd>
                    </div>
                }
                <div class="flex items-center justify-between gap-4 pt-3 text-base font-semibold">
                    <dt class="text-(--lux-text-highlighted)">Total</dt>
                    <dd class="font-mono text-(--lux-text-highlighted)">$2,808.00</dd>
                </div>
            </dl>
            <p class="text-xs text-(--lux-text-muted)">Paid by card on 14 March. Reminders stopped.</p>
        </div>
    </Media>
</LxPageHero>

@code {
    private static readonly (string Label, string Amount)[] _lines =
    [
        ("Brand identity, 12 h", "$1,440.00"),
        ("Illustrations, 6 items", "$900.00"),
        ("VAT 20%", "$468.00"),
    ];

    private static readonly PageHeroUi _ui = new()
    {
        Container = "gap-12 py-16 sm:py-20 lg:py-24",
        Title = "text-4xl sm:text-5xl lg:text-6xl",
    };
}
