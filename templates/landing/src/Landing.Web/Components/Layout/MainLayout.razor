@inherits LayoutComponentBase

<KlyApp>
    <KlySkipLink />

    @* Links are relative: they resolve against <base href>, so the site works at the root of a domain and below a path. *@
    <KlyHeader Items="SiteContent.Navigation" AriaLabel="@SiteContent.HeaderLabel" MenuTitle="@SiteContent.HeaderMenuTitle">
        <Left>
            <a href="./" class="flex items-center gap-2 rounded-sm font-semibold text-(--klyroo-text-highlighted)">
                <KlyIcon Name="ph:paper-plane-tilt" Class="size-6" />
                <span>@SiteContent.Name</span>
            </a>
        </Left>
        <Right>
            <KlyLocaleSelect Size="KlySize.Sm" />
            <KlyColorModeButton Size="KlySize.Sm" />
            <KlyButton Label="@SiteContent.HeaderButtonLabel" Href="@SiteContent.SignUpUrl" Size="KlySize.Sm" Class="ms-1 hidden sm:inline-flex" />
        </Right>
    </KlyHeader>

    <KlyMain id="main" tabindex="-1" class="focus:outline-none">
        @Body
    </KlyMain>

    <KlyFooter>
        <Top>
            <KlyFooterColumns Columns="SiteContent.FooterColumns" AriaLabel="@SiteContent.FooterLabel">
                <Left>
                    <a href="./" class="flex items-center gap-2 rounded-sm font-semibold text-(--klyroo-text-highlighted)">
                        <KlyIcon Name="ph:paper-plane-tilt" Class="size-6" />
                        <span>@SiteContent.Name</span>
                    </a>
                    <p class="mt-3 max-w-xs text-sm text-(--klyroo-text-muted)">@SiteContent.Tagline</p>
                </Left>
            </KlyFooterColumns>
        </Top>
        <Left>
            <p class="text-sm text-(--klyroo-text-muted)">@SiteContent.Copyright</p>
        </Left>
    </KlyFooter>
</KlyApp>
