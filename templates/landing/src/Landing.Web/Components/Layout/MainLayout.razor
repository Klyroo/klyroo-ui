@inherits LayoutComponentBase

<BxApp>
    <BxSkipLink />

    @* Links are relative: they resolve against <base href>, so the site works at the root of a domain and below a path. *@
    <BxHeader Items="SiteContent.Navigation" AriaLabel="@SiteContent.HeaderLabel" MenuTitle="@SiteContent.HeaderMenuTitle">
        <Left>
            <a href="./" class="flex items-center gap-2 rounded-sm font-semibold text-(--blux-text-highlighted)">
                <BxIcon Name="ph:paper-plane-tilt" Class="size-6" />
                <span>@SiteContent.Name</span>
            </a>
        </Left>
        <Right>
            <BxLocaleSelect Size="BxSize.Sm" />
            <BxColorModeButton Size="BxSize.Sm" />
            <BxButton Label="@SiteContent.HeaderButtonLabel" Href="@SiteContent.SignUpUrl" Size="BxSize.Sm" Class="ms-1 hidden sm:inline-flex" />
        </Right>
    </BxHeader>

    <BxMain id="main" tabindex="-1" class="focus:outline-none">
        @Body
    </BxMain>

    <BxFooter>
        <Top>
            <BxFooterColumns Columns="SiteContent.FooterColumns" AriaLabel="@SiteContent.FooterLabel">
                <Left>
                    <a href="./" class="flex items-center gap-2 rounded-sm font-semibold text-(--blux-text-highlighted)">
                        <BxIcon Name="ph:paper-plane-tilt" Class="size-6" />
                        <span>@SiteContent.Name</span>
                    </a>
                    <p class="mt-3 max-w-xs text-sm text-(--blux-text-muted)">@SiteContent.Tagline</p>
                </Left>
            </BxFooterColumns>
        </Top>
        <Left>
            <p class="text-sm text-(--blux-text-muted)">@SiteContent.Copyright</p>
        </Left>
    </BxFooter>
</BxApp>
