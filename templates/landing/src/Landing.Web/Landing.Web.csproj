<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Tailwind compiled by the build (no Node): Styles/app.css becomes app.css, which App.razor links. -->
    <LuxTailwind>true</LuxTailwind>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lux.UI" />
  </ItemGroup>

  <!-- Fonts are downloaded at build time and served from the site's own origin (BxFonts in App.razor links them). -->
  <ItemGroup>
    <LuxFont Include="Geist" Role="sans" Weights="400..700" Subsets="latin" />
    <LuxFont Include="Geist Mono" Role="mono" Weights="400..600" Subsets="latin" />
  </ItemGroup>

  <!-- The logo marks of the strip: Assets/marks/*.svg are bundled as the icons mark:<file name>, drawn in the current text color. -->
  <ItemGroup>
    <LuxIconCollection Include="Assets/marks" Prefix="mark" />
  </ItemGroup>

</Project>
