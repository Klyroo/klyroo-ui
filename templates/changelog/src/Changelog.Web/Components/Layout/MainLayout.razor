@inherits LayoutComponentBase

<KlyApp>
    <KlySkipLink />

    @* Links are relative: they resolve against <base href>, so the site works at the root of a domain and below a path. *@
    <KlyHeader>
        <Left>
            <a href="./" class="flex items-center gap-2 rounded-sm font-semibold text-(--klyroo-text-highlighted)">
                <KlyIcon Name="ph:tag" Class="size-6" />
                <span>@SiteInfo.Name</span>
            </a>
        </Left>
        <Right>
            @* The feed of the latest releases (Atom): /feed.xml, built by ReleaseNotes/ReleaseFeed.cs. *@
            <KlyButton Href="feed.xml" Square Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" Size="KlySize.Sm" data-testid="feed-link"
                      aria-label="Atom feed of the releases">
                <LeadingIcon><KlyIcon Name="ph:rss" Class="size-5" /></LeadingIcon>
            </KlyButton>
            <KlyColorModeButton Size="KlySize.Sm" />
        </Right>
    </KlyHeader>

    <KlyMain id="main" tabindex="-1" class="focus:outline-none">
        @Body
    </KlyMain>

    <KlyFooter>
        <Left>
            <p class="text-sm text-(--klyroo-text-muted)">@SiteInfo.Copyright</p>
        </Left>
    </KlyFooter>
</KlyApp>
