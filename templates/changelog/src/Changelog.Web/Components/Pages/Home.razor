@page "/"
@inject ReleaseService Releases
@inject ReleaseBody Body
@inject IOptions<ChangelogOptions> Options
@inject NavigationManager Navigation

<PageTitle>@SiteInfo.Title - @SiteInfo.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@SiteInfo.Description" />
    <link rel="alternate" type="application/atom+xml" title="@SiteInfo.FeedTitle" href="feed.xml" />
</HeadContent>

<BxContainer Class="py-8 lg:py-12">
    <BxPageHeader Headline="@SiteInfo.Name" Title="@SiteInfo.Title" Description="@SiteInfo.Description" Links="_links" />

    @if (_list is not null)
    {
        <ReleaseProblem List="_list" />
    }

    @if (_list is { Available: true })
    {
        @if (_visible.Count == 0)
        {
            <BxEmpty Title="No releases yet" Description="This repository has not published a release." HeadingLevel="2" Class="mt-10" />
        }
        else
        {
            @* A timeline: each release is an article with its date, its version, its author and its notes. The title of a release is an h2, so the
               headings of its notes start at h3. *@
            <BxChangelogVersions Class="mt-10" data-testid="releases">
                @foreach (var release in _visible)
                {
                    <BxChangelogVersion Title="@release.Title"
                                        HeadingLevel="2"
                                        Href="@($"releases/{release.Slug}")"
                                        Date="release.PublishedAt"
                                        Badge="@BadgeOf(release)"
                                        BadgeColor="@(release.Prerelease ? BxColor.Warning : BxColor.Primary)"
                                        Authors="AuthorsOf(release)"
                                        data-testid="release">
                        @if (Body.Render(release, PageHref(_page), 3) is { Length: > 0 } html)
                        {
                            <BxPageBody Class="markdown-body">@((MarkupString)html)</BxPageBody>
                        }
                    </BxChangelogVersion>
                }
            </BxChangelogVersions>

            @if (_pages > 1)
            {
                <nav aria-label="Pages of releases" class="mt-10 flex items-center justify-between gap-4 border-t border-(--blux-border) pt-6" data-testid="pagination">
                    @if (_page > 1)
                    {
                        <BxButton Label="Newer releases" Href="@PageHref(_page - 1)" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" rel="prev">
                            <LeadingIcon><BxIcon Name="ph:arrow-left" Class="size-4" /></LeadingIcon>
                        </BxButton>
                    }
                    else
                    {
                        <span></span>
                    }
                    <p class="text-sm text-(--blux-text-muted)">Page @_page of @_pages</p>
                    @if (_page < _pages)
                    {
                        <BxButton Label="Older releases" Href="@PageHref(_page + 1)" Variant="ButtonVariant.Outline" Color="BxColor.Neutral" rel="next">
                            <TrailingIcon><BxIcon Name="ph:arrow-right" Class="size-4" /></TrailingIcon>
                        </BxButton>
                    }
                    else
                    {
                        <span></span>
                    }
                </nav>
            }
        }
    }
</BxContainer>

@code {
    private IReadOnlyList<PageLinkItem> _links = [];
    private ReleaseList? _list;
    private IReadOnlyList<ReleaseEntry> _visible = [];
    private int _page = 1;
    private int _pages = 1;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// The number of the page of releases, from <c>?page=2</c>. Without it, the first. It is text here, not a number: a number that the binder cannot read
    /// (<c>?page=abc</c>) would fail the request before this page runs, and it is a page that does not exist, a 404, like any other.
    /// </summary>
    [SupplyParameterFromQuery(Name = "page")] public string? PageText { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _list = await Releases.GetAsync(HttpContext?.RequestAborted ?? CancellationToken.None);
        _links = BuildLinks(_list);

        if (!_list.Available)
        {
            // The page is the explanation; the status tells search engines and monitors that the content is missing, not gone.
            if (HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status503ServiceUnavailable;
                context.Response.Headers.RetryAfter = "300";
            }
            return;
        }

        var size = Math.Max(1, Options.Value.PageSize);
        _pages = Math.Max(1, (int)Math.Ceiling(_list.Releases.Count / (double)size));
        if (!int.TryParse(PageText, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out _page))
        {
            _page = string.IsNullOrEmpty(PageText) ? 1 : 0;
        }
        if (_page < 1 || _page > _pages)
        {
            // Answers 404 with the page of Pages/NotFound.razor.
            Navigation.NotFound();
            return;
        }
        _visible = [.. _list.Releases.Skip((_page - 1) * size).Take(size)];
    }

    private IReadOnlyList<PageLinkItem> BuildLinks(ReleaseList list)
    {
        var links = new List<PageLinkItem> { new("Subscribe", "feed.xml") { Icon = "ph:rss" } };
        if (list.RepositoryUrl is { } repository)
        {
            links.Add(new PageLinkItem("View on GitHub", repository) { Icon = "ph:github-logo", Color = BxColor.Neutral, Variant = ButtonVariant.Outline });
        }
        return links;
    }

    private static string PageHref(int page) => page == 1 ? "./" : $"?page={page}";

    // The version badge, when the title is not already the tag. A pre-release says so in words: the color alone would not tell everyone.
    private static string? BadgeOf(ReleaseEntry release) =>
        release.Prerelease ? $"{release.Tag} pre-release" : release.Title == release.Tag ? null : release.Tag;

    private static IReadOnlyList<BxPostAuthor> AuthorsOf(ReleaseEntry release) =>
        release.Author is { } author ? [new BxPostAuthor(author.Login) { AvatarSrc = author.AvatarUrl, Href = author.ProfileUrl }] : [];
}
