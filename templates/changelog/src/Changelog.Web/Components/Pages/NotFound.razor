@page "/not-found"

<PageTitle>Not found - @SiteInfo.Name</PageTitle>

<BxContainer Class="flex flex-col items-start gap-4 py-16">
    <p class="font-mono text-sm text-(--blux-text-muted)">404</p>
    <h1 class="text-2xl font-semibold text-(--blux-text-highlighted)">Not found</h1>
    <p class="text-(--blux-text-muted)">There is nothing at this address. The release may have been removed, or the address mistyped: start from the list of releases.</p>
    <BxButton Label="All releases" Href="./" />
</BxContainer>
