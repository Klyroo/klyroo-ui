@page "/error"

<PageTitle>Error</PageTitle>

<LxContainer Class="flex flex-col items-start gap-4 py-16">
    <h1 class="text-2xl font-semibold text-(--lux-error-text)">Something went wrong</h1>
    <p class="text-(--lux-text-muted)">The request could not be completed. Try again, and if the problem stays, check the logs of the server.</p>
    <LxButton Label="All releases" Href="./" />
</LxContainer>
