<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Tailwind compiled by the build (no Node): Styles/app.css becomes app.css, which App.razor links. -->
    <BluxTailwind>true</BluxTailwind>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blux.UI" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- The sample releases of the file source (Changelog:Source=File). They are read from the folder at run time, so they travel with the build and with the publish output. -->
  <ItemGroup>
    <None Update="data/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fonts are downloaded at build time and served from the site's own origin (BxFonts in App.razor links them). -->
  <ItemGroup>
    <BluxFont Include="Geist" Role="sans" Weights="400..700" Subsets="latin" />
    <BluxFont Include="Geist Mono" Role="mono" Weights="400..600" Subsets="latin" />
  </ItemGroup>

</Project>
