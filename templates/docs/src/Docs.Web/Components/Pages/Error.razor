@page "/error"

<PageTitle>Error</PageTitle>

<KlyContainer Class="flex flex-col items-start gap-4 py-16">
    <h1 class="text-2xl font-semibold text-(--klyroo-error-text)">Something went wrong</h1>
    <p class="text-(--klyroo-text-muted)">The request could not be completed. Try again, and if the problem stays, check the logs of the server.</p>
    <KlyButton Label="Back home" Href="./" />
</KlyContainer>
