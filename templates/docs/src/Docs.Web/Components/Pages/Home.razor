@page "/"
@inject MarkdownStore Store

<PageTitle>@SiteInfo.Name: @SiteInfo.Tagline</PageTitle>

<HeadContent>
    <meta name="description" content="@SiteInfo.Description" />
</HeadContent>

<BxPageHero Headline="@SiteInfo.HeroHeadline"
            Title="@SiteInfo.HeroTitle"
            Description="@SiteInfo.HeroDescription"
            Links="SiteInfo.HeroLinks"
            Ui="_heroUi">
    <Media>
        @* The same renderer as the pages: highlighted, with a copy button. *@
        <div data-testid="hero-snippet" class="mx-auto w-full max-w-[29rem]">@((MarkupString)_snippet)</div>
    </Media>
</BxPageHero>

<BxPageSection Headline="@SiteInfo.FeaturesHeadline"
               Title="@SiteInfo.FeaturesTitle"
               Description="@SiteInfo.FeaturesDescription"
               Orientation="BxOrientation.Vertical"
               Features="SiteInfo.Features" />

@* One card per section of the documentation: the top level folders of the content folder, each with the pages it holds. *@
<BxContainer Class="py-12 sm:py-16">
    <h2 class="text-2xl font-semibold tracking-tight text-(--blux-text-highlighted)">Browse the documentation</h2>
    <ul data-testid="sections" class="m-0 mt-8 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-3">
        @foreach (var section in _sections)
        {
            <li class="flex flex-col gap-3 rounded-[calc(var(--blux-radius)*2)] bg-(--blux-bg-elevated)/50 p-6 ring ring-(--blux-border)">
                <h3 class="flex items-center gap-2 text-base font-semibold text-(--blux-text-highlighted)">
                    @if (section.Icon is not null)
                    {
                        <BxIcon Name="@section.Icon" Class="size-5 text-(--blux-text-muted)" />
                    }
                    @section.Title
                </h3>
                <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-sm">
                    @foreach (var link in section.Children ?? [])
                    {
                        <li><a href="@link.Href" class="rounded-sm text-(--blux-primary-text) underline underline-offset-4">@link.Title</a></li>
                    }
                </ul>
            </li>
        }
    </ul>
</BxContainer>

<BxPageCta Variant="BxVariant.Outline"
           Title="@SiteInfo.CtaTitle"
           Description="@SiteInfo.CtaDescription"
           Links="SiteInfo.CtaLinks"
           Class="mb-8" />

@code {
    private static readonly PageHeroUi _heroUi = new()
    {
        Container = "gap-12 py-16 sm:py-20 lg:py-24",
        Title = "text-4xl sm:text-5xl lg:text-6xl",
    };

    // Rendered once: it never changes with the content.
    private static readonly string _snippet = new MarkdownRenderer().Render(SiteInfo.HeroSnippet, "", "./").Html;

    private IReadOnlyList<BxContentNavigationItem> _sections = [];

    protected override void OnInitialized() =>
        _sections = [.. Store.Site.Navigation.Where(item => item.Children is { Count: > 0 })];
}
