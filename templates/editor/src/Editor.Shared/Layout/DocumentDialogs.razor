@implements IDisposable
@inject DocumentState Documents
@inject IToastService Toasts

@* The rename and delete dialogs, one of each for the whole list. The rows of the list ask for them through DocumentState. They are outside the sidebar
   on purpose: on a phone the sidebar is a panel that closes before a dialog outside it opens. *@
<KlyModal @bind-Open="_renameOpen" Title="Rename document" Description="The title is shown in the list and at the top of the document." data-testid="rename-dialog">
    <Body>
        <form id="rename-form" @onsubmit="RenameAsync" class="flex flex-col gap-2">
            <KlyFormField Label="Title">
                <KlyInput @bind-Value="_title" Immediate Placeholder="Title" data-testid="rename-input" />
            </KlyFormField>
        </form>
    </Body>
    <Footer>
        <KlyButton Label="Cancel" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" data-kly-close />
        <KlyButton Label="Save" Type="submit" form="rename-form" Disabled="@(DocumentState.CleanTitle(_title).Length == 0)" data-testid="rename-save" />
    </Footer>
</KlyModal>

<KlyModal @bind-Open="_deleteOpen" Title="Delete document?" Description="@(_target is null ? null : $"\"{_target.Title}\" is removed from this browser. This cannot be undone.")" data-testid="delete-dialog">
    <Footer>
        <KlyButton Label="Cancel" Color="KlyColor.Neutral" Variant="ButtonVariant.Ghost" data-kly-close />
        <KlyButton Label="Delete" Color="KlyColor.Error" OnClick="DeleteAsync" data-testid="delete-confirm" />
    </Footer>
</KlyModal>

@code {
    private bool _renameOpen;
    private bool _deleteOpen;
    private string? _title;
    private Document? _target;

    protected override void OnInitialized()
    {
        Documents.RenameRequested += OnRename;
        Documents.DeleteRequested += OnDelete;
        Documents.Notice += OnNotice;
    }

    // What the app removed on its own (the limits, a repair of the storage, another tab) is never silent: a toast says how many documents went and why. It stays long enough to read.
    private void OnNotice(StateNotice notice) => _ = InvokeAsync(async () =>
    {
        var (title, description) = notice.Describe();
        await Toasts.Add(new KlyToast { Title = title, Description = description, Color = KlyColor.Warning, Duration = TimeSpan.FromSeconds(15) });
    });

    private void OnRename(Document document) => _ = InvokeAsync(() =>
    {
        _target = document;
        _title = document.Title;
        _renameOpen = true;
        StateHasChanged();
    });

    private void OnDelete(Document document) => _ = InvokeAsync(() =>
    {
        _target = document;
        _deleteOpen = true;
        StateHasChanged();
    });

    private async Task RenameAsync()
    {
        if (_target is null || DocumentState.CleanTitle(_title).Length == 0) return;
        var saved = await Documents.RenameAsync(_target, _title);
        _renameOpen = false;
        if (!saved) await Toasts.Add(new KlyToast { Title = "Not saved", Description = "This browser did not keep the change: it applies to this visit only.", Color = KlyColor.Warning });
    }

    private async Task DeleteAsync()
    {
        if (_target is null) return;
        await Documents.DeleteAsync(_target);
        _deleteOpen = false;
        _target = null;
    }

    public void Dispose()
    {
        Documents.RenameRequested -= OnRename;
        Documents.DeleteRequested -= OnDelete;
        Documents.Notice -= OnNotice;
    }
}
