<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tailwind compiled by the build (no Node): Styles/app.css becomes _content/Editor.Shared/app.css, for the web host and the MAUI app. -->
    <KlyrooTailwind>true</KlyrooTailwind>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Icons the build cannot see because the page picks the name at run time (a variable, a condition). The ones written as literals are found by the build. -->
  <ItemGroup>
    <KlyrooIcon Include="lucide:file-text;lucide:hard-drive;lucide:check;lucide:triangle-alert" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Klyroo.UI" />
  </ItemGroup>

</Project>
