<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Editor.Web.Client\Editor.Web.Client.csproj" />
    <ProjectReference Include="..\Editor.Shared\Editor.Shared.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <!-- Fonts are downloaded at build time and served from the app's own origin (LxFonts in App.razor links them). They belong to the host project. -->
  <ItemGroup>
    <LuxFont Include="Geist" Role="sans" Weights="400..700" Subsets="latin" />
    <LuxFont Include="Geist Mono" Role="mono" Weights="400..600" Subsets="latin" />
  </ItemGroup>

</Project>
