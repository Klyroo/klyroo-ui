<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Blux.UI.Tools reaches every project of the app and warns (BLUXTOOLS001) where nothing compiles Tailwind. Dashboard.Shared compiles it, for this host too (it links
         _content/Dashboard.Shared/app.css), so the check has nothing to say here. -->
    <BluxToolsOwnTailwind>true</BluxToolsOwnTailwind>
    <!-- Dates and numbers in every language of the locale select, not only the default subset. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <ProjectReference Include="..\Dashboard.Shared\Dashboard.Shared.csproj" />
  </ItemGroup>

</Project>
