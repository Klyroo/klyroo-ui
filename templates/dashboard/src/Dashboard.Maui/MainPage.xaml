<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
             xmlns:shared="clr-namespace:Dashboard.Shared;assembly=Dashboard.Shared"
             x:Class="Dashboard.Maui.MainPage"
             SafeAreaEdges="Container">

    <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
            <!-- Renders what BxHead (and PageTitle, HeadContent) send to the head: the theme variables and the fonts. -->
            <blazor:RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

</ContentPage>
