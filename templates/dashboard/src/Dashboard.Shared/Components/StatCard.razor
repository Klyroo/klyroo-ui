@* One number of the Home page: what it counts, its value, and how it moved compared with the period before. The arrow and the sign carry the direction, never the color alone. *@
<KlyCard data-testid="@TestId">
    <div class="flex items-start justify-between gap-3">
        <div class="flex min-w-0 flex-col gap-1">
            <p class="text-sm text-(--klyroo-text-muted)">@Label</p>
            <p class="truncate text-2xl font-semibold tracking-tight text-(--klyroo-text-highlighted)" data-testid="@(TestId is null ? null : TestId + "-value")">@Value</p>
        </div>
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-(--klyroo-bg-elevated) text-(--klyroo-text-muted)" aria-hidden="true">
            <KlyIcon Name="@Icon" Class="size-5" />
        </span>
    </div>
    <div class="mt-3 flex items-center gap-2">
        <KlyBadge Color="@(Change >= 0 ? KlyColor.Success : KlyColor.Error)" Variant="KlyVariant.Subtle" Size="KlySize.Sm" data-testid="@(TestId is null ? null : TestId + "-change")">
            <LeadingIcon><KlyIcon Name="@(Change >= 0 ? "lucide:trending-up" : "lucide:trending-down")" Class="size-3.5" /></LeadingIcon>
            <ChildContent>@(Change >= 0 ? "+" : "-")@Math.Abs(Change).ToString("0.0")%</ChildContent>
        </KlyBadge>
        <span class="text-xs text-(--klyroo-text-muted)">than the period before</span>
    </div>
</KlyCard>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>The change in percent, negative when the number went down.</summary>
    [Parameter] public double Change { get; set; }

    /// <summary>The name of an icon.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    [Parameter] public string? TestId { get; set; }
}
