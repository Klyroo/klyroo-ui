@using System.ComponentModel.DataAnnotations
@inject CustomerStore Store
@inject IToastService Toasts

@* The form of a new customer, in a slideover. The country is searched in a remote source (BxSelectMenu with an options provider): a list of any size works, because
   only the page that matches the search is loaded. *@
<BxSlideover Open="Open" OpenChanged="OpenChanged" Title="New customer" Description="The customer is added to the table for this session." Side="SlideoverSide.Right" data-testid="new-customer">
    <Body>
        <BxForm Model="_model" FormName="new-customer" OnValidSubmit="CreateAsync" id="new-customer-form" class="flex flex-col gap-4">
            <BxFormField Label="Name" Required For="() => _model.Name">
                <BxInput @bind-Value="_model.Name" autocomplete="off" data-testid="new-name" />
            </BxFormField>
            <BxFormField Label="Email" Required For="() => _model.Email">
                <BxInput @bind-Value="_model.Email" Type="email" autocomplete="off" data-testid="new-email" />
            </BxFormField>
            <BxFormField Label="Company" For="() => _model.Company">
                <BxInput @bind-Value="_model.Company" autocomplete="off" />
            </BxFormField>
            <BxFormField Label="Country" Required Error="@_countryError">
                <BxSelectMenu OptionsProvider="CountryDirectory.Search" ResolveSelected="CountryDirectory.Resolve" PageSize="12" Placeholder="Search a country"
                              Value="_country" ValueChanged="OnCountry" data-testid="new-country" />
            </BxFormField>
            <BxFormField Label="Plan">
                <BxSelect Items="_plans" @bind-Value="_model.Plan" />
            </BxFormField>
        </BxForm>
    </Body>
    <Footer>
        <BxButton Label="Cancel" Variant="ButtonVariant.Ghost" Color="BxColor.Neutral" data-bx-close />
        <BxButton Label="Create customer" Type="submit" form="new-customer-form" data-testid="new-create" />
    </Footer>
</BxSlideover>

@code {
    private static readonly BxSelectItem[] _plans = [.. CustomerData.Plans.Select(p => new BxSelectItem(p, p))];

    private readonly NewCustomer _model = new();
    private IReadOnlyList<string> _country = [];
    private string? _countryError;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private void OnCountry(IReadOnlyList<string>? value)
    {
        _country = value ?? [];
        _countryError = null;
    }

    private async Task CreateAsync()
    {
        if (_country.Count == 0)
        {
            _countryError = "Pick a country.";
            return;
        }
        var customer = Store.Add(_model.Name!.Trim(), _model.Email!.Trim(), string.IsNullOrWhiteSpace(_model.Company) ? "Independent" : _model.Company.Trim(), CountryDirectory.NameOf(_country[0]), _model.Plan);
        await Toasts.Add(new BxToast { Title = "Customer added", Description = $"{customer.Name} is in the table.", Color = BxColor.Success });
        _model.Name = _model.Email = _model.Company = null;
        _model.Plan = "Free";
        _country = [];
        await OpenChanged.InvokeAsync(false);
    }

    private sealed class NewCustomer
    {
        [Required(ErrorMessage = "The name is required.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "The email is required.")]
        [EmailAddress(ErrorMessage = "This is not an email address.")]
        public string? Email { get; set; }

        public string? Company { get; set; }

        public string Plan { get; set; } = "Free";
    }
}
