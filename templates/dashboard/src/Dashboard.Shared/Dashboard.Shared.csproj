<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tailwind compiled by the build (no Node): Styles/app.css becomes _content/Dashboard.Shared/app.css, for the web host and the MAUI app. -->
    <KlyrooTailwind>true</KlyrooTailwind>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Icons the build cannot see because the page picks the name at run time (a variable, a condition). The ones written as literals are found by the build. -->
  <ItemGroup>
    <KlyrooIcon Include="lucide:trending-up;lucide:trending-down;lucide:monitor;lucide:smartphone;lucide:laptop" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Klyroo.UI" />
    <!-- The data table of the Customers page is KlyDataList. Tools has no precompiled stylesheet: KlyrooTailwind (above) compiles its classes too. -->
    <PackageReference Include="Klyroo.Table" />
  </ItemGroup>

</Project>
