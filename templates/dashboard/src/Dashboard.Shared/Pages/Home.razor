@page "/"
@using System.Globalization

<PageTitle>Home</PageTitle>

<AppPage Title="Home" TestId="home">
    <Toolbar>
        <KlyDashboardToolbar>
            <Left>
                @* The period is in the address (?period=month): a link works without a script and the view can be shared. *@
                <nav aria-label="Period" class="flex items-center gap-1">
                    @foreach (var (period, label) in _periods)
                    {
                        var name = period.ToString().ToLowerInvariant();
                        <KlyButton Label="@label" Size="KlySize.Sm" Color="KlyColor.Neutral" Href="@($"./?period={name}")"
                                  Variant="@(period == _period ? ButtonVariant.Soft : ButtonVariant.Ghost)"
                                  aria-current="@(period == _period ? "true" : null)" data-testid="@($"period-{name}")" />
                    }
                </nav>
            </Left>
        </KlyDashboardToolbar>
    </Toolbar>
    <ChildContent>
        <section aria-label="Key figures" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <StatCard Label="Revenue" Icon="lucide:circle-dollar-sign" TestId="stat-revenue"
                      Value="@FormatMoney((double)_summary.Revenue)" Change="Change((double)_summary.Revenue, (double)_summary.PreviousRevenue)" />
            <StatCard Label="Orders" Icon="lucide:shopping-bag" TestId="stat-orders"
                      Value="@_summary.Orders.ToString("N0", CultureInfo.CurrentCulture)" Change="Change(_summary.Orders, _summary.PreviousOrders)" />
            <StatCard Label="New customers" Icon="lucide:user-plus" TestId="stat-customers"
                      Value="@_summary.NewCustomers.ToString("N0", CultureInfo.CurrentCulture)" Change="Change(_summary.NewCustomers, _summary.PreviousNewCustomers)" />
            <StatCard Label="Conversion rate" Icon="lucide:percent" TestId="stat-conversion"
                      Value="@($"{_summary.Conversion.ToString("0.00", CultureInfo.CurrentCulture)}%")" Change="Change(_summary.Conversion, _summary.PreviousConversion)" />
        </section>

        <div class="grid gap-4 xl:grid-cols-3">
            <KlyCard Class="xl:col-span-2" data-testid="revenue-card">
                <Header>
                    <h2 class="font-semibold text-(--klyroo-text-highlighted)">Revenue</h2>
                    <p class="text-sm text-(--klyroo-text-muted)">@PeriodLabel, compared with the period before.</p>
                </Header>
                <ChildContent>
                    <KlyChart TItem="RevenuePoint" Data="_revenue" Index="@(p => p.Label)" Categories="_categories" Type="KlyChartType.Area" Curve="KlyChartCurve.Monotone"
                             Format="FormatMoney" Width="720" Height="300" AriaLabel="@($"Revenue, {PeriodLabel}, compared with the period before")" Table="KlyChartTable.Toggle" data-testid="revenue-chart" />
                </ChildContent>
            </KlyCard>

            <KlyCard data-testid="channels-card">
                <Header>
                    <h2 class="font-semibold text-(--klyroo-text-highlighted)">Revenue by channel</h2>
                    <p class="text-sm text-(--klyroo-text-muted)">Where the orders came from.</p>
                </Header>
                <ChildContent>
                    <KlyChart TItem="ChannelShare" Data="_channels" Index="@(c => c.Channel)" Categories="_channelCategories" Type="KlyChartType.Donut"
                             Format="FormatMoney" Height="300" Thickness="40" data-testid="channels-chart">
                        <Center>
                            <span class="text-xl font-semibold text-(--klyroo-text-highlighted)">@FormatMoney(_channels.Sum(c => c.Revenue))</span>
                            <span class="text-xs text-(--klyroo-text-muted)">total</span>
                        </Center>
                    </KlyChart>
                </ChildContent>
            </KlyCard>
        </div>

        <div class="grid gap-4 xl:grid-cols-3">
            <KlyCard Class="xl:col-span-2" data-testid="sales-card">
                <Header>
                    <div class="flex items-center justify-between gap-3">
                        <h2 class="font-semibold text-(--klyroo-text-highlighted)">Recent sales</h2>
                        <KlyButton Label="All customers" Href="customers" Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" Size="KlySize.Sm" />
                    </div>
                </Header>
                <ChildContent>
                    <ul class="flex flex-col divide-y divide-(--klyroo-border)" aria-label="Recent sales">
                        @foreach (var sale in SalesData.Recent)
                        {
                            <li class="flex items-center gap-3 py-3 first:pt-0 last:pb-0" data-testid="sale">
                                <KlyAvatar Alt="@sale.Customer.Name" Size="KlySize.Sm" />
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium text-(--klyroo-text-highlighted)">@sale.Customer.Name</p>
                                    <p class="truncate text-xs text-(--klyroo-text-muted)">@sale.Customer.Email</p>
                                </div>
                                <KlyBadge Label="@sale.Status" Color="@StatusColor(sale.Status)" Variant="KlyVariant.Subtle" Size="KlySize.Sm" class="max-sm:hidden" />
                                <div class="text-end">
                                    <p class="text-sm font-medium tabular-nums text-(--klyroo-text-highlighted)">@Dashboard.Shared.Data.Money.Format(sale.Amount, 2)</p>
                                    <p class="text-xs text-(--klyroo-text-muted)">Today, @sale.At.ToString("HH:mm", CultureInfo.CurrentCulture)</p>
                                </div>
                            </li>
                        }
                    </ul>
                </ChildContent>
            </KlyCard>

            <KlyCard data-testid="orders-card">
                <Header>
                    <h2 class="font-semibold text-(--klyroo-text-highlighted)">Orders per day</h2>
                    <p class="text-sm text-(--klyroo-text-muted)">The last two weeks.</p>
                </Header>
                <ChildContent>
                    <KlyChart TItem="DayOrders" Data="_ordersByDay" Index="@(d => d.Day)" Categories="_orderCategories" Type="KlyChartType.Bar"
                             Legend="false" Width="420" Height="300" Table="KlyChartTable.Toggle" data-testid="orders-chart" />
                </ChildContent>
            </KlyCard>
        </div>
    </ChildContent>
</AppPage>

@code {
    private sealed record DayOrders(string Day, int Orders);

    private static readonly (MetricsPeriod Period, string Label)[] _periods =
    [
        (MetricsPeriod.Week, "7 days"), (MetricsPeriod.Month, "30 days"), (MetricsPeriod.Quarter, "12 weeks"), (MetricsPeriod.Year, "1 year"),
    ];

    private static readonly KlyChartCategory<RevenuePoint>[] _categories =
    [
        new("current", p => p.Current) { Label = "This period" },
        new("previous", p => p.Previous) { Label = "Period before", Color = KlyColor.Neutral },
    ];

    private static readonly KlyChartCategory<ChannelShare>[] _channelCategories = [new("revenue", c => c.Revenue) { Label = "Revenue" }];

    private static readonly KlyChartCategory<DayOrders>[] _orderCategories = [new("orders", d => d.Orders) { Label = "Orders" }];

    private MetricsPeriod _period = MetricsPeriod.Month;
    private MetricsSummary _summary = default!;
    private IReadOnlyList<RevenuePoint> _revenue = [];
    private IReadOnlyList<ChannelShare> _channels = [];
    private IReadOnlyList<DayOrders> _ordersByDay = [];

    [SupplyParameterFromQuery(Name = "period")] private string? PeriodName { get; set; }

    private string PeriodLabel => _period switch
    {
        MetricsPeriod.Week => "The last 7 days",
        MetricsPeriod.Month => "The last 30 days",
        MetricsPeriod.Quarter => "The last 12 weeks",
        _ => "The last year",
    };

    protected override void OnParametersSet()
    {
        _period = Enum.TryParse<MetricsPeriod>(PeriodName, ignoreCase: true, out var period) && Enum.IsDefined(period) ? period : MetricsPeriod.Month;
        _summary = MetricsData.Summary(_period);
        _revenue = MetricsData.Revenue(_period);
        _channels = MetricsData.Channels(_period);
        _ordersByDay = [.. MetricsData.OrdersByDay().Select(d => new DayOrders(d.Day, d.Orders))];
    }

    private static string FormatMoney(double value) => Dashboard.Shared.Data.Money.Format((decimal)value);

    private static double Change(double current, double previous) => previous == 0 ? 0 : (current - previous) / previous * 100;

    private static KlyColor StatusColor(string status) => status switch
    {
        "Paid" => KlyColor.Success,
        "Pending" => KlyColor.Warning,
        _ => KlyColor.Neutral,
    };
}
