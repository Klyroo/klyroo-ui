@inject AppState App
@inject IToastService Toasts

@* The signed-in user at the bottom of the sidebar. There is no sign-in in this template: the user is a sample one. *@
<LxDropdownMenu Items="_items" OnSelect="OnSelect" Placement="top-start">
    <button type="button"
            class="flex w-full min-w-0 items-center gap-2 rounded-(--lux-radius) p-1.5 text-start transition-colors hover:bg-(--lux-bg-elevated) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--lux-primary-text)"
            data-testid="user-menu">
        @* The avatar repeats the name next to it: hidden, so the button is named by the visible text. *@
        <LxAvatar Alt="Maren Albrecht" Size="LxSize.Sm" aria-hidden="true" />
        <span class="min-w-0 flex-1 truncate text-sm font-medium text-(--lux-text-highlighted) group-data-[state=collapsed]/sidebar:sr-only">Maren Albrecht</span>
        <LxIcon Name="chevrons-up-down" Class="size-4 shrink-0 text-(--lux-text-muted) group-data-[state=collapsed]/sidebar:hidden" />
    </button>
</LxDropdownMenu>

@code {
    private static readonly LxMenuItem[] _items =
    [
        LxMenuItem.Heading("maren@example.com"),
        new() { Label = "Profile", Href = "settings", Icon = LxIcons.Named("user", "size-4") },
        new() { Label = "Notifications", Value = "notifications", Icon = LxIcons.Named("bell", "size-4") },
        new() { Label = "Appearance", Value = "appearance", Icon = LxIcons.Named("lucide:palette", "size-4") },
        LxMenuItem.Separator(),
        new() { Label = "Log out", Value = "logout", Icon = LxIcons.Named("log-out", "size-4"), Color = LxColor.Error },
    ];

    private async Task OnSelect(LxMenuItem item)
    {
        switch (item.Value ?? item.Label)
        {
            case "notifications":
                App.OpenNotifications();
                break;
            case "appearance":
                App.OpenAppearance();
                break;
            case "logout":
                await Toasts.Add(new LxToast { Title = "No sign-in here", Description = "This template has no authentication: add yours and sign out from here.", Color = LxColor.Info });
                break;
        }
    }
}
