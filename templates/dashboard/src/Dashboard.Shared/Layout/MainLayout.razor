@inherits LayoutComponentBase
@implements IDisposable
@inject AppearanceState Appearance
@inject IToastService Toasts
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState

@* KlyHead sends the theme variables and the self-hosted fonts to <head> through the HeadOutlet root component of the MAUI app.
   It renders nothing on the web, where App.razor places them. *@
<KlyHead />
<SystemBars />

@* The primary color of the appearance dialog. The colors of AddKlyrooUi (the default ones here) are the base; this style replaces them for the page. *@
<KlyThemeStyle Colors="Appearance.Colors" Scope=":root" />

<KlyApp>
    <KlySkipLink />

    @* The group fills its parent, so the parent needs a height: the page itself. It is the main landmark, so the sidebar, the panels and their resize handles are all
       inside a landmark (the sidebar is a div: its navigation is a landmark of its own, and a complementary one may not sit in main). Each page puts one or more
       panels next to the sidebar. *@
    <KlyMain id="main" tabindex="-1" Class="h-dvh min-h-0 focus:outline-none">
        <KlyDashboardGroup StorageKey="dashboard">
            @* Links are relative: they resolve against <base href>, so the app works at the root of a site and below a path. *@
            <KlyDashboardSidebar As="KlyElement.Div" Resizable Width="260" MinWidth="208" MaxWidth="360" AriaLabel="Main" MobileTitle="Menu" data-testid="sidebar">
                <Header>
                    <TeamMenu />
                </Header>
                <ChildContent>
                    <KlyDashboardSearchButton data-testid="search-button" />
                    <KlyNavigationMenu Items="_items" Orientation="KlyOrientation.Vertical" AriaLabel="Pages" Ui="_navUi" />
                </ChildContent>
                <Footer>
                    <UserMenu />
                </Footer>
            </KlyDashboardSidebar>

            @Body

            <KlyDashboardSearch Groups="_groups" OnSelect="OnCommand" />
        </KlyDashboardGroup>
    </KlyMain>

    @* Says how the page renders (Static until it is interactive, then Server or WebAssembly): what the browser tests wait for before they click. *@
    <span class="sr-only" aria-hidden="true" data-testid="renderer">@RendererInfo.Name</span>

    <NotificationsSlideover />
    <AppearanceDialog />
</KlyApp>

<div id="blazor-error-ui" data-nosnippet class="fixed inset-x-0 bottom-0 z-50 hidden bg-amber-100 px-4 py-3 text-sm text-zinc-900">
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss ms-4 cursor-pointer">x</span>
</div>

@code {
    [Inject] private AppState App { get; set; } = default!;

    // In a collapsed sidebar the labels stay for screen readers and the icons are all that shows.
    private static readonly NavigationMenuUi _navUi = new() { Label = "group-data-[state=collapsed]/sidebar:sr-only" };

    private static readonly KlyNavigationItem[] _items =
    [
        new("Home") { Href = "./", Exact = true, Icon = KlyIcons.Named("home", "size-5") },
        new("Inbox") { Href = "inbox", Icon = KlyIcons.Named("inbox", "size-5") },
        new("Customers") { Href = "customers", Icon = KlyIcons.Named("lucide:users", "size-5") },
        new("Settings") { Href = "settings", Icon = KlyIcons.Named("lucide:settings", "size-5") },
    ];

    // Ctrl+K (Cmd+K) opens it. Links navigate on their own; the commands without a link come to OnCommand.
    private static readonly KlyCommandGroup[] _groups =
    [
        new("Go to",
        [
            new() { Label = "Home", Href = "./", Keywords = "overview revenue sales stats", Icon = KlyIcons.Named("home", "size-4") },
            new() { Label = "Inbox", Href = "inbox", Keywords = "mail messages", Icon = KlyIcons.Named("inbox", "size-4") },
            new() { Label = "Customers", Href = "customers", Keywords = "people accounts table", Icon = KlyIcons.Named("lucide:users", "size-4") },
            new() { Label = "General settings", Href = "settings", Keywords = "profile account", Icon = KlyIcons.Named("lucide:settings", "size-4") },
            new() { Label = "Members", Href = "settings/members", Keywords = "team invite roles", Icon = KlyIcons.Named("lucide:user-plus", "size-4") },
            new() { Label = "Notification settings", Href = "settings/notifications", Keywords = "email alerts", Icon = KlyIcons.Named("bell", "size-4") },
            new() { Label = "Security", Href = "settings/security", Keywords = "password sessions two-factor", Icon = KlyIcons.Named("lock", "size-4") },
        ]),
        new("Customers",
        [
            .. CustomerData.All.OrderByDescending(c => c.TotalSpent).Take(5).Select(c => new KlyCommandItem
            {
                Label = c.Name,
                Description = c.Company,
                Href = $"customers?q={Uri.EscapeDataString(c.Name)}",
                Keywords = c.Email,
                Icon = KlyIcons.Named("user", "size-4"),
            }),
        ]),
        new("Actions",
        [
            new() { Label = "Open notifications", Value = "notifications", Keywords = "bell alerts", Icon = KlyIcons.Named("bell", "size-4") },
            new() { Label = "Change the appearance", Value = "appearance", Keywords = "theme color primary dark light", Icon = KlyIcons.Named("lucide:palette", "size-4") },
            new() { Label = "Log out", Value = "logout", Keywords = "sign out", Icon = KlyIcons.Named("log-out", "size-4") },
        ]),
    ];

    private const string PersistKey = "appearance";

    private PersistingComponentStateSubscription _persisting;

    protected override void OnInitialized()
    {
        // A prerender read the cookie and has the colors; the interactive render that follows it has no request, so the prerender hands them over (as the names of the
        // two palettes) and the first interactive render keeps them instead of starting from the defaults.
        if (ApplicationState.TryTakeFromJson<string>(PersistKey, out var saved) && saved?.Split('|') is [var primary, var neutral])
        {
            Appearance.Restore(primary, neutral);
        }
        _persisting = ApplicationState.RegisterOnPersisting(() =>
        {
            ApplicationState.PersistAsJson(PersistKey, $"{Appearance.Primary.Name}|{Appearance.Neutral.Name}");
            return Task.CompletedTask;
        });
        Appearance.Changed += OnAppearanceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Appearance.LoadAsync();
    }

    private void OnAppearanceChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnCommand(KlyCommandItem item)
    {
        switch (item.Value ?? item.Label)
        {
            case "notifications":
                App.OpenNotifications();
                break;
            case "appearance":
                App.OpenAppearance();
                break;
            case "logout":
                await Toasts.Add(new KlyToast { Title = "No sign-in here", Description = "This template has no authentication: add yours and sign out from here.", Color = KlyColor.Info });
                break;
        }
    }

    public void Dispose()
    {
        Appearance.Changed -= OnAppearanceChanged;
        _persisting.Dispose();
    }
}
