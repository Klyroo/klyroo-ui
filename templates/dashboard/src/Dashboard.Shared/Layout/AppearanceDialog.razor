@implements IDisposable
@inject AppState App
@inject AppearanceState Appearance

@* The primary color, and the color mode. The mode is Klyroo's own control: it is remembered in the browser and applied before the first paint. *@
<KlyModal @bind-Open="_open" Title="Appearance" Description="Pick the color of buttons, links and focus rings, and the gray of text, backgrounds and borders." data-testid="appearance">
    <Body>
        <div class="flex flex-col gap-5">
            <p class="-mb-3 text-sm font-medium text-(--klyroo-text-highlighted)">Primary color</p>
            <div role="group" aria-label="Primary color" class="flex flex-wrap gap-2">
                @foreach (var palette in AppearanceState.Palettes)
                {
                    var current = palette;
                    <KlyButton Label="@Label(current)" Size="KlySize.Sm" Color="KlyColor.Neutral"
                              Variant="@(current == Appearance.Primary ? ButtonVariant.Solid : ButtonVariant.Outline)"
                              aria-pressed="@(current == Appearance.Primary ? "true" : "false")"
                              data-testid="@($"palette-{current.Name}")"
                              OnClick="@(() => Appearance.SetAsync(current, Appearance.Neutral))" />
                }
            </div>
            <p class="-mb-3 text-sm font-medium text-(--klyroo-text-highlighted)">Neutral color</p>
            <div role="group" aria-label="Neutral color" class="flex flex-wrap gap-2">
                @foreach (var palette in AppearanceState.Neutrals)
                {
                    var current = palette;
                    <KlyButton Label="@Label(current)" Size="KlySize.Sm" Color="KlyColor.Neutral"
                              Variant="@(current == Appearance.Neutral ? ButtonVariant.Solid : ButtonVariant.Outline)"
                              aria-pressed="@(current == Appearance.Neutral ? "true" : "false")"
                              data-testid="@($"neutral-{current.Name}")"
                              OnClick="@(() => Appearance.SetAsync(Appearance.Primary, current))" />
                }
            </div>
            <KlyFormField Label="Color mode">
                <KlyColorModeSelect />
            </KlyFormField>
        </div>
    </Body>
    <Footer>
        <KlyButton Label="Done" data-kly-close />
    </Footer>
</KlyModal>

@code {
    private bool _open;

    private static string Label(KlyPalette palette) => palette.IsKlyroo ? "Default" : char.ToUpperInvariant(palette.Name[0]) + palette.Name[1..];

    protected override void OnInitialized()
    {
        App.AppearanceRequested += OnRequested;
        Appearance.Changed += OnChanged;
    }

    private void OnRequested() => _ = InvokeAsync(() =>
    {
        _open = true;
        StateHasChanged();
    });

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        App.AppearanceRequested -= OnRequested;
        Appearance.Changed -= OnChanged;
    }
}
