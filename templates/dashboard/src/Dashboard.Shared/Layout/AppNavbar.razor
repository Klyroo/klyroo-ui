@implements IDisposable
@inject AppState App
@inject NotificationStore Notifications

@* The top bar of every page: the sidebar toggle (below lg), the title, the actions of the page, the color mode and the notifications. *@
<LxDashboardNavbar Title="@Title">
    <Leading>
        <LxDashboardSidebarCollapse />
    </Leading>
    <Right>
        @Actions
        <LxColorModeButton />
        <LxChip Show="@(Notifications.UnreadCount > 0)" Label="@($"{Notifications.UnreadCount} unread notifications")" Size="LxSize.Sm" Inset>
            <LxButton Square Variant="ButtonVariant.Ghost" Color="LxColor.Neutral" aria-label="Notifications" OnClick="App.OpenNotifications" data-testid="notifications-button">
                <LeadingIcon>@LxIcons.Named("bell")</LeadingIcon>
            </LxButton>
        </LxChip>
        <LxDropdownMenu Items="_create" Placement="bottom-end">
            <LxButton Square Variant="ButtonVariant.Solid" aria-label="Create" data-testid="create-button">
                <LeadingIcon>@LxIcons.Named("plus")</LeadingIcon>
            </LxButton>
        </LxDropdownMenu>
    </Right>
</LxDashboardNavbar>

@code {
    /// <summary>The title of the page.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Extra actions of the page, before the color mode button.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    private static readonly LxMenuItem[] _create =
    [
        new() { Label = "New message", Href = "inbox", Icon = LxIcons.Named("mail", "size-4") },
        new() { Label = "New customer", Href = "customers?new=true", Icon = LxIcons.Named("user", "size-4") },
        new() { Label = "Invite people", Href = "settings/members", Icon = LxIcons.Named("lucide:user-plus", "size-4") },
    ];

    protected override void OnInitialized() => Notifications.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Notifications.Changed -= OnChanged;
}
